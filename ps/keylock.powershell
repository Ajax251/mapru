# 1. Отключение залипания клавиш (Sticky Keys)
Set-ItemProperty -Path "HKCU:\Control Panel\Accessibility\StickyKeys" -Name "Flags" -Value "506"

# 2. Отключение фильтрации ввода (Filter Keys)
Set-ItemProperty -Path "HKCU:\Control Panel\Accessibility\Keyboard Response" -Name "Flags" -Value "122"

# 3. Отключение озвучивания нажатий (Toggle Keys)
Set-ItemProperty -Path "HKCU:\Control Panel\Accessibility\ToggleKeys" -Name "Flags" -Value "58"

# 4. Отключение быстрого вызова 5 нажатиями Shift (отключение шорткатов)
Set-ItemProperty -Path "HKCU:\Control Panel\Accessibility\StickyKeys" -Name "Flags" -Value "504"
Set-ItemProperty -Path "HKCU:\Control Panel\Accessibility\TimeOut" -Name "Flags" -Value "0"

Write-Host "Все функции залипания и фильтрации клавиатуры успешно отключены!" -ForegroundColor Green