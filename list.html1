/* =====================================================================
   ЛИНЕЙКИ (горизонтальная и вертикальная) — как в Word:
   • поля страницы (серые зоны) перетаскиваются мышью;
   • маркеры отступов абзаца: первая строка ▽, выступ △, слева ▭, справа △;
   • границы столбцов таблицы;
   • шаг привязки 0,25 см (Alt — без привязки), подсказка со значением,
     пунктирная направляющая через весь документ, двойной щелчок —
     «Параметры страницы».
   ===================================================================== */
const rulerH = $('rulerH'), rulerV = $('rulerV');
let rulerRaf = 0, rulerDrag = null, rulerHits = { h: [], v: [] };
function drawRulers() {
  if (!view.rulers || rulerRaf) return;
  rulerRaf = requestAnimationFrame(() => { rulerRaf = 0; try { drawRulerH(); drawRulerV(); } catch (e) { console.warn(e); } });
}
function prepCanvas(cv) {
  const r = cv.getBoundingClientRect(), dpr = window.devicePixelRatio || 1;
  const w = Math.max(1, Math.round(r.width * dpr)), h = Math.max(1, Math.round(r.height * dpr));
  if (cv.width !== w || cv.height !== h) { cv.width = w; cv.height = h; }
  const ctx = cv.getContext('2d'); ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  return { ctx, r };
}
function rulerColors() {
  const cs = getComputedStyle(document.documentElement);
  return { bg: cs.getPropertyValue('--canvas-bg').trim(), white: cs.getPropertyValue('--ruler-bg').trim(),
           margin: cs.getPropertyValue('--ruler-margin').trim(), tick: cs.getPropertyValue('--ruler-tick').trim() };
}
function wsGeom() {
  const ws = workspace.getBoundingClientRect(), d = dims();
  return { ws, d, s: ws.width / d.W };
}
/* сведения об отступах текущего абзаца */
function indentInfo() {
  const r = getRange() || savedRange;
  if (!r || !editor.contains(r.startContainer)) return null;
  const b = closestBlock(r.startContainer);
  if (!b || b.tagName === 'TD' || b.tagName === 'TH') return null;
  const { ws, s } = wsGeom();
  const par = b.parentElement, pr = par.getBoundingClientRect(), pcs = getComputedStyle(par), bcs = getComputedStyle(b);
  const baseL = (pr.left - ws.left) / s + parseFloat(pcs.paddingLeft) + parseFloat(pcs.borderLeftWidth);
  const baseR = (pr.right - ws.left) / s - parseFloat(pcs.paddingRight) - parseFloat(pcs.borderRightWidth);
  const ml = parseFloat(bcs.marginLeft) || 0, mr = parseFloat(bcs.marginRight) || 0, ti = parseFloat(bcs.textIndent) || 0;
  return { b, baseL, baseR, left: baseL + ml, first: baseL + ml + ti, right: baseR - mr, ml, mr, ti };
}
function tableInfo() {
  const r = getRange() || savedRange;
  if (!r || !editor.contains(r.startContainer)) return null;
  const n = r.startContainer.nodeType === 1 ? r.startContainer : r.startContainer.parentNode;
  const cell = n.closest && n.closest('td,th');
  if (!cell || !editor.contains(cell) || cell.closest('[data-pb]')) return null;
  const table = cell.closest('table');
  const { ws, s } = wsGeom();
  const cols = ensureColgroup(table);
  const tr = table.getBoundingClientRect();
  let x = (tr.left - ws.left) / s; const edges = [x];
  const total = tr.width / s;
  cols.forEach(c => { x += parseFloat(c.style.width) / 100 * total; edges.push(x); });
  return { table, edges, cell };
}

function drawRulerH() {
  const { ctx, r } = prepCanvas(rulerH);
  const C = rulerColors(), { ws, d, s } = wsGeom();
  const x0 = ws.left - r.left, W = r.width, H = r.height;
  ctx.clearRect(0, 0, W, H);
  ctx.fillStyle = C.bg; ctx.fillRect(0, 0, W, H);
  const top = 4, bot = H - 4;
  ctx.fillStyle = C.margin; ctx.fillRect(x0, top, d.W * s, bot - top);
  ctx.fillStyle = C.white; ctx.fillRect(x0 + d.ml * s, top, (d.W - d.ml - d.mr) * s, bot - top);
  // деления
  const origin = x0 + d.ml * s, q = mm2px(2.5) * s;
  ctx.strokeStyle = C.tick; ctx.fillStyle = C.tick; ctx.lineWidth = 1;
  ctx.font = '9px Segoe UI, Arial'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
  const kMin = -Math.floor(d.ml * s / q), kMax = Math.floor((d.W - d.ml) * s / q);
  const showEvery = q * 4 < 22 ? 2 : 1;
  ctx.beginPath();
  for (let k = kMin; k <= kMax; k++) {
    const x = Math.round(origin + k * q) + 0.5, mid = (top + bot) / 2;
    if (k % 4 === 0) { if (k !== 0 && (k / 4) % showEvery === 0) ctx.fillText(Math.abs(k / 4), x, mid + 0.5); }
    else if (k % 2 === 0) { ctx.moveTo(x, mid - 3); ctx.lineTo(x, mid + 3); }
    else if (q > 4) { ctx.moveTo(x, mid - 1); ctx.lineTo(x, mid + 1); }
  }
  ctx.stroke();
  const hits = [];
  hits.push({ kind: 'ml', x: origin, prio: 1 }, { kind: 'mr', x: x0 + (d.W - d.mr) * s, prio: 1 },
            { kind: 'ml', x: origin, y0: 8.5, y1: 12, prio: 7 }, { kind: 'mr', x: x0 + (d.W - d.mr) * s, y0: 8.5, y1: 12, prio: 7 });
  // таблица
  const ti = tableInfo();
  if (ti) {
    ti.edges.forEach((e, i) => {
      const x = x0 + e * s;
      ctx.fillStyle = C.margin; ctx.fillRect(x - 3, top, 6, bot - top);
      ctx.strokeStyle = C.tick; ctx.strokeRect(Math.round(x - 3) + .5, top + .5, 6, bot - top - 1);
      if (i > 0 && i < ti.edges.length - 1) hits.push({ kind: 'col', x, idx: i - 1, table: ti.table, prio: 3 });
    });
  }
  // отступы
  const ii = indentInfo();
  if (ii) {
    const fx = x0 + ii.first * s, lx = x0 + ii.left * s, rx = x0 + ii.right * s;
    const marker = (x, up, y) => {
      ctx.beginPath();
      if (up) { ctx.moveTo(x - 4.5, y + 5); ctx.lineTo(x + 4.5, y + 5); ctx.lineTo(x, y); }
      else { ctx.moveTo(x - 4.5, y); ctx.lineTo(x + 4.5, y); ctx.lineTo(x, y + 5); }
      ctx.closePath(); ctx.fillStyle = '#fff'; ctx.fill(); ctx.strokeStyle = '#555'; ctx.stroke();
    };
    marker(fx, false, 0.5);
    marker(lx, true, H - 11.5);
    ctx.fillStyle = '#fff'; ctx.fillRect(lx - 4.5, H - 6, 9, 5); ctx.strokeStyle = '#555'; ctx.strokeRect(Math.round(lx - 4.5) + .5, H - 6.5, 9, 5);
    marker(rx, true, H - 9.5);
    hits.push({ kind: 'first', x: fx, y0: 0, y1: 8, prio: 5, info: ii },
              { kind: 'hang', x: lx, y0: 12.5, y1: H - 6, prio: 5, info: ii },
              { kind: 'lbox', x: lx, y0: H - 7, y1: H, prio: 6, info: ii },
              { kind: 'rind', x: rx, y0: 12.5, y1: H, prio: 5, info: ii });
  }
  rulerHits.h = hits;
}
function drawRulerV() {
  const { ctx, r } = prepCanvas(rulerV);
  const C = rulerColors(), { ws, d, s } = wsGeom();
  const W = r.width, H = r.height;
  ctx.clearRect(0, 0, W, H); ctx.fillStyle = C.bg; ctx.fillRect(0, 0, W, H);
  let idx = caretPage();
  const c = canvas.getBoundingClientRect();
  const pageTopAt = i => ws.top + i * pageStep() * s;
  if (idx === null || pageTopAt(idx) > c.bottom || pageTopAt(idx) + d.H * s < c.top) idx = visiblePage();
  const y0 = pageTopAt(idx) - r.top;
  const left = 4, right = W - 4;
  ctx.fillStyle = C.margin; ctx.fillRect(left, y0, right - left, d.H * s);
  ctx.fillStyle = C.white; ctx.fillRect(left, y0 + d.mt * s, right - left, (d.H - d.mt - d.mb) * s);
  const origin = y0 + d.mt * s, q = mm2px(2.5) * s;
  ctx.strokeStyle = C.tick; ctx.fillStyle = C.tick; ctx.font = '9px Segoe UI, Arial';
  ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
  const showEvery = q * 4 < 22 ? 2 : 1;
  ctx.beginPath();
  for (let k = -Math.floor(d.mt * s / q); k <= Math.floor((d.H - d.mt) * s / q); k++) {
    const y = Math.round(origin + k * q) + 0.5, mid = W / 2;
    if (y < -10 || y > H + 10) continue;
    if (k % 4 === 0) { if (k !== 0 && (k / 4) % showEvery === 0) { ctx.save(); ctx.translate(mid, y); ctx.rotate(-Math.PI / 2); ctx.fillText(Math.abs(k / 4), 0, 0.5); ctx.restore(); } }
    else if (k % 2 === 0) { ctx.moveTo(mid - 3, y); ctx.lineTo(mid + 3, y); }
    else if (q > 4) { ctx.moveTo(mid - 1, y); ctx.lineTo(mid + 1, y); }
  }
  ctx.stroke();
