        const rr = document.createRange();
        if (nx.nodeType === 3 && nx.nodeValue.length) { rr.setStart(nx, 0); rr.setEnd(nx, 1); } else rr.selectNode(nx);
        const rs = rr.getClientRects(); if (!rs.length) break;
        const err = target - (rs[0].top - geo.top) / geo.scale;
        if (Math.abs(err) < 0.3) break;
        h = Math.max(0, h + err); sp.style.height = h + 'px';
