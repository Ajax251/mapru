}
function relY(clientY) { return (clientY - geo.top) / geo.scale; }

function paginate() {
  clearTimeout(paginateTimer);
  if (!editor.firstChild) editor.innerHTML = '<p><br></p>';
  const d = dims(), step = d.H + view.gap;
  clearPagination();
  editor.style.minHeight = d.H + 'px';
  geoInit();
  const pageOf = y => Math.max(0, Math.floor((y + 0.5) / step));
  const cTop = k => k * step + d.mt, cBot = k => k * step + d.H - d.mb;
  const usable = d.H - d.mt - d.mb;
  let breakTarget = null;
  let guard = 0;

  function push(el, target) {
    const before = relRect(el).top;
    if (target - before < 0.5) return;
    let prev = el.previousElementSibling;
    while (prev && prev.hasAttribute('data-pb')) prev = prev.previousElementSibling;
    let mt;
    if (prev && getComputedStyle(prev).float === 'none') mt = target - relRect(prev).bottom;
    else mt = (parseFloat(getComputedStyle(el).marginTop) || 0) + (target - before);
    el.classList.add('pb-push'); el.style.setProperty('--pb-mt', mt + 'px');
