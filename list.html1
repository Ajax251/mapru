function htmlToMd(root) {
  const inline = n => Array.from(n.childNodes).map(c => {
    if (c.nodeType === 3) return c.nodeValue.replace(/([*_`[\]])/g, '\\$1');
    if (c.nodeType !== 1 || c.hasAttribute('data-pb')) return '';
    const t = c.tagName, inner = inline(c), st = c.style || {};
    if (t === 'BR') return '  \n';
    if (t === 'IMG') return `![${c.alt || ''}](${c.src.startsWith('data:') ? 'image' : c.src})`;
    if (t === 'A' && c.getAttribute('href')) return `[${inner}](${c.getAttribute('href')})`;
    if (t === 'CODE') return '`' + c.textContent + '`';
    const b = t === 'B' || t === 'STRONG' || st.fontWeight === 'bold' || parseInt(st.fontWeight) >= 600;
    const i = t === 'I' || t === 'EM' || st.fontStyle === 'italic';
    const s = t === 'S' || t === 'DEL' || t === 'STRIKE' || (st.textDecoration || '').includes('line-through');
    let r = inner; if (!r.trim()) return r;
    if (s) r = `~~${r}~~`; if (i) r = `*${r}*`; if (b) r = `**${r}**`;
    return r;
  }).join('');
  const block = (n, depth = 0) => Array.from(n.children).map(c => {
    if (c.hasAttribute('data-pb')) return '';
    const t = c.tagName;
    if (/^H(\d)$/.test(t)) return '#'.repeat(+t[1]) + ' ' + inline(c) + '\n\n';
    if (c.classList && c.classList.contains('doc-title')) return '# ' + inline(c) + '\n\n';
    if (t === 'UL' || t === 'OL') return Array.from(c.children).map((li, k) => '  '.repeat(depth) + (t === 'OL' ? `${k + 1}. ` : '- ') + inline(li).trim() + '\n' +
      Array.from(li.children).filter(x => x.tagName === 'UL' || x.tagName === 'OL').map(x => block({ children: [x] }, depth + 1)).join('')).join('') + (depth ? '' : '\n');
    if (t === 'BLOCKQUOTE') return '> ' + inline(c) + '\n\n';
    if (t === 'PRE') return '```\n' + c.textContent + '\n```\n\n';
    if (t === 'HR') return '---\n\n';
    if (c.classList.contains('manual-break')) return '\n---\n\n';
    if (c.classList.contains('toc')) return '';
    if (t === 'TABLE') {
      const rows = Array.from(c.rows).filter(r => !r.hasAttribute('data-pb')).map(r => '| ' + Array.from(r.cells).map(td => inline(td).replace(/\|/g, '\\|').replace(/\n/g, ' ').trim()).join(' | ') + ' |');
      if (!rows.length) return '';
      const n = Array.from(c.rows)[0].cells.length;
      return rows[0] + '\n|' + ' --- |'.repeat(n) + '\n' + rows.slice(1).join('\n') + '\n\n';
    }
    if (hasBlockChild(c)) return block(c, depth);
    return inline(c) + '\n\n';
  }).join('');
  return block(root).replace(/\n{3,}/g, '\n\n').trim() + '\n';
}

/* ---------- скачивание / системные диалоги ---------- */
function download(blob, name) {
  const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = name;
  document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 4000);
}
const safeName = () => (state.title || 'Документ').replace(/[\\/:*?"<>|]+/g, '_');
const FILE_TYPES = {
  docx: { description: 'Документ Word', accept: { 'application/vnd.openxmlformats-officedocument.wordprocessingml.document': ['.docx'] } },
  html: { description: 'Документ Лист / веб-страница', accept: { 'text/html': ['.html', '.htm'] } },
  txt: { description: 'Обычный текст', accept: { 'text/plain': ['.txt'] } },
  md: { description: 'Markdown', accept: { 'text/markdown': ['.md'] } }
};
async function makeBlob(kind) {
  if (kind === 'docx') return DOCX.build();
  if (kind === 'html') return new Blob([buildHtmlFile()], { type: 'text/html;charset=utf-8' });
  if (kind === 'txt') { const c = cleanClone(); c.querySelectorAll('.toc').forEach(t => t.remove()); return new Blob([textIndexOf(c)], { type: 'text/plain;charset=utf-8' }); }
  if (kind === 'md') return new Blob([htmlToMd(cleanClone())], { type: 'text/markdown;charset=utf-8' });
}
function textIndexOf(root) {
  const out = [];
  const walk = n => Array.from(n.childNodes).forEach(c => {
    if (c.nodeType === 3) { out.push(c.nodeValue); return; }
    if (c.nodeType !== 1) return;
    if (c.tagName === 'BR') { out.push('\n'); return; }
    if (c.tagName === 'TD' || c.tagName === 'TH') { walk(c); out.push('\t'); return; }
    walk(c);
    if (isBlock(c) && !/^(TBODY|TABLE|COLGROUP|COL|UL|OL)$/.test(c.tagName)) out.push('\n');
  });
  walk(root);
  return out.join('').replace(/\t\n/g, '\n').replace(/\n{3,}/g, '\n\n');
}
async function saveAs(kind = null) {
  try {
    if (window.showSaveFilePicker) {
      const order = kind ? [kind] : ['docx', 'html', 'txt', 'md'];
      const h = await window.showSaveFilePicker({ suggestedName: safeName() + '.' + (kind || 'docx'), types: order.map(k => FILE_TYPES[k]) });
      const ext = (h.name.split('.').pop() || 'docx').toLowerCase();
      const k = ext === 'htm' ? 'html' : FILE_TYPES[ext] ? ext : 'docx';
      await writeHandle(h, k);
      if (k === 'docx' || k === 'html') { fileHandle = h; fileKind = k; }
      setTitle(h.name.replace(/\.[^.]+$/, ''));
    } else {
      const k = kind || 'docx';
      download(await makeBlob(k), safeName() + '.' + k);
      markSaved();
    }
  } catch (e) { if (e.name !== 'AbortError') { console.error(e); toast('Ошибка сохранения: ' + e.message, 4000); } }
}
async function writeHandle(h, kind) {
  const w = await h.createWritable(); await w.write(await makeBlob(kind)); await w.close();
  markSaved(); toast('Сохранено: ' + h.name);
}
function markSaved() { dirty = false; $('saveState').textContent = '✓ Сохранено'; autosave(); }
async function save() {
  if (fileHandle) { try { await writeHandle(fileHandle, fileKind); return; } catch (e) { if (e.name === 'AbortError') return; fileHandle = null; } }
  return saveAs();
}
async function exportAs(kind) {
  try { download(await makeBlob(kind), safeName() + '.' + kind); toast('Экспортировано в ' + kind.toUpperCase()); }
  catch (e) { console.error(e); toast('Ошибка экспорта: ' + e.message, 4000); }
}

/* ---------- открытие ---------- */
async function openFile(file, handle = null) {
  const name = file.name, ext = name.split('.').pop().toLowerCase();
  if (dirty && !confirm('Открыть другой документ? Несохранённые изменения будут потеряны (черновик останется в автосохранении до следующего изменения).')) return;
  try {
    if (ext === 'docx') {
      const buf = await file.arrayBuffer();
      let res;
      try { res = await DOCXIN.parse(buf); }
      catch (err) {
        console.warn('Собственный импорт не удался, используем mammoth', err);
        if (!window.mammoth) throw err;
        const m = await mammoth.convertToHtml({ arrayBuffer: buf });
        res = { html: m.value, page: {}, hf: null, defaults: null };
      }
      const st = defaultState();
      st.title = name.replace(/\.docx$/i, '');
      if (res.page && res.page.w) {
        const match = Object.entries(PAPERS).find(([, v]) => Math.abs(v[0] - res.page.w) < 2 && Math.abs(v[1] - res.page.h) < 2);
        st.page = Object.assign(st.page, res.page, { size: match ? match[0] : 'custom' });
      } else if (res.page) Object.assign(st.page, res.page);
      if (res.hf) st.hf = res.hf;
      if (res.defaults) st.defaults = res.defaults;
      if (res.bg) st.page.color = res.bg;
      loadDocument(sanitizeHTML(res.html, true), st);
      fileHandle = handle; fileKind = handle ? 'docx' : null;
    } else if (ext === 'html' || ext === 'htm') {
      const { html, st } = parseHtmlFile(await file.text());
      st.title = name.replace(/\.html?$/i, '');
      loadDocument(html, st);
      fileHandle = handle; fileKind = handle ? 'html' : null;
    } else if (ext === 'md' || ext === 'markdown') {
      loadDocument(mdToHtml(await file.text()), Object.assign(defaultState(), { title: name.replace(/\.[^.]+$/, '') }));
      fileHandle = null;
    } else if (ext === 'txt' || file.type.startsWith('text/')) {
      loadDocument(textToHtml(await file.text()), Object.assign(defaultState(), { title: name.replace(/\.[^.]+$/, '') }));
      fileHandle = null;
    } else if (ext === 'rtf') {
  const text = await file.text();
  const html = RTFParser.parse(text);
  loadDocument(html, Object.assign(defaultState(), { title: name.replace(/\.rtf$/i, '') }));
  fileHandle = null;
  toast('RTF документ открыт');
} else if (ext === 'doc') {
  const buf = await file.arrayBuffer();
  const html = DOCParser.extractText(buf);
  if (!html) {
    toast('Не удалось прочитать текст из старого .doc файла', 4000);
    return;
  }
  loadDocument(html, Object.assign(defaultState(), { title: name.replace(/\.doc$/i, '') }));
  fileHandle = null;
  toast('Извлечен текст из старого документа Word (.doc)');
} else { toast('Неизвестный формат файла: .' + ext, 4000); return; }
    toast('Открыт: ' + name);
  } catch (e) { console.error(e); toast('Не удалось открыть файл: ' + e.message, 5000); }
}

/* =====================================================================
   ПАРСЕРЫ RTF И СТАРОГО DOC (Word 97-2003)
   ===================================================================== */
const RTFParser = {
  parse(rtfText) {
    const cp1251Decoder = new TextDecoder('windows-1251');
    const tokenRegex = /\\([a-zA-Z]+)(-?\d+)? ?|\\\'([0-9a-fA-F]{2})|\\([^a-zA-Z0-9\s])|[{}]|([^{}\\]+)/g;
    let match;

    const stack = [];
    let cur = {
      bold: false, italic: false, underline: false, size: null,
      skip: false, isField: false, isInst: false, isRslt: false,
      fieldUrl: '', instText: '', buffer: ''
    };

    while ((match = tokenRegex.exec(rtfText)) !== null) {
      const [token, word, arg, hexByte, symbol, text] = match;

      if (token === '{') {
        stack.push(cur);
        cur = {
          bold: cur.bold, italic: cur.italic, underline: cur.underline, size: cur.size,
          skip: cur.skip, isField: cur.isField, isInst: cur.isInst, isRslt: cur.isRslt,
          fieldUrl: cur.fieldUrl, instText: '', buffer: ''
        };
        continue;
      }

      if (token === '}') {
        if (!stack.length) continue;
        const closing = cur;
        cur = stack.pop();

        if (closing.isInst) {
          // Извлекаем адрес из инструкции HYPERLINK "..."
          const m = /HYPERLINK\s+(?:"([^"]+)"|'([^']+)'|(\S+))/i.exec(closing.instText);
          if (m) {
            cur.fieldUrl = (m[1] || m[2] || m[3] || '').replace(/\\\\/g, '\\');
          }
        } else if (closing.isRslt) {
          if (cur.fieldUrl) {
            cur.buffer += `<a href="${esc(cur.fieldUrl)}">${closing.buffer}</a>`;
            cur.fieldUrl = '';
          } else {
            cur.buffer += closing.buffer;
          }
        } else if (closing.isField) {
          if (closing.fieldUrl && closing.buffer) {
            cur.buffer += `<a href="${esc(closing.fieldUrl)}">${closing.buffer}</a>`;
          } else {
            cur.buffer += closing.buffer;
          }
        } else if (!closing.skip) {
          cur.buffer += closing.buffer;
        }
        continue;
      }

      if (cur.skip) continue;

      if (word) {
        const val = arg !== undefined ? parseInt(arg, 10) : 1;
        switch (word.toLowerCase()) {
          case 'field': cur.isField = true; break;
          case 'fldinst': cur.isInst = true; break;
          case 'fldrslt': cur.isRslt = true; break;
          case 'fonttbl':
          case 'colortbl':
          case 'stylesheet':
          case 'info':
          case 'generator':
            cur.skip = true;
            break;
          case 'b': cur.bold = val !== 0; break;
          case 'i': cur.italic = val !== 0; break;
          case 'ul': cur.underline = true; break;
          case 'ulnone': cur.underline = false; break;
          case 'plain': cur.bold = false; cur.italic = false; cur.underline = false; cur.size = null; break;
          case 'fs': cur.size = Math.round(val / 2); break;
          case 'par': if (!cur.isInst) cur.buffer += '</p><p>'; break;
          case 'line': if (!cur.isInst) cur.buffer += '<br>'; break;
          case 'tab': if (cur.isInst) cur.instText += ' '; else cur.buffer += '\t'; break;
          case 'u':
            if (arg !== undefined) {
              const code = parseInt(arg, 10);
              const ch = String.fromCharCode(code < 0 ? code + 65536 : code);
              if (cur.isInst) cur.instText += ch;
              else cur.buffer += this.wrapChar(esc(ch), cur.bold, cur.italic, cur.underline, cur.size);
              if (rtfText[tokenRegex.lastIndex] === '?') tokenRegex.lastIndex++;
            }
            break;
        }
      } else if (hexByte) {
        const bytes = [parseInt(hexByte, 16)];
        let next;
        while ((next = /^\\\'([0-9a-fA-F]{2})/i.exec(rtfText.slice(tokenRegex.lastIndex)))) {
          bytes.push(parseInt(next[1], 16));
          tokenRegex.lastIndex += next[0].length;
        }
        const decoded = cp1251Decoder.decode(new Uint8Array(bytes));
        if (cur.isInst) cur.instText += decoded;
        else cur.buffer += this.wrapChar(esc(decoded), cur.bold, cur.italic, cur.underline, cur.size);
      } else if (symbol) {
        if (symbol === '*') {
          const peek = rtfText.slice(tokenRegex.lastIndex, tokenRegex.lastIndex + 15);
          if (!peek.startsWith('\\fldinst')) cur.skip = true;
        } else if (symbol === '~') {
          if (!cur.isInst) cur.buffer += '\u00a0';
        } else if (symbol === '_') {
          if (!cur.isInst) cur.buffer += '‑';
        } else if (symbol === '\\' || symbol === '{' || symbol === '}') {
          if (cur.isInst) cur.instText += symbol;
          else cur.buffer += this.wrapChar(symbol, cur.bold, cur.italic, cur.underline, cur.size);
        }
      } else if (text) {
        const clean = text.replace(/[\r\n]+/g, '');
        if (cur.isInst) cur.instText += clean;
        else cur.buffer += this.wrapChar(esc(clean), cur.bold, cur.italic, cur.underline, cur.size);
      }
    }

    let res = cur.buffer;
    // Автоматическая коррекция, если в тексте уже остался мусор вида *HYPERLINK "url"текст
    res = res.replace(/\*?HYPERLINK\s+"([^"]+)"(\s*)(<a\s+[^>]*>.*?<\/a>|[^<>\n\r]{1,80})/gi, (m, url, sp, txt) => {
      if (txt.startsWith('<a')) return txt;
      return `<a href="${url}">${txt}</a>`;
    });

    if (!res.startsWith('<p>')) res = '<p>' + res;
    if (!res.endsWith('</p>')) res = res + '</p>';
    return res.replace(/<p><\/p>/g, '').replace(/<p>\s*<\/p>/g, '<p><br></p>');
  },

  wrapChar(str, b, i, u, sz) {
    if (!str) return '';
    let res = str;
    if (b) res = `<b>${res}</b>`;
    if (i) res = `<i>${res}</i>`;
    if (u) res = `<u>${res}</u>`;
    if (sz) res = `<span style="font-size:${sz}pt">${res}</span>`;
    return res;
  }
};

const DOCParser = {
  // Извлечение текстового содержимого из бинарного потока Word 97-2003
  extractText(buffer) {
    const bytes = new Uint8Array(buffer);
    let str16 = '', str8 = '';
    const decoder1251 = new TextDecoder('windows-1251');

    // Попытка 1: чтение UTF-16LE текстовых блоков
    for (let i = 0; i < bytes.length - 1; i += 2) {
      const code = bytes[i] | (bytes[i + 1] << 8);
      if (code === 13 || code === 10 || (code >= 32 && code <= 0x045F)) {
        str16 += String.fromCharCode(code);
      } else if (str16.length > 0 && !str16.endsWith('\n')) {
        str16 += '\n';
      }
    }

    // Попытка 2: чтение 8-битного потока (CP1251)
    str8 = decoder1251.decode(bytes).replace(/[^\x20-\x7E\u0400-\u045F\r\n\t]/g, ' ');

    // Выбираем блок с наибольшим содержанием полезного текста
    const chosen = (str16.replace(/\s/g, '').length > str8.replace(/\s/g, '').length ? str16 : str8);
    const paragraphs = chosen
      .split(/[\r\n]+/)
      .map(p => p.trim())
      .filter(p => p.length > 3 && !/^(Root Entry|WordDocument|1Table|Data)/.test(p));

    return paragraphs.map(p => `<p>${esc(p)}</p>`).join('');
  }
};



async function openDialog() {
  if (window.showOpenFilePicker) {
    try {
      const [h] = await window.showOpenFilePicker({
        types: [
          {
            description: 'Все поддерживаемые документы',
            accept: {
              'application/vnd.openxmlformats-officedocument.wordprocessingml.document': ['.docx'],
              'application/msword': ['.doc'],
              'application/rtf': ['.rtf'],
              'text/plain': ['.txt'],
              'text/html': ['.html', '.htm'],
              'text/markdown': ['.md', '.markdown']
            }
          },
          {
            description: 'Документы Word (*.docx, *.doc)',
            accept: {
              'application/vnd.openxmlformats-officedocument.wordprocessingml.document': ['.docx'],
              'application/msword': ['.doc']
            }
          },
          {
            description: 'Файлы RTF (*.rtf)',
            accept: {
              'application/rtf': ['.rtf']
            }
          },
          {
            description: 'Текстовые файлы (*.txt)',
            accept: {
              'text/plain': ['.txt']
            }
          },
          {
            description: 'Веб-страницы (*.html, *.htm)',
            accept: {
              'text/html': ['.html', '.htm']
            }
          },
          {
            description: 'Документы Markdown (*.md, *.markdown)',
            accept: {
              'text/markdown': ['.md', '.markdown']
            }
          }
        ]
      });
      await openFile(await h.getFile(), h);
    } catch (e) { if (e.name !== 'AbortError') toast(e.message); }
  } else $('openFile').click();
}

$('openFile').addEventListener('change', e => { const f = e.target.files[0]; if (f) openFile(f); e.target.value = ''; });
function newDocument() {
  if (dirty && !confirm('Создать новый документ? Несохранённые изменения будут потеряны.')) return;
  const keep = { defaults: Object.assign({}, state.defaults), page: Object.assign({}, state.page, { margins: Object.assign({}, state.page.margins) }) };
  const st = defaultState(); st.defaults = keep.defaults; st.page = keep.page; st.page.color = '#ffffff';
  fileHandle = null; fileKind = null;
  loadDocument('<p><br></p>', st);
}

/* ---------- печать / PDF ---------- */
function preparePrint() {
  if (view.printing) return;
  view.printing = true; view._gap = view.gap; view.gap = 0; view._zoom = view.zoom;
  selectImage(null);
  workspace.style.zoom = 1;
  if (hasHL) { CSS.highlights.delete('find-all'); CSS.highlights.delete('find-cur'); }
  sheetsKey = ''; paginate();
  buildPrintPages();
}
/* Печать: каждая страница — «окно» высотой в лист на копию раскладки (gap = 0),
   поэтому браузер не обрезает отступы на разрывах и результат совпадает с экраном */
function buildPrintPages() {
  const old = $('printRoot'); if (old) old.remove();
  const d = dims(), root = document.createElement('div'); root.id = 'printRoot';
  const kids = Array.from(editor.children).map(c => ({ el: c, top: c.offsetTop, bottom: c.offsetTop + c.offsetHeight }));
  for (let i = 0; i < pageCount; i++) {
    const y0 = i * d.H, y1 = y0 + d.H;
    const pg = document.createElement('div'); pg.className = 'print-page';
    pg.style.cssText = `width:${round(d.wmm, 2)}mm;height:${round(d.hmm, 2)}mm`;
    const ws = workspace.cloneNode(false); ws.removeAttribute('id'); ws.className = 'print-ws';
    ws.style.cssText = `position:absolute;left:0;top:${-y0}px;width:${d.W}px;margin:0;zoom:1`;
    ws.appendChild($('sheets').cloneNode(true));
    const ed = editor.cloneNode(false); ed.removeAttribute('contenteditable'); ed.removeAttribute('id'); ed.style.cssText = editor.style.cssText;
    // в копию попадают только блоки, видимые на этой странице; пропущенные заменяются распоркой
    let first = kids.findIndex(k => k.bottom > y0 - 40); if (first < 0) first = kids.length;
    if (first > 0 && first < kids.length) {
      const k = kids[first], mt = parseFloat(getComputedStyle(k.el).marginTop) || 0, pt = parseFloat(getComputedStyle(editor).paddingTop) || 0;
      const sp = document.createElement('div'); sp.style.cssText = `height:${Math.max(0, k.top - mt - pt)}px;margin:0;padding:0`;
      ed.appendChild(sp);
    }
    for (let j = first; j < kids.length && kids[j].top < y1 + 40; j++) ed.appendChild(kids[j].el.cloneNode(true));
    ws.appendChild(ed); pg.appendChild(ws); root.appendChild(pg);
  }
  document.body.appendChild(root); document.body.classList.add('has-print-root');
}
function finishPrint() {
  if (!view.printing) return;
  const pr = $('printRoot'); if (pr) pr.remove(); document.body.classList.remove('has-print-root');
  view.printing = false; view.gap = view._gap; setZoom(view._zoom, true);
  sheetsKey = ''; paginate(); drawRulers();
}
window.addEventListener('beforeprint', preparePrint);
window.addEventListener('afterprint', finishPrint);
function doPrint() { preparePrint(); setTimeout(() => { window.print(); setTimeout(finishPrint, 300); }, 50); }

/* ---------- автосохранение (IndexedDB, запасной вариант — localStorage) ---------- */
const DB = {
  db: null,
  open() {
    return new Promise(res => {
      if (!window.indexedDB) return res(null);
      const rq = indexedDB.open('list-pro', 1);
      rq.onupgradeneeded = () => rq.result.createObjectStore('kv');
      rq.onsuccess = () => { this.db = rq.result; res(this.db); };
      rq.onerror = () => res(null);
    });
  },
  async get(k) { if (!this.db) await this.open(); if (!this.db) return JSON.parse(localStorage.getItem('list-pro:' + k) || 'null');
    return new Promise(res => { const rq = this.db.transaction('kv').objectStore('kv').get(k); rq.onsuccess = () => res(rq.result); rq.onerror = () => res(null); }); },
  async set(k, v) { if (!this.db) await this.open();
    if (!this.db) { try { localStorage.setItem('list-pro:' + k, JSON.stringify(v)); } catch (e) {} return; }
    return new Promise(res => { const tx = this.db.transaction('kv', 'readwrite'); tx.objectStore('kv').put(v, k); tx.oncomplete = res; tx.onerror = res; }); }
};
async function autosave() {
  clearTimeout(autosaveTimer);
  try { await DB.set('draft', { html: getCleanHTML(), state, ts: Date.now() }); if (dirty) $('saveState').textContent = '● Черновик сохранён'; } catch (e) { console.warn(e); }
}
async function saveSettings() { try { localStorage.setItem('list-pro:view', JSON.stringify({ rulers: view.rulers, marks: view.marks, nav: view.nav, dark: view.dark, smart: view.smart, spell: view.spell, zoom: view.zoom })); } catch (e) {} }
window.addEventListener('beforeunload', e => { if (dirty) { autosave(); e.preventDefault(); e.returnValue = ''; } });
/* =====================================================================
   ИНТЕРФЕЙС: вкладки, меню, диалоги, горячие клавиши, контекстное меню,
   строка состояния, навигация, масштаб, тема, ввод/вставка
   ===================================================================== */
/* ---------- модальные окна ---------- */
let modalOk = null;
function showModal(html, onOk, opts = {}) {
  const box = $('modalBox');
  box.className = 'modal' + (opts.wide ? ' wide' : '');
  box.innerHTML = html + `<div class="actions">${opts.noCancel ? '' : '<button class="mbtn" data-mc="0">Отмена</button>'}<button class="mbtn primary" data-mc="1">${opts.okText || 'ОК'}</button></div>`;
  modalOk = onOk;
  $('modal').classList.add('open');
  box.querySelectorAll('[data-mc]').forEach(b => b.onclick = () => { const ok = b.dataset.mc === '1'; const fn = modalOk; closeModal(); if (ok && fn) fn(); });
  const first = box.querySelector('input:not([type=checkbox]),select,textarea');
  if (first && !opts.noFocus) setTimeout(() => { first.focus(); if (first.select) first.select(); }, 20);
  lucide.createIcons();
}
function closeModal() { $('modal').classList.remove('open'); modalOk = null; restoreSelection(); }
$('modal').addEventListener('mousedown', e => { if (e.target === $('modal')) closeModal(); });
$('modalBox').addEventListener('keydown', e => {
  if (e.key === 'Escape') { e.preventDefault(); closeModal(); }
  if (e.key === 'Enter' && e.target.tagName !== 'TEXTAREA' && e.target.tagName !== 'BUTTON') { e.preventDefault(); const fn = modalOk; closeModal(); if (fn) fn(); }
});

/* ---------- выпадающие меню ---------- */
let menuEl = null;
function closeMenu() { if (menuEl) { menuEl.remove(); menuEl = null; } }
function openDropdown(html, x, y, onPick, minW) {
  closeMenu();
  menuEl = document.createElement('div'); menuEl.className = 'dropdown'; menuEl.innerHTML = html;
  if (minW) menuEl.style.minWidth = minW + 'px';
  document.body.appendChild(menuEl);
  const r = menuEl.getBoundingClientRect();
  menuEl.style.left = Math.max(4, Math.min(x, innerWidth - r.width - 6)) + 'px';
  menuEl.style.top = Math.max(4, Math.min(y, innerHeight - r.height - 6)) + 'px';
  menuEl.addEventListener('mousedown', e => { if (e.target.tagName !== 'INPUT') e.preventDefault(); });
  menuEl.addEventListener('click', e => {
    const it = e.target.closest('[data-v]'); if (!it) return;
    const v = it.dataset.v; closeMenu(); onPick(v, it);
  });
  lucide.createIcons();
  return menuEl;
}
document.addEventListener('mousedown', e => { if (menuEl && !menuEl.contains(e.target)) closeMenu(); });
const mi = (v, label, kbd = '', extra = '') => `<button class="mi" data-v="${esc(v)}" ${extra}>${label}${kbd ? `<span class="kbd">${kbd}</span>` : ''}</button>`;
const PALETTE = ['#ffffff','#000000','#e7e6e6','#44546a','#4472c4','#ed7d31','#a5a5a5','#ffc000','#5b9bd5','#70ad47',
  '#f2f2f2','#7f7f7f','#d0cece','#d6dce4','#d9e2f3','#fbe5d5','#ededed','#fff2cc','#deebf6','#e2efd9',
  '#d8d8d8','#595959','#aeabab','#adb9ca','#b4c6e7','#f7caac','#dbdbdb','#fee599','#bdd7ee','#c5e0b3',
  '#bfbfbf','#3f3f3f','#757070','#8496b0','#8eaadb','#f4b083','#c9c9c9','#ffd965','#9cc3e5','#a8d08d',
  '#a5a5a5','#262626','#3a3838','#323f4f','#2f5496','#c45911','#7b7b7b','#bf8f00','#2e75b5','#538135',
  '#c00000','#ff0000','#ffc000','#ffff00','#92d050','#00b050','#00b0f0','#0070c0','#002060','#7030a0'];
function paletteHtml(noneLabel) {
  return (noneLabel ? mi('none', noneLabel) : '') + `<div class="palette">${PALETTE.map(c => `<div class="swatch" data-v="${c}" style="background:${c}" title="${c}"></div>`).join('')}</div>` +
    `<div class="msep"></div><label class="mi" style="cursor:pointer">Другие цвета… <input type="color" id="customColor" style="margin-left:auto;width:36px;height:22px;border:0;padding:0;background:none"></label>`;
}
function colorMenu(btn, noneLabel, fn) {
  const r = btn.getBoundingClientRect();
  const m = openDropdown(paletteHtml(noneLabel), r.left, r.bottom + 2, v => fn(v), 240);
  const cc = m.querySelector('#customColor');
  cc.addEventListener('change', () => { const v = cc.value; closeMenu(); fn(v); });
}
const MENUS = {
  case: btn => ({ html: mi('sentence', 'Как в предложениях.') + mi('lower', 'все строчные') + mi('upper', 'ВСЕ ПРОПИСНЫЕ') + mi('title', 'Начинать С Прописных') + mi('toggle', 'иЗМЕНИТЬ РЕГИСТР') + '<div class="msep"></div>' + mi('cycle', 'Переключить по кругу', 'Shift+F3'), pick: v => changeCase(v) }),
  textColor: btn => colorMenu(btn, 'Авто (чёрный)', v => applyTextColor(v === 'none' ? '#000000' : v)),
  highlight: btn => colorMenu(btn, 'Нет цвета', v => applyHighlight(v)),
  shading: btn => colorMenu(btn, 'Нет заливки', v => setBlockStyle('backgroundColor', v === 'none' ? '' : v)),
  cellShade: btn => colorMenu(btn, 'Нет заливки', v => cellStyle('backgroundColor', v === 'none' ? '' : v)),
  pageColor: btn => colorMenu(btn, 'Нет цвета (белый)', v => { state.page.color = v === 'none' ? '#ffffff' : v; sheetsKey = ''; renderSheets(); markDirty(false); autosave(); }),
  bullets: btn => ({ html: '<div class="mhead">Библиотека маркеров</div>' + mi('disc', '●  Круг') + mi('circle', '○  Окружность') + mi('square', '■  Квадрат') + mi('dash', '–  Тире') + mi('check', '✓  Галочка'), pick: v => makeList('ul', v) }),
  numbering: btn => ({ html: '<div class="mhead">Библиотека нумерации</div>' + mi('decimal', '1. 2. 3.') + mi('lower-alpha', 'a. b. c.') + mi('upper-alpha', 'A. B. C.') + mi('lower-roman', 'i. ii. iii.') + mi('upper-roman', 'I. II. III.') + '<div class="msep"></div>' + mi('multi', '1. / 1.1. / 1.1.1. Многоуровневый'), pick: v => makeList('ol', v) }),
  spacing: btn => ({ html: ['1.0', '1.15', '1.5', '2.0', '2.5', '3.0'].map(v => mi(v, v.replace('.', ','))).join('') + '<div class="msep"></div>' +
      mi('addBefore', 'Добавить/убрать интервал перед абзацем') + mi('addAfter', 'Добавить/убрать интервал после абзаца') + '<div class="msep"></div>' + mi('dialog', 'Другие варианты междустрочных интервалов…'),
    pick: v => {
      if (v === 'dialog') return paragraphDialog();
      if (v === 'addBefore' || v === 'addAfter') { const b = selectedBlocks()[0]; if (!b) return; const prop = v === 'addBefore' ? 'marginTop' : 'marginBottom'; const cur = parseFloat(getComputedStyle(b)[prop]) || 0; setSpacing(v === 'addBefore' ? 'before' : 'after', cur > 0 ? 0 : 12); return; }
      setLineHeight(parseFloat(v));
    } }),
  table: btn => {
    const r = btn.getBoundingClientRect();
    let html = '<div class="mhead" id="gridLbl">Вставка таблицы</div><div class="grid-picker">';
    for (let i = 0; i < 8; i++) for (let j = 0; j < 10; j++) html += `<div data-r="${i + 1}" data-c="${j + 1}"></div>`;
    html += '</div><div class="msep"></div>' + mi('dialog', 'Вставить таблицу…') + mi('text', 'Преобразовать текст в таблицу');
    const m = openDropdown(html, r.left, r.bottom + 2, v => { if (v === 'dialog') tableDialog(); else if (v === 'text') textToTable(); }, 220);
    m.querySelectorAll('.grid-picker div').forEach(c => {
      c.addEventListener('mouseenter', () => { const R = +c.dataset.r, C = +c.dataset.c; m.querySelector('#gridLbl').textContent = `Таблица ${C} × ${R}`; m.querySelectorAll('.grid-picker div').forEach(x => x.classList.toggle('hl', +x.dataset.r <= R && +x.dataset.c <= C)); });
      c.addEventListener('click', () => { closeMenu(); insertTable(+c.dataset.r, +c.dataset.c); });
    });
  },
  pageNum: btn => ({ html: mi('fc', 'Внизу страницы — по центру') + mi('fr', 'Внизу страницы — справа') + mi('hr', 'Вверху страницы — справа') + mi('hc', 'Вверху страницы — по центру') + mi('xofy', 'Внизу: «Страница X из Y»') + '<div class="msep"></div>' + mi('nofirst', 'Не показывать на первой странице') + mi('del', 'Удалить номера страниц', '', 'style="color:#c42b1c"'),
    pick: v => {
      const hf = state.hf;
      const clr = o => ['l', 'c', 'r'].forEach(k => o[k] = String(o[k] || '').replace(/(Страница\s*)?\{PAGE\}(\s*из\s*\{PAGES\})?/g, '').trim());
      if (v === 'del') { clr(hf.header); clr(hf.footer); clr(hf.first.header); clr(hf.first.footer); }
      else if (v === 'nofirst') { hf.differentFirst = true; hf.first = { header: { l: '', c: '', r: '' }, footer: { l: '', c: '', r: '' } }; }
      else { clr(hf.header); clr(hf.footer); const o = v[0] === 'f' || v === 'xofy' ? hf.footer : hf.header; const k = v === 'xofy' ? 'c' : v[1]; o[k] = v === 'xofy' ? 'Страница {PAGE} из {PAGES}' : '{PAGE}'; }
      sheetsKey = ''; renderSheets(); markDirty(false); autosave();
    } }),
  margins: btn => ({ html: Object.entries(MARGIN_PRESETS).map(([k, p]) => mi(k, `<b style="width:110px;display:inline-block">${p.name}</b><span style="color:var(--text-muted);font-size:11px">верх ${cm(p.m.top)}, низ ${cm(p.m.bottom)}, лев ${cm(p.m.left)}, пр ${cm(p.m.right)}</span>`)).join('') + '<div class="msep"></div>' + mi('custom', 'Настраиваемые поля…'),
    pick: v => { if (v === 'custom') return openPageSetup(); state.page.margins = Object.assign({}, MARGIN_PRESETS[v].m); applyPage(); changed({ paginate: false }); } }),
  orientation: btn => ({ html: mi('p', '▯  Книжная') + mi('l', '▭  Альбомная'), pick: v => { state.page.landscape = v === 'l'; applyPage(); lucide.createIcons(); changed({ paginate: false }); } }),
  paperSize: btn => ({ html: Object.entries(PAPERS).map(([k, p]) => mi(k, (state.page.size === k ? '✓ ' : '&nbsp;&nbsp; ') + p[2])).join('') + '<div class="msep"></div>' + mi('custom', 'Другие размеры бумаги…'),
    pick: v => { if (v === 'custom') return openPageSetup(); state.page.size = v; state.page.w = PAPERS[v][0]; state.page.h = PAPERS[v][1]; applyPage(); changed({ paginate: false }); } }),
  watermark: btn => ({ html: mi('', 'Нет подложки') + ['ЧЕРНОВИК', 'ОБРАЗЕЦ', 'КОНФИДЕНЦИАЛЬНО', 'НЕ КОПИРОВАТЬ', 'СРОЧНО', 'КОПИЯ'].map(t => mi(t, t)).join('') + '<div class="msep"></div>' + mi('custom', 'Настраиваемая подложка…'),
    pick: v => {
      if (v === 'custom') {
        showModal(`<h3>Подложка</h3><label>Текст</label><input type="text" id="wmT" value="${esc(state.watermark.text)}"><div class="grid2"><div><label>Цвет</label><input type="color" id="wmC" value="${state.watermark.color}" style="width:100%;height:30px"></div><div><label>Прозрачность, %</label><input type="number" id="wmO" min="5" max="100" value="${Math.round(state.watermark.opacity * 100)}"></div></div>`,
          () => { state.watermark = { text: $('wmT').value, color: $('wmC').value, opacity: clamp((parseFloat($('wmO').value) || 45) / 100, 0.05, 1) }; sheetsKey = ''; renderSheets(); markDirty(false); autosave(); });
        return;
      }
      state.watermark.text = v; sheetsKey = ''; renderSheets(); markDirty(false); autosave();
    } }),
  docFont: btn => ({ html: '<div class="mhead">Шрифт по умолчанию для всего документа</div>' + FONTS.map(f => mi(f, `<span style="font-family:'${f}'">${f}</span>`)).join(''), pick: v => { state.defaults.font = v; applyDefaults(); changed(); } })
};
function openMenu(name, btn) {
  const fn = MENUS[name]; if (!fn) return;
  if (menuEl && menuEl.dataset.name === name) { closeMenu(); return; }
  const res = fn(btn);
  if (res && res.html) {
    const r = btn.getBoundingClientRect();
    openDropdown(res.html, r.left, r.bottom + 2, res.pick);
  }
  if (menuEl) menuEl.dataset.name = name;
}
function tableDialog() {
  showModal(`<h3>Вставка таблицы</h3><div class="grid2"><div><label>Число столбцов</label><input type="number" id="tdC" value="4" min="1" max="63"></div><div><label>Число строк</label><input type="number" id="tdR" value="3" min="1" max="500"></div></div>
    <label class="chk"><input type="checkbox" id="tdH">Строка заголовка (повторять на каждой странице)</label>`,
    () => { insertTable(clamp(parseInt($('tdR').value) || 3, 1, 500), clamp(parseInt($('tdC').value) || 4, 1, 63)); if ($('tdH').checked) { const c = currentCell(); if (c) { const t = c.closest('table'); t.dataset.repeatHeader = '1'; t.rows[0] && Array.from(t.rows[0].cells).forEach(x => x.style.fontWeight = 'bold'); changed(); } } });
}
function textToTable() {
  restoreSelection();
  const blocks = selectedBlocks().filter(b => b.tagName === 'P');
  if (!blocks.length) { toast('Выделите абзацы с текстом, разделённым табуляцией, «;» или «,»'); return; }
  const sep = blocks.some(b => b.textContent.includes('\t')) ? '\t' : blocks.some(b => b.textContent.includes(';')) ? ';' : ',';
  const rows = blocks.map(b => b.textContent.split(sep).map(s => s.trim()));
  const n = Math.max(...rows.map(r => r.length));
  const html = `<table><colgroup>${Array(n).fill(`<col style="width:${round(100 / n, 3)}%">`).join('')}</colgroup><tbody>${rows.map(r => `<tr>${Array.from({ length: n }, (_, i) => `<td>${esc(r[i] || '') || '<br>'}</td>`).join('')}</tr>`).join('')}</tbody></table>`;
  const tmp = document.createElement('div'); tmp.innerHTML = html;
  blocks[0].before(tmp.firstChild); blocks.forEach(b => b.remove());
  changed();
}

/* ---------- параметры страницы ---------- */
function openPageSetup() {
  const p = state.page, m = p.margins;
  const sizes = Object.entries(PAPERS).map(([k, v]) => `<option value="${k}">${v[2]}</option>`).join('') + '<option value="custom">Другой размер</option>';
  showModal(`<h3>Параметры страницы</h3>
    <fieldset><legend>Поля, см</legend><div class="grid2">
      <div><label>Верхнее</label><input type="number" step="0.1" min="0" id="psT" value="${m.top / 10}"></div>
      <div><label>Нижнее</label><input type="number" step="0.1" min="0" id="psB" value="${m.bottom / 10}"></div>
      <div><label>Левое</label><input type="number" step="0.1" min="0" id="psL" value="${m.left / 10}"></div>
      <div><label>Правое</label><input type="number" step="0.1" min="0" id="psR" value="${m.right / 10}"></div></div></fieldset>
    <fieldset><legend>Бумага</legend>
      <label>Размер</label><select id="psSize">${sizes}</select>
      <div class="grid2"><div><label>Ширина, см</label><input type="number" step="0.1" id="psW" value="${p.w / 10}"></div><div><label>Высота, см</label><input type="number" step="0.1" id="psH" value="${p.h / 10}"></div></div>
      <label>Ориентация</label><select id="psO"><option value="p">Книжная</option><option value="l">Альбомная</option></select></fieldset>
    <fieldset><legend>Колонтитулы — расстояние от края, см</legend><div class="grid2">
      <div><label>Верхнего</label><input type="number" step="0.1" id="psHd" value="${p.header / 10}"></div>
      <div><label>Нижнего</label><input type="number" step="0.1" id="psFd" value="${p.footer / 10}"></div></div></fieldset>
    <label class="chk"><input type="checkbox" id="psDef">Использовать по умолчанию для новых документов</label>`,
    () => {
      const v = id => Math.max(0, parseFloat(String($(id).value).replace(',', '.')) || 0) * 10;
      const size = $('psSize').value;
      p.size = size;
      if (size === 'custom') { p.w = clamp(v('psW'), 50, 1200); p.h = clamp(v('psH'), 50, 1200); } else { p.w = PAPERS[size][0]; p.h = PAPERS[size][1]; }
      p.landscape = $('psO').value === 'l';
      const d = dims();
      p.margins = { top: Math.min(v('psT'), d.hmm - 20), bottom: Math.min(v('psB'), d.hmm - 20), left: Math.min(v('psL'), d.wmm - 20), right: Math.min(v('psR'), d.wmm - 20) };
      p.header = v('psHd'); p.footer = v('psFd');
      if ($('psDef').checked) try { localStorage.setItem('list-pro:pageDefaults', JSON.stringify(p)); } catch (e) {}
      applyPage(); lucide.createIcons(); changed({ paginate: false });
    }, { wide: true });
  $('psSize').value = PAPERS[p.size] ? p.size : 'custom';
  $('psO').value = p.landscape ? 'l' : 'p';
  $('psSize').onchange = () => { const s = $('psSize').value; if (PAPERS[s]) { $('psW').value = PAPERS[s][0] / 10; $('psH').value = PAPERS[s][1] / 10; } };
}
function headerFooterDialog() {
  const hf = state.hf;
  const row = (pre, o) => `<div class="grid3"><div><label>Слева</label><input type="text" id="${pre}l" value="${esc(o.l)}"></div><div><label>По центру</label><input type="text" id="${pre}c" value="${esc(o.c)}"></div><div><label>Справа</label><input type="text" id="${pre}r" value="${esc(o.r)}"></div></div>`;
  showModal(`<h3>Колонтитулы</h3>
    <fieldset><legend>Верхний колонтитул</legend>${row('hh', hf.header)}</fieldset>
    <fieldset><legend>Нижний колонтитул</legend>${row('ff', hf.footer)}</fieldset>
    <label class="chk"><input type="checkbox" id="hfFirst" ${hf.differentFirst ? 'checked' : ''}>Особый колонтитул для первой страницы</label>
    <div id="hfFirstBox" class="${hf.differentFirst ? '' : 'hidden'}">
      <fieldset><legend>Первая страница — верхний</legend>${row('fh', hf.first.header)}</fieldset>
      <fieldset><legend>Первая страница — нижний</legend>${row('fF', hf.first.footer)}</fieldset></div>
    <div class="hint">Поля: <b>{PAGE}</b> — номер страницы, <b>{PAGES}</b> — всего страниц, <b>{DATE}</b> — дата, <b>{TITLE}</b> — название документа. Двойной щелчок по полю страницы тоже открывает это окно.</div>`,
    () => {
      const g = pre => ({ l: $(pre + 'l').value, c: $(pre + 'c').value, r: $(pre + 'r').value });
      hf.header = g('hh'); hf.footer = g('ff'); hf.differentFirst = $('hfFirst').checked;
      hf.first = { header: g('fh'), footer: g('fF') };
      sheetsKey = ''; renderSheets(); markDirty(false); autosave();
    }, { wide: true });
  $('hfFirst').onchange = () => $('hfFirstBox').classList.toggle('hidden', !$('hfFirst').checked);
}
function statsDialog() {
  const c = cleanClone(); c.querySelectorAll('.toc').forEach(t => t.remove());
  const t = textIndexOf(c);
  const words = (t.match(/[\p{L}\p{N}]+(?:[-'’][\p{L}\p{N}]+)*/gu) || []).length;
  const r = getRange(); const selT = r && !r.collapsed ? r.toString() : '';
  const paras = Array.from(c.querySelectorAll('p,li,h1,h2,h3,h4,h5,h6,blockquote,pre')).filter(p => p.textContent.trim()).length;
  showModal(`<h3>Статистика</h3><table class="stat-table">
    <tr><td>Страниц</td><td>${pageCount}</td></tr><tr><td>Слов</td><td>${words.toLocaleString('ru')}</td></tr>
    <tr><td>Знаков (без пробелов)</td><td>${t.replace(/\s/g, '').length.toLocaleString('ru')}</td></tr>
    <tr><td>Знаков (с пробелами)</td><td>${t.replace(/\n/g, '').length.toLocaleString('ru')}</td></tr>
    <tr><td>Абзацев</td><td>${paras}</td></tr><tr><td>Таблиц / рисунков</td><td>${c.querySelectorAll('table').length} / ${c.querySelectorAll('img').length}</td></tr>
    ${selT ? `<tr><td>В выделении: слов / знаков</td><td>${(selT.match(/[\p{L}\p{N}]+/gu) || []).length} / ${selT.length}</td></tr>` : ''}
    <tr><td>Авторских листов (40 000 зн.)</td><td>${round(t.replace(/\n/g, '').length / 40000, 2)}</td></tr></table>`, null, { okText: 'Закрыть', noCancel: true });
}
function propsDialog() {
  const p = state.props;
  showModal(`<h3>Свойства документа</h3><label>Название</label><input type="text" id="prT" value="${esc(state.title)}">
    <label>Автор</label><input type="text" id="prA" value="${esc(p.author)}"><label>Тема</label><input type="text" id="prS" value="${esc(p.subject)}">
    <label>Ключевые слова</label><input type="text" id="prK" value="${esc(p.keywords)}">`,
    () => { setTitle($('prT').value || state.title); Object.assign(p, { author: $('prA').value, subject: $('prS').value, keywords: $('prK').value }); markDirty(false); autosave(); });
}
function gotoPageDialog() {
  showModal(`<h3>Перейти к странице</h3><label>Номер страницы (1–${pageCount})</label><input type="number" id="gpN" min="1" max="${pageCount}" value="${(caretPage() ?? 0) + 1}">`, () => {
    const n = clamp(parseInt($('gpN').value) || 1, 1, pageCount);
    const { s } = wsGeom(); canvas.scrollTop = (workspace.offsetTop * s) + (n - 1) * pageStep() * s - 10;
  });
}

/* ---------- действия ---------- */
const ACT = {
  newDoc: newDocument, open: openDialog, save, saveAs: () => saveAs(), print: doPrint, exportPdf: () => { toast('В окне печати выберите «Сохранить как PDF»', 4000); setTimeout(doPrint, 400); },
  exportDocx: () => exportAs('docx'), exportHtml: () => exportAs('html'), exportTxt: () => exportAs('txt'), exportMd: () => exportAs('md'), docProps: propsDialog,
  undo: () => History.undo(), redo: () => History.redo(),
  cut: () => { restoreSelection(); document.execCommand('cut'); }, copy: () => { restoreSelection(); document.execCommand('copy'); }, paste: () => pasteFromButton(false),
  formatPainter: () => startPainter(false), bold: () => exec('bold'), italic: () => exec('italic'), underline: () => exec('underline'), strikeThrough: () => exec('strikeThrough'),
  subscript: () => exec('subscript'), superscript: () => exec('superscript'), growFont: () => stepFont(1), shrinkFont: () => stepFont(-1), clearFormat,
  applyTextColor: () => applyTextColor(), applyHighlight: () => applyHighlight(),
  bullets: () => makeList('ul'), numbering: () => makeList('ol'), indent: () => indent(1), outdent: () => indent(-1),
  alignLeft: () => setAlign('left'), alignCenter: () => setAlign('center'), alignRight: () => setAlign('right'), alignJustify: () => setAlign('justify'),
  paragraphDialog, toggleMarks: () => { view.marks = !view.marks; document.body.classList.toggle('show-marks', view.marks); $('btnMarks').classList.toggle('active', view.marks); $('btnMarks2').classList.toggle('active', view.marks); sheetsKey = ''; renderSheets(); saveSettings(); },
  find: () => openFind(false), replace: () => openFind(true), selectAll: () => { editor.focus(); document.execCommand('selectAll'); },
  pageBreak: insertPageBreak, blankPage: insertBlankPage, insertImage: insertImageDialog, insertHr, link: linkDialog, bookmark: bookmarkDialog,
  headerFooter: headerFooterDialog, dateTime: dateDialog, symbol: symbolDialog, insertCode: insertCodeBlock,
  gostPreset: presetGost, wordPreset: presetWord, defaultsDialog, pageSetup: openPageSetup,
  insertToc, updateToc, removeToc, footnote: insertFootnote,
  toggleSpell: () => { view.spell = !view.spell; editor.spellcheck = view.spell; $('btnSpell').classList.toggle('active', view.spell); editor.blur(); editor.focus(); saveSettings(); toast(view.spell ? 'Проверка орфографии браузером включена' : 'Проверка орфографии выключена'); },
  toggleSmart: () => { view.smart = !view.smart; $('btnSmart').classList.toggle('active', view.smart); saveSettings(); toast(view.smart ? 'Автозамена включена: «ёлочки», тире, многоточие, ©' : 'Автозамена выключена'); },
  wordStats: statsDialog,
  readMode: () => { document.body.classList.add('reading'); toast('Режим чтения. Esc — выход'); setTimeout(() => { drawRulers(); }, 50); },
  layoutMode: () => { document.body.classList.remove('reading'); setTimeout(drawRulers, 50); },
  toggleRulers: () => { view.rulers = !view.rulers; document.body.classList.toggle('no-rulers', !view.rulers); $('btnRulers').classList.toggle('active', view.rulers); drawRulers(); saveSettings(); },
  toggleNav: () => { view.nav = !view.nav; $('navPane').classList.toggle('hidden', !view.nav); $('btnNav').classList.toggle('active', view.nav); updateNav(); drawRulers(); saveSettings(); },
  zoom100: () => setZoom(1), zoomIn: () => setZoom(Math.round(view.zoom * 10 + 1) / 10), zoomOut: () => setZoom(Math.round(view.zoom * 10 - 1) / 10),
  zoomPage: () => setZoom((canvas.clientHeight - 50) / dims().H), zoomWidth: () => setZoom((canvas.clientWidth - 60) / dims().W),
  toggleTheme: () => { view.dark = !view.dark; applyTheme(); saveSettings(); },
  fullscreen: () => { if (document.fullscreenElement) document.exitFullscreen(); else document.documentElement.requestFullscreen().catch(() => {}); },
  tRowAbove: () => tableOp(sr => insertRows(sr, false)), tRowBelow: () => tableOp(sr => insertRows(sr, true)),
  tColLeft: () => tableOp(sr => insertCols(sr, false)), tColRight: () => tableOp(sr => insertCols(sr, true)),
  tDelRow: () => tableOp(deleteRows), tDelCol: () => tableOp(deleteCols), tDelTable: () => { const c = currentCell(); if (c) deleteTable(c.closest('table')); },
  tMerge: () => tableOp(mergeCells), tSplit: splitDialog, tDistribute: distributeCols, tAutofit: autofitCols, tHeader: toggleRepeatHeader,
  tVTop: () => cellStyle('verticalAlign', ''), tVMiddle: () => cellStyle('verticalAlign', 'middle'), tVBottom: () => cellStyle('verticalAlign', 'bottom'), tBorders: toggleBorders,
  imgInline: () => imgWrap('inline'), imgCenter: () => imgWrap('center'), imgLeft: () => imgWrap('left'), imgRight: () => imgWrap('right'),
  imgSize: el => imgSize(+el.dataset.v), imgDialog, imgBorder, imgDelete
};
document.addEventListener('mousedown', e => {
  const b = e.target.closest('[data-act],[data-menu]');
  if (b && !b.closest('.modal')) e.preventDefault(); // не теряем выделение в документе
});
document.addEventListener('click', e => {
  const b = e.target.closest('[data-act]');
  if (b && ACT[b.dataset.act] && !b.disabled) { closeMenu(); ACT[b.dataset.act](b); return; }
  const m = e.target.closest('[data-menu]');
  if (m) openMenu(m.dataset.menu, m);
});
$('btnPainter').addEventListener('dblclick', () => { stopPainter(); startPainter(true); });

/* ---------- вкладки ---------- */
function switchTab(name) {
  document.querySelectorAll('.tab').forEach(t => t.classList.toggle('active', t.dataset.tab === name));
  document.querySelectorAll('.panel').forEach(p => p.classList.toggle('hidden', p.dataset.panel !== name));
}
document.querySelectorAll('.tab').forEach(t => { t.addEventListener('mousedown', e => e.preventDefault()); t.addEventListener('click', () => switchTab(t.dataset.tab)); });
function updateContextTabs() {
  const inTable = !!currentCell(), img = !!selectedImg;
  $('tabTable').classList.toggle('hidden', !inTable);
  $('tabImage').classList.toggle('hidden', !img);
  const active = document.querySelector('.tab.active');
  if (active && active.classList.contains('hidden')) switchTab('home');
}

/* ---------- шрифт и размер в ленте ---------- */
$('fontList').innerHTML = FONTS.map(f => `<option value="${f}">`).join('');
$('sizeList').innerHTML = SIZES.map(s => `<option value="${String(s).replace('.', ',')}">`).join('');
const ff = $('fontFamily'), fsz = $('fontSize');
ff.addEventListener('change', () => setFontFamily(ff.value));
ff.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); setFontFamily(ff.value); } if (e.key === 'Escape') { editor.focus(); restoreSelection(); } });
fsz.addEventListener('change', () => setFontSize(fsz.value));
fsz.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); setFontSize(fsz.value); } if (e.key === 'Escape') { editor.focus(); restoreSelection(); } });
[ff, fsz].forEach(i => i.addEventListener('focus', () => i.select()));
const layoutInputs = { indLeft: v => setBlockStyle('marginLeft', v ? v + 'cm' : ''), indRight: v => setBlockStyle('marginRight', v ? v + 'cm' : ''), spBefore: v => setSpacing('before', v), spAfter: v => setSpacing('after', v) };
Object.entries(layoutInputs).forEach(([id, fn]) => $(id).addEventListener('change', e => fn(parseFloat(String(e.target.value).replace(',', '.')) || 0)));

/* ---------- обновление интерфейса ---------- */
let uiRaf = 0, statTimer = 0;
function scheduleUiUpdate() { if (!uiRaf) uiRaf = requestAnimationFrame(() => { uiRaf = 0; updateUi(); }); }
function updateUi() {
  try {
    document.querySelectorAll('[data-state]').forEach(b => { try { b.classList.toggle('active', document.queryCommandState(b.dataset.state)); } catch (e) {} });
    const r = getRange();
    if (r) {
      const n = r.startContainer.nodeType === 1 ? r.startContainer : r.startContainer.parentNode;
      const cs = getComputedStyle(n);
      if (document.activeElement !== ff) ff.value = cs.fontFamily.split(',')[0].replace(/["']/g, '').trim();
      if (document.activeElement !== fsz) fsz.value = String(round(parseFloat(cs.fontSize) * 0.75, 1)).replace('.', ',');
      const al = blockAlign();
      document.querySelectorAll('[data-align]').forEach(b => b.classList.toggle('active', b.dataset.align === al));
      const b = closestBlock(r.startContainer), st = styleOf(b);
      document.querySelectorAll('.style-card').forEach(c => c.classList.toggle('active', !!st && c.dataset.style === st.id));
      if (b && !document.querySelector('.panel[data-panel=layout].hidden')) {
        const bc = getComputedStyle(b), toCm = v => round(px2mm(parseFloat(v) || 0) / 10, 2);
        if (document.activeElement.id !== 'indLeft') $('indLeft').value = toCm(bc.marginLeft);
        if (document.activeElement.id !== 'indRight') $('indRight').value = toCm(bc.marginRight);
        if (document.activeElement.id !== 'spBefore') $('spBefore').value = round((parseFloat(bc.marginTop) || 0) * 0.75, 1);
        if (document.activeElement.id !== 'spAfter') $('spAfter').value = round((parseFloat(bc.marginBottom) || 0) * 0.75, 1);
      }
      const cell = currentCell(); if (cell) $('btnTHeader').classList.toggle('active', cell.closest('table').dataset.repeatHeader === '1');
    } else {
      if (document.activeElement !== ff) ff.value = state.defaults.font;
      if (document.activeElement !== fsz) fsz.value = String(state.defaults.size).replace('.', ',');
    }
    updateContextTabs();
    updateStatusPage();
    drawRulers();
    History.ui();
    clearTimeout(statTimer); statTimer = setTimeout(updateCounts, 300);
  } catch (e) { console.warn(e); }
}
function updateStatusPage() {
  const cp = caretPage();
  const p = (cp === null ? visiblePage() : cp) + 1;
  $('pageInfo').textContent = `Страница ${p} из ${pageCount}`;
}
function updateCounts() {
  const t = editor.innerText || '';
  const words = (t.match(/[\p{L}\p{N}]+(?:[-'’][\p{L}\p{N}]+)*/gu) || []).length;
  const r = getRange(); const sel = r && !r.collapsed ? r.toString() : '';
  if (sel) { const sw = (sel.match(/[\p{L}\p{N}]+/gu) || []).length; $('wordInfo').textContent = `Слов: ${sw} из ${words}`; $('charInfo').textContent = `Знаков: ${sel.length}`; }
  else { $('wordInfo').textContent = `Слов: ${words.toLocaleString('ru')}`; $('charInfo').textContent = `Знаков: ${t.replace(/\n/g, '').length.toLocaleString('ru')}`; }
}
$('wordInfo').onclick = statsDialog;
$('pageInfo').onclick = gotoPageDialog;
$('zoomLabel').onclick = () => {
  const r = $('zoomLabel').getBoundingClientRect();
  openDropdown(['50', '75', '100', '125', '150', '200', '300'].map(z => mi(z, z + '%')).join('') + '<div class="msep"></div>' + mi('page', 'Страница целиком') + mi('width', 'По ширине страницы'), r.left - 100, r.top - 280, v => v === 'page' ? ACT.zoomPage() : v === 'width' ? ACT.zoomWidth() : setZoom(+v / 100));
};

/* ---------- навигация ---------- */
let navTimer = 0;
function updateNavSoon() { if (!view.nav) return; clearTimeout(navTimer); navTimer = setTimeout(updateNav, 400); }
function updateNav() {
  if (!view.nav) return;
  const hs = headingsList();
  hs.forEach(h => { if (!h.id) h.id = 'h-' + Math.random().toString(36).slice(2, 8); });
  $('navList').innerHTML = hs.length ? hs.map(h => `<div class="nav-item" data-id="${h.id}" style="padding-left:${8 + (h.tagName[1] - 1) * 14}px;${h.tagName === 'H1' ? 'font-weight:600' : ''}">${esc(h.textContent.trim())}</div>`).join('')
    : '<div style="padding:10px;color:var(--text-muted);font-size:12px;white-space:normal">Чтобы заголовки появились здесь, примените к ним стили «Заголовок 1–4» (Главная → Стили).</div>';
}
$('navList').addEventListener('click', e => { const it = e.target.closest('.nav-item'); if (it) jumpTo(it.dataset.id); });

/* ---------- масштаб ---------- */
function setZoom(z, silent) {
  z = clamp(round(z, 2), 0.25, 3);
  const before = canvas.scrollHeight ? (canvas.scrollTop + canvas.clientHeight / 2) / canvas.scrollHeight : 0;
  view.zoom = z; workspace.style.zoom = z;
  $('zoomSlider').value = Math.round(z * 100); $('zoomLabel').textContent = Math.round(z * 100) + '%';
  if (!silent) { canvas.scrollTop = before * canvas.scrollHeight - canvas.clientHeight / 2; saveSettings(); }
  drawRulers(); updateImgOverlay();
}
$('zoomSlider').addEventListener('input', e => setZoom(e.target.value / 100));
canvas.addEventListener('wheel', e => { if (e.ctrlKey || e.metaKey) { e.preventDefault(); setZoom(view.zoom * (e.deltaY < 0 ? 1.1 : 1 / 1.1)); } }, { passive: false });

/* ---------- тема ---------- */
function applyTheme() {
  document.documentElement.classList.toggle('dark', view.dark);
  $('themeIcon').setAttribute('data-lucide', view.dark ? 'sun' : 'moon');
  lucide.createIcons(); drawRulers();
}

/* ---------- название документа ---------- */
const titleEl = $('docTitle');
titleEl.addEventListener('click', () => { titleEl.contentEditable = 'true'; titleEl.focus(); document.execCommand('selectAll'); });
titleEl.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === 'Escape') { e.preventDefault(); titleEl.blur(); } });
titleEl.addEventListener('blur', () => { titleEl.contentEditable = 'false'; setTitle(titleEl.textContent.trim() || 'Документ'); sheetsKey = ''; renderSheets(); markDirty(false); autosave(); });

/* ---------- ввод текста ---------- */
function smartType(ch) {
  const r = getRange(); if (!r || !r.collapsed || r.startContainer.nodeType !== 3) return;
  const n = r.startContainer, o = r.startOffset, v = n.nodeValue;
  if (n.parentElement.closest('pre,code')) return;
  const before = v.slice(0, o);
  let rep = null, len = 0;
  if (ch === '"') { const prev = before.slice(-2, -1); rep = (!prev || /[\s(\[{«„-]/.test(prev)) ? '«' : '»'; len = 1; }
  else if (ch === ' ' && / - $/.test(before) ) { rep = ' – '; len = 3; }
  else if (ch === ' ' && /--$/.test(before.slice(0, -1))) { rep = '— '; len = 3; }
  else if (ch === '.' && /\.\.\.$/.test(before)) { rep = '…'; len = 3; }
  else if (ch === ')' && /\((c|с)\)$/i.test(before)) { rep = '©'; len = 3; }
  else if (ch === ')' && /\(r\)$/i.test(before)) { rep = '®'; len = 3; }
  else if (ch === ')' && /\(tm\)$/i.test(before)) { rep = '™'; len = 4; }
  else if (ch === '>' && /->$/.test(before)) { rep = '→'; len = 2; }
  else if (ch === '>' && /=>$/.test(before)) { rep = '⇒'; len = 2; }
  if (rep === null) return;
  const rg = document.createRange(); rg.setStart(n, o - len); rg.setEnd(n, o);
  const s = getSelection(); s.removeAllRanges(); s.addRange(rg);
  document.execCommand('insertText', false, rep);
}
function fixNewParagraph() {
  const r = getRange(); if (!r) return;
  const b = closestBlock(r.startContainer); if (!b) return;
  if (b.id && document.querySelectorAll('#' + CSS.escape(b.id)).length > 1) b.removeAttribute('id');
  const prev = b.previousElementSibling;
  const empty = !b.textContent.replace(/\u200b/g, '').length;
  if (empty && prev && (/^H\d$/.test(b.tagName) || b.classList.contains('doc-title') || b.classList.contains('doc-subtitle')) && prev.textContent.trim()) {
    const p = replaceTag(b, 'P'); p.removeAttribute('id'); STYLE_CLASSES.forEach(c => p.classList.remove(c)); if (!p.className) p.removeAttribute('class');
    p.innerHTML = '<br>';
    const rg = document.createRange(); rg.setStart(p, 0); rg.collapse(true); const s = getSelection(); s.removeAllRanges(); s.addRange(rg);
  }
  if (b.tagName === 'DIV' && !b.className && b.parentElement === editor) { const p = replaceTag(b, 'P'); const rg = document.createRange(); rg.selectNodeContents(p); rg.collapse(true); const s = getSelection(); s.removeAllRanges(); s.addRange(rg); }
}
editor.addEventListener('input', e => {
  if (editor.querySelector('font')) { const off = getSelOffsets(); normalizeFonts(); setSelOffsets(off); }
  if (view.smart && e.inputType === 'insertText' && e.data) smartType(e.data.slice(-1));
  if (e.inputType === 'insertParagraph') fixNewParagraph();
  if (!editor.firstElementChild) { editor.innerHTML = '<p><br></p>'; }
  markDirty(); schedulePaginate(); scheduleUiUpdate();
});
editor.addEventListener('beforeinput', e => {
  if (e.inputType === 'historyUndo') { e.preventDefault(); History.undo(); }
  if (e.inputType === 'historyRedo') { e.preventDefault(); History.redo(); }
});
/* Backspace/Delete рядом со служебным разрывом строки */
function adjacentSpacer(back) {
  const r = getRange(); if (!r || !r.collapsed) return null;
  let n = r.startContainer, o = r.startOffset;
  let cand = null;
  if (n.nodeType === 3) { if (back && o === 0) cand = n.previousSibling; else if (!back && o === n.nodeValue.length) cand = n.nextSibling; }
  else cand = back ? n.childNodes[o - 1] : n.childNodes[o];
  return cand && cand.nodeType === 1 && cand.classList.contains('pb-line') ? cand : null;
}
editor.addEventListener('keydown', e => {
  if (e.key === 'Backspace' || e.key === 'Delete') {
    const sp = adjacentSpacer(e.key === 'Backspace');
    if (sp) { const p = sp.parentNode, off = getSelOffsets(); sp.remove(); p.normalize(); setSelOffsets(off); }
    editor.querySelectorAll('.pb-line').forEach(s => { const p = s.parentNode; if (getRange() && getRange().intersectsNode(s) && !getRange().collapsed) { s.remove(); } void p; });
  }
  if (e.key === 'Tab' && !e.ctrlKey && !e.altKey && !e.metaKey) {
    e.preventDefault();
    if (tableTab(e.shiftKey)) return;
    if (inList()) { indent(e.shiftKey ? -1 : 1); return; }
    if (!e.shiftKey) { document.execCommand('insertText', false, '\t'); }
  }
  if (e.key === 'Enter' && (e.ctrlKey || e.metaKey) && !e.shiftKey) { e.preventDefault(); insertPageBreak(); }
  if (e.key === 'Enter' && e.shiftKey && !e.ctrlKey) { e.preventDefault(); document.execCommand('insertLineBreak'); }
});

/* ---------- буфер обмена ---------- */
let pastePlain = false;
function cleanFragmentHTML(r) {
  const div = document.createElement('div'); div.appendChild(r.cloneContents()); stripArtifacts(div);
  div.querySelectorAll('.selected-cell').forEach(c => c.classList.remove('selected-cell'));
  return div;
}
editor.addEventListener('copy', e => {
  const r = getRange(); if (!r || r.collapsed) return;
  const div = cleanFragmentHTML(r);
  e.clipboardData.setData('text/html', div.innerHTML);
  e.clipboardData.setData('text/plain', textIndexOf(div).replace(/\n$/, ''));
  e.preventDefault();
});
editor.addEventListener('cut', e => {
  const r = getRange(); if (!r || r.collapsed) return;
  const div = cleanFragmentHTML(r);
  e.clipboardData.setData('text/html', div.innerHTML);
  e.clipboardData.setData('text/plain', textIndexOf(div).replace(/\n$/, ''));
  e.preventDefault();
  if (cutBusy) return; cutBusy = true; setTimeout(() => { document.execCommand('delete'); cutBusy = false; changed(); }, 0);
});
let cutBusy = false;
function insertPlainText(text) {
  text = text.replace(/\r\n?/g, '\n');
  const lines = text.split('\n');
  if (lines.length === 1) document.execCommand('insertText', false, text);
  else if (lines.length <= 300) lines.forEach((l, i) => { if (i) document.execCommand('insertParagraph'); if (l) document.execCommand('insertText', false, l); });
  else document.execCommand('insertHTML', false, lines.map(l => `<p>${esc(l) || '<br>'}</p>`).join(''));
}
function insertCleanHTML(html) {
  html = html.replace(/^[\s\S]*?<!--StartFragment-->/, '').replace(/<!--EndFragment-->[\s\S]*$/, '');
  const clean = sanitizeHTML(html, false);
  document.execCommand('insertHTML', false, clean);
  normalizeFonts();
  editor.querySelectorAll('table').forEach(t => { if (!Array.from(t.children).some(c => c.tagName === 'COLGROUP')) ensureColgroup(t); });
}
editor.addEventListener('paste', e => {
  const cd = e.clipboardData; if (!cd) return;
  e.preventDefault();
  const html = cd.getData('text/html'), text = cd.getData('text/plain');
  const files = Array.from(cd.files || []).filter(f => f.type.startsWith('image/'));
  if (files.length && (!html || !/<(p|table|span|div)/i.test(html))) { insertImageFiles(files); return; }
  if (html && !pastePlain) insertCleanHTML(html);
  else if (text) insertPlainText(text);
  pastePlain = false;
  changed(); scrollCaretIntoView();
});
async function pasteFromButton(plain) {
  restoreSelection();
  try {
    if (!plain && navigator.clipboard.read) {
      const items = await navigator.clipboard.read();
      for (const it of items) {
        const img = it.types.find(t => t.startsWith('image/'));
        if (it.types.includes('text/html')) { insertCleanHTML(await (await it.getType('text/html')).text()); changed(); return; }
        if (img) { await insertImageFiles([new File([await it.getType(img)], 'img', { type: img })]); return; }
      }
    }
    const t = await navigator.clipboard.readText(); insertPlainText(t); changed();
  } catch (e) { toast('Браузер запретил доступ к буферу. Используйте Ctrl+V (Ctrl+Shift+V — без форматирования)', 4000); }
}

/* ---------- контекстное меню ---------- */
/* ---------- контекстное меню ---------- */
editor.addEventListener('contextmenu', e => {
  e.preventDefault();
  const img = e.target.closest('img'), cell = e.target.closest('td,th');

  // Определяем ссылку по клику или по текущему выделению
  let a = e.target.closest && e.target.closest('a[href]');
  if (!a) {
    const r = getRange();
    if (r) {
      const sc = r.startContainer.nodeType === 1 ? r.startContainer : r.startContainer.parentNode;
      const ec = r.endContainer.nodeType === 1 ? r.endContainer : r.endContainer.parentNode;
      a = (sc && sc.closest('a[href]')) || (ec && ec.closest('a[href]'));
      if (!a) {
        const common = r.commonAncestorContainer;
        const el = common.nodeType === 1 ? common : common.parentNode;
        if (el) a = el.closest('a[href]') || el.querySelector('a[href]');
      }
    }
  }

  if (img) selectImage(img);
  else if (!getRange() || getRange().collapsed) {
    const r = document.caretRangeFromPoint ? document.caretRangeFromPoint(e.clientX, e.clientY) : null;
    if (r && editor.contains(r.startContainer) && !(cell && editor.querySelector('.selected-cell'))) {
      const s = getSelection(); s.removeAllRanges(); s.addRange(r);
    }
  }

  let h = mi('cut', '<i data-lucide="scissors"></i> Вырезать', 'Ctrl+X') +
          mi('copy', '<i data-lucide="copy"></i> Копировать', 'Ctrl+C') +
          mi('paste', '<i data-lucide="clipboard-paste"></i> Вставить', 'Ctrl+V') +
          mi('pastePlain', '<i data-lucide="clipboard-type"></i> Вставить только текст', 'Ctrl+Shift+V');

  if (img) {
    h += '<div class="msep"></div>' +
         mi('imgInline', '<i data-lucide="text"></i> В тексте') +
         mi('imgCenter', '<i data-lucide="align-center"></i> По центру') +
         mi('imgLeft', '<i data-lucide="wrap-text"></i> Обтекание слева') +
         mi('imgRight', '<i data-lucide="wrap-text"></i> Обтекание справа') +
         mi('imgDialog', '<i data-lucide="scaling"></i> Размер и положение…') +
         mi('imgDelete', '<i data-lucide="trash-2"></i> Удалить рисунок', '', 'class="mi danger"');
  } else if (cell) {
    h += '<div class="msep"></div><div class="mhead">Таблица</div>' +
         mi('tRowAbove', '<i data-lucide="between-horizontal-end"></i> Вставить строку сверху') +
         mi('tRowBelow', '<i data-lucide="between-horizontal-start"></i> Вставить строку снизу') +
         mi('tColLeft', '<i data-lucide="between-vertical-end"></i> Вставить столбец слева') +
         mi('tColRight', '<i data-lucide="between-vertical-start"></i> Вставить столбец справа') +
         mi('tMerge', '<i data-lucide="merge"></i> Объединить ячейки') +
         mi('tSplit', '<i data-lucide="split"></i> Разделить ячейку…') +
         mi('tDistribute', '<i data-lucide="columns-2"></i> Выровнять ширину столбцов') +
         mi('tDelRow', '<i data-lucide="rows-3"></i> Удалить строки') +
         mi('tDelCol', '<i data-lucide="columns-3"></i> Удалить столбцы') +
         mi('tDelTable', '<i data-lucide="trash-2"></i> Удалить таблицу', '', 'class="mi danger"');
  } else {
    h += '<div class="msep"></div>' +
         mi('paragraphDialog', '<i data-lucide="settings-2"></i> Абзац…') +
         mi('bullets', '<i data-lucide="list"></i> Маркеры') +
         mi('numbering', '<i data-lucide="list-ordered"></i> Нумерация');
  }

  // Пункты для ссылки
  if (a) {
    h += '<div class="msep"></div>' +
         mi('editLink', '<i data-lucide="link"></i> Изменить ссылку…', 'Ctrl+K') +
         mi('openLink', '<i data-lucide="external-link"></i> Открыть ссылку') +
         mi('unlink', '<i data-lucide="unlink"></i> Удалить ссылку');
  } else {
    h += '<div class="msep"></div>' + mi('link', '<i data-lucide="link"></i> Ссылка…', 'Ctrl+K');
  }

  h += mi('clearFormat', '<i data-lucide="remove-formatting"></i> Очистить формат');

  openDropdown(h, e.clientX, e.clientY, v => {
    if (v === 'pastePlain') return pasteFromButton(true);
    if (v === 'openLink') return window.open(a.href, '_blank', 'noopener');
    if (v === 'unlink') { a.replaceWith(...a.childNodes); changed(); return; }
    if (v === 'editLink' || v === 'link') { linkDialog(a); return; }
    if (ACT[v]) ACT[v]();
  }, 230);
});

/* ---------- двойной щелчок по полям → колонтитулы ---------- */
editor.addEventListener('dblclick', e => {
  geoInit(); const d = dims(), step = pageStep();
  const y = relY(e.clientY), within = y - Math.floor(y / step) * step;
  if (within < d.mt - 4 || within > d.H - d.mb + 4) { e.preventDefault(); headerFooterDialog(); }
});

/* ---------- горячие клавиши ---------- */
document.addEventListener('keydown', e => {
  const mod = e.ctrlKey || e.metaKey, k = e.key.toLowerCase(), code = e.code;
  const inEditor = editor.contains(document.activeElement) || document.activeElement === editor;
  if (e.key === 'Escape') {
    if (menuEl) { closeMenu(); return; }
    if (painter) { stopPainter(); return; }
    if (!$('findPanel').classList.contains('hidden')) { closeFind(); return; }
    if (document.body.classList.contains('reading')) { ACT.layoutMode(); return; }
    clearCellSelection();
  }
  if (e.key === 'F12') { e.preventDefault(); saveAs(); return; }
  if (e.key === 'F3' && e.shiftKey) { e.preventDefault(); changeCase('cycle'); return; }
  if (e.key === 'F3' && !e.shiftKey) { e.preventDefault(); findStep(1); return; }
  if (e.key === 'F11') { e.preventDefault(); ACT.fullscreen(); return; }
  if (!mod) return;
  if ($('modal').classList.contains('open')) return;
  const map = {
    KeyS: () => e.shiftKey ? saveAs() : save(), KeyO: openDialog, KeyP: doPrint, KeyF: () => openFind(false), KeyH: () => openFind(true),
    KeyZ: () => e.shiftKey ? History.redo() : History.undo(), KeyY: () => History.redo(), KeyK: linkDialog
  };
  const edMap = {
    KeyE: () => setAlign('center'), KeyL: () => e.shiftKey ? makeList('ul') : setAlign('left'), KeyR: () => setAlign('right'), KeyJ: () => setAlign('justify'),
    Digit1: () => e.altKey ? applyStyle('h1') : setLineHeight(1), Digit2: () => e.altKey ? applyStyle('h2') : setLineHeight(2), Digit5: () => setLineHeight(1.5),
    Digit3: () => e.altKey && applyStyle('h3'), Digit4: () => e.altKey && applyStyle('h4'), KeyN: () => e.shiftKey && applyStyle('normal'),
    BracketRight: () => stepFont(1), BracketLeft: () => stepFont(-1), Period: () => e.shiftKey && stepFont(1), Comma: () => e.shiftKey && stepFont(-1),
    Equal: () => exec(e.shiftKey ? 'superscript' : 'subscript'), Digit8: () => e.shiftKey && ACT.toggleMarks(),
    Space: () => e.shiftKey ? document.execCommand('insertText', false, '\u00a0') : exec('removeFormat'),
    Minus: () => e.shiftKey && document.execCommand('insertText', false, '\u2011'),
    KeyD: () => e.shiftKey && ACT.dateTime()
  };
  if (map[code] && !e.altKey) { e.preventDefault(); map[code](); return; }
  if (inEditor && edMap[code]) {
    if ((code === 'KeyN' || code === 'Digit8' || code === 'Period' || code === 'Comma' || code === 'Minus' || code === 'KeyD') && !e.shiftKey) return;
    if ((code === 'Digit3' || code === 'Digit4') && !e.altKey) return;
    e.preventDefault(); edMap[code](); return;
  }
  if (inEditor && code === 'KeyV' && e.shiftKey) { pastePlain = true; return; }
  if ((k === '=' || k === '+') && !inEditor) { e.preventDefault(); ACT.zoomIn(); }
  if (k === '-' && !inEditor) { e.preventDefault(); ACT.zoomOut(); }
});

/* ---------- перетаскивание файлов ---------- */
let dragDepth = 0;
window.addEventListener('dragenter', e => { if (e.dataTransfer && Array.from(e.dataTransfer.types).includes('Files')) { dragDepth++; $('dropHint').style.display = 'flex'; } });
window.addEventListener('dragleave', () => { dragDepth = Math.max(0, dragDepth - 1); if (!dragDepth) $('dropHint').style.display = 'none'; });
window.addEventListener('dragover', e => { if (e.dataTransfer && Array.from(e.dataTransfer.types).includes('Files')) e.preventDefault(); });
window.addEventListener('drop', e => {
  dragDepth = 0; $('dropHint').style.display = 'none';
  const files = Array.from(e.dataTransfer && e.dataTransfer.files || []);
  if (!files.length) return;
  e.preventDefault();
  const imgs = files.filter(f => f.type.startsWith('image/'));
  if (imgs.length) {
    const r = document.caretRangeFromPoint && document.caretRangeFromPoint(e.clientX, e.clientY);
    if (r && editor.contains(r.startContainer)) { const s = getSelection(); s.removeAllRanges(); s.addRange(r); savedRange = r; }
    insertImageFiles(imgs); return;
  }
  openFile(files[0]);
});

/* ================= запуск ================= */
const WELCOME = `
<p class="doc-title" style="text-align:center">Листик</p>
<p style="text-align:center"><em>Текстовый редактор в браузере — с разбиением на страницы, линейкой и форматом Word</em></p>
<h2>Что умеет редактор</h2>
<ul>
<li><b>Настоящие страницы</b>: текст и таблицы переносятся построчно, колонтитулы и номера на каждой странице.</li>
<li><b>Линейка как в Word</b>: поля страницы, отступ первой строки, выступ, левый и правый отступы, ширина столбцов таблицы. Двойной щелчок по линейке — «Параметры страницы».</li>
<li><b>Стили</b> (Обычный, Заголовки 1–4, Название, Цитата, Код), оглавление со ссылками и номерами страниц.</li>
<li><b>Таблицы</b>: объединение и разбиение ячеек, вставка строк/столбцов, заливка, повтор строки заголовка.</li>
<li><b>Рисунки</b>: вставка из файла, буфера или перетаскиванием, изменение размера, обтекание.</li>
<li><b>Файлы</b>: открытие и сохранение <b>DOCX</b> с полями, размером страницы, колонтитулами, списками и таблицами; также HTML, Markdown, TXT, печать и PDF.</li>
<li>Автосохранение черновика, поиск и замена, статистика, пресет оформления по ГОСТ.</li>
</ul>
<h2>Горячие клавиши</h2>
<table style="width:100%"><colgroup><col style="width:45%"><col style="width:55%"></colgroup>
<tbody>
<tr><td><b>Ctrl+S / Ctrl+O / Ctrl+N</b></td><td>Сохранить / открыть / создать</td></tr>
<tr><td><b>Ctrl+Z / Ctrl+Y</b></td><td>Отменить / повторить</td></tr>
<tr><td><b>Ctrl+B / I / U</b></td><td>Полужирный / курсив / подчёркнутый</td></tr>
<tr><td><b>Ctrl+Alt+1…4</b></td><td>Заголовок 1–4</td></tr>
<tr><td><b>Ctrl+L / E / R / J</b></td><td>Выравнивание: влево / по центру / вправо / по ширине</td></tr>
<tr><td><b>Ctrl+Enter</b></td><td>Разрыв страницы</td></tr>
<tr><td><b>Ctrl+F / Ctrl+H</b></td><td>Найти / заменить</td></tr>
<tr><td><b>Ctrl+K</b></td><td>Гиперссылка</td></tr>
<tr><td><b>Ctrl+P</b></td><td>Печать / сохранить в PDF</td></tr>
<tr><td><b>Ctrl+колесо мыши</b></td><td>Масштаб</td></tr>
</tbody></table>
<p></p>
<p>Начните печатать или откройте документ (<b>Файл → Открыть</b> или перетащите файл в окно).</p>`;

(async function init() {
  try { Object.assign(view, JSON.parse(localStorage.getItem('list-pro:view') || '{}')); } catch (e) {}
  view.printing = false; view.gap = GAP;
  try { document.execCommand('defaultParagraphSeparator', false, 'p'); } catch (e) {}
  document.body.classList.toggle('show-marks', view.marks);
  document.body.classList.toggle('no-rulers', !view.rulers);
  $('btnMarks').classList.toggle('active', view.marks); $('btnMarks2').classList.toggle('active', view.marks);
  $('btnRulers').classList.toggle('active', view.rulers);
  $('btnNav').classList.toggle('active', view.nav); $('navPane').classList.toggle('hidden', !view.nav);
  $('btnSmart').classList.toggle('active', view.smart);
  $('btnSpell').classList.toggle('active', view.spell); editor.spellcheck = view.spell;

  const st = defaultState();
  try { const pd = JSON.parse(localStorage.getItem('list-pro:pageDefaults') || 'null'); if (pd) st.page = Object.assign(st.page, pd, { margins: Object.assign({}, st.page.margins, pd.margins || {}) }); } catch (e) {}

  let draft = null;
  try { draft = await DB.get('draft'); } catch (e) {}
  if (!draft) {
    try { const old = localStorage.getItem('list_draft_content_v3'); if (old) draft = { html: old, state: null }; } catch (e) {}
  }
  if (draft && draft.html && draft.html.replace(/<[^>]+>|\s|&nbsp;/g, '')) {
    loadDocument(sanitizeHTML(draft.html, false), draft.state || st, { noFocus: true });
    if (draft.ts) toast('Восстановлен черновик от ' + new Date(draft.ts).toLocaleString('ru-RU'));
  } else {
    st.title = 'Добро пожаловать';
    loadDocument(WELCOME, st, { noFocus: true });
  }
  applyTheme();
  setZoom(view.zoom || 1, true);
  const ready = () => { paginate(); drawRulers(); updateUi(); updateNav(); };
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(ready); else setTimeout(ready, 300);
  window.addEventListener('resize', () => drawRulers());
})();
</script>
</body>
</html>
