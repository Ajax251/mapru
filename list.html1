  const rg = document.createRange();
  function charTop(tn, i) {
    for (let k = i; k < Math.min(tn.total, i + 4); k++) {
      const [n, o] = charAt(tn, k);
      rg.setStart(n, o); rg.setEnd(n, o + 1);
      const rs = rg.getClientRects();
      if (rs.length && rs[0].height > 0) return (rs[0].top - geo.top) / geo.scale;
    }
    return null;
  }
  /* построчный разрыв абзаца; возвращает true, если удалось */
  function splitLines(el, p) {
    for (let iter = 0; iter < 60; iter++) {
      const lines = lineBoxes(el);
      if (lines.length < 2) return iter > 0;
      const limit = cBot(p);
      let k = lines.findIndex(l => l.bottom > limit + 0.5);
      if (k === -1) return true;
      const atTop = lines[0].top <= cTop(p) + 2;
      if (k === 0) return iter > 0 ? (push(el, cTop(p + 1)), true) : false;
      if (k === 1 && lines.length > 2 && !atTop && iter === 0) return false;  // защита от «висячей» первой строки
      if (lines.length - k === 1 && k >= 2) k--;                              // защита от «вдовы»
      const tn = textNodesOf(el);
      if (!tn.total) return false;
      const lineTop = lines[k].top;
      let lo = 0, hi = tn.total - 1, found = -1;
      while (lo <= hi) {
        const m = (lo + hi) >> 1, t = charTop(tn, m);
        if (t !== null && t >= lineTop - 1) { found = m; hi = m - 1; } else lo = m + 1;
      }
      if (found <= 0) return iter > 0;
      const [node, off] = charAt(tn, found);
      const t0 = charTop(tn, found);
      const target = cTop(p + 1) + (t0 - lineTop);
      const sp = document.createElement('span');
      sp.className = 'pb-line'; sp.setAttribute('data-pb', '1'); sp.contentEditable = 'false';
      let h = (target - t0) + (lines[k].bottom - lines[k].top) * 0.8;
      sp.style.height = h + 'px';
      const r = document.createRange(); r.setStart(node, off); r.insertNode(sp);
      for (let i = 0; i < 3; i++) {
        const nx = sp.nextSibling;
