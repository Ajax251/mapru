      acceptNode: n => n.parentElement.closest('[data-pb]') ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT });
    let n, total = 0;
    while ((n = w.nextNode())) { if (n.nodeValue.length) { out.push({ n, start: total }); total += n.nodeValue.length; } }
    return { nodes: out, total };
  }
