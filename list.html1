    const blocked = new Set();
    rows.forEach((row, ri) => Array.from(row.cells).forEach(c => { for (let k = 1; k < (c.rowSpan || 1); k++) blocked.add(ri + k); }));
    const nCols = Math.max(1, ...rows.map(r => Array.from(r.cells).reduce((a, c) => a + (c.colSpan || 1), 0)));
    let guardT = 0;
    let startIdx = 0;
    while (guardT++ < 500) {
      let r = -1;
      for (let i = startIdx; i < rows.length; i++) { if (relRect(rows[i]).bottom > cBot(p) + 0.5) { r = i; break; } }
      if (r === -1) return;
      let j = r;
      while (j > startIdx && blocked.has(j)) j--;
      if (j === 0) {
        if (relRect(t).top > cTop(p) + 2) { push(t, cTop(p + 1)); p++; startIdx = 0; continue; }
        // первая строка выше страницы — пропускаем
        startIdx = 1; p = pageOf(relRect(rows[0]).bottom - 1); continue;
      }
      if (j === startIdx) {
        // строка выше страницы целиком — оставляем
        startIdx = j + 1; p = pageOf(relRect(rows[j]).bottom - 1); continue;
      }
      const row = rows[j];
      const sp = document.createElement('tr');
      sp.className = 'pb-spacer'; sp.setAttribute('data-pb', '1'); sp.contentEditable = 'false';
      const td = document.createElement('td'); td.colSpan = nCols; sp.appendChild(td);
      row.parentNode.insertBefore(sp, row);
      let ghost = null;
      if (t.dataset.repeatHeader === '1' && !blocked.has(1) && j > 1) {
        ghost = rows[0].cloneNode(true);
        ghost.className = 'pb-ghost'; ghost.setAttribute('data-pb', '1'); ghost.contentEditable = 'false';
        ghost.querySelectorAll('[id]').forEach(e => e.removeAttribute('id'));
        row.parentNode.insertBefore(ghost, row);
      }
      const target = cTop(p + 1);
      const first = ghost || row;
      let h = Math.max(0, target - relRect(sp).top);
      td.style.height = h + 'px';
      for (let i = 0; i < 3; i++) {
        const err = target - relRect(first).top;
        if (Math.abs(err) < 0.3) break;
        h = Math.max(0, h + err); td.style.height = h + 'px';
      }
      p++; startIdx = j;
    }
  }

  function headingKeep(el, p) {
    let prev = el.previousElementSibling;
    while (prev && prev.hasAttribute('data-pb')) prev = prev.previousElementSibling;
    if (prev && /^H[1-6]$/.test(prev.tagName)) {
      const pr = relRect(prev);
      if (pageOf(pr.top) === p && pr.top > cTop(p) + 2) return prev;
    }
    return null;
  }

  function processChildren(container) {
    for (const ch of Array.from(container.children)) processEl(ch);
  }
  function processEl(el) {
    if (guard++ > 20000 || el.hasAttribute('data-pb')) return;
    const cs = getComputedStyle(el);
    if (cs.display === 'none' || cs.position === 'absolute' || cs.position === 'fixed' || cs.float !== 'none') return;
    let r = relRect(el);
    if (breakTarget !== null) {
      const t = breakTarget; breakTarget = null;
      if (r.top < t - 0.5) { push(el, t); r = relRect(el); }
    }
    if (el.classList.contains('manual-break')) {
      breakTarget = cTop(pageOf(r.top) + 1);
      return;
    }
    if (r.height < 0.5) return;
    let p = pageOf(r.top);
    if (r.top > cBot(p) - 1) { push(el, cTop(p + 1)); r = relRect(el); p = pageOf(r.top); }
    if (r.bottom <= cBot(p) + 0.5) return;
    const tag = el.tagName;
    if (tag === 'UL' || tag === 'OL' || ((tag === 'DIV' || tag === 'BLOCKQUOTE' || tag === 'SECTION' || tag === 'LI' || tag === 'ARTICLE') && hasBlockChild(el))) {
      if (tag === 'LI') { // строка пункта + вложенные блоки
        const inner = Array.from(el.children).filter(c => isBlock(c));
        inner.forEach(processEl);
      } else processChildren(el);
      return;
    }
    if (tag === 'TABLE') { splitTable(el, p); return; }
    if (TEXT_BLOCKS.has(tag) && splitLines(el, p)) return;
    if (r.top > cTop(p) + 2 && r.height <= usable + 1) {
      const h = headingKeep(el, p);
      if (h) { push(h, cTop(p + 1)); return; }
      push(el, cTop(p + 1));
    }
  }

  processChildren(editor);

  const last = editor.lastElementChild;
  let bottom = last ? relRect(last).bottom : d.mt;
  const lastBottom = Math.max(bottom, editor.scrollHeight / 1 - d.mb - 1);
  const raw = editor.lastElementChild ? relRect(editor.lastElementChild).bottom : 0;
  pageCount = Math.max(1, pageOf(Math.max(raw, d.mt) - 1) + 1);
  const needH = pageCount * step - view.gap;
  editor.style.minHeight = needH + 'px';
  // если плавающие элементы/переполнение увеличили высоту
  const realH = editor.getBoundingClientRect().height / geo.scale;
  if (realH > needH + 1) { pageCount = Math.ceil((realH + view.gap) / step); editor.style.minHeight = (pageCount * step - view.gap) + 'px'; }
  renderSheets();
  updateTocNumbers();
  updateNavSoon();
  updateImgOverlay();
  void lastBottom;
}
function caretPage() {
  const r = getRange();
  if (!r) return null;
  let rect = r.getClientRects()[0] || r.getBoundingClientRect();
  if (!rect || (!rect.height && !rect.top)) { const n = r.startContainer.nodeType === 1 ? r.startContainer : r.startContainer.parentNode; rect = n.getBoundingClientRect(); }
  geoInit();
  return clamp(Math.floor(relY(rect.top + 1) / pageStep()), 0, pageCount - 1);
}
function visiblePage() {
  geoInit();
