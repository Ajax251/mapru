      if (inl.some(n => n.nodeType === 1 || n.nodeValue.trim())) out += `<w:p>${pPr(null, o)}${await inlineXml(inl, ctx, o.base || {})}</w:p>`;
      inl = [];
    };
    for (const n of nodes) {
      if (n.nodeType === 1 && n.hasAttribute('data-pb')) continue;
      if (n.nodeType !== 1 || !isBlock(n)) { if (n.nodeType === 3 || n.nodeType === 1) inl.push(n); continue; }
      await flush();
      const t = n.tagName;
      if (n.classList.contains('manual-break')) { out += '<w:p><w:r><w:br w:type="page"/></w:r></w:p>'; continue; }
      if (n.classList.contains('toc')) { out += await tocXml(n, ctx); continue; }
      if (t === 'TABLE') { out += await tableXml(n, ctx); continue; }
      if (t === 'HR') { out += `<w:p>${pPr(null, { border: true })}</w:p>`; continue; }
      if (t === 'UL' || t === 'OL') { out += await listXml(n, ctx, 0, o); continue; }
      if ((t === 'DIV' || t === 'BLOCKQUOTE' || t === 'SECTION' || t === 'ARTICLE' || t === 'FIGURE' || t === 'HEADER' || t === 'FOOTER' || t === 'MAIN' || t === 'NAV' || t === 'ASIDE') && hasBlockChild(n)) {
        out += await blocksXml(n.childNodes, ctx, Object.assign({}, o, { align: n.style.textAlign || o.align })); continue;
      }
      if (t === 'TBODY' || t === 'TR' || t === 'COLGROUP') continue;
      const base = Object.assign({}, o.base || {}, blockBaseProps(n));
      let inner = await inlineXml(n.childNodes, ctx, base);
      if (/^H[1-6]$/.test(t) && n.id) { const bid = ctx.bm++; inner = `<w:bookmarkStart w:id="${bid}" w:name="${xe(n.id.slice(0, 40))}"/>${inner}<w:bookmarkEnd w:id="${bid}"/>`; }
      if (t === 'PRE') inner = inner;
      const centerImg = n.querySelector(':scope > img.img-center');
      out += `<w:p>${pPr(n, Object.assign({}, o, { align: centerImg && !n.style.textAlign ? 'center' : o.align }))}${inner}</w:p>`;
    }
    await flush();
    return out;
  }
  async function listXml(list, ctx, lvl, o) {
    const id = newNum(ctx, list);
    let out = '';
    for (const li of Array.from(list.children)) {
      if (li.tagName !== 'LI') { if (li.tagName === 'UL' || li.tagName === 'OL') out += await listXml(li, ctx, lvl + 1, o); continue; }
      const own = [], nested = [];
      Array.from(li.childNodes).forEach(c => (c.nodeType === 1 && (c.tagName === 'UL' || c.tagName === 'OL')) ? nested.push(c) : own.push(c));
      const base = Object.assign({}, o.base || {}, blockBaseProps(li));
      let inner = '';
      const blockKids = own.filter(c => c.nodeType === 1 && isBlock(c));
      if (blockKids.length) {
        let first = true;
        for (const c of own) {
          if (c.nodeType === 1 && isBlock(c)) {
            const x = await inlineXml(c.childNodes, ctx, Object.assign({}, base, blockBaseProps(c)));
            out += `<w:p>${pPr(li, first ? { num: { id, lvl } } : { extraLeft: 47 * (lvl + 1) })}${x}</w:p>`; first = false;
          } else if (c.nodeType === 3 && c.nodeValue.trim()) { out += `<w:p>${pPr(li, first ? { num: { id, lvl } } : {})}${textRuns(c.nodeValue, base)}</w:p>`; first = false; }
        }
      } else {
        inner = await inlineXml(own, ctx, base);
        out += `<w:p>${pPr(li, { num: { id, lvl } })}${inner}</w:p>`;
      }
      for (const nl of nested) out += await listXml(nl, ctx, lvl + 1, o);
    }
    return out;
  }
  async function tocXml(toc, ctx) {
    const cw = tw(contentWidth());
    let out = `<w:p>${pPr(null, { style: 'TOCHeading' })}${textRuns(toc.querySelector('.toc-h') ? toc.querySelector('.toc-h').textContent : 'Оглавление', {})}</w:p>`;
    toc.querySelectorAll('.toc-e[data-target]').forEach(e => {
      const lvl = +((e.className.match(/toc-l(\d)/) || [0, 1])[1]);
      const t = e.querySelector('.toc-t').textContent, n = e.querySelector('.toc-n').textContent;
      out += `<w:p>${pPr(null, { style: 'TOC' + lvl, tabs: `<w:tabs><w:tab w:val="right" w:leader="dot" w:pos="${cw}"/></w:tabs>` })}<w:hyperlink w:anchor="${xe(e.dataset.target.slice(0, 40))}">${textRuns(t, {})}<w:r><w:tab/></w:r>${textRuns(n, {})}</w:hyperlink></w:p>`;
    });
    return out;
  }
  async function tableXml(t, ctx) {
    const m = readTable(t), g = buildGrid(m);
    const cw = contentWidth();
    const cg = Array.from(t.children).find(c => c.tagName === 'COLGROUP');
    let widths = cg ? Array.from(cg.children).map(c => parseFloat(c.style.width) || 0) : [];
    if (widths.length !== m.nCols || widths.some(w => !w)) widths = Array(m.nCols).fill(100 / m.nCols);
    const sum = widths.reduce((a, b) => a + b, 0);
    const tableW = lenPx(t.style.width, 14.67, cw) || cw;
    const tw2 = widths.map(w => Math.round(tw(tableW) * w / sum));
    const nb = t.classList.contains('no-borders');
    const bd = v => ['top', 'left', 'bottom', 'right', 'insideH', 'insideV'].map(s => `<w:${s} w:val="${v}" w:sz="4" w:space="0" w:color="auto"/>`).join('');
    let x = `<w:tbl><w:tblPr><w:tblStyle w:val="TableGrid"/><w:tblW w:w="${tw(tableW)}" w:type="dxa"/><w:tblBorders>${bd(nb ? 'nil' : 'single')}</w:tblBorders><w:tblLayout w:type="fixed"/><w:tblLook w:val="04A0" w:firstRow="1" w:lastRow="0" w:firstColumn="1" w:lastColumn="0" w:noHBand="0" w:noVBand="1"/></w:tblPr><w:tblGrid>${tw2.map(w => `<w:gridCol w:w="${w}"/>`).join('')}</w:tblGrid>`;
    for (let r = 0; r < m.nRows; r++) {
      x += `<w:tr>${r === 0 && t.dataset.repeatHeader === '1' ? '<w:trPr><w:tblHeader/></w:trPr>' : ''}`;
      for (let c = 0; c < m.nCols;) {
        const cell = g[r][c];
        if (!cell) { x += `<w:tc><w:tcPr><w:tcW w:w="${tw2[c]}" w:type="dxa"/></w:tcPr><w:p/></w:tc>`; c++; continue; }
        const w = tw2.slice(cell.c, cell.c + cell.cs).reduce((a, b) => a + b, 0);
        const bg = colorHex(cell.el.style.backgroundColor) || (cell.el.tagName === 'TH' ? 'F2F2F2' : null);
        const va = { middle: 'center', bottom: 'bottom' }[cell.el.style.verticalAlign];
        let pr = `<w:tcW w:w="${w}" w:type="dxa"/>${cell.cs > 1 ? `<w:gridSpan w:val="${cell.cs}"/>` : ''}`;
        if (cell.rs > 1) pr += cell.r === r ? '<w:vMerge w:val="restart"/>' : '<w:vMerge/>';
        if (bg) pr += `<w:shd w:val="clear" w:color="auto" w:fill="${bg}"/>`;
        if (va) pr += `<w:vAlign w:val="${va}"/>`;
        let content = '<w:p/>';
        if (cell.r === r) {
          const base = cell.el.tagName === 'TH' ? { b: true } : {};
          content = await blocksXml(cell.el.childNodes, ctx, { cell: true, base: Object.assign(base, runProps(cell.el, {})), align: cell.el.style.textAlign || (cell.el.tagName === 'TH' ? 'center' : '') });
          if (!content.includes('<w:p')) content += `<w:p>${pPr(null, { cell: true })}</w:p>`;
          if (content.trim().endsWith('</w:tbl>')) content += '<w:p/>';
        }
        x += `<w:tc><w:tcPr>${pr}</w:tcPr>${content}</w:tc>`;
        c += cell.cs;
      }
      x += '</w:tr>';
    }
    return x + '</w:tbl>';
  }
  /* ---------- колонтитулы ---------- */
  function hfPartXml(text) {
    let out = '';
    String(text || '').split(/(\{PAGE\}|\{PAGES\})/).forEach(s => {
      if (s === '{PAGE}') out += '<w:fldSimple w:instr=" PAGE "><w:r><w:t>1</w:t></w:r></w:fldSimple>';
      else if (s === '{PAGES}') out += '<w:fldSimple w:instr=" NUMPAGES "><w:r><w:t>1</w:t></w:r></w:fldSimple>';
      else if (s) out += textRuns(fieldText(s, 1).replace(/\{PAGE\}|\{PAGES\}/g, ''), {});
    });
    return out;
  }
  function hfXml(tag, o) {
    const cw = tw(contentWidth());
    const body = `<w:p><w:pPr><w:pStyle w:val="${tag === 'hdr' ? 'Header' : 'Footer'}"/><w:tabs><w:tab w:val="center" w:pos="${Math.round(cw / 2)}"/><w:tab w:val="right" w:pos="${cw}"/></w:tabs></w:pPr>${hfPartXml(o.l)}${o.c || o.r ? '<w:r><w:tab/></w:r>' : ''}${hfPartXml(o.c)}${o.r ? '<w:r><w:tab/></w:r>' : ''}${hfPartXml(o.r)}</w:p>`;
    return `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:${tag} ${NS}>${body}</w:${tag}>`;
  }
  const hasHF = o => !!(o.l || o.c || o.r);
  /* ---------- стили ---------- */
  function stylesXml() {
    const d = state.defaults, f = xe(d.font);
    const jc = { left: 'left', center: 'center', right: 'right', justify: 'both' }[d.align] || 'left';
    const pst = (id, name, ppr, rpr, extra = '') => `<w:style w:type="paragraph" w:styleId="${id}"><w:name w:val="${name}"/><w:basedOn w:val="Normal"/><w:next w:val="Normal"/><w:qFormat/>${extra}<w:pPr>${ppr}</w:pPr><w:rPr>${rpr}</w:rPr></w:style>`;
    const hd = (n, sz, col, before, extra = '') => pst('Heading' + n, 'heading ' + n, `<w:keepNext/><w:keepLines/><w:spacing w:before="${before}" w:after="0"/><w:ind w:firstLine="0"/><w:jc w:val="left"/><w:outlineLvl w:val="${n - 1}"/>`, `${extra}<w:color w:val="${col}"/><w:sz w:val="${sz}"/><w:szCs w:val="${sz}"/>`);
    return `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:styles ${NS}>
<w:docDefaults><w:rPrDefault><w:rPr><w:rFonts w:ascii="${f}" w:hAnsi="${f}" w:eastAsia="${f}" w:cs="${f}"/><w:sz w:val="${Math.round(d.size * 2)}"/><w:szCs w:val="${Math.round(d.size * 2)}"/><w:lang w:val="ru-RU" w:eastAsia="en-US" w:bidi="ar-SA"/></w:rPr></w:rPrDefault>
<w:pPrDefault><w:pPr><w:spacing w:before="${Math.round(d.before * 20)}" w:after="${Math.round(d.after * 20)}" w:line="${Math.round(d.lineHeight * 240)}" w:lineRule="auto"/>${d.indent ? `<w:ind w:firstLine="${Math.round(d.indent * MM * 15)}"/>` : ''}<w:jc w:val="${jc}"/></w:pPr></w:pPrDefault></w:docDefaults>
<w:style w:type="paragraph" w:default="1" w:styleId="Normal"><w:name w:val="Normal"/><w:qFormat/></w:style>
<w:style w:type="character" w:default="1" w:styleId="DefaultParagraphFont"><w:name w:val="Default Paragraph Font"/><w:uiPriority w:val="1"/><w:semiHidden/></w:style>
${hd(1, 32, '2F5496', 240)}${hd(2, 26, '2F5496', 40)}${hd(3, 24, '1F3763', 40)}${hd(4, Math.round(d.size * 2), '2F5496', 40, '<w:i/>')}
${pst('Title', 'Title', '<w:spacing w:after="80" w:line="240" w:lineRule="auto"/><w:ind w:firstLine="0"/><w:jc w:val="left"/>', '<w:spacing w:val="-10"/><w:kern w:val="28"/><w:sz w:val="56"/><w:szCs w:val="56"/>')}
${pst('Subtitle', 'Subtitle', '<w:ind w:firstLine="0"/><w:jc w:val="left"/>', '<w:color w:val="5A5A5A"/><w:spacing w:val="15"/>')}
${pst('NoSpacing', 'No Spacing', '<w:spacing w:before="0" w:after="0" w:line="240" w:lineRule="auto"/>', '')}
${pst('Quote', 'Quote', '<w:spacing w:before="200" w:after="160"/><w:ind w:left="567" w:right="567" w:firstLine="0"/><w:jc w:val="center"/>', '<w:i/><w:iCs/><w:color w:val="404040"/>')}
${pst('IntenseQuote', 'Intense Quote', '<w:pBdr><w:top w:val="single" w:sz="4" w:space="10" w:color="4472C4"/><w:bottom w:val="single" w:sz="4" w:space="10" w:color="4472C4"/></w:pBdr><w:spacing w:before="360" w:after="360"/><w:ind w:left="864" w:right="864" w:firstLine="0"/><w:jc w:val="center"/>', '<w:i/><w:iCs/><w:color w:val="4472C4"/>')}
${pst('Code', 'Code', '<w:shd w:val="clear" w:color="auto" w:fill="F4F4F4"/><w:spacing w:after="0" w:line="240" w:lineRule="auto"/><w:ind w:firstLine="0"/><w:jc w:val="left"/>', '<w:rFonts w:ascii="Consolas" w:hAnsi="Consolas" w:cs="Consolas"/><w:sz w:val="20"/><w:szCs w:val="20"/>')}
${pst('ListParagraph', 'List Paragraph', '<w:ind w:firstLine="0"/><w:contextualSpacing/>', '')}
${pst('TOCHeading', 'TOC Heading', '<w:spacing w:before="240" w:after="120"/><w:ind w:firstLine="0"/><w:jc w:val="left"/>', '<w:color w:val="2F5496"/><w:sz w:val="28"/>')}
${[1, 2, 3, 4].map(i => pst('TOC' + i, 'toc ' + i, `<w:spacing w:after="60"/><w:ind w:left="${(i - 1) * 340}" w:firstLine="0"/><w:jc w:val="left"/>`, '')).join('')}
${pst('Header', 'header', '<w:spacing w:after="0" w:line="240" w:lineRule="auto"/><w:ind w:firstLine="0"/>', '<w:sz w:val="18"/>')}
${pst('Footer', 'footer', '<w:spacing w:after="0" w:line="240" w:lineRule="auto"/><w:ind w:firstLine="0"/>', '<w:sz w:val="18"/>')}
<w:style w:type="character" w:styleId="Hyperlink"><w:name w:val="Hyperlink"/><w:rPr><w:color w:val="0563C1"/><w:u w:val="single"/></w:rPr></w:style>
<w:style w:type="table" w:default="1" w:styleId="TableNormal"><w:name w:val="Normal Table"/><w:semiHidden/><w:tblPr><w:tblInd w:w="0" w:type="dxa"/><w:tblCellMar><w:top w:w="0" w:type="dxa"/><w:left w:w="108" w:type="dxa"/><w:bottom w:w="0" w:type="dxa"/><w:right w:w="108" w:type="dxa"/></w:tblCellMar></w:tblPr></w:style>
<w:style w:type="table" w:styleId="TableGrid"><w:name w:val="Table Grid"/><w:basedOn w:val="TableNormal"/><w:pPr><w:spacing w:after="0" w:line="240" w:lineRule="auto"/></w:pPr><w:tblPr><w:tblBorders><w:top w:val="single" w:sz="4" w:space="0" w:color="auto"/><w:left w:val="single" w:sz="4" w:space="0" w:color="auto"/><w:bottom w:val="single" w:sz="4" w:space="0" w:color="auto"/><w:right w:val="single" w:sz="4" w:space="0" w:color="auto"/><w:insideH w:val="single" w:sz="4" w:space="0" w:color="auto"/><w:insideV w:val="single" w:sz="4" w:space="0" w:color="auto"/></w:tblBorders></w:tblPr></w:style>
</w:styles>`;
  }
  /* ---------- сборка пакета ---------- */
  async function build() {
    if (!window.JSZip) throw new Error('Библиотека JSZip не загружена (нет интернета?)');
    const ctx = new Ctx();
    const body = await blocksXml(Array.from(editor.childNodes), ctx, {});
    const zip = new JSZip();
    const p = state.page, d = dims();
    const hf = state.hf;
    let refs = '', extraCT = '';
    const addHF = (tag, type, o, n) => {
      const file = `${tag === 'hdr' ? 'header' : 'footer'}${n}.xml`;
      zip.file('word/' + file, hfXml(tag, o));
      const rid = ctx.rel(`http://schemas.openxmlformats.org/officeDocument/2006/relationships/${tag === 'hdr' ? 'header' : 'footer'}`, file);
      refs += `<w:${tag === 'hdr' ? 'header' : 'footer'}Reference w:type="${type}" r:id="${rid}"/>`;
      extraCT += `<Override PartName="/word/${file}" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.${tag === 'hdr' ? 'header' : 'footer'}+xml"/>`;
    };
    if (hasHF(hf.header)) addHF('hdr', 'default', hf.header, 1);
    if (hasHF(hf.footer)) addHF('ftr', 'default', hf.footer, 1);
    if (hf.differentFirst) { addHF('hdr', 'first', hf.first.header, 2); addHF('ftr', 'first', hf.first.footer, 2); }
    const W = Math.round(d.wmm * 56.6929), H = Math.round(d.hmm * 56.6929), m = p.margins, t = v => Math.round(v * 56.6929);
    const bgColor = colorHex(p.color);
    const sect = `<w:sectPr>${refs}<w:pgSz w:w="${W}" w:h="${H}"${p.landscape ? ' w:orient="landscape"' : ''}/><w:pgMar w:top="${t(m.top)}" w:right="${t(m.right)}" w:bottom="${t(m.bottom)}" w:left="${t(m.left)}" w:header="${t(p.header)}" w:footer="${t(p.footer)}" w:gutter="0"/><w:cols w:space="708"/>${hf.differentFirst ? '<w:titlePg/>' : ''}<w:docGrid w:linePitch="360"/></w:sectPr>`;
    const docBg = bgColor && bgColor !== 'FFFFFF' ? `<w:background w:color="${bgColor}"/>` : '';
    zip.file('word/document.xml', `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:document ${NS}>${docBg}<w:body>${body}${sect}</w:body></w:document>`);
    zip.file('word/styles.xml', stylesXml());
    zip.file('word/settings.xml', `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:settings xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">${docBg ? '<w:displayBackgroundShape/>' : ''}<w:defaultTabStop w:val="709"/><w:characterSpacingControl w:val="doNotCompress"/><w:compat><w:compatSetting w:name="compatibilityMode" w:uri="http://schemas.microsoft.com/office/word" w:val="15"/></w:compat><w:themeFontLang w:val="ru-RU"/></w:settings>`);
    const numXml = ctx.abstracts.map(a => a.xml).join('') + ctx.nums.join('');
    zip.file('word/numbering.xml', `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:numbering xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">${numXml}</w:numbering>`);
    ctx.media.forEach(mm => zip.file('word/media/' + mm.name, mm.buf));
    const rels = [
      `<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/>`,
      `<Relationship Id="rId2" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/settings" Target="settings.xml"/>`,
      `<Relationship Id="rId3" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/numbering" Target="numbering.xml"/>`,
      ...ctx.rels.map(r => `<Relationship Id="${r.id}" Type="${r.type}" Target="${xe(r.target)}"${r.ext ? ' TargetMode="External"' : ''}/>`)
    ];
    zip.file('word/_rels/document.xml.rels', `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">${rels.join('')}</Relationships>`);
    zip.file('_rels/.rels', `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="word/document.xml"/><Relationship Id="rId2" Type="http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties" Target="docProps/core.xml"/><Relationship Id="rId3" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/extended-properties" Target="docProps/app.xml"/></Relationships>`);
    const now = new Date().toISOString().replace(/\.\d+Z$/, 'Z');
    zip.file('docProps/core.xml', `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><cp:coreProperties xmlns:cp="http://schemas.openxmlformats.org/package/2006/metadata/core-properties" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><dc:title>${xe(state.title)}</dc:title><dc:subject>${xe(state.props.subject || '')}</dc:subject><dc:creator>${xe(state.props.author || '')}</dc:creator><cp:keywords>${xe(state.props.keywords || '')}</cp:keywords><dcterms:created xsi:type="dcterms:W3CDTF">${now}</dcterms:created><dcterms:modified xsi:type="dcterms:W3CDTF">${now}</dcterms:modified></cp:coreProperties>`);
    zip.file('docProps/app.xml', `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Properties xmlns="http://schemas.openxmlformats.org/officeDocument/2006/extended-properties"><Application>Листик</Application><Pages>${pageCount}</Pages></Properties>`);
    zip.file('[Content_Types].xml', `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Default Extension="png" ContentType="image/png"/><Default Extension="jpeg" ContentType="image/jpeg"/><Default Extension="gif" ContentType="image/gif"/><Default Extension="bmp" ContentType="image/bmp"/><Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/><Override PartName="/word/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.styles+xml"/><Override PartName="/word/settings.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.settings+xml"/><Override PartName="/word/numbering.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.numbering+xml"/><Override PartName="/docProps/core.xml" ContentType="application/vnd.openxmlformats-package.core-properties+xml"/><Override PartName="/docProps/app.xml" ContentType="application/vnd.openxmlformats-officedocument.extended-properties+xml"/>${extraCT}</Types>`);
    return zip.generateAsync({ type: 'blob', mimeType: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', compression: 'DEFLATE' });
  }
  return { build, colorHex, lenPx };
})();
/* =====================================================================
   ИМПОРТ DOCX (собственный разбор WordprocessingML; при ошибке — mammoth)
   Переносит: размер бумаги, ориентацию, поля, колонтитулы, шрифт и
   интервалы по умолчанию, стили заголовков, выравнивание, отступы,
   интервалы, шрифты/размеры/цвета/выделение, списки, таблицы с
   объединёнными ячейками и заливкой, ширины столбцов, рисунки,
   ссылки, закладки, разрывы страниц.
   ===================================================================== */
const DOCXIN = (() => {
  const W = 'http://schemas.openxmlformats.org/wordprocessingml/2006/main';
  const kids = (el, name) => el ? Array.from(el.children).filter(c => c.localName === name) : [];
  const kid = (el, name) => el ? Array.from(el.children).find(c => c.localName === name) || null : null;
  const at = (el, name) => el ? (el.getAttributeNS(W, name) ?? el.getAttribute('w:' + name) ?? el.getAttribute(name)) : null;
  const val = (el, name) => at(kid(el, name), 'val');
  const onOff = (el, name) => { const k = kid(el, name); if (!k) return undefined; const v = at(k, 'val'); return !(v === '0' || v === 'false' || v === 'off'); };
  const HL = { yellow: '#ffff00', green: '#00ff00', cyan: '#00ffff', magenta: '#ff00ff', blue: '#0000ff', red: '#ff0000', darkBlue: '#000080', darkCyan: '#008080', darkGreen: '#008000', darkMagenta: '#800080', darkRed: '#800000', darkYellow: '#808000', darkGray: '#808080', lightGray: '#c0c0c0', black: '#000000', white: '#ffffff' };
  const twPx = v => parseFloat(v) / 15;

  function parsePPr(p) {
    const o = {}; if (!p) return o;
    const jc = val(p, 'jc'); if (jc) o.align = { both: 'justify', distribute: 'justify', center: 'center', right: 'right', end: 'right', left: 'left', start: 'left' }[jc] || 'left';
    const ind = kid(p, 'ind');
    if (ind) {
      const l = at(ind, 'left') ?? at(ind, 'start'), r = at(ind, 'right') ?? at(ind, 'end'), f = at(ind, 'firstLine'), h = at(ind, 'hanging');
      if (l !== null) o.left = twPx(l); if (r !== null) o.right = twPx(r);
      if (h !== null) o.first = -twPx(h); else if (f !== null) o.first = twPx(f);
    }
    const sp = kid(p, 'spacing');
    if (sp) {
      const b = at(sp, 'before'), a = at(sp, 'after'), ln = at(sp, 'line'), rule = at(sp, 'lineRule');
      if (b !== null && at(sp, 'beforeAutospacing') !== '1') o.before = parseFloat(b) / 20;
      if (a !== null && at(sp, 'afterAutospacing') !== '1') o.after = parseFloat(a) / 20;
      if (ln !== null) o.line = (!rule || rule === 'auto') ? { mult: parseFloat(ln) / 240 } : { px: twPx(ln), rule };
    }
    if (kid(p, 'contextualSpacing')) o.contextual = true;
    const shd = kid(p, 'shd'); if (shd) { const f = at(shd, 'fill'); if (f && f !== 'auto' && f !== 'FFFFFF') o.shd = '#' + f; }
    if (onOff(p, 'pageBreakBefore')) o.pbb = true;
    const np = kid(p, 'numPr');
    if (np) o.num = { id: val(np, 'numId'), lvl: parseInt(val(np, 'ilvl') || '0') };
    const ol = val(p, 'outlineLvl'); if (ol !== null) o.outline = parseInt(ol);
    return o;
  }
  function parseRPr(r, theme) {
    const o = {}; if (!r) return o;
    const b = onOff(r, 'b'); if (b !== undefined) o.b = b;
    const i = onOff(r, 'i'); if (i !== undefined) o.i = i;
    const u = kid(r, 'u'); if (u) o.u = at(u, 'val') !== 'none';
    const s = onOff(r, 'strike'), ds = onOff(r, 'dstrike'); if (s !== undefined || ds !== undefined) o.strike = !!(s || ds);
    const caps = onOff(r, 'caps'); if (caps !== undefined) o.caps = caps;
    const sc = onOff(r, 'smallCaps'); if (sc !== undefined) o.smallCaps = sc;
    if (onOff(r, 'vanish')) o.hidden = true;
    const c = val(r, 'color'); if (c && c !== 'auto') o.color = '#' + c;
    const sz = val(r, 'sz'); if (sz) o.sz = parseFloat(sz) / 2;
    const f = kid(r, 'rFonts');
    if (f) {
      let name = at(f, 'ascii') || at(f, 'hAnsi') || at(f, 'cs') || at(f, 'eastAsia');
      const th = at(f, 'asciiTheme') || at(f, 'hAnsiTheme');
      if (!name && th && theme) name = /major/i.test(th) ? theme.major : theme.minor;
      if (name) o.font = name;
    }
    const hl = val(r, 'highlight'); if (hl && hl !== 'none' && HL[hl]) o.bg = HL[hl];
    const shd = kid(r, 'shd'); if (shd && !o.bg) { const fl = at(shd, 'fill'); if (fl && fl !== 'auto' && fl !== 'FFFFFF') o.bg = '#' + fl; }
    const va = val(r, 'vertAlign'); if (va === 'superscript' || va === 'subscript') o.vert = va;
    const rs = val(r, 'rStyle'); if (rs) o.rStyle = rs;
    return o;
  }
  async function parse(buf) {
    const zip = await JSZip.loadAsync(buf);
    const read = async p => { const f = zip.file(p); return f ? f.async('string') : null; };
    const xml = s => new DOMParser().parseFromString(s, 'application/xml');
    const docStr = await read('word/document.xml'); if (!docStr) throw new Error('word/document.xml не найден');
    const doc = xml(docStr);
    const relsOf = async path => {
      const s = await read(path); const m = {};
      if (s) Array.from(xml(s).getElementsByTagName('Relationship')).forEach(r => m[r.getAttribute('Id')] = { t: r.getAttribute('Target'), ext: r.getAttribute('TargetMode') === 'External', type: r.getAttribute('Type') });
      return m;
    };
    const rels = await relsOf('word/_rels/document.xml.rels');
    // тема
    let theme = { major: 'Calibri Light', minor: 'Calibri' };
    const thStr = await read('word/theme/theme1.xml');
    if (thStr) {
      const t = xml(thStr);
      const mj = t.getElementsByTagNameNS('http://schemas.openxmlformats.org/drawingml/2006/main', 'majorFont')[0];
      const mn = t.getElementsByTagNameNS('http://schemas.openxmlformats.org/drawingml/2006/main', 'minorFont')[0];
      const lat = el => el && Array.from(el.children).find(c => c.localName === 'latin');
      if (lat(mj)) theme.major = lat(mj).getAttribute('typeface') || theme.major;
      if (lat(mn)) theme.minor = lat(mn).getAttribute('typeface') || theme.minor;
    }
    // стили
    const styles = {}; let defP = {}, defR = {}, defaultPStyle = 'Normal';
    const stStr = await read('word/styles.xml');
    if (stStr) {
      const st = xml(stStr);
      const dd = st.getElementsByTagNameNS(W, 'docDefaults')[0];
      if (dd) {
        defR = parseRPr(kid(kid(dd, 'rPrDefault'), 'rPr'), theme);
        defP = parsePPr(kid(kid(dd, 'pPrDefault'), 'pPr'));
      }
      Array.from(st.getElementsByTagNameNS(W, 'style')).forEach(s => {
        const id = at(s, 'styleId');
        styles[id] = { id, type: at(s, 'type'), name: (val(s, 'name') || '').toLowerCase(), basedOn: val(s, 'basedOn'),
          p: parsePPr(kid(s, 'pPr')), r: parseRPr(kid(s, 'rPr'), theme) };
        if (at(s, 'default') === '1' && at(s, 'type') === 'paragraph') defaultPStyle = id;
      });
    }
    const resolve = (id, depth = 0) => {
      const s = styles[id]; if (!s || depth > 20) return { p: {}, r: {}, chain: [] };
      const base = s.basedOn ? resolve(s.basedOn, depth + 1) : { p: {}, r: {}, chain: [] };
      return { p: Object.assign({}, base.p, s.p), r: Object.assign({}, base.r, s.r), chain: [s, ...base.chain] };
    };
    const normal = resolve(defaultPStyle);
    const D = { p: Object.assign({}, defP, normal.p), r: Object.assign({}, defR, normal.r) };
    // нумерация
    const nums = {}, abstracts = {};
    const nStr = await read('word/numbering.xml');
    if (nStr) {
      const nd = xml(nStr);
      Array.from(nd.getElementsByTagNameNS(W, 'abstractNum')).forEach(a => {
        const lv = {};
        kids(a, 'lvl').forEach(l => lv[at(l, 'ilvl')] = { fmt: val(l, 'numFmt') || 'decimal', text: val(l, 'lvlText') || '', start: parseInt(val(l, 'start') || '1') });
        abstracts[at(a, 'abstractNumId')] = lv;
      });
      Array.from(nd.getElementsByTagNameNS(W, 'num')).forEach(n => {
        const lv = Object.assign({}, abstracts[val(n, 'abstractNumId')] || {});
        kids(n, 'lvlOverride').forEach(o => { const il = at(o, 'ilvl'), so = val(o, 'startOverride'); if (so && lv[il]) lv[il] = Object.assign({}, lv[il], { start: parseInt(so) }); });
        nums[at(n, 'numId')] = lv;
      });
    }
    // медиа
    const mediaCache = {};
    const mediaUrl = async target => {
      if (mediaCache[target]) return mediaCache[target];
      const path = target.startsWith('/') ? target.slice(1) : 'word/' + target.replace(/^\.\//, '');
      const f = zip.file(path); if (!f) return null;
      const b64 = await f.async('base64');
      const ext = path.split('.').pop().toLowerCase();
      const mime = { png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', gif: 'image/gif', bmp: 'image/bmp', svg: 'image/svg+xml', webp: 'image/webp', tif: 'image/tiff', tiff: 'image/tiff', emf: 'image/emf', wmf: 'image/wmf' }[ext] || 'image/png';
      if (ext === 'emf' || ext === 'wmf') return null;
      return (mediaCache[target] = `data:${mime};base64,${b64}`);
    };

    /* --- CSS из свойств --- */
    const fmtRun = (eff, base) => {
      const css = [];
      if (eff.font && eff.font !== base.font) css.push(`font-family:'${eff.font.replace(/'/g, '')}'`);
      const sz = eff.vert ? null : eff.sz;
      if (sz && Math.abs(sz - base.sz) > 0.01) css.push(`font-size:${sz}pt`);
      const col = (eff.color || '#000000').toLowerCase();
      if (col !== base.color) css.push(`color:${col}`);
      if (eff.bg) css.push(`background-color:${eff.bg}`);
      if (!!eff.b !== !!base.b) css.push(eff.b ? 'font-weight:bold' : 'font-weight:normal');
      if (!!eff.i !== !!base.i) css.push(eff.i ? 'font-style:italic' : 'font-style:normal');
      const deco = [eff.u ? 'underline' : '', eff.strike ? 'line-through' : ''].filter(Boolean).join(' ');
      if (deco) css.push('text-decoration:' + deco);
      if (eff.vert) css.push(`vertical-align:${eff.vert === 'superscript' ? 'super' : 'sub'};font-size:${round((eff.sz || base.sz) * 0.65, 1)}pt`);
      if (eff.caps) css.push('text-transform:uppercase');
      if (eff.smallCaps) css.push('font-variant:small-caps');
      return css.join(';');
    };
    const baseFor = level => {
      const b = { font: D.r.font || theme.minor, sz: D.r.sz || 11, color: '#000000', b: false, i: false };
      if (typeof level === 'number') Object.assign(b, { sz: [0, 16, 13, 12, D.r.sz || 11][level], color: level === 3 ? '#1f3763' : '#2f5496', i: level === 4 });
      else if (level === 'title') b.sz = 28;
      else if (level === 'subtitle') b.color = '#5a5a5a';
      else if (level === 'quote') Object.assign(b, { i: true, color: '#404040' });
      else if (level === 'iquote') Object.assign(b, { i: true, color: '#4472c4' });
      return b;
    };
    const pCss = (pp, isHeading) => {
      const css = [];
      if (pp.align && (pp.align !== (D.p.align || 'left') || isHeading)) css.push(`text-align:${pp.align}`);
      if (pp.left && Math.abs(pp.left) > 0.5) css.push(`margin-left:${round(pp.left / MM / 10, 2)}cm`);
      if (pp.right && Math.abs(pp.right) > 0.5) css.push(`margin-right:${round(pp.right / MM / 10, 2)}cm`);
      if (pp.first !== undefined && Math.abs(pp.first - (D.p.first || 0)) > 0.5) css.push(`text-indent:${round(pp.first / MM / 10, 2)}cm`);
      if (pp.before !== undefined && pp.before !== (D.p.before || 0)) css.push(`margin-top:${pp.before}pt`);
      if (pp.after !== undefined && pp.after !== (D.p.after || 0)) css.push(`margin-bottom:${pp.after}pt`);
      if (pp.contextual && pp.after) css.push('margin-bottom:0');
      if (pp.line) {
        if (pp.line.mult) { if (Math.abs(pp.line.mult - (D.p.line && D.p.line.mult || 1.15)) > 0.01) css.push(`line-height:${round(pp.line.mult, 2)}`); }
        else css.push(`line-height:${round(pp.line.px, 1)}px`);
      }
      if (pp.shd) css.push(`background-color:${pp.shd}`);
      return css.join(';');
    };
    const headingLevel = chain => {
      for (const s of chain) {
        const m = s.name.match(/^(heading|заголовок)\s*(\d)$/) || s.id.match(/^Heading(\d)$/i) && [0, 0, s.id.match(/\d/)[0]];
        if (m) return Math.min(4, parseInt(m[2]));
        if (s.name === 'title') return 'title';
        if (s.name === 'subtitle') return 'subtitle';
        if (s.name === 'quote') return 'quote';
        if (s.name === 'intense quote') return 'iquote';
        if (s.name === 'no spacing') return 'nospace';
      }
      return null;
    };

    /* --- runs --- */
    let pendingBreak = false;
    async function runsHtml(parent, pr, ctx) {
      let html = '';
      for (const n of Array.from(parent.children)) {
        const ln = n.localName;
        if (ln === 'r') html += await runHtml(n, pr, ctx);
        else if (ln === 'hyperlink') {
          const rid = n.getAttributeNS('http://schemas.openxmlformats.org/officeDocument/2006/relationships', 'id') || n.getAttribute('r:id');
          const anchor = at(n, 'anchor');
          const href = rid && rels[rid] ? rels[rid].t : anchor ? '#' + anchor : null;
          const inner = await runsHtml(n, pr, ctx);
          html += href ? `<a href="${esc(href)}">${inner}</a>` : inner;
        }
        else if (ln === 'ins' || ln === 'smartTag' || ln === 'customXml' || ln === 'fldSimple' || ln === 'dir' || ln === 'bdo') html += await runsHtml(n, pr, ctx);
        else if (ln === 'sdt') html += await runsHtml(kid(n, 'sdtContent') || n, pr, ctx);
        else if (ln === 'bookmarkStart') { const nm = at(n, 'name'); if (nm && !nm.startsWith('_')) html += `<a id="${esc(nm)}"></a>`; }
        else if (ln === 'oMath' || ln === 'oMathPara') html += esc(n.textContent);
      }
      return html;
    }
    async function runHtml(r, pr, ctx) {
      const rpr = kid(r, 'rPr');
      const own = parseRPr(rpr, theme);
      let st = {};
      if (own.rStyle) st = resolve(own.rStyle).r;
      const eff = Object.assign({}, pr.r, st, own);
      if (eff.hidden) return '';
      let text = '';
      for (const c of Array.from(r.children)) {
        const ln = c.localName;
        if (ln === 't') text += esc(c.textContent);
        else if (ln === 'tab' || ln === 'ptab') text += '\t';
        else if (ln === 'br') { const t = at(c, 'type'); if (t === 'page') { pendingBreak = true; text += '\u0001'; } else if (t !== 'column') text += '<br>'; }
        else if (ln === 'cr') text += '<br>';
        else if (ln === 'noBreakHyphen') text += '‑';
        else if (ln === 'softHyphen') text += '\u00ad';
        else if (ln === 'sym') { const ch = parseInt(at(c, 'char'), 16); if (ch) text += esc(String.fromCharCode(ch >= 0xF000 ? ch - 0xF000 : ch)); }
        else if (ln === 'fldChar') { const t = at(c, 'fldCharType'); if (t === 'begin') ctx.fld = 'instr'; else if (t === 'separate') ctx.fld = 'result'; else if (t === 'end') ctx.fld = null; }
        else if (ln === 'instrText') { /* код поля — пропускаем */ }
        else if (ln === 'drawing' || ln === 'pict' || ln === 'object') text += await drawingHtml(c);
        else if (ln === 'AlternateContent') { const fb = c.getElementsByTagNameNS(W, 'drawing')[0] || c.getElementsByTagName('w:pict')[0]; if (fb) text += await drawingHtml(fb); }
      }
      if (ctx.fld === 'instr') return '';
      if (!text) return '';
      const css = fmtRun(eff, pr.base);
      return css ? `<span style="${css}">${text}</span>` : text;
    }
    async function drawingHtml(d) {
      const blip = d.getElementsByTagNameNS('http://schemas.openxmlformats.org/drawingml/2006/main', 'blip')[0];
      let rid = blip && (blip.getAttributeNS('http://schemas.openxmlformats.org/officeDocument/2006/relationships', 'embed') || blip.getAttribute('r:embed'));
      if (!rid) { const im = d.getElementsByTagName('v:imagedata')[0]; if (im) rid = im.getAttribute('r:id'); }
      if (!rid || !rels[rid]) return '';
      const src = await mediaUrl(rels[rid].t); if (!src) return '';
      const ext = d.getElementsByTagNameNS('http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing', 'extent')[0];
      let w = ext ? parseInt(ext.getAttribute('cx')) / 9525 : null;
      const anchor = d.getElementsByTagNameNS('http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing', 'anchor')[0];
      let cls = '';
      if (anchor) {
        const al = anchor.getElementsByTagNameNS('http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing', 'align')[0];
        const wrapSq = anchor.getElementsByTagNameNS('http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing', 'wrapSquare')[0] || anchor.getElementsByTagNameNS('http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing', 'wrapTight')[0];
        const a = al ? al.textContent : '';
        if (wrapSq) cls = a === 'right' ? 'img-right' : 'img-left'; else cls = 'img-center';
      }
      const docPr = d.getElementsByTagNameNS('http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing', 'docPr')[0];
      const alt = docPr ? docPr.getAttribute('descr') || '' : '';
      return `<img src="${src}" alt="${esc(alt)}"${cls ? ` class="${cls}"` : ''}${w ? ` style="width:${Math.round(w)}px"` : ''}>`;
    }

    /* --- абзацы --- */
    async function paragraph(p) {
      const ppEl = kid(p, 'pPr');
      const own = parsePPr(ppEl);
      const sid = val(ppEl, 'pStyle') || defaultPStyle;
      const sr = resolve(sid);
      const pp = Object.assign({}, D.p, sr.p, own);
      const level = headingLevel(sr.chain);
      const special = level !== null && level !== 'nospace';
      const ctx = { fld: null };
      pendingBreak = false;
      const html = await runsHtml(p, { r: Object.assign({}, D.r, sr.r), base: baseFor(level) }, ctx);
      const num = own.num || sr.p.num;
      const cssProps = special ? Object.assign({}, own, { align: own.align || sr.p.align }) : Object.assign({}, sr.p, own);
      return { pp, level, html: html.split('\u0001'), brk: pendingBreak, num, css: pCss(cssProps, special), pbb: pp.pbb };
    }
    const wrapP = (info, inner) => {
      const css = info.css ? ` style="${info.css}"` : '';
      const body = inner && inner.replace(/<a id="[^"]*"><\/a>/g, '').trim() ? inner : (inner || '') + '<br>';
      const lv = info.level;
      if (typeof lv === 'number') return `<h${lv} id="h-${Math.random().toString(36).slice(2, 8)}"${css}>${body}</h${lv}>`;
      if (lv === 'title') return `<p class="doc-title"${css}>${body}</p>`;
      if (lv === 'subtitle') return `<p class="doc-subtitle"${css}>${body}</p>`;
      if (lv === 'quote') return `<blockquote${css}>${body}</blockquote>`;
      if (lv === 'iquote') return `<blockquote class="intense"${css}>${body}</blockquote>`;
      if (lv === 'nospace') return `<p class="no-spacing"${css}>${body}</p>`;
      return `<p${css}>${body}</p>`;
    };
    const BREAK = '<div class="manual-break" contenteditable="false"></div>';

    async function bodyHtml(container, inCell) {
      let out = '';
      let stack = []; // {kind, lvl, numId, html: [] }
      const closeAll = () => { while (stack.length) closeTop(); };
      const closeTop = () => {
        const top = stack.pop();
        const html = `<${top.kind}${top.attrs}>${top.items.join('')}</${top.kind}>`;
        if (stack.length) { const p = stack[stack.length - 1]; if (p.items.length) p.items[p.items.length - 1] = p.items[p.items.length - 1].replace(/<\/li>$/, html + '</li>'); else p.items.push(`<li>${html}</li>`); }
        else out += html;
      };
      for (const el of Array.from(container.children)) {
        const ln = el.localName;
        if (ln === 'p') {
          const info = await paragraph(el);
          const lvDef = info.num && nums[info.num.id] && nums[info.num.id][info.num.lvl];
          if (lvDef && lvDef.fmt !== 'none' && info.num.id !== '0') {
            const lvl = info.num.lvl, kind = lvDef.fmt === 'bullet' ? 'ul' : 'ol';
            while (stack.length && stack[stack.length - 1].lvl > lvl) closeTop();
            if (stack.length && stack[stack.length - 1].lvl === lvl && (stack[stack.length - 1].numId !== info.num.id || stack[stack.length - 1].kind !== kind)) closeTop();
            if (!stack.length || stack[stack.length - 1].lvl < lvl) {
              let attrs = '';
              if (kind === 'ol') {
                const t = { lowerLetter: 'lower-alpha', upperLetter: 'upper-alpha', lowerRoman: 'lower-roman', upperRoman: 'upper-roman', russianLower: 'lower-alpha', russianUpper: 'upper-alpha' }[lvDef.fmt];
                if (lvl > 0 && /%1\.%2/.test(lvDef.text)) attrs += '';
                if (t) attrs += ` style="list-style-type:${t}"`;
                if (lvDef.start && lvDef.start !== 1) attrs += ` start="${lvDef.start}"`;
                if (lvl === 0) { const l1 = nums[info.num.id][1]; if (l1 && /%1\.%2/.test(l1.text)) attrs += ' class="multi"'; }
              } else {
                if (/^[–—-]/.test(lvDef.text)) attrs += ' class="dash"';
                else if (lvDef.text === 'o') attrs += ' style="list-style-type:circle"';
                else if (/[▪§\uF0A7]/.test(lvDef.text)) attrs += ' style="list-style-type:square"';
              }
              stack.push({ kind, lvl, numId: info.num.id, items: [], attrs });
            }
            const css = info.css.replace(/margin-left:[^;]+;?|text-indent:[^;]+;?/g, '').replace(/;$/, '');
            stack[stack.length - 1].items.push(`<li${css ? ` style="${css}"` : ''}>${info.html.join('') || '<br>'}</li>`);
            continue;
          }
          closeAll();
          if (info.pbb && !inCell && out) out += BREAK;
          info.html.forEach((h, i) => {
            if (i > 0) out += BREAK;
            if (i > 0 && !h.trim()) return;
            if (i === 0 && !h.trim() && info.html.length > 1 && info.brk) return;
            out += wrapP(info, h);
          });
        } else if (ln === 'tbl') { closeAll(); out += await tableHtml(el); }
        else if (ln === 'sdt') { closeAll(); out += await bodyHtml(kid(el, 'sdtContent') || el, inCell); }
        else if (ln === 'customXml') { closeAll(); out += await bodyHtml(el, inCell); }
      }
      closeAll();
      return out;
    }
    async function tableHtml(tbl) {
      const grid = kids(kid(tbl, 'tblGrid'), 'gridCol').map(g => parseFloat(at(g, 'w')) || 0);
      const tblPr = kid(tbl, 'tblPr');
      const borders = kid(tblPr, 'tblBorders');
      const styleId = val(tblPr, 'tblStyle');
      let noBorders = false;
