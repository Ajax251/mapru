  for (const h of rulerHits.v) { const dy = Math.abs(h.y - y); if (dy <= 5 && (!best || dy < best.dy)) best = { ...h, dy }; }
  return best;
}
const RULER_NAMES = { ml: 'Левое поле', mr: 'Правое поле', mt: 'Верхнее поле', mb: 'Нижнее поле', first: 'Отступ первой строки',
  hang: 'Выступ', lbox: 'Отступ слева', rind: 'Отступ справа', col: 'Граница столбца' };
function showTip(text, clientX, clientY) {
  const tip = $('rulerTip'), a = $('docArea').getBoundingClientRect();
  tip.textContent = text; tip.style.display = 'block';
  tip.style.left = clamp(clientX - a.left + 12, 0, a.width - 160) + 'px'; tip.style.top = (clientY - a.top + 14) + 'px';
}
function hideTip() { $('rulerTip').style.display = 'none'; }
function guide(kind, client) {
  const a = $('docArea').getBoundingClientRect();
  const gv = $('guideV'), gh = $('guideH');
  if (kind === 'v') { gv.style.display = 'block'; gv.style.left = (client - a.left) + 'px'; }
  else if (kind === 'h') { gh.style.display = 'block'; gh.style.top = (client - a.top) + 'px'; }
  else { gv.style.display = gh.style.display = 'none'; }
}
const snap = (v, origin, alt) => alt ? v : origin + Math.round((v - origin) / mm2px(2.5)) * mm2px(2.5);

rulerH.addEventListener('mousemove', e => {
  if (rulerDrag) return;
  const h = hitH(e);
  rulerH.style.cursor = h ? (h.prio >= 5 ? 'pointer' : 'ew-resize') : 'default';
  if (h) showTip(RULER_NAMES[h.kind], e.clientX, e.clientY); else hideTip();
});
rulerV.addEventListener('mousemove', e => {
  if (rulerDrag) return;
  const h = hitV(e); rulerV.style.cursor = h ? 'ns-resize' : 'default';
  if (h) showTip(RULER_NAMES[h.kind], e.clientX, e.clientY); else hideTip();
});
rulerH.addEventListener('mouseleave', () => { if (!rulerDrag) hideTip(); });
rulerV.addEventListener('mouseleave', () => { if (!rulerDrag) hideTip(); });
rulerH.addEventListener('dblclick', () => openPageSetup());
rulerV.addEventListener('dblclick', () => openPageSetup());

rulerH.addEventListener('mousedown', e => {
  const h = hitH(e); if (!h || e.button !== 0) return;
  e.preventDefault();
  const { ws, s, d } = wsGeom();
  const toPage = cx => (cx - ws.left) / s;
  const m = state.page.margins;
  const start = { ml: m.left, mr: m.right };
  let blocks = [], colDrag = null, info = h.info;
  if (h.info) blocks = selectedBlocks().filter(b => b.tagName !== 'TD' && b.tagName !== 'TH');
  if (h.kind === 'col') colDrag = startColResize(h.table, h.idx);
  const startX = e.clientX;
  const move = ev => {
    const alt = ev.altKey;
    let px = toPage(ev.clientX);
    let label = '';
    switch (h.kind) {
      case 'ml': {
        px = snap(px, 0, alt);
        m.left = round(clamp(px2mm(px), 0, d.wmm - m.right - 20), 1);
        label = 'Левое поле: ' + cm(m.left); applyPageLight(); break; }
      case 'mr': {
        px = snap(px, 0, alt);
        m.right = round(clamp(d.wmm - px2mm(px), 0, d.wmm - m.left - 20), 1);
        label = 'Правое поле: ' + cm(m.right); applyPageLight(); break; }
      case 'first': {
        px = snap(px, info.baseL, alt);
        blocks.forEach(b => setIndent(b, null, px - (info.baseL + parseFloat(getComputedStyle(b).marginLeft || 0)), null));
        label = 'Первая строка: ' + cm(px2mm(px - info.left)); break; }
      case 'hang': {
        px = snap(px, info.baseL, alt);
        const newMl = px - info.baseL;
        blocks.forEach(b => setIndent(b, newMl, info.first - info.baseL - newMl, null));
        label = 'Выступ: ' + cm(px2mm(info.first - px)); break; }
      case 'lbox': {
        px = snap(px, info.baseL, alt);
        const newMl = px - info.baseL;
        blocks.forEach(b => setIndent(b, newMl, null, null));
        label = 'Отступ слева: ' + cm(px2mm(newMl)); break; }
      case 'rind': {
        px = snap(px, info.baseR, alt);
        const mr = info.baseR - px;
        blocks.forEach(b => setIndent(b, null, null, mr));
        label = 'Отступ справа: ' + cm(px2mm(mr)); break; }
      case 'col': {
        colDrag.move((ev.clientX - startX) / s);
        label = 'Столбец'; break; }
    }
    guide('v', ev.clientX);
    showTip(label, ev.clientX, ev.clientY);
    drawRulers();
  };
  const up = () => {
    document.removeEventListener('mousemove', move); document.removeEventListener('mouseup', up);
    rulerDrag = null; guide(null); hideTip();
    if (colDrag) colDrag.end();
    if (h.kind === 'ml' || h.kind === 'mr') { if (start.ml !== m.left || start.mr !== m.right) { applyPage(); markDirty(false); autosave(); } }
    else changed();
  };
  rulerDrag = h;
  document.addEventListener('mousemove', move); document.addEventListener('mouseup', up);
  move(e);
});
rulerV.addEventListener('mousedown', e => {
  const h = hitV(e); if (!h || e.button !== 0) return;
  e.preventDefault();
  const m = state.page.margins, d = dims(), s = wsGeom().s;
  const startY = e.clientY, st = { top: m.top, bottom: m.bottom };
  const move = ev => {
    const dy = px2mm((ev.clientY - startY) / s);
    let v;
    if (h.kind === 'mt') { v = st.top + dy; if (!ev.altKey) v = Math.round(v / 2.5) * 2.5; m.top = round(clamp(v, 0, d.hmm - m.bottom - 20), 1); }
    else { v = st.bottom - dy; if (!ev.altKey) v = Math.round(v / 2.5) * 2.5; m.bottom = round(clamp(v, 0, d.hmm - m.top - 20), 1); }
    applyPageLight();
    guide('h', ev.clientY);
    showTip((h.kind === 'mt' ? 'Верхнее поле: ' : 'Нижнее поле: ') + cm(h.kind === 'mt' ? m.top : m.bottom), ev.clientX, ev.clientY);
  };
  const up = () => {
    document.removeEventListener('mousemove', move); document.removeEventListener('mouseup', up);
    rulerDrag = null; guide(null); hideTip();
    if (st.top !== m.top || st.bottom !== m.bottom) { applyPage(); markDirty(false); autosave(); }
  };
  rulerDrag = h;
  document.addEventListener('mousemove', move); document.addEventListener('mouseup', up);
});
/* лёгкое обновление при перетаскивании полей (без полной пагинации) */
let lightTimer = 0;
function applyPageLight() {
  const d = dims();
  editor.style.padding = `${d.mt}px ${d.mr}px ${d.mb}px ${d.ml}px`;
  sheetsKey = ''; renderSheets(); drawRulers();
  clearTimeout(lightTimer); lightTimer = setTimeout(() => { paginate(); drawRulers(); }, 120);
}
/* установка отступов абзаца (px; null — не менять) */
function setIndent(b, ml, ti, mr) {
  const toCm = px => round(px2mm(px) / 10, 2) + 'cm';
  if (ml !== null) b.style.marginLeft = Math.abs(ml) < 0.5 ? '' : toCm(ml);
  if (ti !== null) b.style.textIndent = toCm(ti);
  if (mr !== null) b.style.marginRight = Math.abs(mr) < 0.5 ? '' : toCm(mr);
}
canvas.addEventListener('scroll', () => { drawRulers(); updateImgOverlay(); updateStatusPage(); }, { passive: true });
window.addEventListener('resize', () => { drawRulers(); updateImgOverlay(); });
/* =====================================================================
   ФОРМАТИРОВАНИЕ ТЕКСТА И АБЗАЦЕВ
   ===================================================================== */
let lastSizePt = 11;
FONT_SIZES_LEGACY[7] = null;
const _normalizeFonts = normalizeFonts;
normalizeFonts = function (root = editor) {
  root.querySelectorAll('font[size="7"]').forEach(f => { f.removeAttribute('size'); f.style.fontSize = lastSizePt + 'pt'; });
  _normalizeFonts(root);
};
function exec(cmd, val = null, css = false) {
  restoreSelection();
  document.execCommand('styleWithCSS', false, css);
  document.execCommand(cmd, false, val);
  document.execCommand('styleWithCSS', false, false);
  changed();
}
const FONTS = ['Calibri','Calibri Light','Cambria','Arial','Arial Narrow','Times New Roman','Georgia','Garamond','Verdana','Tahoma',
  'Segoe UI','Trebuchet MS','Century Gothic','Book Antiqua','Palatino Linotype','Courier New','Consolas','Lucida Console',
  'Comic Sans MS','Impact','PT Sans','PT Serif','PT Mono','Roboto','Open Sans','Liberation Serif','Liberation Sans'];
const SIZES = [8, 9, 10, 10.5, 11, 12, 14, 16, 18, 20, 22, 24, 26, 28, 36, 48, 72];

function setFontSize(pt) {
  pt = clamp(parseFloat(String(pt).replace(',', '.')) || state.defaults.size, 1, 1638);
  lastSizePt = pt;
  restoreSelection();
  document.execCommand('styleWithCSS', false, false);
  document.execCommand('fontSize', false, 7);
  changed();
  editor.focus({ preventScroll: true });
}
function currentSizePt() {
  const r = getRange() || savedRange; if (!r) return state.defaults.size;
  const n = r.startContainer.nodeType === 1 ? r.startContainer : r.startContainer.parentNode;
  return round(parseFloat(getComputedStyle(n).fontSize) * 0.75, 1);
}
function stepFont(dir) {
  const cur = currentSizePt();
  let next = dir > 0 ? SIZES.find(s => s > cur + 0.01) : [...SIZES].reverse().find(s => s < cur - 0.01);
  if (next === undefined) next = dir > 0 ? cur + 10 : Math.max(1, cur - 1);
  setFontSize(next);
}
function setFontFamily(name) {
  if (!name) return;
  restoreSelection();
  document.execCommand('styleWithCSS', false, false);
  document.execCommand('fontName', false, name);
  changed();
  editor.focus({ preventScroll: true });
}
let textColor = '#c00000', hlColor = '#ffff00';
function applyTextColor(c = textColor) { textColor = c; $('textColorBar').style.background = c; exec('foreColor', c); }
function applyHighlight(c = hlColor) {
  if (c === 'none') { exec('hiliteColor', 'transparent', true); return; }
  hlColor = c; $('hlColorBar').style.background = c; exec('hiliteColor', c, true);
}

/* --- стили абзацев --- */
const STYLES = [
  { id: 'normal',   name: 'Обычный',          tag: 'P',  cls: '' },
  { id: 'nospace',  name: 'Без интервала',    tag: 'P',  cls: 'no-spacing' },
  { id: 'h1',       name: 'Заголовок 1',      tag: 'H1', cls: '' },
  { id: 'h2',       name: 'Заголовок 2',      tag: 'H2', cls: '' },
  { id: 'h3',       name: 'Заголовок 3',      tag: 'H3', cls: '' },
  { id: 'h4',       name: 'Заголовок 4',      tag: 'H4', cls: '' },
  { id: 'title',    name: 'Название',         tag: 'P',  cls: 'doc-title' },
  { id: 'subtitle', name: 'Подзаголовок',     tag: 'P',  cls: 'doc-subtitle' },
  { id: 'quote',    name: 'Цитата',           tag: 'BLOCKQUOTE', cls: '' },
  { id: 'iquote',   name: 'Выделенная цитата', tag: 'BLOCKQUOTE', cls: 'intense' },
  { id: 'code',     name: 'Код',              tag: 'PRE', cls: '' }
];
const STYLE_CLASSES = ['no-spacing', 'doc-title', 'doc-subtitle', 'intense'];
function styleOf(b) {
  if (!b) return null;
  return STYLES.find(s => s.tag === b.tagName && (s.cls ? b.classList.contains(s.cls) : !STYLE_CLASSES.some(c => b.classList.contains(c)))) || null;
}
function renderStylesGallery() {
  const g = $('stylesGallery'); if (!g) return;
  const sample = { normal: 'АаБбВв', nospace: 'АаБбВв', h1: 'Заголовок 1', h2: 'Заголовок 2', h3: 'Заголовок 3', h4: 'Заголовок 4',
    title: 'Название', subtitle: 'Подзаг.', quote: 'Цитата', iquote: 'Цитата', code: 'Код' };
  const css = { normal: `font-size:12px`, nospace: `font-size:12px`, h1: 'font-size:15px;color:#2f5496', h2: 'font-size:13px;color:#2f5496',
    h3: 'font-size:12px;color:#1f3763', h4: 'font-size:12px;color:#2f5496;font-style:italic', title: 'font-size:18px', subtitle: 'font-size:12px;color:#5a5a5a',
    quote: 'font-size:12px;font-style:italic', iquote: 'font-size:12px;font-style:italic;color:#4472c4', code: 'font-family:Consolas,monospace;font-size:12px' };
  g.innerHTML = STYLES.map(s => `<div class="style-card" data-style="${s.id}" title="${s.name}"><div class="sample" style="font-family:${s.id === 'code' ? 'Consolas' : state.defaults.font};${css[s.id]}">${sample[s.id]}</div><div class="sname">${s.name}</div></div>`).join('');
  g.querySelectorAll('.style-card').forEach(c => {
    c.addEventListener('mousedown', e => e.preventDefault());
    c.addEventListener('click', () => applyStyle(c.dataset.style));
  });
}
function replaceTag(b, tag) {
  if (b.tagName === tag) return b;
  const n = document.createElement(tag);
  Array.from(b.attributes).forEach(a => n.setAttribute(a.name, a.value));
  while (b.firstChild) n.appendChild(b.firstChild);
  b.replaceWith(n);
  return n;
}
function applyStyle(id) {
  const st = STYLES.find(s => s.id === id); if (!st) return;
  restoreSelection();
  const off = getSelOffsets();
  const blocks = selectedBlocks();
  blocks.forEach(b => {
    if (b.tagName === 'TD' || b.tagName === 'TH') {
      const p = document.createElement('p'); while (b.firstChild) p.appendChild(b.firstChild); b.appendChild(p); b = p;
    }
    if (b.tagName === 'LI') { // в списке — переносим содержимое в абзац нужного стиля
      if (st.tag === 'P' && !st.cls) return;
      const ul = b.parentElement; const n = document.createElement(st.tag);
      while (b.firstChild) n.appendChild(b.firstChild);
      if (st.cls) n.className = st.cls;
      ul.parentNode.insertBefore(n, ul.nextSibling); b.remove(); if (!ul.children.length) ul.remove();
      return;
    }
    const n = replaceTag(b, st.tag);
    STYLE_CLASSES.forEach(c => n.classList.remove(c));
    if (st.cls) n.classList.add(st.cls);
    if (!n.className) n.removeAttribute('class');
    if (/^H\d$/.test(st.tag) && !n.id) n.id = 'h-' + Math.random().toString(36).slice(2, 8);
  });
  setSelOffsets(off);
  changed();
}

/* --- выравнивание, интервалы, отступы --- */
function setBlockStyle(prop, val) {
  restoreSelection();
  const blocks = selectedBlocks();
  if (!blocks.length) return;
  blocks.forEach(b => { b.style[prop] = val; if (!b.getAttribute('style')) b.removeAttribute('style'); });
  changed();
}
function setAlign(a) {
  if (selectedImg) { imgWrap(a === 'center' ? 'center' : a === 'right' ? 'right' : 'inline'); return; }
  setBlockStyle('textAlign', a);
}
function blockAlign() {
  const b = (selectedBlocks(false) || [])[0]; if (!b) return state.defaults.align;
  const a = getComputedStyle(b).textAlign;
  return a === 'start' ? 'left' : a === 'end' ? 'right' : a;
}
function setLineHeight(v) { setBlockStyle('lineHeight', v ? String(v) : ''); }
function setSpacing(which, pt) { setBlockStyle(which === 'before' ? 'marginTop' : 'marginBottom', pt === null ? '' : pt + 'pt'); }
function inList() { const r = getRange(); return !!(r && (r.startContainer.nodeType === 1 ? r.startContainer : r.startContainer.parentNode).closest('li')); }
function indent(dir) {
  restoreSelection();
  if (inList()) { document.execCommand(dir > 0 ? 'indent' : 'outdent'); changed(); return; }
  const blocks = selectedBlocks().filter(b => b.tagName !== 'TD' && b.tagName !== 'TH');
  blocks.forEach(b => {
    const cur = parseFloat(getComputedStyle(b).marginLeft) || 0;
    const step = mm2px(12.5);
    const next = Math.max(0, Math.round((cur + dir * step) / step) * step);
    b.style.marginLeft = next ? round(next / MM / 10, 2) + 'cm' : '';
  });
  changed();
}

/* --- списки --- */
function makeList(kind, type) {
  restoreSelection();
  const cmd = kind === 'ol' ? 'insertOrderedList' : 'insertUnorderedList';
  const r = getRange();
  const inSame = r && (r.startContainer.nodeType === 1 ? r.startContainer : r.startContainer.parentNode).closest(kind);
  if (!(inSame && type)) document.execCommand(cmd);
  const r2 = getRange();
  const list = r2 && (r2.startContainer.nodeType === 1 ? r2.startContainer : r2.startContainer.parentNode).closest(kind);
  if (list && type) {
    list.classList.remove('multi', 'dash', 'check'); list.style.listStyleType = '';
    if (type === 'multi' || type === 'dash' || type === 'check') list.classList.add(type);
    else if (type !== 'disc' && type !== 'decimal') list.style.listStyleType = type;
    if (!list.className) list.removeAttribute('class');
    if (!list.getAttribute('style')) list.removeAttribute('style');
  }
  // Chrome иногда оставляет <li> внутри <p>
  editor.querySelectorAll('p > ul, p > ol').forEach(l => { const p = l.parentNode; if (p.textContent.trim() === l.textContent.trim()) p.replaceWith(l); });
  changed();
}

/* --- регистр --- */
function changeCase(mode) {
  restoreSelection();
  const r = getRange(); if (!r || r.collapsed) { toast('Выделите текст'); return; }
  const off = getSelOffsets();
  const nodes = [];
  const w = document.createTreeWalker(r.commonAncestorContainer.nodeType === 3 ? r.commonAncestorContainer.parentNode : r.commonAncestorContainer, NodeFilter.SHOW_TEXT);
  let n; while ((n = w.nextNode())) if (r.intersectsNode(n) && !n.parentElement.closest('[data-pb]')) nodes.push(n);
  let all = nodes.map(n => { const s = n === r.startContainer ? r.startOffset : 0, e = n === r.endContainer ? r.endOffset : n.nodeValue.length; return n.nodeValue.slice(s, e); }).join('');
  if (mode === 'cycle') mode = all === all.toLowerCase() ? 'upper' : all === all.toUpperCase() ? 'title' : 'lower';
  let prevSpace = true, sentenceStart = true;
  const tf = ch => {
    let out;
    switch (mode) {
      case 'upper': out = ch.toUpperCase(); break;
      case 'lower': out = ch.toLowerCase(); break;
      case 'toggle': out = ch === ch.toUpperCase() ? ch.toLowerCase() : ch.toUpperCase(); break;
      case 'title': out = prevSpace ? ch.toUpperCase() : ch.toLowerCase(); break;
      case 'sentence': out = sentenceStart && /\p{L}/u.test(ch) ? ch.toUpperCase() : ch.toLowerCase(); break;
    }
    prevSpace = /\s/.test(ch);
    if (/\p{L}/u.test(ch)) sentenceStart = false; else if (/[.!?]/.test(ch)) sentenceStart = true;
    return out;
  };
  nodes.forEach(n => {
    const s = n === r.startContainer ? r.startOffset : 0, e = n === r.endContainer ? r.endOffset : n.nodeValue.length;
    const v = n.nodeValue;
    n.nodeValue = v.slice(0, s) + Array.from(v.slice(s, e)).map(tf).join('') + v.slice(e);
  });
  setSelOffsets(off);
  changed();
}

/* --- очистить формат --- */
function clearFormat() {
  restoreSelection();
  const off = getSelOffsets();
  document.execCommand('removeFormat');
  document.execCommand('unlink');
  selectedBlocks().forEach(b => {
    if (b.tagName === 'TD' || b.tagName === 'TH') return;
    let n = b;
    if (/^(H\d|BLOCKQUOTE|PRE)$/.test(b.tagName)) n = replaceTag(b, 'P');
    n.removeAttribute('style'); STYLE_CLASSES.forEach(c => n.classList.remove(c)); if (!n.className) n.removeAttribute('class');
    n.querySelectorAll('span').forEach(s => { s.removeAttribute('style'); if (!s.attributes.length) s.replaceWith(...s.childNodes); });
  });
  setSelOffsets(off);
  changed();
}

/* --- формат по образцу --- */
let painter = null;
function captureFormat() {
  const r = getRange() || savedRange; if (!r) return null;
  const n = r.startContainer.nodeType === 1 ? r.startContainer : r.startContainer.parentNode;
  const cs = getComputedStyle(n);
  let bg = null, el = n, deco = '';
  while (el && el !== editor) {
    const c = getComputedStyle(el);
    if (!bg && c.backgroundColor && c.backgroundColor !== 'rgba(0, 0, 0, 0)' && !TEXT_BLOCKS.has(el.tagName)) bg = c.backgroundColor;
    deco += ' ' + c.textDecorationLine;
    if (TEXT_BLOCKS.has(el.tagName)) break;
    el = el.parentElement;
  }
  return { bold: parseInt(cs.fontWeight) >= 600, italic: cs.fontStyle === 'italic', underline: deco.includes('underline'),
    strike: deco.includes('line-through'), color: cs.color, bg, font: cs.fontFamily.split(',')[0].replace(/["']/g, '').trim(),
    size: round(parseFloat(cs.fontSize) * 0.75, 1), block: closestBlock(n) };
}
function applyFormat(f) {
  document.execCommand('styleWithCSS', false, false);
  document.execCommand('removeFormat');
  if (f.bold) document.execCommand('bold');
  if (f.italic) document.execCommand('italic');
  if (f.underline) document.execCommand('underline');
  if (f.strike) document.execCommand('strikeThrough');
  document.execCommand('foreColor', false, f.color);
  document.execCommand('fontName', false, f.font);
  lastSizePt = f.size; document.execCommand('fontSize', false, 7);
  if (f.bg) { document.execCommand('styleWithCSS', false, true); document.execCommand('hiliteColor', false, f.bg); document.execCommand('styleWithCSS', false, false); }
  changed();
}
function startPainter(sticky) {
  if (painter) { stopPainter(); return; }
  const f = captureFormat(); if (!f) return;
  painter = { f, sticky };
  $('btnPainter').classList.add('active');
  editor.style.cursor = 'copy';
}
function stopPainter() { painter = null; $('btnPainter').classList.remove('active'); editor.style.cursor = ''; }
editor.addEventListener('mouseup', () => {
  if (!painter) return;
  setTimeout(() => {
    const r = getRange();
    if (r && !r.collapsed) { applyFormat(painter.f); if (!painter.sticky) stopPainter(); }
  }, 0);
});

/* --- параметры абзаца --- */
function paragraphDialog() {
  restoreSelection();
  const b = selectedBlocks()[0]; if (!b) return;
  const cs = getComputedStyle(b), fs = parseFloat(cs.fontSize);
  const ti = parseFloat(cs.textIndent) || 0;
  const lh = cs.lineHeight === 'normal' ? 1.15 : round(parseFloat(cs.lineHeight) / fs, 2);
  const toCm = px => round(px2mm(px) / 10, 2);
  showModal(`<h3>Абзац</h3>
   <div class="grid2">
    <div><label>Выравнивание</label><select id="pdAlign"><option value="left">По левому краю</option><option value="center">По центру</option><option value="right">По правому краю</option><option value="justify">По ширине</option></select></div>
    <div><label>Междустрочный интервал (множитель)</label><input type="number" id="pdLh" step="0.05" min="0.5" value="${lh}"></div>
   </div>
   <fieldset><legend>Отступ, см</legend><div class="grid2">
    <div><label>Слева</label><input type="number" id="pdL" step="0.25" value="${toCm(parseFloat(cs.marginLeft) || 0)}"></div>
    <div><label>Справа</label><input type="number" id="pdR" step="0.25" value="${toCm(parseFloat(cs.marginRight) || 0)}"></div>
    <div><label>Первая строка</label><select id="pdFT"><option value="none">(нет)</option><option value="indent">Отступ</option><option value="hang">Выступ</option></select></div>
    <div><label>на</label><input type="number" id="pdF" step="0.25" min="0" value="${Math.abs(toCm(ti))}"></div>
   </div></fieldset>
   <fieldset><legend>Интервал, пт</legend><div class="grid2">
    <div><label>Перед</label><input type="number" id="pdB" step="6" min="0" value="${round((parseFloat(cs.marginTop) || 0) * 0.75, 1)}"></div>
    <div><label>После</label><input type="number" id="pdA" step="6" min="0" value="${round((parseFloat(cs.marginBottom) || 0) * 0.75, 1)}"></div>
   </div></fieldset>
   <label class="chk"><input type="checkbox" id="pdPB" ${b.style.breakBefore === 'page' ? 'checked' : ''}>С новой страницы</label>
   <label class="chk"><input type="checkbox" id="pdAll">Применить как стиль «Обычный» для всего документа</label>`,
  () => {
    const v = id => parseFloat($(id).value.replace(',', '.')) || 0;
    const a = $('pdAlign').value, ft = $('pdFT').value, f = v('pdF');
    const tiCm = ft === 'none' ? 0 : ft === 'indent' ? f : -f;
    if ($('pdAll').checked) {
      Object.assign(state.defaults, { align: a, lineHeight: v('pdLh') || 1.15, before: v('pdB'), after: v('pdA'), indent: tiCm * 10 });
      applyDefaults(); changed(); return;
    }
    selectedBlocks().forEach(bl => {
      bl.style.textAlign = a === state.defaults.align ? '' : a;
      bl.style.lineHeight = v('pdLh') ? String(v('pdLh')) : '';
      bl.style.marginLeft = v('pdL') ? v('pdL') + 'cm' : '';
      bl.style.marginRight = v('pdR') ? v('pdR') + 'cm' : '';
      bl.style.textIndent = tiCm + 'cm';
      bl.style.marginTop = v('pdB') + 'pt'; bl.style.marginBottom = v('pdA') + 'pt';
      bl.style.breakBefore = $('pdPB').checked ? 'page' : '';
      if (!bl.getAttribute('style')) bl.removeAttribute('style');
    });
    changed();
  });
  $('pdAlign').value = blockAlign();
  $('pdFT').value = Math.abs(ti) < 0.5 ? 'none' : ti > 0 ? 'indent' : 'hang';
}
function defaultsDialog() {
  const d = state.defaults;
  showModal(`<h3>Стиль «Обычный» (по умолчанию для документа)</h3>
    <div class="grid2">
      <div><label>Шрифт</label><input type="text" id="ddFont" list="fontList" value="${esc(d.font)}"></div>
      <div><label>Размер, пт</label><input type="number" id="ddSize" step="0.5" value="${d.size}"></div>
      <div><label>Междустрочный (множитель)</label><input type="number" id="ddLh" step="0.05" value="${d.lineHeight}"></div>
      <div><label>Выравнивание</label><select id="ddAlign"><option value="left">По левому краю</option><option value="justify">По ширине</option><option value="center">По центру</option><option value="right">По правому краю</option></select></div>
      <div><label>Интервал перед, пт</label><input type="number" id="ddB" value="${d.before}"></div>
      <div><label>Интервал после, пт</label><input type="number" id="ddA" value="${d.after}"></div>
      <div><label>Отступ первой строки, см</label><input type="number" id="ddI" step="0.25" value="${d.indent / 10}"></div>
    </div>`, () => {
      const v = id => parseFloat($(id).value.replace(',', '.'));
      Object.assign(state.defaults, { font: $('ddFont').value || 'Calibri', size: v('ddSize') || 11, lineHeight: v('ddLh') || 1.15,
        align: $('ddAlign').value, before: v('ddB') || 0, after: v('ddA') || 0, indent: (v('ddI') || 0) * 10 });
      applyDefaults(); changed();
    });
  $('ddAlign').value = d.align;
}
function presetGost() {
  Object.assign(state.defaults, { font: 'Times New Roman', size: 14, lineHeight: 1.5, before: 0, after: 0, indent: 12.5, align: 'justify' });
  state.page.margins = { top: 20, bottom: 20, left: 30, right: 15 };
  applyDefaults(); applyPage(); changed(); toast('Применено оформление по ГОСТ: TNR 14 пт, 1,5 интервала, отступ 1,25 см');
}
function presetWord() {
  Object.assign(state.defaults, { font: 'Calibri', size: 11, lineHeight: 1.15, before: 0, after: 8, indent: 0, align: 'left' });
  applyDefaults(); changed();
}
/* =====================================================================
   ТАБЛИЦЫ: модель сетки, вставка/удаление строк и столбцов,
   объединение/разделение ячеек, ширина столбцов, выделение ячеек
   ===================================================================== */
function tableRowsOf(t) { return Array.from(t.rows).filter(r => !r.hasAttribute('data-pb') && r.closest('table') === t); }
function readTable(t) {
  const rows = tableRowsOf(t), grid = [], cells = [];
  rows.forEach((tr, r) => {
    grid[r] = grid[r] || [];
    let c = 0;
    Array.from(tr.cells).forEach(td => {
      while (grid[r][c]) c++;
      const rs = clamp(td.rowSpan || 1, 1, rows.length - r), cs = Math.max(1, td.colSpan || 1);
      const cell = { el: td, r, c, rs, cs };
      cells.push(cell);
      for (let i = 0; i < rs; i++) { grid[r + i] = grid[r + i] || []; for (let j = 0; j < cs; j++) grid[r + i][c + j] = cell; }
      c += cs;
    });
  });
  const nCols = Math.max(1, ...grid.map(g => g ? g.length : 0));
  return { t, rows, cells, nRows: rows.length, nCols, rowAttrs: rows.map(r => Array.from(r.attributes).map(a => [a.name, a.value])) };
}
function buildGrid(m) {
  const g = Array.from({ length: m.nRows }, () => Array(m.nCols).fill(null));
  m.cells.forEach(c => { for (let i = 0; i < c.rs; i++) for (let j = 0; j < c.cs; j++) if (g[c.r + i]) g[c.r + i][c.c + j] = c; });
  return g;
}
function newCellLike(ref) {
  const td = document.createElement(ref && ref.tagName === 'TH' ? 'th' : 'td');
  if (ref) { const st = ref.getAttribute('style'); if (st) td.setAttribute('style', st); td.style.width = ''; if (!td.getAttribute('style')) td.removeAttribute('style'); }
  td.innerHTML = '<br>';
  return td;
}
function writeTable(m) {
  const t = m.t;
  t.querySelectorAll('[data-pb]').forEach(n => n.remove());
  Array.from(t.rows).filter(r => r.closest('table') === t).forEach(r => r.remove());
  Array.from(t.children).filter(c => /^(THEAD|TFOOT)$/.test(c.tagName)).forEach(c => c.remove());
  let body = t.tBodies[0]; if (!body) { body = document.createElement('tbody'); t.appendChild(body); }
  const g = buildGrid(m);
  // убрать пустые строки (все ячейки начинаются выше)
  for (let i = m.nRows - 1; i >= 0; i--) {
    if (!m.cells.some(c => c.r === i) && g[i].every(x => x)) {
      m.cells.forEach(c => { if (c.r < i && c.r + c.rs > i) c.rs--; else if (c.r > i) c.r--; });
      m.nRows--; if (m.rowAttrs) m.rowAttrs.splice(i, 1);
    }
  }
  const g2 = buildGrid(m);
  const trs = [];
  for (let r = 0; r < m.nRows; r++) {
    const tr = document.createElement('tr');
    (m.rowAttrs && m.rowAttrs[r] || []).forEach(([k, v]) => tr.setAttribute(k, v));
    trs.push(tr); body.appendChild(tr);
  }
  for (let r = 0; r < m.nRows; r++) for (let c = 0; c < m.nCols; c++) {
    if (!g2[r][c]) { const cell = { el: newCellLike(null), r, c, rs: 1, cs: 1 }; m.cells.push(cell); g2[r][c] = cell; }
  }
  m.cells.sort((a, b) => a.r - b.r || a.c - b.c).forEach(c => {
    if (c.rs > 1) c.el.rowSpan = c.rs; else c.el.removeAttribute('rowspan');
    if (c.cs > 1) c.el.colSpan = c.cs; else c.el.removeAttribute('colspan');
    c.el.style.width = ''; if (!c.el.getAttribute('style')) c.el.removeAttribute('style');
    trs[c.r].appendChild(c.el);
  });
}
function ensureColgroup(t) {
  const m = readTable(t);
  let cg = Array.from(t.children).find(c => c.tagName === 'COLGROUP');
  let cols = cg ? Array.from(cg.children).filter(c => c.tagName === 'COL') : [];
  const okPct = cols.length === m.nCols && cols.every(c => /%$/.test(c.style.width));
  if (okPct) return cols;
  // измеряем текущие ширины
  let widths = Array(m.nCols).fill(0);
  const g = buildGrid(m);
  for (let c = 0; c < m.nCols; c++) {
    for (let r = 0; r < m.nRows; r++) { const cell = g[r][c]; if (cell && cell.cs === 1) { widths[c] = cell.el.offsetWidth; break; } }
  }
  if (cols.length === m.nCols && cols.some(c => c.style.width || c.getAttribute('width'))) {
    widths = cols.map(c => parseFloat(c.style.width || c.getAttribute('width')) || 0);
  }
  const known = widths.filter(w => w > 0), avg = known.length ? known.reduce((a, b) => a + b, 0) / known.length : 1;
  widths = widths.map(w => w > 0 ? w : avg);
  const sum = widths.reduce((a, b) => a + b, 0) || 1;
  if (cg) cg.remove();
  cg = document.createElement('colgroup');
  widths.forEach(w => { const col = document.createElement('col'); col.style.width = round(w / sum * 100, 3) + '%'; cg.appendChild(col); });
  t.insertBefore(cg, t.firstChild);
  t.querySelectorAll('td,th').forEach(td => { if (td.closest('table') === t) { td.style.width = ''; td.removeAttribute('width'); if (!td.getAttribute('style')) td.removeAttribute('style'); } });
  return Array.from(cg.children);
}
function setColWidths(t, widths) {
  const sum = widths.reduce((a, b) => a + b, 0) || 1;
  let cg = Array.from(t.children).find(c => c.tagName === 'COLGROUP');
  if (cg) cg.remove();
  cg = document.createElement('colgroup');
  widths.forEach(w => { const col = document.createElement('col'); col.style.width = round(w / sum * 100, 3) + '%'; cg.appendChild(col); });
  t.insertBefore(cg, t.firstChild);
}
function colWidths(t) { return ensureColgroup(t).map(c => parseFloat(c.style.width) || 0); }

/* --- текущая ячейка / выделение ячеек --- */
let cellSel = { table: null, start: null, active: false };
function currentCell() {
  const r = getRange() || savedRange; if (!r) return null;
  const n = r.startContainer.nodeType === 1 ? r.startContainer : r.startContainer.parentNode;
  const c = n && n.closest && n.closest('td,th');
  return c && editor.contains(c) && !c.closest('[data-pb]') ? c : null;
}
function selectedCellRect() {
  const cell = currentCell();
  let table = cell ? cell.closest('table') : cellSel.table;
  if (!table) return null;
  const m = readTable(table);
  const sel = Array.from(table.querySelectorAll('.selected-cell')).filter(c => c.closest('table') === table);
  const targets = sel.length ? sel : (cell ? [cell] : []);
  if (!targets.length) return null;
  let r0 = 1e9, r1 = -1, c0 = 1e9, c1 = -1;
  targets.forEach(el => { const c = m.cells.find(x => x.el === el); if (!c) return; r0 = Math.min(r0, c.r); r1 = Math.max(r1, c.r + c.rs - 1); c0 = Math.min(c0, c.c); c1 = Math.max(c1, c.c + c.cs - 1); });
  return { m, r0, r1, c0, c1, table };
}
function clearCellSelection() {
  editor.querySelectorAll('.selected-cell').forEach(c => { c.classList.remove('selected-cell'); if (!c.className) c.removeAttribute('class'); });
}
function highlightCells(table, a, b) {
  clearCellSelection();
  const m = readTable(table), ca = m.cells.find(x => x.el === a), cb = m.cells.find(x => x.el === b);
  if (!ca || !cb) return;
  let r0 = Math.min(ca.r, cb.r), r1 = Math.max(ca.r + ca.rs - 1, cb.r + cb.rs - 1), c0 = Math.min(ca.c, cb.c), c1 = Math.max(ca.c + ca.cs - 1, cb.c + cb.cs - 1);
  m.cells.forEach(c => { if (c.r <= r1 && c.r + c.rs - 1 >= r0 && c.c <= c1 && c.c + c.cs - 1 >= c0) c.el.classList.add('selected-cell'); });
}
editor.addEventListener('mousedown', e => {
  if (e.button !== 0) return;
  const cell = e.target.closest && e.target.closest('td,th');
  if (!e.shiftKey) clearCellSelection();
  if (cell && !cell.closest('[data-pb]') && !colHover) {
    if (e.shiftKey && cellSel.start && cellSel.table === cell.closest('table')) { e.preventDefault(); highlightCells(cellSel.table, cellSel.start, cell); return; }
    cellSel = { table: cell.closest('table'), start: cell, active: true };
  } else cellSel.active = false;
});
editor.addEventListener('mouseover', e => {
  if (!cellSel.active || !(e.buttons & 1)) return;
  const cell = e.target.closest && e.target.closest('td,th');
  if (cell && cell !== cellSel.start && cell.closest('table') === cellSel.table) {
    highlightCells(cellSel.table, cellSel.start, cell);
    const r = document.createRange(); r.selectNodeContents(cell); r.collapse(true);
    const s = window.getSelection(); s.removeAllRanges(); s.addRange(r);
  }
});
document.addEventListener('mouseup', () => { cellSel.active = false; });

/* --- операции --- */
function tableOp(fn) {
  const sr = selectedCellRect(); if (!sr) { toast('Поместите курсор в таблицу'); return; }
  const off = getSelOffsets();
  sr.table.querySelectorAll('[data-pb]').forEach(n => n.remove());
  const sr2 = selectedCellRect() || sr;
  const res = fn(sr2);
  if (res !== false) {
    if (sr2.table.isConnected) writeTable(sr2.m);
    clearCellSelection();
    if (res && res.focus) { const r = document.createRange(); r.selectNodeContents(res.focus); r.collapse(true); const s = getSelection(); s.removeAllRanges(); s.addRange(r); }
    else setSelOffsets(off);
    changed();
  }
}
function insertRows(sr, below) {
  const m = sr.m, at = below ? sr.r1 + 1 : sr.r0, count = sr.r1 - sr.r0 + 1;
  const ref = buildGrid(m)[below ? sr.r1 : sr.r0];
  for (let k = 0; k < count; k++) {
    m.cells.forEach(c => { if (c.r >= at) c.r++; else if (c.r + c.rs > at) c.rs++; });
    m.nRows++;
    if (m.rowAttrs) m.rowAttrs.splice(at, 0, []);
    const g = buildGrid(m);
    for (let c = 0; c < m.nCols; c++) if (!g[at][c]) m.cells.push({ el: newCellLike(ref[c] && ref[c].el), r: at, c, rs: 1, cs: 1 });
  }
  return { focus: null };
}
function insertCols(sr, right) {
  const m = sr.m, at = right ? sr.c1 + 1 : sr.c0, count = sr.c1 - sr.c0 + 1;
  const widths = colWidths(m.t);
  const refW = widths[right ? sr.c1 : sr.c0] || 10;
  const g0 = buildGrid(m);
  for (let k = 0; k < count; k++) {
    m.cells.forEach(c => { if (c.c >= at) c.c++; else if (c.c + c.cs > at) c.cs++; });
    m.nCols++;
    widths.splice(at, 0, refW);
    const g = buildGrid(m);
    for (let r = 0; r < m.nRows; r++) if (!g[r][at]) { const ref = g0[r][right ? sr.c1 : sr.c0]; m.cells.push({ el: newCellLike(ref && ref.el), r, c: at, rs: 1, cs: 1 }); }
  }
  setColWidths(m.t, widths);
}
function deleteRows(sr) {
  const m = sr.m;
  if (sr.r0 === 0 && sr.r1 === m.nRows - 1) { deleteTable(m.t); return false; }
  for (let i = sr.r1; i >= sr.r0; i--) {
    m.cells = m.cells.filter(c => !(c.r === i && c.rs === 1));
    m.cells.forEach(c => { if (c.r === i) c.rs--; else if (c.r < i && c.r + c.rs > i) c.rs--; else if (c.r > i) c.r--; });
    m.nRows--; if (m.rowAttrs) m.rowAttrs.splice(i, 1);
  }
}
function deleteCols(sr) {
  const m = sr.m;
  if (sr.c0 === 0 && sr.c1 === m.nCols - 1) { deleteTable(m.t); return false; }
  const widths = colWidths(m.t);
  for (let i = sr.c1; i >= sr.c0; i--) {
    m.cells = m.cells.filter(c => !(c.c === i && c.cs === 1));
    m.cells.forEach(c => { if (c.c === i) c.cs--; else if (c.c < i && c.c + c.cs > i) c.cs--; else if (c.c > i) c.c--; });
    m.nCols--; widths.splice(i, 1);
  }
  setColWidths(m.t, widths);
}
function deleteTable(t) {
  const p = document.createElement('p'); p.innerHTML = '<br>';
  t.replaceWith(p);
  const r = document.createRange(); r.selectNodeContents(p); r.collapse(true); const s = getSelection(); s.removeAllRanges(); s.addRange(r);
  changed();
}
const isEmptyCell = el => !el.textContent.replace(/\u200b/g, '').trim() && !el.querySelector('img,table');
function mergeCells(sr) {
  const m = sr.m;
  let { r0, r1, c0, c1 } = sr, changedB = true;
  while (changedB) {
    changedB = false;
    m.cells.forEach(c => {
      if (c.r <= r1 && c.r + c.rs - 1 >= r0 && c.c <= c1 && c.c + c.cs - 1 >= c0) {
        if (c.r < r0) { r0 = c.r; changedB = true; } if (c.r + c.rs - 1 > r1) { r1 = c.r + c.rs - 1; changedB = true; }
        if (c.c < c0) { c0 = c.c; changedB = true; } if (c.c + c.cs - 1 > c1) { c1 = c.c + c.cs - 1; changedB = true; }
      }
    });
  }
  const inside = m.cells.filter(c => c.r >= r0 && c.r <= r1 && c.c >= c0 && c.c <= c1);
  if (inside.length < 2) { toast('Выделите несколько ячеек (протяните мышью или Shift+щелчок)'); return false; }
  const anchor = inside.find(c => c.r === r0 && c.c === c0) || inside[0];
  inside.forEach(c => {
    if (c === anchor) return;
    if (!isEmptyCell(c.el)) {
      if (isEmptyCell(anchor.el)) anchor.el.innerHTML = '';
      const kids = Array.from(c.el.childNodes);
      if (!hasBlockChild(anchor.el) && anchor.el.childNodes.length) { const p = document.createElement('p'); while (anchor.el.firstChild) p.appendChild(anchor.el.firstChild); anchor.el.appendChild(p); }
      if (kids.some(isBlock)) kids.forEach(k => anchor.el.appendChild(k));
      else { const p = document.createElement('p'); kids.forEach(k => p.appendChild(k)); anchor.el.appendChild(p); }
    }
    c.el.remove();
  });
  m.cells = m.cells.filter(c => c === anchor || !inside.includes(c));
  anchor.r = r0; anchor.c = c0; anchor.rs = r1 - r0 + 1; anchor.cs = c1 - c0 + 1;
  return { focus: anchor.el };
}
function splitCellOp(sr, rows, cols) {
  const m = sr.m;
  const cell = m.cells.find(c => c.r === sr.r0 && c.c === sr.c0) || m.cells.find(c => c.el === currentCell());
  if (!cell) return false;
  const widths = colWidths(m.t);
  if (cols > cell.cs) {
    const add = cols - cell.cs, at = cell.c + cell.cs;
    m.cells.forEach(c => {
      if (c === cell) return;
      if (c.c >= at) c.c += add; else if (c.c + c.cs > at - 1 && c.c <= at - 1) c.cs += add;
    });
    cell.cs += add; m.nCols += add;
    const w = widths[at - 1] || 10;
    widths.splice(at - 1, 1, ...Array(add + 1).fill(w / (add + 1)));
  }
  if (rows > cell.rs) {
    const add = rows - cell.rs, at = cell.r + cell.rs;
    m.cells.forEach(c => {
      if (c === cell) return;
      if (c.r >= at) c.r += add; else if (c.r + c.rs > at - 1 && c.r <= at - 1) c.rs += add;
    });
    cell.rs += add; m.nRows += add;
    if (m.rowAttrs) m.rowAttrs.splice(at, 0, ...Array(add).fill([]));
  }
  const parts = (n, k) => { const out = [], base = Math.floor(n / k); let rest = n - base * k; for (let i = 0; i < k; i++) { out.push(base + (rest > 0 ? 1 : 0)); rest--; } return out; };
  const pr = parts(cell.rs, rows), pc = parts(cell.cs, cols);
  const sub = [];
  let rr = cell.r;
  pr.forEach((h, i) => {
    let cc = cell.c;
    pc.forEach((w, j) => { sub.push({ el: i === 0 && j === 0 ? cell.el : newCellLike(cell.el), r: rr, c: cc, rs: h, cs: w }); cc += w; });
    rr += h;
  });
  m.cells = m.cells.filter(c => c !== cell).concat(sub);
  setColWidths(m.t, widths);
  return { focus: cell.el };
}
function splitDialog() {
  if (!currentCell()) { toast('Поместите курсор в ячейку'); return; }
  showModal(`<h3>Разделить ячейку</h3><div class="grid2">
    <div><label>Число столбцов</label><input type="number" id="spC" value="2" min="1" max="20"></div>
    <div><label>Число строк</label><input type="number" id="spR" value="1" min="1" max="50"></div></div>`,
    () => { const c = clamp(parseInt($('spC').value) || 1, 1, 20), r = clamp(parseInt($('spR').value) || 1, 1, 50); tableOp(sr => splitCellOp(sr, r, c)); });
}
function distributeCols() { tableOp(sr => { setColWidths(sr.m.t, Array(sr.m.nCols).fill(1)); }); }
function autofitCols() {
  tableOp(sr => {
    const t = sr.m.t; const cg = Array.from(t.children).find(c => c.tagName === 'COLGROUP'); if (cg) cg.remove();
    t.style.tableLayout = 'auto';
    const m = readTable(t), g = buildGrid(m), w = Array(m.nCols).fill(0);
    for (let c = 0; c < m.nCols; c++) for (let r = 0; r < m.nRows; r++) { const x = g[r][c]; if (x && x.cs === 1) w[c] = Math.max(w[c], x.el.offsetWidth); }
    t.style.tableLayout = ''; if (!t.getAttribute('style')) t.removeAttribute('style');
    setColWidths(t, w.map(x => x || 20));
  });
}
function cellsInSel(sr) { return sr.m.cells.filter(c => c.r <= sr.r1 && c.r + c.rs - 1 >= sr.r0 && c.c <= sr.c1 && c.c + c.cs - 1 >= sr.c0).map(c => c.el); }
function cellStyle(prop, val) { tableOp(sr => { cellsInSel(sr).forEach(el => { el.style[prop] = val; if (!el.getAttribute('style')) el.removeAttribute('style'); }); }); }
function toggleBorders() { const c = currentCell(); if (!c) return; c.closest('table').classList.toggle('no-borders'); changed(); }
function toggleRepeatHeader() {
  const c = currentCell(); if (!c) return;
  const t = c.closest('table');
  if (t.dataset.repeatHeader === '1') delete t.dataset.repeatHeader; else t.dataset.repeatHeader = '1';
  changed(); toast(t.dataset.repeatHeader ? 'Первая строка будет повторяться на каждой странице' : 'Повтор заголовка выключен');
}
function insertTable(rows, cols) {
  restoreSelection();
  let html = '<table><colgroup>' + Array(cols).fill(`<col style="width:${round(100 / cols, 3)}%">`).join('') + '</colgroup><tbody>';
  for (let r = 0; r < rows; r++) html += '<tr>' + Array(cols).fill('<td><br></td>').join('') + '</tr>';
  html += '</tbody></table>';
  insertBlockHTML(html, true);
  const tables = editor.querySelectorAll('table');
  changed();
  void tables;
}
/* вставка блочного HTML на место текущего абзаца */
function insertBlockHTML(html, paraAfter) {
  restoreSelection();
  const r = getRange();
  const tmp = document.createElement('div'); tmp.innerHTML = html;
  const nodes = Array.from(tmp.childNodes);
  let b = r ? closestBlock(r.startContainer) : null;
  while (b && b.parentElement !== editor && !/^(TD|TH|LI|BLOCKQUOTE)$/.test(b.parentElement.tagName)) b = b.parentElement;
  if (b && /^(TD|TH)$/.test(b.tagName)) b = null;
  let after;
  if (b) {
    const empty = !b.textContent.trim() && !b.querySelector('img');
    if (empty) { b.replaceWith(...nodes); }
    else {
      // разрезаем абзац в точке курсора
      const rr = document.createRange(); rr.setStart(r.endContainer, r.endOffset); rr.setEndAfter(b.lastChild || b);
      const tail = rr.extractContents();
      const nb = b.cloneNode(false); nb.removeAttribute('id'); nb.appendChild(tail);
      if (!b.textContent && !b.querySelector('img,br')) b.innerHTML = '<br>';
      b.after(...nodes);
      if (nb.textContent.trim() || nb.querySelector('img')) nodes[nodes.length - 1].after(nb);
    }
  } else if (r) {
    r.deleteContents(); const frag = document.createDocumentFragment(); nodes.forEach(n => frag.appendChild(n)); r.insertNode(frag);
  } else nodes.forEach(n => editor.appendChild(n));
  const last = nodes[nodes.length - 1];
  after = last.nextElementSibling;
  if (paraAfter && (!after || after.tagName === 'TABLE' || after.classList.contains('manual-break'))) {
    after = document.createElement('p'); after.innerHTML = '<br>'; last.after(after);
  }
  const target = (nodes[0].tagName === 'TABLE' ? nodes[0].querySelector('td,th') : null) || after || last;
  const rg = document.createRange(); rg.selectNodeContents(target); rg.collapse(true);
  const s = getSelection(); s.removeAllRanges(); s.addRange(rg);
  return nodes;
}

/* --- изменение ширины столбцов мышью --- */
let colHover = null;
function startColResize(t, idx) {
  const start = colWidths(t), total = t.offsetWidth || 1;
  const min = 100 * 18 / total;
  return {
    move(dxPx) {
      const dp = dxPx / total * 100;
      const w = start.slice();
      if (idx + 1 < w.length) {
        w[idx] = clamp(start[idx] + dp, min, start[idx] + start[idx + 1] - min);
        w[idx + 1] = start[idx] + start[idx + 1] - w[idx];
      }
      const cols = ensureColgroup(t); cols.forEach((c, i) => c.style.width = round(w[i], 3) + '%');
      drawRulers();
    },
    end() { changed(); }
  };
}
editor.addEventListener('mousemove', e => {
  if (e.buttons) return;
  const cell = e.target.closest && e.target.closest('td,th');
  colHover = null;
  if (cell && !cell.closest('[data-pb]')) {
    const r = cell.getBoundingClientRect();
    const t = cell.closest('table'), m = readTable(t), c = m.cells.find(x => x.el === cell);
    if (c) {
      if (Math.abs(e.clientX - r.right) < 4 && c.c + c.cs < m.nCols) colHover = { t, idx: c.c + c.cs - 1 };
      else if (Math.abs(e.clientX - r.left) < 4 && c.c > 0) colHover = { t, idx: c.c - 1 };
    }
  }
  editor.classList.toggle('col-resize-hover', !!colHover);
});
editor.addEventListener('mousedown', e => {
  if (!colHover || e.button !== 0) return;
  e.preventDefault(); e.stopPropagation();
  const h = colHover, s = wsGeom().s, x0 = e.clientX;
  const drag = startColResize(h.t, h.idx);
  const move = ev => { drag.move((ev.clientX - x0) / s); guide('v', ev.clientX); };
  const up = () => { document.removeEventListener('mousemove', move); document.removeEventListener('mouseup', up); guide(null); drag.end(); };
  document.addEventListener('mousemove', move); document.addEventListener('mouseup', up);
}, true);

/* Tab в таблице */
function tableTab(back) {
  const cell = currentCell(); if (!cell) return false;
  const t = cell.closest('table'), cells = Array.from(t.querySelectorAll('td,th')).filter(c => c.closest('table') === t && !c.closest('[data-pb]'));
  let i = cells.indexOf(cell) + (back ? -1 : 1);
  if (i >= cells.length) { tableOp(sr => { sr.r0 = sr.r1 = sr.m.nRows - 1; insertRows(sr, true); }); const cs = Array.from(t.querySelectorAll('td,th')).filter(c => c.closest('table') === t && !c.closest('[data-pb]')); i = cs.length - readTable(t).nCols; selectCellContents(cs[Math.max(0, i)]); return true; }
  if (i < 0) return true;
  selectCellContents(cells[i]);
  return true;
}
function selectCellContents(c) {
  if (!c) return;
  const r = document.createRange(); r.selectNodeContents(c);
  if (isEmptyCell(c)) r.collapse(true);
  const s = getSelection(); s.removeAllRanges(); s.addRange(r);
}
/* =====================================================================
   РИСУНКИ: вставка (файл/URL/буфер/перетаскивание), выделение,
   изменение размера маркерами, обтекание, рамка
   ===================================================================== */
let selectedImg = null;
const imgOverlay = $('imgOverlay');
function contentWidth() { const d = dims(); return d.W - d.ml - d.mr; }
function insertImageSrc(src) {
  return new Promise(res => {
    const probe = new Image();
    probe.onload = () => {
      restoreSelection();
      const w = Math.min(probe.naturalWidth || 300, contentWidth());
      const html = `<img src="${src}" alt="" style="width:${Math.round(w)}px">`;
      document.execCommand('insertHTML', false, html);
      changed(); res();
    };
    probe.onerror = () => { toast('Не удалось загрузить изображение'); res(); };
    probe.src = src;
  });
}
function fileToDataURL(f) { return new Promise((res, rej) => { const r = new FileReader(); r.onload = () => res(r.result); r.onerror = rej; r.readAsDataURL(f); }); }
async function insertImageFiles(files) {
  for (const f of files) if (f.type.startsWith('image/')) await insertImageSrc(await fileToDataURL(f));
}
function insertImageDialog() {
  showModal(`<h3>Вставить рисунок</h3>
    <button class="mbtn primary" id="imgFromFile" style="width:100%;margin-bottom:12px">Выбрать файл на компьютере…</button>
    <label>или адрес изображения (URL)</label><input type="url" id="imgUrl" placeholder="https://…">
    <div class="hint">Также можно вставить рисунок из буфера (Ctrl+V) или перетащить файл в документ.</div>`,
    () => { const u = $('imgUrl').value.trim(); if (u) insertImageSrc(u); });
  $('imgFromFile').onclick = () => { closeModal(); $('imageFile').click(); };
}
$('imageFile').addEventListener('change', e => { insertImageFiles(Array.from(e.target.files)); e.target.value = ''; });

function selectImage(img) {
  if (selectedImg && selectedImg !== img) selectedImg.classList.remove('selected-img');
  selectedImg = img;
  if (!img) { imgOverlay.style.display = 'none'; updateContextTabs(); return; }
  img.classList.add('selected-img');
  const r = document.createRange(); r.selectNode(img); const s = getSelection(); s.removeAllRanges(); s.addRange(r);
  updateImgOverlay(); updateContextTabs();
}
function updateImgOverlay() {
  if (!selectedImg || !selectedImg.isConnected) { if (selectedImg) selectedImg = null; imgOverlay.style.display = 'none'; return; }
  const { ws, s } = wsGeom(), r = selectedImg.getBoundingClientRect();
  Object.assign(imgOverlay.style, { display: 'block', left: (r.left - ws.left) / s + 'px', top: (r.top - ws.top) / s + 'px', width: r.width / s + 'px', height: r.height / s + 'px' });
  imgOverlay.querySelector('.sz').textContent = `${cm(px2mm(r.width / s))} × ${cm(px2mm(r.height / s))}`;
}
editor.addEventListener('click', e => {
  const img = e.target.closest && e.target.closest('img');
  if (img && editor.contains(img)) { selectImage(img); return; }
  if (selectedImg) selectImage(null);
  const a = e.target.closest && e.target.closest('a[href]');
  if (a && (e.ctrlKey || e.metaKey)) { e.preventDefault(); const h = a.getAttribute('href'); if (h.startsWith('#')) jumpTo(h.slice(1)); else window.open(h, '_blank', 'noopener'); }
});
editor.addEventListener('mouseover', e => { const a = e.target.closest && e.target.closest('a[href]'); if (a && !a.title) a.title = a.getAttribute('href') + '\nCtrl+щелчок — перейти'; });
document.addEventListener('keydown', e => { if (selectedImg && (e.key === 'Delete' || e.key === 'Backspace') && !e.target.closest('.modal')) { e.preventDefault(); imgDelete(); } }, true);
imgOverlay.addEventListener('mousedown', e => {
  const h = e.target.dataset.h; if (!h || !selectedImg) return;
  e.preventDefault(); e.stopPropagation();
  const img = selectedImg, s = wsGeom().s, x0 = e.clientX, y0 = e.clientY;
  const w0 = img.getBoundingClientRect().width / s, h0 = img.getBoundingClientRect().height / s, ratio = h0 / w0 || 1;
  const maxW = contentWidth();
  const move = ev => {
    const dx = (ev.clientX - x0) / s * (h.includes('w') ? -1 : 1), dy = (ev.clientY - y0) / s * (h.includes('n') ? -1 : 1);
    if (h === 's') { img.style.height = Math.max(10, h0 + dy) + 'px'; img.style.width = w0 + 'px'; }
    else if (h === 'e') { img.style.width = clamp(w0 + dx, 10, maxW) + 'px'; img.style.height = h0 + 'px'; }
    else {
      let w = clamp(Math.max(w0 + dx, (h0 + dy) / ratio), 10, maxW);
      img.style.width = w + 'px'; img.style.height = (ev.shiftKey ? Math.max(10, h0 + dy) : w * ratio) + 'px';
      if (!ev.shiftKey) img.style.height = '';
    }
    updateImgOverlay();
  };
  const up = () => { document.removeEventListener('mousemove', move); document.removeEventListener('mouseup', up); changed(); };
  document.addEventListener('mousemove', move); document.addEventListener('mouseup', up);
});
function imgWrap(mode) {
  const img = selectedImg; if (!img) return;
  img.classList.remove('img-left', 'img-right', 'img-center');
  if (mode !== 'inline') img.classList.add('img-' + mode);
  img.style.margin = ''; img.style.float = ''; img.style.display = '';
  if (!img.getAttribute('style')) img.removeAttribute('style');
  changed(); updateImgOverlay();
}
function imgSize(pct) { if (!selectedImg) return; selectedImg.style.width = Math.round(contentWidth() * pct / 100) + 'px'; selectedImg.style.height = ''; changed(); updateImgOverlay(); }
function imgBorder() { if (!selectedImg) return; selectedImg.classList.toggle('img-border'); changed(); }
function imgDelete() { if (!selectedImg) return; const i = selectedImg; selectImage(null); i.remove(); changed(); }
function imgDialog() {
  const img = selectedImg; if (!img) return;
  const r = img.getBoundingClientRect(), s = wsGeom().s;
  const w = round(px2mm(r.width / s) / 10, 2), h = round(px2mm(r.height / s) / 10, 2);
  showModal(`<h3>Размер и замещающий текст</h3><div class="grid2">
    <div><label>Ширина, см</label><input type="number" id="imW" step="0.1" value="${w}"></div>
    <div><label>Высота, см</label><input type="number" id="imH" step="0.1" value="${h}"></div></div>
    <label class="chk"><input type="checkbox" id="imLock" checked>Сохранять пропорции</label>
    <label>Замещающий текст</label><input type="text" id="imAlt" value="${esc(img.alt || '')}">`,
    () => {
      const nw = parseFloat($('imW').value) * 10 * MM, nh = parseFloat($('imH').value) * 10 * MM;
      if ($('imLock').checked) { img.style.width = Math.min(nw, contentWidth()) + 'px'; img.style.height = ''; }
      else { img.style.width = Math.min(nw, contentWidth()) + 'px'; img.style.height = nh + 'px'; }
      img.alt = $('imAlt').value; changed(); updateImgOverlay();
    });
  const lockSync = src => { if (!$('imLock').checked) return; const k = h / w; if (src === 'w') $('imH').value = round(parseFloat($('imW').value) * k, 2); else $('imW').value = round(parseFloat($('imH').value) / k, 2); };
  $('imW').oninput = () => lockSync('w'); $('imH').oninput = () => lockSync('h');
}

/* =====================================================================
   ПОИСК И ЗАМЕНА (Ctrl+F / Ctrl+H)
   ===================================================================== */
const find = { matches: [], idx: -1 };
const hasHL = !!(window.CSS && CSS.highlights && window.Highlight);
function textIndex() {
  const nodes = []; let text = '';
  const w = document.createTreeWalker(editor, NodeFilter.SHOW_TEXT, { acceptNode: n => n.parentElement.closest('[data-pb]') ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT });
  let n, lastBlock = null;
  while ((n = w.nextNode())) {
    const b = closestBlock(n);
    if (lastBlock && b !== lastBlock) text += '\n';
    lastBlock = b;
    nodes.push({ n, start: text.length }); text += n.nodeValue;
  }
  return { nodes, text };
}
function posToPoint(idx, pos, isEnd) {
  let lo = 0, hi = idx.nodes.length - 1;
  while (lo < hi) { const m = (lo + hi + 1) >> 1; if (idx.nodes[m].start <= pos - (isEnd ? 1 : 0)) lo = m; else hi = m - 1; }
  const it = idx.nodes[lo]; return [it.n, clamp(pos - it.start, 0, it.n.nodeValue.length)];
}
function runFind(keepIdx) {
  const q = $('findInput').value;
  find.matches = [];
  if (hasHL) { CSS.highlights.delete('find-all'); CSS.highlights.delete('find-cur'); }
  if (!q) { $('findCount').textContent = ''; return; }
  const idx = textIndex();
  const flags = $('findCase').checked ? 'g' : 'gi';
  const src = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const re = new RegExp($('findWord').checked ? `(?<![\\p{L}\\p{N}_])${src}(?![\\p{L}\\p{N}_])` : src, flags + 'u');
  let m;
  while ((m = re.exec(idx.text)) && find.matches.length < 5000) {
    if (!m[0].length) { re.lastIndex++; continue; }
    const [sn, so] = posToPoint(idx, m.index, false), [en, eo] = posToPoint(idx, m.index + m[0].length, true);
    const r = document.createRange(); r.setStart(sn, so); r.setEnd(en, eo); find.matches.push(r);
  }
  if (!keepIdx) {
    const cur = getRange();
    find.idx = cur ? find.matches.findIndex(r => r.compareBoundaryPoints(Range.START_TO_START, cur) >= 0) : 0;
    if (find.idx < 0) find.idx = 0;
  } else find.idx = Math.min(find.idx, find.matches.length - 1);
  paintFind();
}
function paintFind() {
  const n = find.matches.length;
  $('findCount').textContent = n ? `${find.idx + 1} из ${n}` : 'Нет совпадений';
  if (hasHL) {
    CSS.highlights.set('find-all', new Highlight(...find.matches));
    if (find.matches[find.idx]) CSS.highlights.set('find-cur', new Highlight(find.matches[find.idx]));
  }
  const r = find.matches[find.idx];
  if (r) {
    const rect = r.getBoundingClientRect(), c = canvas.getBoundingClientRect();
    if (rect.top < c.top + 30 || rect.bottom > c.bottom - 30) canvas.scrollTop += rect.top - c.top - c.height / 3;
  }
}
function findStep(dir) {
  if (!find.matches.length) runFind();
  if (!find.matches.length) return;
  find.idx = (find.idx + dir + find.matches.length) % find.matches.length;
  paintFind();
  if (!hasHL) { const s = getSelection(); s.removeAllRanges(); s.addRange(find.matches[find.idx]); }
}
function openFind(replace) {
  $('findPanel').classList.remove('hidden');
  const showR = replace || !$('replaceInput').classList.contains('hidden');
  ['replaceInput', 'btnReplaceOne', 'btnReplaceAll'].forEach(id => $(id).classList.toggle('hidden', !showR));
  const r = getRange();
  if (r && !r.collapsed && r.toString().length < 200 && !r.toString().includes('\n')) $('findInput').value = r.toString();
  $(replace ? 'replaceInput' : 'findInput').focus(); $('findInput').select();
  runFind();
}
function closeFind() {
  $('findPanel').classList.add('hidden');
  if (hasHL) { CSS.highlights.delete('find-all'); CSS.highlights.delete('find-cur'); }
  const r = find.matches[find.idx];
  editor.focus({ preventScroll: true });
  if (r) { const s = getSelection(); s.removeAllRanges(); s.addRange(r); }
  find.matches = [];
}
function replaceOne() {
  if (!find.matches.length) runFind();
  const r = find.matches[find.idx]; if (!r) return;
  const s = getSelection(); s.removeAllRanges(); s.addRange(r);
  document.execCommand('insertText', false, $('replaceInput').value);
  changed(); runFind(true); paintFind();
}
function replaceAll() {
  runFind(); const n = find.matches.length; if (!n) return;
  const val = $('replaceInput').value;
  for (let i = n - 1; i >= 0; i--) {
    const r = find.matches[i];
    const sn = r.startContainer, so = r.startOffset;
    r.deleteContents();
    if (sn.nodeType === 3) sn.insertData(so, val); else r.insertNode(document.createTextNode(val));
  }
  editor.normalize();
  changed(); runFind(); toast(`Заменено: ${n}`);
}
$('findInput').addEventListener('input', () => runFind());
$('findCase').addEventListener('change', () => runFind());
$('findWord').addEventListener('change', () => runFind());
$('findInput').addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); findStep(e.shiftKey ? -1 : 1); } if (e.key === 'Escape') closeFind(); });
$('replaceInput').addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); replaceOne(); } if (e.key === 'Escape') closeFind(); });
$('findNext').onclick = () => findStep(1); $('findPrev').onclick = () => findStep(-1);
$('btnReplaceOne').onclick = replaceOne; $('btnReplaceAll').onclick = replaceAll;
$('findClose').onclick = closeFind;
$('findToggleReplace').onclick = () => openFind($('replaceInput').classList.contains('hidden'));

/* =====================================================================
   ВСТАВКА: разрывы, линия, ссылки, закладки, символы, дата, код,
   оглавление, сноски
   ===================================================================== */
function insertPageBreak() { insertBlockHTML('<div class="manual-break" contenteditable="false"></div>', true); changed(); scrollCaretIntoView(); }
function insertBlankPage() { insertBlockHTML('<div class="manual-break" contenteditable="false"></div><p><br></p><div class="manual-break" contenteditable="false"></div>', true); changed(); }
function insertHr() { insertBlockHTML('<hr>', true); changed(); }
function insertCodeBlock() { insertBlockHTML('<pre><br></pre>', true); const pre = getRange() && closestBlock(getRange().startContainer); changed(); void pre; }
function linkDialog(targetA) {
  let a = targetA && editor.contains(targetA) ? targetA : null;
  if (a) {
    const rg = document.createRange();
    rg.selectNodeContents(a);
    const s = window.getSelection();
    s.removeAllRanges();
    s.addRange(rg);
    savedRange = rg.cloneRange();
  } else {
    restoreSelection();
  }

  const r = getRange();
  if (!a && r) {
    const n = r.startContainer.nodeType === 1 ? r.startContainer : r.startContainer.parentNode;
    a = n.closest('a[href]');
  }

  const bms = Array.from(editor.querySelectorAll('h1[id],h2[id],h3[id],h4[id],a[id]:not([href])'));
  showModal(`<h3>${a ? 'Изменить' : 'Вставить'} ссылку</h3>
    <label>Текст ссылки</label><input type="text" id="lkText" value="${esc(a ? a.textContent : (r ? r.toString() : ''))}">
    <label>Адрес (URL, e-mail или место в документе)</label><input type="text" id="lkUrl" list="lkBms" value="${esc(a ? a.getAttribute('href') : '')}" placeholder="https://…">
    <datalist id="lkBms">${bms.map(b => `<option value="#${b.id}">${esc(b.textContent.slice(0, 60) || b.id)}</option>`).join('')}</datalist>
    ${a ? '<button class="mbtn danger" id="lkRemove" style="margin-bottom:8px">Удалить ссылку</button>' : ''}`,
    () => {
      let url = $('lkUrl').value.trim(); const text = $('lkText').value;
      if (!url) return;
      if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(url)) url = 'mailto:' + url;
      else if (!/^(https?:|mailto:|tel:|#|\/|ftp:)/i.test(url)) url = 'https://' + url;
      if (a && editor.contains(a)) {
        a.setAttribute('href', url);
        if (text && text !== a.textContent) a.textContent = text;
      }
      else if (r && !r.collapsed && (!text || text === r.toString())) {
        document.execCommand('createLink', false, url);
      }
      else {
        document.execCommand('insertHTML', false, `<a href="${esc(url)}">${esc(text || url)}</a>`);
      }
      changed();
    });
  if (a) $('lkRemove').onclick = () => { a.replaceWith(...a.childNodes); closeModal(); changed(); };
  setTimeout(() => $('lkUrl').focus(), 30);
}
function bookmarkDialog() {
  restoreSelection();
  showModal(`<h3>Закладка</h3><label>Имя закладки</label><input type="text" id="bmName" placeholder="Например: глава1">
    <div class="hint">Затем на закладку можно сослаться: Вставка → Ссылка → «#имя».</div>`, () => {
    const n = $('bmName').value.trim().replace(/\s+/g, '_'); if (!n) return;
    restoreSelection(); document.execCommand('insertHTML', false, `<a id="${esc(n)}"></a>`); changed();
  });
}
const SYMBOLS = '© ® ™ § ¶ ° ± × ÷ ≈ ≠ ≤ ≥ ∞ √ ∑ ∏ ∫ ∂ ∆ π α β γ δ ε λ μ σ φ ω Ω € £ ¥ ₽ $ ¢ « » „ “ ” ‘ ’ – — … • · ‰ № ½ ¼ ¾ ¹ ² ³ → ← ↑ ↓ ↔ ⇒ ⇔ ✓ ✔ ✗ ✘ ★ ☆ ♥ ♦ ♣ ♠ ☐ ☑ ☒ ⌀ ∅ ∈ ∉ ∩ ∪ ⊂ ⊃ ∀ ∃ ¬ ∧ ∨ ′ ″ ‹ › ¡ ¿ ß æ œ ø'.split(' ');
function symbolDialog() {
  restoreSelection();
  showModal(`<h3>Символ</h3><div class="sym-grid">${SYMBOLS.map(s => `<button data-s="${s}" title="U+${s.codePointAt(0).toString(16).toUpperCase().padStart(4, '0')}">${s}</button>`).join('')}</div>
    <div class="hint" style="margin-top:10px">Неразрывный пробел — Ctrl+Shift+Пробел, неразрывный дефис — Ctrl+Shift+−</div>`, null, { okText: 'Закрыть', noCancel: true });
  $('modalBox').querySelectorAll('.sym-grid button').forEach(b => b.onclick = () => { restoreSelection(); document.execCommand('insertText', false, b.dataset.s); changed(); });
}
function dateDialog() {
  restoreSelection();
  const d = new Date();
  const fmts = [d.toLocaleDateString('ru-RU'), d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }) ,
    d.toLocaleDateString('ru-RU', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }), d.toISOString().slice(0, 10),
    d.toLocaleDateString('ru-RU', { month: 'long', year: 'numeric' }), d.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' }),
    d.toLocaleString('ru-RU', { dateStyle: 'short', timeStyle: 'short' })];
  showModal(`<h3>Дата и время</h3>${fmts.map(f => `<button class="mi" data-f="${esc(f)}">${esc(f)}</button>`).join('')}`, null, { okText: 'Отмена', noCancel: true });
  $('modalBox').querySelectorAll('[data-f]').forEach(b => b.onclick = () => { closeModal(); restoreSelection(); document.execCommand('insertText', false, b.dataset.f); changed(); });
}
/* оглавление */
function headingsList() { return Array.from(editor.querySelectorAll('h1,h2,h3,h4')).filter(h => !h.closest('[data-pb]') && !h.closest('.toc') && h.textContent.trim()); }
function buildTocHTML() {
  const hs = headingsList();
  hs.forEach(h => { if (!h.id) h.id = 'h-' + Math.random().toString(36).slice(2, 8); });
  return `<div class="toc" contenteditable="false"><div class="toc-h">Оглавление</div>` +
    (hs.length ? hs.map(h => `<div class="toc-e toc-l${h.tagName[1]}" data-target="${h.id}"><span class="toc-t">${esc(h.textContent.trim())}</span><span class="toc-d"></span><span class="toc-n">1</span></div>`).join('')
      : '<div class="toc-e" style="color:#888">Нет заголовков. Примените стили «Заголовок 1–4».</div>') + '</div>';
}
function insertToc() {
  const old = editor.querySelector('.toc');
  if (old) { old.outerHTML = buildTocHTML(); changed(); toast('Оглавление обновлено'); return; }
  insertBlockHTML(buildTocHTML(), true); changed();
}
function updateToc() { const t = editor.querySelector('.toc'); if (!t) { toast('В документе нет оглавления'); return; } t.outerHTML = buildTocHTML(); changed(); toast('Оглавление обновлено'); }
function removeToc() { const t = editor.querySelector('.toc'); if (t) { t.remove(); changed(); } }
function updateTocNumbers() {
  const toc = editor.querySelector('.toc'); if (!toc) return;
  const step = pageStep();
  toc.querySelectorAll('.toc-e[data-target]').forEach(e => {
    const h = document.getElementById(e.dataset.target);
    const n = e.querySelector('.toc-n');
    if (h && n) { const p = Math.floor(relRect(h).top / step) + 1; if (n.textContent !== String(p)) n.textContent = p; }
  });
}
editor.addEventListener('click', e => {
  const t = e.target.closest && e.target.closest('.toc-e[data-target]');
  if (t) jumpTo(t.dataset.target);
});
function jumpTo(id) {
  const el = document.getElementById(id); if (!el || !editor.contains(el)) return;
  const c = canvas.getBoundingClientRect(), r = el.getBoundingClientRect();
  canvas.scrollTop += r.top - c.top - 40;
  const rg = document.createRange(); rg.selectNodeContents(el); rg.collapse(true); const s = getSelection(); s.removeAllRanges(); s.addRange(rg);
  editor.focus({ preventScroll: true });
}
/* сноски (концевые) */
function insertFootnote() {
  restoreSelection();
  let list = editor.querySelector('ol.footnotes');
  const n = (list ? list.children.length : 0) + 1;
  const id = 'fn' + Date.now().toString(36);
  document.execCommand('insertHTML', false, `<sup><a href="#${id}" id="${id}-ref">${n}</a></sup>`);
  if (!list) {
    const hr = document.createElement('hr'); hr.className = 'fn-sep';
    list = document.createElement('ol'); list.className = 'footnotes'; list.style.fontSize = '9pt';
    editor.appendChild(hr); editor.appendChild(list);
  }
  const li = document.createElement('li'); li.id = id; li.innerHTML = '<br>';
  list.appendChild(li);
  const r = document.createRange(); r.selectNodeContents(li); r.collapse(true); const s = getSelection(); s.removeAllRanges(); s.addRange(r);
  changed(); scrollCaretIntoView();
}
/* =====================================================================
