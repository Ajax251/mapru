<!DOCTYPE html>
<html lang="ru" id="htmlRoot">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" href="img/leaf.png" type="image/png">
<title>Документ 1 — Листик</title>
<script src="webfonts/lucide.min.js"></script>
<script src="webfonts/jszip.min.js"></script>
<script src="webfonts/mammoth.browser.min.js"></script>
<style id="pageRule">@page { size: 210mm 297mm; margin: 0; }</style>
<style>
/* ===================== UI: ПЕРЕМЕННЫЕ ===================== */
:root{
  --accent:#185abd; --accent-dark:#103f86; --accent-soft:#cfe4fb;
  --canvas-bg:#e9e8e7; --panel-bg:#fff; --panel-border:#e1dfdd; --ribbon-bg:#f8f8f8;
  --text-main:#201f1e; --text-muted:#605e5c; --hover-bg:#eaf2fb;
  --ruler-bg:#ffffff; --ruler-margin:#d6d6d6; --ruler-tick:#5f5f5f;
}
html.dark{
  --canvas-bg:#1e1e1e; --panel-bg:#2b2a29; --panel-border:#3b3a39; --ribbon-bg:#252423;
  --text-main:#f3f2f1; --text-muted:#b3b0ad; --hover-bg:#3a3937; --accent-soft:#2c4a73;
  --ruler-bg:#3a3937; --ruler-margin:#262524; --ruler-tick:#c8c6c4;
}
*{box-sizing:border-box}
html,body{margin:0;height:100%}
body{font-family:'Segoe UI',Tahoma,Arial,sans-serif;color:var(--text-main);background:var(--canvas-bg);overflow:hidden;font-size:13px}
button{font-family:inherit}
.hidden{display:none!important}
svg.lucide{width:16px;height:16px;stroke-width:1.75}
.big svg.lucide{width:22px;height:22px}
#app{display:flex;flex-direction:column;height:100vh}

/* ===================== TITLE BAR ===================== */
.titlebar{background:var(--accent);color:#fff;height:38px;display:flex;align-items:center;gap:4px;padding:0 8px;user-select:none;flex-shrink:0}
html.dark .titlebar,html.dark .tabs,html.dark .statusbar{background:var(--accent-dark)}
.tbtn{width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border:0;background:transparent;color:inherit;border-radius:4px;cursor:pointer}
.tbtn:hover{background:rgba(255,255,255,.18)}
.tbtn:disabled{opacity:.4;cursor:default;background:transparent}
#docTitle{margin:0 auto;font-size:13px;padding:3px 8px;border-radius:4px;cursor:text;max-width:40vw;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#docTitle:hover{background:rgba(255,255,255,.15)}
#docTitle[contenteditable=true]{background:#fff;color:#000;outline:none}
#saveState{font-size:12px;opacity:.85;margin-right:6px;white-space:nowrap}

/* ===================== RIBBON ===================== */
.tabs{background:var(--accent);display:flex;align-items:flex-end;padding:2px 6px 0;gap:2px;user-select:none;flex-shrink:0;overflow-x:auto}
.tab{padding:6px 14px;color:rgba(255,255,255,.92);font-size:13px;cursor:pointer;border:0;background:transparent;border-radius:4px 4px 0 0;white-space:nowrap}
.tab:hover{background:rgba(255,255,255,.12)}
.tab.active{background:var(--ribbon-bg);color:var(--accent)}
html.dark .tab.active{color:#7fb2ff}
.tab.ctx{color:#ffe08a;font-weight:600}
.tab.ctx.active{color:#b06d00}
.ribbon{background:var(--ribbon-bg);border-bottom:1px solid var(--panel-border);min-height:96px;user-select:none;flex-shrink:0;overflow-x:auto;overflow-y:hidden}
.panel{display:flex;align-items:stretch;padding:4px 4px 2px;min-height:94px}
.group{display:flex;flex-direction:column;justify-content:space-between;align-items:center;padding:2px 8px;border-right:1px solid var(--panel-border);flex-shrink:0}
.group-body{display:flex;gap:3px;align-items:flex-start;flex:1}
.group-label{font-size:11px;color:var(--text-muted);margin-top:2px;white-space:nowrap}
.col{display:flex;flex-direction:column;gap:3px}
.row{display:flex;gap:2px;align-items:center}
.rb{display:inline-flex;align-items:center;justify-content:center;gap:4px;min-width:28px;height:28px;padding:0 5px;border-radius:4px;border:1px solid transparent;background:transparent;color:var(--text-main);cursor:pointer;font-size:13px;white-space:nowrap;position:relative}
.rb:hover{background:var(--hover-bg);border-color:var(--panel-border)}
.rb.active{background:var(--accent-soft);border-color:var(--accent)}
.rb:disabled{opacity:.4;cursor:default}
.rb.big{flex-direction:column;min-width:54px;height:70px;font-size:11px;gap:3px;padding:2px 4px;line-height:1.1;text-align:center}
.rb.big span{max-width:76px;white-space:normal}
.rb .caret{font-size:0;width:0;height:0;border-left:3.5px solid transparent;border-right:3.5px solid transparent;border-top:4px solid currentColor;opacity:.75;display:inline-block;margin:0 1px}
.rsel,.rinp{height:26px;border:1px solid var(--panel-border);border-radius:4px;background:var(--panel-bg);color:var(--text-main);font-size:12px;padding:0 4px}
.rinp{width:52px}
.color-bar{position:absolute;left:5px;right:5px;bottom:3px;height:3px;border-radius:1px}
.styles-gallery{display:flex;gap:3px;flex-wrap:nowrap}
.style-card{width:84px;height:62px;border:1px solid var(--panel-border);background:var(--panel-bg);border-radius:4px;cursor:pointer;display:flex;flex-direction:column;justify-content:center;padding:4px 6px;overflow:hidden;color:#000}
html.dark .style-card{color:var(--text-main)}
.style-card:hover{border-color:var(--accent)}
.style-card.active{border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}
.style-card .sample{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.style-card .sname{font-size:10px;color:var(--text-muted);margin-top:2px}

/* Выпадающие меню */
.dropdown{position:fixed;z-index:300;background:var(--panel-bg);color:var(--text-main);border:1px solid var(--panel-border);border-radius:6px;box-shadow:0 8px 28px rgba(0,0,0,.22);padding:4px;min-width:180px;max-height:70vh;overflow:auto;user-select:none}
.mi{display:flex;align-items:center;gap:8px;width:100%;padding:6px 10px;border:0;background:transparent;color:inherit;text-align:left;border-radius:4px;cursor:pointer;font-size:13px;white-space:nowrap}
.mi:hover{background:var(--hover-bg)}
.mi.danger{color:#c42b1c}
.mi .kbd{margin-left:auto;color:var(--text-muted);font-size:11px;padding-left:16px}
.msep{border-top:1px solid var(--panel-border);margin:4px 2px}
.mhead{font-size:11px;color:var(--text-muted);padding:4px 10px 2px}
.palette{display:grid;grid-template-columns:repeat(10,18px);gap:3px;padding:6px}
.swatch{width:18px;height:18px;border:1px solid rgba(0,0,0,.15);border-radius:2px;cursor:pointer}
.swatch:hover{outline:2px solid var(--accent)}
.grid-picker{display:grid;grid-template-columns:repeat(10,18px);gap:2px;padding:6px}
.grid-picker div{width:18px;height:18px;border:1px solid var(--panel-border);background:var(--panel-bg)}
.grid-picker div.hl{background:var(--accent-soft);border-color:var(--accent)}

/* ===================== ОСНОВНАЯ ОБЛАСТЬ ===================== */
.main{flex:1;display:flex;min-height:0}
#navPane{width:260px;background:var(--panel-bg);border-right:1px solid var(--panel-border);display:flex;flex-direction:column;flex-shrink:0}
#navPane h4{margin:10px 12px 6px;font-size:13px;display:flex;align-items:center}
#navList{overflow:auto;flex:1;padding:0 6px 10px}
.nav-item{padding:4px 8px;border-radius:4px;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:12.5px}
.nav-item:hover{background:var(--hover-bg)}
.nav-item.current{background:var(--accent-soft)}
.doc-area{flex:1;display:flex;flex-direction:column;min-width:0;position:relative}
.hruler-row{height:24px;display:flex;flex-shrink:0;background:var(--canvas-bg);border-bottom:1px solid var(--panel-border)}
.ruler-corner{width:24px;flex-shrink:0}
#rulerH{flex:1;height:24px;display:block;min-width:0}
.doc-body{flex:1;display:flex;min-height:0}
#rulerV{width:24px;flex-shrink:0;display:block;background:var(--canvas-bg);border-right:1px solid var(--panel-border)}
.no-rulers .hruler-row,.no-rulers #rulerV{display:none}
#canvas{flex:1;overflow:auto;position:relative;overflow-anchor:none;min-width:0}
#workspace{position:relative;margin:24px auto 40px}
#sheets{position:absolute;left:0;top:0;width:100%;pointer-events:none}
.sheet{position:absolute;left:0;width:100%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.2),0 4px 14px rgba(0,0,0,.08);overflow:hidden}
.sheet .hf{position:absolute;display:flex;font-size:9pt;color:#444;font-family:var(--font);line-height:1.2;white-space:pre}
.sheet .hf>div{flex:1}
.sheet .hf .c{text-align:center}.sheet .hf .r{text-align:right}
.sheet .wm{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) rotate(-45deg);font-family:Calibri,Arial,sans-serif;font-weight:700;white-space:nowrap;user-select:none;letter-spacing:4px}
.sheet .crop{position:absolute;width:14px;height:14px;border-color:#b8b8b8;border-style:solid;border-width:0}
.show-marks .sheet .crop{display:block}
#guideV,#guideH{position:absolute;pointer-events:none;z-index:50;display:none}
#guideV{top:0;bottom:0;width:0;border-left:1px dashed #333}
#guideH{left:0;right:0;height:0;border-top:1px dashed #333}
#rulerTip{position:absolute;z-index:60;background:#333;color:#fff;font-size:11px;padding:2px 6px;border-radius:3px;pointer-events:none;display:none;white-space:nowrap}

/* ===================== ЛИСТ / РЕДАКТОР ===================== */
.paper{
  position:relative;outline:none;color:#000;
  font-family:var(--font);font-size:var(--fsize);line-height:var(--lh);
  white-space:pre-wrap;word-wrap:break-word;overflow-wrap:break-word;
  tab-size:47.24px;-moz-tab-size:47.24px;caret-color:#000;
}
.paper::selection,.paper *::selection{background:#b4d3f5}
.paper p{margin:var(--pbefore) 0 var(--pafter)}
.paper li{margin:0}
.paper p{text-indent:var(--pindent);text-align:var(--palign)}
.paper li{text-align:var(--palign)}
.paper ul,.paper ol{margin:var(--pbefore) 0 var(--pafter);padding-left:1.25cm}
.paper li>ul,.paper li>ol{margin:0}
.paper li>p{margin:0;text-indent:0}
.paper ol:not(.multi) ol:not(.multi){list-style-type:lower-alpha}
.paper ol:not(.multi) ol:not(.multi) ol:not(.multi){list-style-type:lower-roman}
.paper ol:not(.multi) ol:not(.multi) ol:not(.multi) ol:not(.multi){list-style-type:decimal}
.paper ol.multi{list-style:none;counter-reset:mitem}
.paper ol.multi>li{counter-increment:mitem}
.paper ol.multi>li::marker{content:counters(mitem,".") ". "}
.paper ul.dash{list-style-type:"– "}
.paper ul.check{list-style-type:"✓  "}
.paper h1,.paper h2,.paper h3,.paper h4{font-weight:normal;line-height:1.15;page-break-after:avoid}
.paper h1{font-size:16pt;color:#2f5496;margin:12pt 0 0}
.paper h2{font-size:13pt;color:#2f5496;margin:2pt 0 0}
.paper h3{font-size:12pt;color:#1f3763;margin:2pt 0 0}
.paper h4{font-size:var(--fsize);color:#2f5496;font-style:italic;margin:2pt 0 0}
.paper .doc-title{font-size:28pt;line-height:1;letter-spacing:-.5px;margin:0 0 4pt;text-indent:0}
.paper .doc-subtitle{font-size:var(--fsize);color:#5a5a5a;letter-spacing:.75pt;margin:0 0 8pt;text-indent:0}
.paper .no-spacing{margin:0!important}
.paper blockquote{margin:10pt 1cm;font-style:italic;color:#404040;text-align:center}
.paper blockquote.intense{border-top:1px solid #4472c4;border-bottom:1px solid #4472c4;color:#4472c4;padding:6pt 0}
.paper pre{font-family:Consolas,'Courier New',monospace;font-size:10pt;background:#f4f4f4;border:1px solid #e1e1e1;padding:6pt 8pt;margin:0 0 var(--pafter);white-space:pre-wrap;line-height:1.3}
.paper code{font-family:Consolas,'Courier New',monospace;font-size:.92em;background:#f2f2f2;padding:0 2px}
.paper a{color:#0563c1;text-decoration:underline}
.paper hr{border:0;border-top:1px solid #000;margin:6pt 0;height:0}
.paper img{max-width:100%;height:auto;vertical-align:bottom}
.paper img.img-center{display:block;margin-left:auto;margin-right:auto}
.paper img.img-left{float:left;margin:2px 12px 6px 0}
.paper img.img-right{float:right;margin:2px 0 6px 12px}
.paper img.img-border{border:1px solid #000}
.paper img.selected-img{outline:2px solid var(--accent);outline-offset:1px}
.paper table{border-collapse:collapse;width:100%;table-layout:fixed;margin:0 0 var(--pafter);white-space:pre-wrap}
.paper td,.paper th{border:1px solid #000;padding:0 .19cm;vertical-align:top;word-break:break-word;overflow-wrap:anywhere;min-width:12px}
.paper th{font-weight:bold;background:#f2f2f2}
.paper td>p,.paper th>p{margin:0;text-indent:0}
.paper table.no-borders td,.paper table.no-borders th{border:1px dashed #c6d4e6}
.paper td.selected-cell,.paper th.selected-cell{background-image:linear-gradient(rgba(24,90,189,.18),rgba(24,90,189,.18))!important}
.paper.col-resize-hover,.paper.col-resize-hover *{cursor:col-resize!important}
.paper .manual-break{display:block;height:18px;margin:0;user-select:none;position:relative;text-indent:0;cursor:default}
.paper .manual-break::after{content:'Разрыв страницы';position:absolute;left:0;right:0;top:8px;border-top:1px dotted #8a8a8a;font-size:9px;color:#8a8a8a;text-align:center;line-height:0;font-family:'Segoe UI',Arial,sans-serif;font-style:normal}
.paper .toc{margin:0 0 var(--pafter);user-select:none;cursor:default;white-space:normal;border:1px dashed transparent}
.paper .toc:hover{border-color:#c6d4e6}
.paper .toc .toc-h{font-size:14pt;color:#2f5496;margin-bottom:6pt}
.paper .toc .toc-e{display:flex;align-items:baseline;cursor:pointer;margin:0 0 3pt}
.paper .toc .toc-e:hover .toc-t{text-decoration:underline}
.paper .toc .toc-e .toc-d{flex:1;border-bottom:1.5px dotted #555;margin:0 4px;transform:translateY(-3px)}
.paper .toc .toc-l2{padding-left:.6cm}.paper .toc .toc-l3{padding-left:1.2cm}.paper .toc .toc-l4{padding-left:1.8cm}
/* Пагинация (служебные элементы, не сохраняются) */
.paper .pb-push{margin-top:var(--pb-mt)!important}
.paper .pb-line{display:inline-block;width:0;vertical-align:baseline;user-select:none;pointer-events:none}
.paper tr.pb-spacer>td{border:0!important;padding:0!important;background:transparent!important}
.paper tr.pb-ghost>td,.paper tr.pb-ghost>th{user-select:none;pointer-events:none}
/* Знаки форматирования */
.show-marks .paper p:not(.manual-break)::after,.show-marks .paper li::after,.show-marks .paper h1::after,.show-marks .paper h2::after,.show-marks .paper h3::after,.show-marks .paper h4::after{content:'¶';color:#4a8bd6;font-style:normal;font-weight:normal;text-decoration:none}
.show-marks .paper br::after{content:'↵'}
.show-marks .paper table.no-borders td{border-color:#9fb6d6}

/* Режим чтения */
body.reading .ribbon,body.reading .tabs,body.reading .hruler-row,body.reading #rulerV{display:none}
/* Подсветка поиска */
::highlight(find-all){background:#fff17a}
::highlight(find-cur){background:#ff9f2e;color:#000}

/* ===================== ОВЕРЛЕИ РИСУНКА ===================== */
#imgOverlay{position:absolute;border:1px solid var(--accent);pointer-events:none;z-index:40;display:none}
#imgOverlay .h{position:absolute;width:9px;height:9px;background:#fff;border:1px solid var(--accent);pointer-events:auto}
#imgOverlay .nw{left:-5px;top:-5px;cursor:nwse-resize}#imgOverlay .ne{right:-5px;top:-5px;cursor:nesw-resize}
#imgOverlay .sw{left:-5px;bottom:-5px;cursor:nesw-resize}#imgOverlay .se{right:-5px;bottom:-5px;cursor:nwse-resize}
#imgOverlay .e{right:-5px;top:calc(50% - 5px);cursor:ew-resize}#imgOverlay .s{bottom:-5px;left:calc(50% - 5px);cursor:ns-resize}
#imgOverlay .sz{position:absolute;bottom:-22px;left:0;background:#333;color:#fff;font-size:10px;padding:1px 4px;border-radius:2px;white-space:nowrap}

/* ===================== СТРОКА СОСТОЯНИЯ ===================== */
.statusbar{background:var(--accent);color:#fff;height:26px;font-size:12px;display:flex;align-items:center;gap:10px;padding:0 10px;user-select:none;flex-shrink:0}
.statusbar .sb-item{cursor:default;white-space:nowrap}
.statusbar .sb-click{cursor:pointer;padding:1px 4px;border-radius:3px}
.statusbar .sb-click:hover{background:rgba(255,255,255,.18)}
.statusbar .sp{margin-left:auto}
.statusbar .tbtn{width:24px;height:22px}
.statusbar .tbtn.active{background:rgba(255,255,255,.25)}
#zoomSlider{width:110px;accent-color:#fff;cursor:pointer}

/* ===================== МОДАЛКИ / ПАНЕЛИ ===================== */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.35);display:none;align-items:center;justify-content:center;z-index:400}
.modal-overlay.open{display:flex}
.modal{background:var(--panel-bg);color:var(--text-main);border-radius:8px;padding:18px 20px;width:380px;max-width:94vw;max-height:90vh;overflow:auto;box-shadow:0 12px 40px rgba(0,0,0,.35)}
.modal.wide{width:520px}
.modal h3{margin:0 0 12px;font-size:16px;font-weight:600}
.modal label{font-size:12.5px;display:block;margin:0 0 3px;color:var(--text-muted)}
.modal input[type=text],.modal input[type=number],.modal input[type=url],.modal select,.modal textarea{width:100%;height:30px;border:1px solid var(--panel-border);border-radius:4px;padding:0 8px;background:var(--panel-bg);color:var(--text-main);margin-bottom:10px;font-family:inherit;font-size:13px}
.modal input[type=checkbox]{margin-right:6px;vertical-align:middle}
.modal .chk{display:flex;align-items:center;color:var(--text-main);margin-bottom:8px;font-size:13px}
.modal .grid2{display:grid;grid-template-columns:1fr 1fr;gap:0 12px}
.modal .grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:0 10px}
.modal fieldset{border:1px solid var(--panel-border);border-radius:6px;padding:8px 10px 2px;margin:0 0 10px}
.modal legend{font-size:12px;padding:0 4px;color:var(--text-muted)}
.modal .hint{font-size:11.5px;color:var(--text-muted);margin:-4px 0 10px}
.modal .actions{display:flex;justify-content:flex-end;gap:8px;margin-top:8px}
.mbtn{padding:7px 16px;border-radius:4px;border:1px solid var(--panel-border);cursor:pointer;font-size:13px;background:transparent;color:var(--text-main)}
.mbtn.primary{background:var(--accent);border-color:var(--accent);color:#fff}
.mbtn:hover{filter:brightness(1.05)}
.sym-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:3px}
.sym-grid button{height:30px;border:1px solid var(--panel-border);background:var(--panel-bg);color:var(--text-main);border-radius:3px;cursor:pointer;font-size:16px}
.sym-grid button:hover{background:var(--hover-bg);border-color:var(--accent)}
.stat-table{width:100%;border-collapse:collapse;font-size:13px}
.stat-table td{padding:5px 2px;border-bottom:1px solid var(--panel-border)}
.stat-table td:last-child{text-align:right;font-weight:600}
#findPanel{position:absolute;top:30px;right:22px;z-index:70;background:var(--panel-bg);border:1px solid var(--panel-border);border-radius:8px;box-shadow:0 8px 28px rgba(0,0,0,.2);padding:10px;width:330px}
#findPanel input[type=text]{width:100%;height:28px;border:1px solid var(--panel-border);border-radius:4px;padding:0 8px;background:var(--panel-bg);color:var(--text-main);margin-bottom:6px}
#findPanel .row{gap:4px;flex-wrap:wrap}
#findCount{font-size:12px;color:var(--text-muted);margin-left:auto}
.toast{position:fixed;left:50%;bottom:40px;transform:translateX(-50%);background:#323130;color:#fff;padding:9px 16px;border-radius:6px;z-index:500;font-size:13px;box-shadow:0 6px 20px rgba(0,0,0,.3);opacity:0;transition:opacity .2s;pointer-events:none}
.toast.show{opacity:1}
#dropHint{position:fixed;inset:0;background:rgba(24,90,189,.15);border:3px dashed var(--accent);z-index:450;display:none;align-items:center;justify-content:center;font-size:20px;color:var(--accent);pointer-events:none}

/* ===================== ПЕЧАТЬ ===================== */
@media print{
  html,body{height:auto!important;overflow:visible!important;background:#fff!important}
  #app{display:block!important;height:auto!important}
  .titlebar,.tabs,.ribbon,.statusbar,#navPane,.hruler-row,#rulerV,#findPanel,#imgOverlay,.dropdown,.modal-overlay,.toast,#guideV,#guideH{display:none!important}
  .main,.doc-area,.doc-body{display:block!important}
  #canvas{overflow:visible!important;height:auto!important}
  #workspace{margin:0!important;zoom:1!important}
  .sheet{box-shadow:none!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .paper *{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .paper .manual-break::after{display:none}
  .paper table.no-borders td,.paper table.no-borders th{border-color:transparent!important}
  .paper .toc{border-color:transparent!important}
  .paper img.selected-img{outline:none}
  .paper td.selected-cell{background-image:none!important}
  .show-marks .paper *::after{content:none!important}
  .paper{orphans:1;widows:1}
  body.has-print-root>*:not(#printRoot){display:none!important}
  #printRoot{display:block!important}
  .print-page{position:relative;overflow:hidden;break-after:page;page-break-after:always;margin:0;padding:0}
  .print-page:last-child{break-after:auto;page-break-after:auto}
}
#printRoot{display:none}
</style>
</head>
<body>
<div id="app">
  <!-- ============ ЗАГОЛОВОК ============ -->
  <header class="titlebar">
    <i data-lucide="file-text"></i>
    <button class="tbtn" data-act="newDoc" title="Создать"><i data-lucide="file-plus-2"></i></button>
    <button class="tbtn" data-act="open" title="Открыть (Ctrl+O)"><i data-lucide="folder-open"></i></button>
    <button class="tbtn" data-act="save" title="Сохранить (Ctrl+S)"><i data-lucide="save"></i></button>
    <button class="tbtn" data-act="undo" id="btnUndo" title="Отменить (Ctrl+Z)"><i data-lucide="undo-2"></i></button>
    <button class="tbtn" data-act="redo" id="btnRedo" title="Повторить (Ctrl+Y)"><i data-lucide="redo-2"></i></button>
    <button class="tbtn" data-act="print" title="Печать (Ctrl+P)"><i data-lucide="printer"></i></button>
    <button class="tbtn" data-act="pageSetup" title="Параметры страницы"><i data-lucide="settings"></i></button>
    <span id="docTitle" title="Щёлкните, чтобы переименовать">Документ 1</span>
    <span id="saveState"></span>
    <button class="tbtn" data-act="find" title="Найти (Ctrl+F)"><i data-lucide="search"></i></button>
    <button class="tbtn" data-act="toggleTheme" title="Светлая / тёмная тема"><i data-lucide="moon" id="themeIcon"></i></button>
    <button class="tbtn" data-act="fullscreen" title="Во весь экран (F11)"><i data-lucide="maximize"></i></button>
  </header>

  <!-- ============ ВКЛАДКИ ============ -->
  <nav class="tabs" id="tabs">
    <button class="tab" data-tab="file">Файл</button>
    <button class="tab active" data-tab="home">Главная</button>
    <button class="tab" data-tab="insert">Вставка</button>
    <button class="tab" data-tab="design">Конструктор</button>
    <button class="tab" data-tab="layout">Макет</button>
    <button class="tab" data-tab="refs">Ссылки</button>
    <button class="tab" data-tab="review">Рецензирование</button>
    <button class="tab" data-tab="view">Вид</button>
    <button class="tab ctx hidden" data-tab="table" id="tabTable">Макет таблицы</button>
    <button class="tab ctx hidden" data-tab="image" id="tabImage">Формат рисунка</button>
  </nav>

  <!-- ============ ЛЕНТА ============ -->
  <section class="ribbon" id="ribbon">

    <!-- ФАЙЛ -->
    <div class="panel hidden" data-panel="file">
      <div class="group"><div class="group-body">
        <button class="rb big" data-act="newDoc"><i data-lucide="file-plus-2"></i><span>Создать</span></button>
        <button class="rb big" data-act="open" title="Открыть DOCX, HTML, TXT, MD (Ctrl+O)"><i data-lucide="folder-open"></i><span>Открыть</span></button>
        <button class="rb big" data-act="save" title="Ctrl+S"><i data-lucide="save"></i><span>Сохранить</span></button>
        <button class="rb big" data-act="saveAs" title="F12"><i data-lucide="save-all"></i><span>Сохранить как</span></button>
      </div><div class="group-label">Документ</div></div>
      <div class="group"><div class="group-body">
        <button class="rb big" data-act="exportDocx"><i data-lucide="file-text"></i><span>Word (.docx)</span></button>
        <button class="rb big" data-act="exportPdf"><i data-lucide="file-down"></i><span>PDF</span></button>
        <button class="rb big" data-act="exportHtml"><i data-lucide="code"></i><span>Веб‑страница</span></button>
        <button class="rb big" data-act="exportMd"><i data-lucide="hash"></i><span>Markdown</span></button>
        <button class="rb big" data-act="exportTxt"><i data-lucide="file-type-2"></i><span>Текст</span></button>
      </div><div class="group-label">Экспорт</div></div>
      <div class="group"><div class="group-body">
        <button class="rb big" data-act="print"><i data-lucide="printer"></i><span>Печать</span></button>
        <button class="rb big" data-act="docProps"><i data-lucide="info"></i><span>Свойства</span></button>
      </div><div class="group-label">Прочее</div></div>
    </div>

    <!-- ГЛАВНАЯ -->
    <div class="panel" data-panel="home">
      <div class="group"><div class="group-body">
        <button class="rb big" data-act="paste" title="Вставить (Ctrl+V)"><i data-lucide="clipboard-paste"></i><span>Вставить</span></button>
        <div class="col">
          <button class="rb" data-act="cut" title="Вырезать (Ctrl+X)"><i data-lucide="scissors"></i></button>
          <button class="rb" data-act="copy" title="Копировать (Ctrl+C)"><i data-lucide="copy"></i></button>
          <button class="rb" data-act="formatPainter" id="btnPainter" title="Формат по образцу (двойной щелчок — многократно)"><i data-lucide="paintbrush"></i></button>
        </div>
      </div><div class="group-label">Буфер обмена</div></div>

      <div class="group"><div class="group-body"><div class="col">
        <div class="row">
          <input class="rsel" id="fontFamily" list="fontList" style="width:140px" title="Шрифт">
          <datalist id="fontList"></datalist>
          <input class="rsel" id="fontSize" list="sizeList" style="width:52px" title="Размер шрифта (пт)">
          <datalist id="sizeList"></datalist>
          <button class="rb" data-act="growFont" title="Увеличить размер (Ctrl+])"><i data-lucide="a-arrow-up"></i></button>
          <button class="rb" data-act="shrinkFont" title="Уменьшить размер (Ctrl+[)"><i data-lucide="a-arrow-down"></i></button>
          <button class="rb" data-menu="case" title="Регистр (Shift+F3)">Aa<span class="caret"></span></button>
          <button class="rb" data-act="clearFormat" title="Очистить всё форматирование"><i data-lucide="remove-formatting"></i></button>
        </div>
        <div class="row">
          <button class="rb" data-act="bold" data-state="bold" title="Полужирный (Ctrl+B)"><b>Ж</b></button>
          <button class="rb" data-act="italic" data-state="italic" title="Курсив (Ctrl+I)"><i style="font-family:Georgia">К</i></button>
          <button class="rb" data-act="underline" data-state="underline" title="Подчёркнутый (Ctrl+U)"><u>Ч</u></button>
          <button class="rb" data-act="strikeThrough" data-state="strikeThrough" title="Зачёркнутый"><s>abc</s></button>
          <button class="rb" data-act="subscript" data-state="subscript" title="Подстрочный (Ctrl+=)">x<sub>2</sub></button>
          <button class="rb" data-act="superscript" data-state="superscript" title="Надстрочный (Ctrl+Shift+=)">x<sup>2</sup></button>
          <button class="rb" data-act="applyTextColor" title="Цвет текста"><i data-lucide="baseline"></i><span class="color-bar" id="textColorBar" style="background:#c00000"></span></button>
          <button class="rb" data-menu="textColor" style="min-width:14px;padding:0 1px" title="Выбрать цвет текста"><span class="caret"></span></button>
          <button class="rb" data-act="applyHighlight" title="Цвет выделения текста"><i data-lucide="highlighter"></i><span class="color-bar" id="hlColorBar" style="background:#ffff00"></span></button>
          <button class="rb" data-menu="highlight" style="min-width:14px;padding:0 1px" title="Выбрать цвет выделения"><span class="caret"></span></button>
        </div>
      </div></div><div class="group-label">Шрифт</div></div>

      <div class="group"><div class="group-body"><div class="col">
        <div class="row">
          <button class="rb" data-act="bullets" data-state="insertUnorderedList" title="Маркеры"><i data-lucide="list"></i></button>
          <button class="rb" data-menu="bullets" style="min-width:14px;padding:0 1px"><span class="caret"></span></button>
          <button class="rb" data-act="numbering" data-state="insertOrderedList" title="Нумерация"><i data-lucide="list-ordered"></i></button>
          <button class="rb" data-menu="numbering" style="min-width:14px;padding:0 1px"><span class="caret"></span></button>
          <button class="rb" data-act="outdent" title="Уменьшить отступ"><i data-lucide="indent-decrease"></i></button>
          <button class="rb" data-act="indent" title="Увеличить отступ"><i data-lucide="indent-increase"></i></button>
          <button class="rb" data-act="toggleMarks" id="btnMarks" title="Знаки форматирования (Ctrl+*)"><i data-lucide="pilcrow"></i></button>
        </div>
        <div class="row">
          <button class="rb" data-act="alignLeft" data-align="left" title="По левому краю (Ctrl+L)"><i data-lucide="align-left"></i></button>
          <button class="rb" data-act="alignCenter" data-align="center" title="По центру (Ctrl+E)"><i data-lucide="align-center"></i></button>
          <button class="rb" data-act="alignRight" data-align="right" title="По правому краю (Ctrl+R)"><i data-lucide="align-right"></i></button>
          <button class="rb" data-act="alignJustify" data-align="justify" title="По ширине (Ctrl+J)"><i data-lucide="align-justify"></i></button>
          <button class="rb" data-menu="spacing" title="Интервал между строками и абзацами"><i data-lucide="list-collapse"></i><span class="caret"></span></button>
          <button class="rb" data-menu="shading" title="Заливка абзаца"><i data-lucide="paint-bucket"></i><span class="caret"></span></button>
          <button class="rb" data-act="paragraphDialog" title="Параметры абзаца"><i data-lucide="settings-2"></i></button>
        </div>
      </div></div><div class="group-label">Абзац</div></div>

      <div class="group"><div class="group-body styles-gallery" id="stylesGallery"></div><div class="group-label">Стили</div></div>

      <div class="group"><div class="group-body"><div class="col">
        <button class="rb" data-act="find" title="Ctrl+F" style="justify-content:flex-start"><i data-lucide="search"></i> Найти</button>
        <button class="rb" data-act="replace" title="Ctrl+H" style="justify-content:flex-start"><i data-lucide="replace"></i> Заменить</button>
        <button class="rb" data-act="selectAll" title="Ctrl+A" style="justify-content:flex-start"><i data-lucide="text-select"></i> Выделить всё</button>
      </div></div><div class="group-label">Редактирование</div></div>
    </div>

    <!-- ВСТАВКА -->
    <div class="panel hidden" data-panel="insert">
      <div class="group"><div class="group-body">
        <button class="rb big" data-act="pageBreak" title="Ctrl+Enter"><i data-lucide="separator-horizontal"></i><span>Разрыв страницы</span></button>
        <button class="rb big" data-act="blankPage"><i data-lucide="file-plus"></i><span>Пустая страница</span></button>
      </div><div class="group-label">Страницы</div></div>
      <div class="group"><div class="group-body">
        <button class="rb big" data-menu="table"><i data-lucide="table"></i><span>Таблица <span class="caret"></span></span></button>
      </div><div class="group-label">Таблицы</div></div>
      <div class="group"><div class="group-body">
        <button class="rb big" data-act="insertImage"><i data-lucide="image"></i><span>Рисунок</span></button>
        <button class="rb big" data-act="insertHr"><i data-lucide="minus"></i><span>Линия</span></button>
      </div><div class="group-label">Иллюстрации</div></div>
      <div class="group"><div class="group-body">
        <button class="rb big" data-act="link" title="Ctrl+K"><i data-lucide="link"></i><span>Ссылка</span></button>
        <button class="rb big" data-act="bookmark"><i data-lucide="bookmark"></i><span>Закладка</span></button>
      </div><div class="group-label">Ссылки</div></div>
      <div class="group"><div class="group-body">
        <button class="rb big" data-act="headerFooter"><i data-lucide="panel-top"></i><span>Колонтитулы</span></button>
        <button class="rb big" data-menu="pageNum"><i data-lucide="hash"></i><span>Номер страницы <span class="caret"></span></span></button>
      </div><div class="group-label">Колонтитулы</div></div>
      <div class="group"><div class="group-body">
        <button class="rb big" data-act="dateTime"><i data-lucide="calendar"></i><span>Дата и время</span></button>
        <button class="rb big" data-act="symbol"><i data-lucide="omega"></i><span>Символ</span></button>
        <button class="rb big" data-act="insertCode"><i data-lucide="square-code"></i><span>Блок кода</span></button>
      </div><div class="group-label">Текст и символы</div></div>
    </div>

    <!-- КОНСТРУКТОР -->
    <div class="panel hidden" data-panel="design">
      <div class="group"><div class="group-body">
        <button class="rb big" data-menu="docFont"><i data-lucide="type"></i><span>Шрифт документа <span class="caret"></span></span></button>
        <button class="rb big" data-act="gostPreset" title="Times New Roman 14, 1,5 интервала, отступ 1,25 см, по ширине, поля 30/15/20/20 мм"><i data-lucide="graduation-cap"></i><span>ГОСТ / реферат</span></button>
        <button class="rb big" data-act="wordPreset"><i data-lucide="file-text"></i><span>Стиль Word</span></button>
        <button class="rb big" data-act="defaultsDialog"><i data-lucide="sliders-horizontal"></i><span>Стиль «Обычный»…</span></button>
      </div><div class="group-label">Форматирование документа</div></div>
      <div class="group"><div class="group-body">
        <button class="rb big" data-menu="watermark"><i data-lucide="droplet"></i><span>Подложка <span class="caret"></span></span></button>
        <button class="rb big" data-menu="pageColor"><i data-lucide="palette"></i><span>Цвет страницы <span class="caret"></span></span></button>
      </div><div class="group-label">Фон страницы</div></div>
    </div>

    <!-- МАКЕТ -->
    <div class="panel hidden" data-panel="layout">
      <div class="group"><div class="group-body">
        <button class="rb big" data-menu="margins"><i data-lucide="square-dashed"></i><span>Поля <span class="caret"></span></span></button>
        <button class="rb big" data-menu="orientation"><i data-lucide="rectangle-vertical" id="orientIcon"></i><span>Ориентация <span class="caret"></span></span></button>
        <button class="rb big" data-menu="paperSize"><i data-lucide="files"></i><span>Размер <span class="caret"></span></span></button>
        <button class="rb big" data-act="pageSetup"><i data-lucide="settings"></i><span>Параметры страницы</span></button>
      </div><div class="group-label">Параметры страницы</div></div>
      <div class="group"><div class="group-body"><div class="col">
        <div class="mhead" style="padding:0">Отступ, см</div>
        <div class="row"><span style="width:44px">Слева</span><input type="number" class="rinp" id="indLeft" step="0.25"></div>
        <div class="row"><span style="width:44px">Справа</span><input type="number" class="rinp" id="indRight" step="0.25"></div>
      </div><div class="col">
        <div class="mhead" style="padding:0">Интервал, пт</div>
        <div class="row"><span style="width:44px">Перед</span><input type="number" class="rinp" id="spBefore" step="6" min="0"></div>
        <div class="row"><span style="width:44px">После</span><input type="number" class="rinp" id="spAfter" step="6" min="0"></div>
      </div></div><div class="group-label">Абзац</div></div>
    </div>

    <!-- ССЫЛКИ -->
    <div class="panel hidden" data-panel="refs">
      <div class="group"><div class="group-body">
        <button class="rb big" data-act="insertToc"><i data-lucide="list-tree"></i><span>Оглавление</span></button>
        <button class="rb big" data-act="updateToc"><i data-lucide="refresh-cw"></i><span>Обновить таблицу</span></button>
        <button class="rb big" data-act="removeToc"><i data-lucide="trash-2"></i><span>Удалить оглавление</span></button>
      </div><div class="group-label">Оглавление</div></div>
      <div class="group"><div class="group-body">
        <button class="rb big" data-act="footnote" title="Вставить сноску (текст в конце документа)"><i data-lucide="superscript"></i><span>Сноска</span></button>
      </div><div class="group-label">Сноски</div></div>
    </div>

    <!-- РЕЦЕНЗИРОВАНИЕ -->
    <div class="panel hidden" data-panel="review">
      <div class="group"><div class="group-body">
        <button class="rb big" data-act="toggleSpell" id="btnSpell"><i data-lucide="spell-check"></i><span>Орфография</span></button>
        <button class="rb big" data-act="wordStats"><i data-lucide="sigma"></i><span>Статистика</span></button>
      </div><div class="group-label">Правописание</div></div>
      <div class="group"><div class="group-body">
        <button class="rb big" data-act="toggleSmart" id="btnSmart" title="«Ёлочки», длинное тире, …"><i data-lucide="wand-sparkles"></i><span>Автозамена</span></button>
      </div><div class="group-label">Параметры</div></div>
    </div>

    <!-- ВИД -->
    <div class="panel hidden" data-panel="view">
      <div class="group"><div class="group-body">
        <button class="rb big" data-act="readMode"><i data-lucide="book-open"></i><span>Режим чтения</span></button>
        <button class="rb big active" data-act="layoutMode"><i data-lucide="layout-panel-top"></i><span>Разметка страницы</span></button>
      </div><div class="group-label">Режимы</div></div>
      <div class="group"><div class="group-body">
        <button class="rb big active" data-act="toggleRulers" id="btnRulers"><i data-lucide="ruler"></i><span>Линейка</span></button>
        <button class="rb big" data-act="toggleNav" id="btnNav"><i data-lucide="panel-left"></i><span>Область навигации</span></button>
        <button class="rb big" data-act="toggleMarks" id="btnMarks2"><i data-lucide="pilcrow"></i><span>Знаки</span></button>
      </div><div class="group-label">Показать</div></div>
      <div class="group"><div class="group-body">
        <button class="rb big" data-act="zoom100"><i data-lucide="search"></i><span>100%</span></button>
        <button class="rb big" data-act="zoomPage"><i data-lucide="file"></i><span>Одна страница</span></button>
        <button class="rb big" data-act="zoomWidth"><i data-lucide="move-horizontal"></i><span>По ширине</span></button>
      </div><div class="group-label">Масштаб</div></div>
      <div class="group"><div class="group-body">
        <button class="rb big" data-act="toggleTheme"><i data-lucide="moon"></i><span>Тёмная тема</span></button>
      </div><div class="group-label">Оформление</div></div>
    </div>

    <!-- МАКЕТ ТАБЛИЦЫ (контекстная) -->
    <div class="panel hidden" data-panel="table">
      <div class="group"><div class="group-body">
        <button class="rb big" data-act="tRowAbove"><i data-lucide="between-horizontal-end"></i><span>Вставить сверху</span></button>
        <button class="rb big" data-act="tRowBelow"><i data-lucide="between-horizontal-start"></i><span>Вставить снизу</span></button>
        <button class="rb big" data-act="tColLeft"><i data-lucide="between-vertical-end"></i><span>Вставить слева</span></button>
        <button class="rb big" data-act="tColRight"><i data-lucide="between-vertical-start"></i><span>Вставить справа</span></button>
      </div><div class="group-label">Строки и столбцы</div></div>
      <div class="group"><div class="group-body"><div class="col">
        <button class="rb" data-act="tDelRow" style="justify-content:flex-start"><i data-lucide="rows-3"></i> Удалить строки</button>
        <button class="rb" data-act="tDelCol" style="justify-content:flex-start"><i data-lucide="columns-3"></i> Удалить столбцы</button>
        <button class="rb danger" data-act="tDelTable" style="justify-content:flex-start;color:#c42b1c"><i data-lucide="trash-2"></i> Удалить таблицу</button>
      </div></div><div class="group-label">Удаление</div></div>
      <div class="group"><div class="group-body">
        <button class="rb big" data-act="tMerge"><i data-lucide="merge"></i><span>Объединить ячейки</span></button>
        <button class="rb big" data-act="tSplit"><i data-lucide="split"></i><span>Разделить ячейку</span></button>
      </div><div class="group-label">Объединение</div></div>
      <div class="group"><div class="group-body">
        <button class="rb big" data-act="tDistribute"><i data-lucide="columns-2"></i><span>Выровнять ширину</span></button>
        <button class="rb big" data-act="tAutofit"><i data-lucide="maximize-2"></i><span>По содержимому</span></button>
        <button class="rb big" data-act="tHeader" id="btnTHeader"><i data-lucide="repeat"></i><span>Повтор заголовка</span></button>
      </div><div class="group-label">Размер</div></div>
      <div class="group"><div class="group-body"><div class="col">
        <div class="row">
          <button class="rb" data-act="tVTop" title="Сверху"><i data-lucide="align-vertical-justify-start"></i></button>
          <button class="rb" data-act="tVMiddle" title="По центру"><i data-lucide="align-vertical-justify-center"></i></button>
          <button class="rb" data-act="tVBottom" title="Снизу"><i data-lucide="align-vertical-justify-end"></i></button>
        </div>
        <div class="row">
          <button class="rb" data-menu="cellShade" title="Заливка ячеек"><i data-lucide="paint-bucket"></i><span class="caret"></span></button>
          <button class="rb" data-act="tBorders" title="Границы вкл/выкл"><i data-lucide="grid-3x3"></i></button>
        </div>
      </div></div><div class="group-label">Ячейки</div></div>
    </div>

    <!-- ФОРМАТ РИСУНКА (контекстная) -->
    <div class="panel hidden" data-panel="image">
      <div class="group"><div class="group-body">
        <button class="rb big" data-act="imgInline"><i data-lucide="text"></i><span>В тексте</span></button>
        <button class="rb big" data-act="imgCenter"><i data-lucide="align-center"></i><span>По центру</span></button>
        <button class="rb big" data-act="imgLeft"><i data-lucide="wrap-text"></i><span>Обтекание слева</span></button>
        <button class="rb big" data-act="imgRight"><i data-lucide="wrap-text" style="transform:scaleX(-1)"></i><span>Обтекание справа</span></button>
      </div><div class="group-label">Положение</div></div>
      <div class="group"><div class="group-body">
        <button class="rb big" data-act="imgSize" data-v="25"><i data-lucide="minimize-2"></i><span>25%</span></button>
        <button class="rb big" data-act="imgSize" data-v="50"><i data-lucide="image"></i><span>50%</span></button>
        <button class="rb big" data-act="imgSize" data-v="100"><i data-lucide="maximize-2"></i><span>По ширине</span></button>
        <button class="rb big" data-act="imgDialog"><i data-lucide="scaling"></i><span>Размер…</span></button>
      </div><div class="group-label">Размер</div></div>
      <div class="group"><div class="group-body">
        <button class="rb big" data-act="imgBorder"><i data-lucide="square"></i><span>Рамка</span></button>
        <button class="rb big" data-act="imgDelete"><i data-lucide="trash-2"></i><span>Удалить</span></button>
      </div><div class="group-label">Рисунок</div></div>
    </div>
  </section>

  <!-- ============ ДОКУМЕНТ ============ -->
  <div class="main">
    <aside id="navPane" class="hidden">
      <h4>Навигация <button class="tbtn" style="margin-left:auto;color:inherit" data-act="toggleNav"><i data-lucide="x"></i></button></h4>
      <div id="navList"></div>
    </aside>
    <div class="doc-area" id="docArea">
      <div class="hruler-row"><div class="ruler-corner"></div><canvas id="rulerH"></canvas></div>
      <div class="doc-body">
        <canvas id="rulerV"></canvas>
        <div id="canvas">
          <div id="workspace">
            <div id="sheets"></div>
            <div class="paper" id="editor" contenteditable="true" spellcheck="false" lang="ru"></div>
            <div id="imgOverlay"><div class="h nw" data-h="nw"></div><div class="h ne" data-h="ne"></div><div class="h sw" data-h="sw"></div><div class="h se" data-h="se"></div><div class="h e" data-h="e"></div><div class="h s" data-h="s"></div><div class="sz"></div></div>
          </div>
        </div>
      </div>
      <div id="guideV"></div><div id="guideH"></div><div id="rulerTip"></div>
      <div id="findPanel" class="hidden">
        <input type="text" id="findInput" placeholder="Найти в документе…">
        <input type="text" id="replaceInput" placeholder="Заменить на…" class="hidden">
        <div class="row" style="margin-bottom:6px">
          <label style="font-size:12px"><input type="checkbox" id="findCase"> Учитывать регистр</label>
          <label style="font-size:12px;margin-left:8px"><input type="checkbox" id="findWord"> Слово целиком</label>
        </div>
        <div class="row">
          <button class="rb" id="findPrev" title="Предыдущее (Shift+Enter)"><i data-lucide="chevron-up"></i></button>
          <button class="rb" id="findNext" title="Следующее (Enter)"><i data-lucide="chevron-down"></i></button>
          <button class="rb hidden" id="btnReplaceOne">Заменить</button>
          <button class="rb hidden" id="btnReplaceAll">Заменить все</button>
          <span id="findCount"></span>
          <button class="rb" id="findToggleReplace" title="Замена"><i data-lucide="replace"></i></button>
          <button class="rb" id="findClose" title="Закрыть (Esc)"><i data-lucide="x"></i></button>
        </div>
      </div>
    </div>
  </div>

  <!-- ============ СТРОКА СОСТОЯНИЯ ============ -->
  <footer class="statusbar">
    <span class="sb-item sb-click" id="pageInfo" title="Перейти к странице">Страница 1 из 1</span>
    <span class="sb-item sb-click" id="wordInfo" title="Статистика">Слов: 0</span>
    <span class="sb-item" id="charInfo">Символов: 0</span>
    <span class="sb-item" id="formatInfo">A4</span>
    <span class="sb-item">Русский</span>
    <span class="sp"></span>
    <button class="tbtn" data-act="readMode" title="Режим чтения"><i data-lucide="book-open"></i></button>
    <button class="tbtn active" data-act="layoutMode" title="Разметка страницы"><i data-lucide="layout-panel-top"></i></button>
    <button class="tbtn" data-act="zoomOut" title="Уменьшить"><i data-lucide="minus"></i></button>
    <input type="range" id="zoomSlider" min="25" max="300" value="100" step="5">
    <button class="tbtn" data-act="zoomIn" title="Увеличить"><i data-lucide="plus"></i></button>
    <span class="sb-item sb-click" id="zoomLabel" style="width:42px;text-align:right" title="Масштаб">100%</span>
  </footer>
</div>

<!-- ============ МОДАЛЬНЫЕ ОКНА ============ -->
<div class="modal-overlay" id="modal"><div class="modal" id="modalBox"></div></div>
<div id="toast" class="toast"></div>
<div id="dropHint">Отпустите файл, чтобы открыть или вставить</div>
<input type="file" id="openFile" accept=".docx,.html,.htm,.txt,.md,.markdown,.doc,.rtf" style="display:none">
<input type="file" id="imageFile" accept="image/*" style="display:none" multiple>
<script>
'use strict';
/* =====================================================================
   ЛИСТ PRO — текстовый редактор в стиле Microsoft Word
   ===================================================================== */
if (!window.lucide) window.lucide = { createIcons(){} };
const $ = id => document.getElementById(id);
const editor = $('editor'), canvas = $('canvas'), workspace = $('workspace'), sheetsEl = $('sheets');
const MM = 96 / 25.4;                 // пикселей в миллиметре
const mm2px = mm => mm * MM, px2mm = px => px / MM;
const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
const round = (v, d = 2) => Math.round(v * 10 ** d) / 10 ** d;
const cm = mm => (round(mm / 10, 2) + '').replace('.', ',') + ' см';
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const isMac = /Mac|iPhone|iPad/.test(navigator.platform);

const PAPERS = {
  A3: [297, 420, 'A3 (29,7 × 42 см)'], A4: [210, 297, 'A4 (21 × 29,7 см)'], A5: [148, 210, 'A5 (14,8 × 21 см)'],
  B5: [176, 250, 'B5 (17,6 × 25 см)'], Letter: [215.9, 279.4, 'Letter (21,59 × 27,94 см)'], Legal: [215.9, 355.6, 'Legal (21,59 × 35,56 см)']
};
const MARGIN_PRESETS = {
  normal:   { name: 'Обычные',   m: { top: 20, bottom: 20, left: 30, right: 15 } },
  narrow:   { name: 'Узкие',     m: { top: 12.7, bottom: 12.7, left: 12.7, right: 12.7 } },
  moderate: { name: 'Средние',   m: { top: 25.4, bottom: 25.4, left: 19.1, right: 19.1 } },
  wide:     { name: 'Широкие',   m: { top: 25.4, bottom: 25.4, left: 50.8, right: 50.8 } },
  gost:     { name: 'ГОСТ 7.32', m: { top: 20, bottom: 20, left: 30, right: 15 } },
  even2:    { name: 'Все по 2 см', m: { top: 20, bottom: 20, left: 20, right: 20 } }
};
const GAP = 24;  // промежуток между страницами на экране

function defaultState() {
  return {
    title: 'Документ 1',
    page: { size: 'A4', w: 210, h: 297, landscape: false,
            margins: { top: 20, bottom: 20, left: 30, right: 15 }, header: 12.5, footer: 12.5, color: '#ffffff' },
    hf: { header: { l: '', c: '', r: '' }, footer: { l: '', c: '', r: '' },
          differentFirst: false, first: { header: { l: '', c: '', r: '' }, footer: { l: '', c: '', r: '' } } },
    watermark: { text: '', color: '#c8c8c8', opacity: 0.45 },
    defaults: { font: 'Calibri', size: 11, lineHeight: 1.15, before: 0, after: 8, indent: 0, align: 'left' },
    props: { author: '', subject: '', keywords: '' }
  };
}
let state = defaultState();
const view = { zoom: 1, rulers: true, marks: false, nav: false, dark: false, smart: true, spell: false, gap: GAP, printing: false };
let fileHandle = null, fileKind = null, dirty = false;

/* -------- геометрия страницы (px) -------- */
function dims() {
  const p = state.page;
  let w = p.w, h = p.h;
  if (p.landscape) [w, h] = [h, w];
  const m = p.margins;
  return { W: mm2px(w), H: mm2px(h), mt: mm2px(m.top), mb: mm2px(m.bottom), ml: mm2px(m.left), mr: mm2px(m.right),
           hd: mm2px(p.header), fd: mm2px(p.footer), wmm: w, hmm: h };
}
const pageStep = () => dims().H + view.gap;

/* -------- уведомления -------- */
let toastTimer;
function toast(msg, ms = 2200) {
  const t = $('toast'); t.textContent = msg; t.classList.add('show');
  clearTimeout(toastTimer); toastTimer = setTimeout(() => t.classList.remove('show'), ms);
}

/* -------- блоки -------- */
const BLOCK_TAGS = new Set(['P','DIV','H1','H2','H3','H4','H5','H6','LI','BLOCKQUOTE','PRE','UL','OL','TABLE','TBODY','THEAD','TFOOT','TR','TD','TH','HR','SECTION','ARTICLE','HEADER','FOOTER','FIGURE','FIGCAPTION','ADDRESS','DL','DT','DD','NAV','ASIDE','MAIN','CAPTION','COLGROUP','COL']);
const TEXT_BLOCKS = new Set(['P','H1','H2','H3','H4','H5','H6','LI','PRE','BLOCKQUOTE','DIV','TD','TH','DT','DD','FIGCAPTION','ADDRESS']);
const isBlock = n => n && n.nodeType === 1 && BLOCK_TAGS.has(n.tagName);
const hasBlockChild = el => Array.from(el.children).some(c => BLOCK_TAGS.has(c.tagName) && c.tagName !== 'BR');

/* текущий блок под курсором */
function closestBlock(node) {
  let n = node && node.nodeType === 3 ? node.parentNode : node;
  while (n && n !== editor) {
    if (n.nodeType === 1 && TEXT_BLOCKS.has(n.tagName) && !(n.tagName === 'DIV' && hasBlockChild(n)) &&
        !(n.tagName === 'BLOCKQUOTE' && hasBlockChild(n))) return n;
    n = n.parentNode;
  }
  return null;
}
function getRange() {
  const s = window.getSelection();
  if (!s.rangeCount) return null;
  const r = s.getRangeAt(0);
  return editor.contains(r.commonAncestorContainer) ? r : null;
}
/* все блоки-абзацы в выделении */
function selectedBlocks(ensure = true) {
  let r = getRange() || savedRange;
  if (!r || !editor.contains(r.commonAncestorContainer)) return [];
  if (ensure) ensureParagraphs();
  const sel = window.getSelection();
  r = sel.rangeCount && editor.contains(sel.getRangeAt(0).commonAncestorContainer) ? sel.getRangeAt(0) : r;
  const start = closestBlock(r.startContainer), end = closestBlock(r.endContainer);
  if (r.collapsed || start === end) return start ? [start] : [];
  const out = [];
  const walker = document.createTreeWalker(editor, NodeFilter.SHOW_ELEMENT, {
    acceptNode: n => n.closest('[data-pb]') ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT });
  let n;
  while ((n = walker.nextNode())) {
    if (closestBlock(n) !== n) continue;
    if (r.intersectsNode(n)) out.push(n);
  }
  if (start && !out.includes(start)) out.unshift(start);
  return out.filter(b => b.tagName !== 'TD' && b.tagName !== 'TH' || !out.some(o => o !== b && b.contains(o)));
}
/* оборачиваем «голый» текст в редакторе и ячейках в <p> */
function ensureParagraphs(root = editor) {
  const wrapLoose = container => {
    let run = [];
    const flush = before => {
      if (!run.length) return;
      if (run.every(n => n.nodeType === 3 && !n.nodeValue.trim())) { run.forEach(n => n.remove()); run = []; return; }
      const p = document.createElement('p');
      container.insertBefore(p, before);
      run.forEach(n => p.appendChild(n)); run = [];
    };
    Array.from(container.childNodes).forEach(n => {
      if (isBlock(n) || (n.nodeType === 1 && n.matches('[data-pb]'))) flush(n);
      else if (n.nodeType === 3 || n.nodeType === 1) run.push(n);
      else n.remove();
    });
    flush(null);
  };
  wrapLoose(root);
  if (!root.firstElementChild) root.innerHTML = '<p><br></p>';
}

/* -------- сохранение выделения для элементов ленты -------- */
let savedRange = null;
document.addEventListener('selectionchange', () => {
  const r = getRange();
  if (r) savedRange = r.cloneRange();
  scheduleUiUpdate();
});
function restoreSelection() {
  const sel = window.getSelection();
  if (getRange()) return;
  editor.focus({ preventScroll: true });
  if (savedRange && editor.contains(savedRange.commonAncestorContainer)) {
    sel.removeAllRanges(); sel.addRange(savedRange);
  } else {
    const r = document.createRange(); r.selectNodeContents(editor.lastElementChild || editor); r.collapse(false);
    sel.removeAllRanges(); sel.addRange(r);
  }
}

/* -------- служебная разметка пагинации -------- */
function stripArtifacts(root) {
  root.querySelectorAll('[data-pb]').forEach(n => { const p = n.parentNode; n.remove(); p && p.normalize && p.normalize(); });
  root.querySelectorAll('.pb-push').forEach(e => {
    e.classList.remove('pb-push'); e.style.removeProperty('--pb-mt');
    if (!e.getAttribute('style')) e.removeAttribute('style');
    if (!e.className) e.removeAttribute('class');
  });
  root.querySelectorAll('.selected-cell,.selected-img').forEach(e => {
    e.classList.remove('selected-cell', 'selected-img'); if (!e.className) e.removeAttribute('class');
  });
}
function getCleanHTML() {
  const c = editor.cloneNode(true); stripArtifacts(c); return c.innerHTML;
}
function cleanClone() { const c = editor.cloneNode(true); stripArtifacts(c); return c; }

/* -------- позиция курсора как смещение в символах (для отмены) -------- */
function unitWalker(root) {
  return document.createTreeWalker(root, NodeFilter.SHOW_TEXT | NodeFilter.SHOW_ELEMENT, {
    acceptNode: n => {
      if (n.nodeType === 1) {
        if (n.hasAttribute('data-pb')) return NodeFilter.FILTER_REJECT;
        return (n.tagName === 'BR' || n.tagName === 'IMG') ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_SKIP;
      }
      return NodeFilter.FILTER_ACCEPT;
    }});
}
function countUnits(root) {
  let n, c = 0; const w = unitWalker(root);
  while ((n = w.nextNode())) c += n.nodeType === 3 ? n.nodeValue.length : 1;
  return c;
}
function pointToOffset(node, off) {
  try { const r = document.createRange(); r.setStart(editor, 0); r.setEnd(node, off); return countUnits(r.cloneContents()); }
  catch (e) { return 0; }
}
function offsetToPoint(target) {
  const w = unitWalker(editor); let n, c = 0, last = null;
  while ((n = w.nextNode())) {
    if (n.nodeType === 3) { if (c + n.nodeValue.length >= target) return [n, target - c]; c += n.nodeValue.length; }
    else { if (c === target) return [n.parentNode, Array.from(n.parentNode.childNodes).indexOf(n)]; c += 1; }
    last = n;
  }
  if (last) return last.nodeType === 3 ? [last, last.nodeValue.length] : [last.parentNode, Array.from(last.parentNode.childNodes).indexOf(last) + 1];
  return [editor, 0];
}
function getSelOffsets() {
  const r = getRange(); if (!r) return null;
  const s = pointToOffset(r.startContainer, r.startOffset);
  return { s, e: r.collapsed ? s : pointToOffset(r.endContainer, r.endOffset) };
}
function setSelOffsets(o) {
  if (!o) return;
  try {
    const [sn, so] = offsetToPoint(o.s), [en, eo] = offsetToPoint(o.e);
    const r = document.createRange(); r.setStart(sn, so); r.setEnd(en, eo);
    const sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(r);
  } catch (e) {}
}

/* -------- история (собственная отмена/повтор) -------- */
const History = {
  stack: [], idx: -1, timer: null,
  snap() { return { html: getCleanHTML(), sel: getSelOffsets() }; },
  reset() { clearTimeout(this.timer); this.timer = null; this.stack = [this.snap()]; this.idx = 0; this.ui(); },
  commit() {
    clearTimeout(this.timer); this.timer = null;
    const s = this.snap(), cur = this.stack[this.idx];
    if (cur && cur.html === s.html) { cur.sel = s.sel || cur.sel; return; }
    this.stack.splice(this.idx + 1); this.stack.push(s);
    if (this.stack.length > 300) this.stack.shift();
    this.idx = this.stack.length - 1; this.ui();
  },
  schedule() { clearTimeout(this.timer); this.timer = setTimeout(() => this.commit(), 450); },
  undo() { if (this.timer) this.commit(); if (this.idx <= 0) return; this.idx--; this.apply(this.stack[this.idx]); },
  redo() { if (this.timer) this.commit(); if (this.idx >= this.stack.length - 1) return; this.idx++; this.apply(this.stack[this.idx]); },
  apply(s) {
    editor.innerHTML = s.html; afterContentLoaded(false);
    editor.focus({ preventScroll: true }); setSelOffsets(s.sel);
    scrollCaretIntoView(); this.ui(); markDirty(false);
  },
  ui() { $('btnUndo').disabled = this.idx <= 0 && !this.timer; $('btnRedo').disabled = this.idx >= this.stack.length - 1; }
};

/* -------- изменение документа -------- */
let paginateTimer = null, autosaveTimer = null;
function markDirty(history = true) {
  dirty = true; $('saveState').textContent = '● Изменено';
  if (history) History.schedule();
  $('btnUndo').disabled = false;
  clearTimeout(autosaveTimer); autosaveTimer = setTimeout(autosave, 1200);
}
/* вызывается после каждой программной операции */
function changed(opts = {}) {
  normalizeFonts();
  if (opts.paginate !== false) paginate();
  History.commit(); markDirty(false);
  updateUi(); drawRulers();
}
function schedulePaginate(delay = 180) {
  clearTimeout(paginateTimer);
  paginateTimer = setTimeout(() => { paginate(); updateUi(); }, delay);
}

/* -------- <font> → <span style> -------- */
const FONT_SIZES_LEGACY = { 1: '8pt', 2: '10pt', 3: '12pt', 4: '14pt', 5: '18pt', 6: '24pt', 7: '36pt' };
function normalizeFonts(root = editor) {
  root.querySelectorAll('font').forEach(f => {
    const span = document.createElement('span');
    span.style.cssText = f.style.cssText;
    if (f.getAttribute('face')) span.style.fontFamily = f.getAttribute('face');
    if (f.getAttribute('color')) span.style.color = f.getAttribute('color');
    if (f.getAttribute('size') && !span.style.fontSize) span.style.fontSize = FONT_SIZES_LEGACY[f.getAttribute('size')] || '';
    while (f.firstChild) span.appendChild(f.firstChild);
    f.replaceWith(span);
  });
}

function scrollCaretIntoView() {
  const r = getRange(); if (!r) return;
  let rect = r.getBoundingClientRect();
  if (!rect.height) { const n = r.startContainer.nodeType === 1 ? r.startContainer : r.startContainer.parentNode; rect = n.getBoundingClientRect(); }
  const c = canvas.getBoundingClientRect();
  if (rect.top < c.top + 20 || rect.bottom > c.bottom - 20) canvas.scrollTop += rect.top - c.top - c.height / 3;
}
/* =====================================================================
   ПАРАМЕТРЫ СТРАНИЦЫ И ВИЗУАЛЬНЫЕ ЛИСТЫ
   ===================================================================== */
let pageCount = 1;
function applyDefaults() {
  const d = state.defaults;
  editor.style.setProperty('--font', `"${d.font}", Calibri, Carlito, Arial, sans-serif`);
  editor.style.setProperty('--fsize', d.size + 'pt');
  editor.style.setProperty('--lh', d.lineHeight);
  editor.style.setProperty('--pbefore', d.before + 'pt');
  editor.style.setProperty('--pafter', d.after + 'pt');
  editor.style.setProperty('--pindent', (d.indent / 10) + 'cm');
  editor.style.setProperty('--palign', d.align);
  sheetsEl.style.setProperty('--font', `"${d.font}", Calibri, Arial, sans-serif`);
  renderStylesGallery && renderStylesGallery();
}
function applyPage(repaginate = true) {
  const d = dims();
  workspace.style.width = d.W + 'px';
  editor.style.padding = `${d.mt}px ${d.mr}px ${d.mb}px ${d.ml}px`;
  $('pageRule').textContent = `@page { size: ${round(d.wmm, 1)}mm ${round(d.hmm, 1)}mm; margin: 0; }`;
  const p = state.page;
  $('formatInfo').textContent = (PAPERS[p.size] ? p.size : `${round(d.wmm / 10, 1)}×${round(d.hmm / 10, 1)} см`) + (p.landscape ? ', альбомная' : '');
  const oi = $('orientIcon'); if (oi) { oi.setAttribute('data-lucide', p.landscape ? 'rectangle-horizontal' : 'rectangle-vertical'); }
  sheetsKey = '';
  if (repaginate) paginate();
  drawRulers();
}

let sheetsKey = '';
function fieldText(s, page) {
  return String(s || '').replace(/\{PAGE\}/g, page).replace(/\{PAGES\}/g, pageCount)
    .replace(/\{DATE\}/g, new Date().toLocaleDateString('ru-RU')).replace(/\{TITLE\}/g, state.title);
}
function renderSheets() {
  const d = dims(), step = d.H + view.gap;
  const wm = state.watermark, hf = state.hf;
  const key = JSON.stringify([pageCount, d.W, d.H, view.gap, hf, wm, state.page, state.title, state.defaults.font]);
  if (key === sheetsKey) return;
  sheetsKey = key;
  let html = '';
  for (let i = 0; i < pageCount; i++) {
    const first = i === 0 && hf.differentFirst;
    const H = first ? hf.first.header : hf.header, F = first ? hf.first.footer : hf.footer;
    const part = (o, cls, style) => (o.l || o.c || o.r) ?
      `<div class="hf ${cls}" style="${style}"><div>${esc(fieldText(o.l, i + 1))}</div><div class="c">${esc(fieldText(o.c, i + 1))}</div><div class="r">${esc(fieldText(o.r, i + 1))}</div></div>` : '';
    const crop = (x, y, bl) => `<div class="crop hidden-marks" style="left:${x}px;top:${y}px;${bl}"></div>`;
    html += `<div class="sheet" style="top:${i * step}px;height:${d.H}px;background:${state.page.color || '#fff'}">` +
      (wm.text ? `<div class="wm" style="color:${wm.color};opacity:${wm.opacity};font-size:${Math.min(d.W, d.H) / Math.max(4, wm.text.length) * 1.25}px">${esc(wm.text)}</div>` : '') +
      part(H, 'hd', `left:${d.ml}px;right:${d.mr}px;top:${d.hd}px`) +
      part(F, 'ft', `left:${d.ml}px;right:${d.mr}px;bottom:${d.fd}px`) +
      (view.marks ? crop(d.ml - 14, d.mt - 14, 'border-right-width:1px;border-bottom-width:1px') + crop(d.W - d.mr, d.mt - 14, 'border-left-width:1px;border-bottom-width:1px') +
        crop(d.ml - 14, d.H - d.mb, 'border-right-width:1px;border-top-width:1px') + crop(d.W - d.mr, d.H - d.mb, 'border-left-width:1px;border-top-width:1px') : '') +
      `</div>`;
  }
  sheetsEl.innerHTML = html;
  sheetsEl.style.height = (pageCount * step - view.gap) + 'px';
}

/* =====================================================================
   АВТОМАТИЧЕСКАЯ РАЗБИВКА НА СТРАНИЦЫ
   Документ — единый поток. Блоки, которые не помещаются на странице,
   сдвигаются на следующую (служебный margin-top), длинные абзацы
   разрываются построчно, таблицы — по строкам (с повтором заголовка).
   Служебная разметка помечена data-pb и не попадает в файл/историю.
   ===================================================================== */
function clearPagination() {
  editor.querySelectorAll('[data-pb]').forEach(n => { const p = n.parentNode; n.remove(); if (p) p.normalize(); });
  editor.querySelectorAll('.pb-push').forEach(e => {
    e.classList.remove('pb-push'); e.style.removeProperty('--pb-mt');
    if (!e.getAttribute('style')) e.removeAttribute('style');
    if (!e.className) e.removeAttribute('class');
