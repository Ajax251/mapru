let geo = null; // кеш геометрии текущего прохода
function geoInit() {
  const r = editor.getBoundingClientRect();
  geo = { top: r.top, left: r.left, scale: (editor.offsetWidth ? r.width / editor.offsetWidth : 1) || 1 };
