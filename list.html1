}

function hitH(e) {
  const r = rulerH.getBoundingClientRect(), x = e.clientX - r.left, y = e.clientY - r.top;
  let best = null;
  for (const h of rulerHits.h) {
    const dx = Math.abs(h.x - x);
    if (dx > (h.prio >= 5 ? 6 : 5)) continue;
    if (h.y0 !== undefined && (y < h.y0 - 1 || y > h.y1 + 1)) continue;
    if (!best || h.prio > best.prio || (h.prio === best.prio && dx < best.dx)) best = { ...h, dx };
  }
  return best;
}
