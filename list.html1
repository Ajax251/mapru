    const rects = Array.from(rg.getClientRects()).map(r => ({ top: (r.top - geo.top) / geo.scale, bottom: (r.bottom - geo.top) / geo.scale, h: r.height }))
      .filter(r => r.h > 0.5).sort((a, b) => a.top - b.top);
    const lines = [];
    for (const r of rects) {
