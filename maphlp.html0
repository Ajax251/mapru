                            </td>
                        </tr>
                        <tr>
                            <td class="icon-cell" data-label="Иконка">
                                <i class="fas fa-building" style="color: #3b82f6;"></i>
                            </td>
                            <td class="title-cell" data-label="Объект">Открыть ОКС</td>
                            <td data-label="Описание">
                                Импортирует контур здания, строения или сооружения в точке клика.
                            </td>
                        </tr>
                        <tr>
                            <td class="icon-cell" data-label="Иконка">
                                <i class="fas fa-globe" style="color: #14b8a6;"></i>
                            </td>
                            <td class="title-cell" data-label="Объект">Территориальные зоны</td>
                            <td data-label="Описание">
