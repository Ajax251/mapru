                </table>
            </section>

            <section id="context-msk">
                <h2>
                    <i class="fas fa-map-marked-alt" style="color: #8b5cf6;"></i>
                    Меню: МСК
                    <span class="badge badge-export">Экспорт в плоские системы</span>
                </h2>
                <p class="intro-text">
                    Набор команд для быстрой конвертации графических контуров из географической системы WGS84 в плоские местные системы координат (МСК).
                </p>
                <table class="feature-table">
                    <thead>
                        <tr>
                            <th scope="col" class="icon-cell"><i class="fas fa-list"></i></th>
