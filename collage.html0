<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Коллаж</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <link id="favicon" rel="icon" href="https://img.icons8.com/?size=100&id=Qw82NJLhJoqc&format=png&color=000000" type="image/png">
    <style>
        :root {
            --primary-color: #667eea;
            --primary-dark: #5a67d8;
            --primary-light: #a3bffa;
            --secondary-color: #48bb78;
            --secondary-dark: #38a169;
            --info-color: #3182ce;
            --danger-color: #e53e3e;
            --bg-color: #f7fafc;
            --card-bg: #ffffff;
            --text-color: #2d3748;
            --text-muted: #718096;
            --border-color: #e2e8f0;
            --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.12), 0 1px 2px rgba(0, 0, 0, 0.24);
            --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.07), 0 2px 4px rgba(0, 0, 0, 0.06);
            --shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.1), 0 4px 6px rgba(0, 0, 0, 0.05);
            --border-radius: 12px;
            --border-radius-sm: 8px;
            --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { height: 100vh; overflow: hidden; }
        body { font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: var(--text-color); display: flex; flex-direction: column; }
        .main-container { display: flex; flex: 1; gap: 1rem; padding: 1rem; min-height: 0; height: 100%; }
        .sidebar { width: 320px; background: var(--card-bg); border-radius: var(--border-radius); box-shadow: var(--shadow-lg); padding: 1.5rem; overflow-y: auto; flex-shrink: 0; display: flex; flex-direction: column; }
        .control-section { margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border-color); }
        .control-section:last-child { border-bottom: none; margin-bottom: 0; }
        .section-title { display: flex; align-items: center; gap: 0.75rem; font-size: 1.1rem; font-weight: 600; color: var(--primary-color); margin-bottom: 1rem; }
        .section-icon { width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; background: var(--primary-light); border-radius: 6px; font-size: 0.875rem; }
        .form-group { margin-bottom: 1rem; }
        .form-label { display: block; font-size: 0.875rem; font-weight: 500; color: var(--text-color); margin-bottom: 0.5rem; }
        .form-input { width: 100%; padding: 0.75rem; border: 2px solid var(--border-color); border-radius: var(--border-radius-sm); font-size: 0.875rem; transition: var(--transition); background: white; }
        .form-input:disabled { background-color: var(--bg-color); color: var(--text-muted); }
        .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.75rem 1.25rem; border: none; border-radius: var(--border-radius-sm); font-size: 0.875rem; font-weight: 600; cursor: pointer; transition: var(--transition); width: 100%; text-decoration: none; }
        .btn-primary { background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%); color: white; }
        .btn-success { background: linear-gradient(135deg, var(--secondary-color) 0%, var(--secondary-dark) 100%); color: white; }
        .btn-info { background: linear-gradient(135deg, var(--info-color) 0%, #2b6cb0 100%); color: white; }
        .btn:disabled { background: var(--text-muted); cursor: not-allowed; transform: none; box-shadow: none; }
        .checkbox-container { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem; background: var(--bg-color); border-radius: var(--border-radius-sm); margin-bottom: 1rem; cursor: pointer; }
        .checkbox { width: 18px; height: 18px; accent-color: var(--primary-color); }
        .help-text { font-size: 0.8rem; color: var(--text-muted); line-height: 1.4; background: var(--bg-color); padding: 0.75rem; border-radius: var(--border-radius-sm); border-left: 3px solid var(--primary-color); margin-top: auto; }
        .workspace-container { flex: 1; display: flex; flex-direction: column; background: var(--card-bg); border-radius: var(--border-radius); box-shadow: var(--shadow-lg); overflow: hidden; min-width: 0; }
        #workspace { flex: 1; position: relative; background-color: #fafafa; background-image: linear-gradient(rgba(102, 126, 234, 0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(102, 126, 234, 0.07) 1px, transparent 1px); background-size: 20px 20px; overflow: hidden; border-radius: var(--border-radius-sm); }
        .palette-container { width: 280px; background: var(--card-bg); border-radius: var(--border-radius); box-shadow: var(--shadow-lg); display: flex; flex-direction: column; overflow: hidden; flex-shrink: 0; }
        .palette-header { padding: 1rem 1.5rem; background: var(--bg-color); border-bottom: 1px solid var(--border-color); }
        .palette-title { font-size: 1.1rem; font-weight: 600; color: var(--text-color); display: flex; align-items: center; gap: 0.75rem; }
        .palette { flex: 1; padding: 1rem; overflow-y: auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(80px, 1fr)); gap: 0.75rem; align-content: start; }
        .palette.drag-over { background-color: var(--primary-light); }
        .palette-item { aspect-ratio: 1; border-radius: var(--border-radius-sm); background-size: cover; background-position: center; cursor: grab; transition: var(--transition); box-shadow: var(--shadow-sm); border: 2px solid transparent; position: relative; overflow: hidden; }
        .palette-item:hover { transform: scale(1.05); box-shadow: var(--shadow-md); border-color: var(--primary-color); }
        .palette-item-name { position: absolute; bottom: 4px; left: 0; right: 0; color: white; font-size: 0.75rem; font-weight: 600; text-align: center; padding: 0 4px; pointer-events: none; text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
        .draggable-item { position: absolute; cursor: move; border: 2px solid transparent; border-radius: var(--border-radius-sm); transition: box-shadow 0.2s, border-color 0.2s; box-shadow: var(--shadow-sm); }
        .draggable-item:hover, .draggable-item.selected { border-color: var(--primary-color); box-shadow: var(--shadow-md); z-index: 10; }
        .draggable-item img { width: 100%; height: 100%; object-fit: cover; border-radius: calc(var(--border-radius-sm) - 2px); pointer-events: none; }
        .resize-handle { position: absolute; width: 20px; height: 20px; background: var(--primary-color); border: 3px solid white; border-radius: 50%; right: -10px; bottom: -10px; cursor: se-resize; z-index: 11; }
        .empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: var(--text-muted); text-align: center; padding: 2rem; grid-column: 1 / -1; }
        .loading-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(4px); display: none; align-items: center; justify-content: center; z-index: 1000; color: white; }
        .loading-content { text-align: center; padding: 2rem; background: rgba(255, 255, 255, 0.1); border-radius: var(--border-radius); backdrop-filter: blur(20px); width: 90%; max-width: 400px; }
        #progress-bar-container { width: 100%; background-color: rgba(255, 255, 255, 0.2); border-radius: 8px; overflow: hidden; margin-top: 1rem; display: none; }
        #progress-bar { width: 0%; height: 10px; background: linear-gradient(90deg, var(--primary-light), var(--primary-color)); transition: width 0.3s ease; }
        .notification { position: fixed; bottom: 2rem; right: 2rem; padding: 1rem 1.5rem; border-radius: var(--border-radius); color: white; font-weight: 500; z-index: 1001; transform: translateX(calc(100% + 2rem)); transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1); box-shadow: var(--shadow-lg); max-width: 400px; }
        .notification.show { transform: translateX(0); }
        
        /* CONTEXT MENU STYLES */
        .context-menu { position: fixed; z-index: 1000; background-color: var(--card-bg); border-radius: var(--border-radius-sm); box-shadow: var(--shadow-lg); padding: 0.5rem 0; min-width: 220px; display: none; border: 1px solid var(--border-color); }
        .context-menu-item { padding: 0.75rem 1.25rem; font-size: 0.875rem; color: var(--text-color); cursor: pointer; display: flex; align-items: center; gap: 0.75rem; transition: var(--transition); }
        .context-menu-item:hover { background-color: var(--bg-color); }
        .context-menu-item i { color: var(--text-muted); width: 16px; text-align: center; }
        .context-menu-item.disabled { color: var(--text-muted); pointer-events: none; opacity: 0.5; }

        /* CROP MODAL STYLES (95% WINDOW UPDATE) */
        #crop-image-modal { display:none; position:fixed; top:0; left:0; width:100%; height:100%; background-color:rgba(0,0,0,0.85); backdrop-filter: blur(5px); z-index:10001; justify-content:center; align-items:center; }
        .crop-modal-content-wrapper { background-color:var(--card-bg); padding:24px; border-radius:var(--border-radius); box-shadow:var(--shadow-lg); width:95vw; height:95vh; max-width:95vw; max-height:95vh; display: flex; flex-direction: column; justify-content: space-between; overflow:hidden; }
        .crop-modal-content-wrapper h3 { margin-top:0; color: var(--text-color); font-size: 1.3rem; }
        .crop-modal-content-wrapper p { font-size:0.9em; color:var(--text-muted); margin-bottom: 0.5rem; }
        
        .crop-modal-body { flex: 1; display: flex; align-items: center; justify-content: center; overflow: auto; background-color: #1a202c; border-radius: var(--border-radius-sm); padding: 10px; min-height: 0; margin: 0.5rem 0; }
        #crop-image-container { position:relative; display:inline-block; user-select:none; touch-action:none; cursor:crosshair; box-shadow: 0 0 15px rgba(0,0,0,0.5); }
        #crop-image-preview { display:block; max-width:100%; max-height:calc(95vh - 200px); user-select:none; -webkit-user-drag:none; }
        #crop-selection-rectangle { position:absolute; border:2px solid var(--primary-color); background-color: rgba(102, 126, 234, 0.2); display:none; pointer-events:none; }
        
        .crop-modal-buttons { margin-top:0.5rem; display: flex; justify-content: center; gap: 1rem; flex-shrink: 0; }
        .crop-modal-buttons .btn { width: auto; }
        .btn-danger { background: linear-gradient(135deg, var(--danger-color) 0%, #c53030 100%); color: white; }
    </style>
</head>
<body>
    <div class="main-container">
        <div class="sidebar">
            <div class="control-section">
                <div class="section-title"><i class="section-icon fas fa-upload"></i>Загрузка</div>
                <button id="load-files-btn" class="btn btn-primary"><i class="fas fa-folder-open"></i>Выбрать изображения</button>
            </div>
            <div class="control-section">
                <div class="section-title"><i class="section-icon fas fa-tools"></i>Инструменты</div>
                <label class="checkbox-container"><input type="checkbox" id="no-overlap-checkbox" class="checkbox" checked>Без наложений</label>
            </div>
            <div class="control-section">
                <div class="section-title"><i class="section-icon fas fa-layer-group"></i>Макет</div>
                <div class="form-group"><button id="save-layout-btn" class="btn btn-info" disabled><i class="fas fa-save"></i>Сохранить макет</button></div>
                <div class="form-group"><button id="load-layout-btn" class="btn btn-info"><i class="fas fa-folder-open"></i>Загрузить макет</button></div>
            </div>
            <div class="control-section">
                <div class="section-title"><i class="section-icon fas fa-archive"></i>Проект</div>
                <div class="form-group"><button id="save-project-btn" class="btn btn-primary" disabled><i class="fas fa-file-archive"></i>Сохранить проект</button></div>
                <div class="form-group"><button id="load-project-btn" class="btn btn-primary"><i class="fas fa-folder-open"></i>Открыть проект</button></div>
            </div>
            <div class="control-section">
                <div class="section-title"><i class="section-icon fas fa-download"></i>Экспорт</div>
                <label class="checkbox-container"><input type="checkbox" id="autosize-checkbox" class="checkbox" checked>Авторазмер (1:1)</label>
                <div class="form-group">
                    <label class="form-label" for="final-width">Итоговая ширина (px)</label>
                    <input type="number" id="final-width" class="form-input" value="0" min="100" step="100" disabled>
                </div>
                <button id="save-image-btn" class="btn btn-success" disabled><i class="fas fa-camera"></i>Сохранить JPG</button>
            </div>
            <div class="help-text">Сохраняйте проекты в формате `.collageproj` для полного восстановления работы. Правый клик на палитре вызывает меню кадрирования.</div>
        </div>
        <div class="workspace-container"><div id="workspace"></div></div>
        <div class="palette-container">
             <div class="palette-header"><div class="palette-title"><i class="fas fa-images"></i>Палитра</div></div>
             <div class="palette" id="palette"><div class="empty-state" id="palette-empty-state"><div class="empty-state-icon"><i class="fas fa-arrow-left"></i></div><div class="empty-state-text">Загрузите изображения или вставьте (Ctrl+V)</div></div></div>
        </div>
    </div>
    <div id="loading-overlay" class="loading-overlay"><div class="loading-content"><div id="loading-text">Обработка...</div><div id="progress-bar-container"><div id="progress-bar"></div></div></div></div>

    <!-- CROP MODAL HTML -->
    <div id="crop-image-modal">
        <div class="crop-modal-content-wrapper">
            <h3 id="crop-modal-title">Обрезать изображение</h3>
            <p>Выделите область для обрезки, оставьте изображение целиком или отмените действие.</p>
            <div class="crop-modal-body">
                <div id="crop-image-container">
                    <img id="crop-image-preview" src="#" alt="Preview" />
                    <div id="crop-selection-rectangle"></div>
                </div>
            </div>
            <div class="crop-modal-buttons">
                <button id="crop-image-button-confirm" class="btn btn-success">
                    <i class="fas fa-check"></i> Применить
                </button>
                <button id="crop-image-button-skip" class="btn btn-info">
                    <i class="fas fa-forward"></i> Использовать всё
                </button>
                <button id="crop-image-button-cancel" class="btn btn-danger">
                    <i class="fas fa-times"></i> Отменить
                </button>
            </div>
        </div>
    </div>

    <!-- WORKSPACE CONTEXT MENU -->
    <div id="workspace-context-menu" class="context-menu">
        <div class="context-menu-item" id="wcm-return"><i class="fas fa-undo"></i> Вернуть в палитру</div>
        <div class="context-menu-item" id="wcm-delete"><i class="fas fa-trash-alt"></i> Удалить навсегда</div>
    </div>

    <!-- PALETTE CONTEXT MENU -->
    <div id="palette-context-menu" class="context-menu">
        <div class="context-menu-item" id="pcm-crop"><i class="fas fa-crop-alt"></i> Обрезать</div>
        <div class="context-menu-item" id="pcm-crop-all"><i class="fas fa-images"></i> Обрезать все</div>
        <div class="context-menu-item" id="pcm-restore"><i class="fas fa-history"></i> Восстановить</div>
        <div class="context-menu-item" id="pcm-restore-all"><i class="fas fa-redo-alt"></i> Восстановить все</div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const DOM = { 
            loadFilesBtn: document.getElementById('load-files-btn'), 
            saveImageBtn: document.getElementById('save-image-btn'), 
            saveLayoutBtn: document.getElementById('save-layout-btn'), 
            loadLayoutBtn: document.getElementById('load-layout-btn'), 
            saveProjectBtn: document.getElementById('save-project-btn'),
            loadProjectBtn: document.getElementById('load-project-btn'),
            finalWidthInput: document.getElementById('final-width'), 
            noOverlapCheckbox: document.getElementById('no-overlap-checkbox'), 
            autosizeCheckbox: document.getElementById('autosize-checkbox'), 
            palette: document.getElementById('palette'), 
            paletteEmptyState: document.getElementById('palette-empty-state'), 
            workspace: document.getElementById('workspace'), 
            loadingOverlay: document.getElementById('loading-overlay'), 
            loadingText: document.getElementById('loading-text'), 
            progressBarContainer: document.getElementById('progress-bar-container'), 
            progressBar: document.getElementById('progress-bar'),
            workspaceContextMenu: document.getElementById('workspace-context-menu'),
            paletteContextMenu: document.getElementById('palette-context-menu')
        };
        let state = { files: [], activeElement: null, action: null, offsetX: 0, offsetY: 0, contextTarget: null, paletteContextTarget: null };

        function initialize() {
            const imageInput = document.createElement('input'); imageInput.type = 'file'; imageInput.multiple = true; imageInput.accept = 'image/*'; imageInput.style.display = 'none'; imageInput.addEventListener('change', handleFileLoad); document.body.appendChild(imageInput);
            const layoutInput = document.createElement('input'); layoutInput.type = 'file'; layoutInput.accept = '.collage,application/json'; layoutInput.style.display = 'none'; layoutInput.addEventListener('change', handleLayoutLoad); document.body.appendChild(layoutInput);
            
            const projectInput = document.createElement('input');
            projectInput.type = 'file';
            projectInput.accept = '.collageproj,.zip';
            projectInput.style.display = 'none';
            projectInput.addEventListener('change', handleProjectLoad);
            document.body.appendChild(projectInput);

            DOM.loadFilesBtn.addEventListener('click', () => imageInput.click());
            DOM.loadLayoutBtn.addEventListener('click', () => layoutInput.click());
            DOM.loadProjectBtn.addEventListener('click', () => projectInput.click());
            DOM.saveProjectBtn.addEventListener('click', saveProject);
            DOM.saveImageBtn.addEventListener('click', assembleAndSave);
            DOM.saveLayoutBtn.addEventListener('click', saveLayout);
            DOM.autosizeCheckbox.addEventListener('change', handleAutosizeToggle);
            DOM.workspace.addEventListener('dragover', e => e.preventDefault());
            DOM.workspace.addEventListener('drop', handleDropOnWorkspace);
            DOM.palette.addEventListener('dragover', e => { e.preventDefault(); DOM.palette.classList.add('drag-over'); });
            DOM.palette.addEventListener('dragleave', () => DOM.palette.classList.remove('drag-over'));
            DOM.palette.addEventListener('drop', handleDropOnPalette);
            
            setupContextMenus();
            document.addEventListener('click', hideContextMenus);
            document.addEventListener('paste', handlePaste);
            updateAutosize();
        }
        
        // --- CROP MODAL LOGIC (UPDATED WITH CANCEL/ABORT FLOW) ---
        function fileToBase64(file) { return new Promise((resolve, reject) => { const reader = new FileReader(); reader.onload = () => resolve(reader.result);  reader.onerror = error => reject(error); reader.readAsDataURL(file); }); }
        
        function dataURLtoFile(dataurl, filename) {
            let arr = dataurl.split(','),
                mimeMatch = arr[0].match(/:(.*?);/),
                mime = mimeMatch ? mimeMatch[1] : 'image/png',
                bstr = atob(arr[1]), 
                n = bstr.length, 
                u8arr = new Uint8Array(n);
            while(n--){
                u8arr[n] = bstr.charCodeAt(n);
            }
            return new File([u8arr], filename, {type:mime});
        }

      function showCropModal(imageSource, titleText = "Обрезать изображение") {
            return new Promise((resolve) => {
                const modal = document.getElementById('crop-image-modal');
                const imgPreview = document.getElementById('crop-image-preview');
                const cropContainer = document.getElementById('crop-image-container');
                const selectionRectDiv = document.getElementById('crop-selection-rectangle');
                const confirmButton = document.getElementById('crop-image-button-confirm');
                const skipButton = document.getElementById('crop-image-button-skip');
                const cancelButton = document.getElementById('crop-image-button-cancel');
                const modalTitle = document.getElementById('crop-modal-title');
                
                if (modalTitle) modalTitle.textContent = titleText;
                
                let cropSelection = { startX: 0, startY: 0, endX: 0, endY: 0, isDrawing: false };
                let imageNaturalSize = { width: 0, height: 0 };
                let imageDisplaySize = { width: 0, height: 0 };
                selectionRectDiv.style.display = 'none';
                cropSelection.isDrawing = false;
                
                const cleanupModal = () => {
                    modal.style.display = 'none';
                    imgPreview.src = '#';
                    imgPreview.onload = null;
                    cropContainer.removeEventListener('mousedown', onMouseDown);
                    cropContainer.removeEventListener('touchstart', onMouseDown);
                    confirmButton.onclick = null;
                    skipButton.onclick = null;
                    cancelButton.onclick = null;
                };

                const initImageLoad = () => {
                    modal.style.display = 'flex';
                    imgPreview.onload = () => {
                        imageNaturalSize.width = imgPreview.naturalWidth;
                        imageNaturalSize.height = imgPreview.naturalHeight;
                        imageDisplaySize.width = imgPreview.offsetWidth;
                        imageDisplaySize.height = imgPreview.offsetHeight;
                    };
                };

                if (imageSource instanceof File) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        imgPreview.src = e.target.result;
                        initImageLoad();
                    };
                    reader.readAsDataURL(imageSource);
                } else if (typeof imageSource === 'string') {
                    imgPreview.src = imageSource;
                    initImageLoad();
                } else {
                    resolve(null);
                    return;
                }

                function updateSelectionRect() {
                    const x = Math.min(cropSelection.startX, cropSelection.endX);
                    const y = Math.min(cropSelection.startY, cropSelection.endY);
                    const width = Math.abs(cropSelection.endX - cropSelection.startX);
                    const height = Math.abs(cropSelection.endY - cropSelection.startY);
                    selectionRectDiv.style.left = `${x}px`;
                    selectionRectDiv.style.top = `${y}px`;
                    selectionRectDiv.style.width = `${width}px`;
                    selectionRectDiv.style.height = `${height}px`;
                }
                function getMousePos(event) {
                    const rect = cropContainer.getBoundingClientRect();
                    let x = event.clientX - rect.left;
                    let y = event.clientY - rect.top;
                    x = Math.max(0, Math.min(x, imageDisplaySize.width));
                    y = Math.max(0, Math.min(y, imageDisplaySize.height));
                    return { x, y };
                }
                const onMouseDown = (e) => {
                    e.preventDefault();
                    cropSelection.isDrawing = true;
                    const pos = getMousePos(e.touches ? e.touches[0] : e);
                    cropSelection.startX = pos.x;
                    cropSelection.startY = pos.y;
                    cropSelection.endX = pos.x;
                    cropSelection.endY = pos.y;
                    selectionRectDiv.style.display = 'block';
                    updateSelectionRect();
                    cropContainer.addEventListener('mousemove', onMouseMove);
                    cropContainer.addEventListener('touchmove', onMouseMove, { passive: false });
                    window.addEventListener('mouseup', onMouseUp);
                    window.addEventListener('touchend', onMouseUp);
                };
                const onMouseMove = (e) => {
                    if (!cropSelection.isDrawing) return;
                    e.preventDefault();
                    const pos = getMousePos(e.touches ? e.touches[0] : e);
                    cropSelection.endX = pos.x;
                    cropSelection.endY = pos.y;
                    updateSelectionRect();
                };
                const onMouseUp = () => {
                    if (!cropSelection.isDrawing) return;
                    cropSelection.isDrawing = false;
                    cropContainer.removeEventListener('mousemove', onMouseMove);
                    window.removeEventListener('mouseup', onMouseUp);
                    cropContainer.removeEventListener('touchmove', onMouseMove);
                    window.removeEventListener('touchend', onMouseUp);
                };
                cropContainer.addEventListener('mousedown', onMouseDown);
                cropContainer.addEventListener('touchstart', onMouseDown, { passive: false });
                
                const handleConfirm = () => {
                    const selWidth = Math.abs(cropSelection.endX - cropSelection.startX);
                    const selHeight = Math.abs(cropSelection.endY - cropSelection.startY);
                    if (selWidth < 10 || selHeight < 10 || selectionRectDiv.style.display === 'none') {
                        handleSkip();
                        return;
                    }
                    const canvas = document.createElement('canvas');
                    const ctx = canvas.getContext('2d');
                    const scaleX = imageNaturalSize.width / imageDisplaySize.width;
                    const scaleY = imageNaturalSize.height / imageDisplaySize.height;
                    const sX = Math.min(cropSelection.startX, cropSelection.endX) * scaleX;
                    const sY = Math.min(cropSelection.startY, cropSelection.endY) * scaleY;
                    const sWidth = selWidth * scaleX;
                    const sHeight = selHeight * scaleY;
                    canvas.width = sWidth;
                    canvas.height = sHeight;
                    ctx.drawImage(imgPreview, sX, sY, sWidth, sHeight, 0, 0, sWidth, sHeight);
                    
                    let mimeType = 'image/jpeg';
                    if (typeof imageSource === 'string' && imageSource.startsWith('data:')) {
                        const match = imageSource.match(/data:([^;]+);/);
                        if (match) mimeType = match[1];
                    } else if (imageSource instanceof File) {
                        mimeType = imageSource.type;
                    }

                    const croppedImageDataUrl = canvas.toDataURL(mimeType);
                    resolve(croppedImageDataUrl);
                    cleanupModal();
                };
                const handleSkip = () => {
                    if (imageSource instanceof File) {
                        fileToBase64(imageSource).then(base64 => resolve(base64));
                    } else {
                        resolve(imageSource);
                    }
                    cleanupModal();
                };
                const handleCancel = () => {
                    resolve('ABORT');
                    cleanupModal();
                };
                confirmButton.onclick = handleConfirm;
                skipButton.onclick = handleSkip;
                cancelButton.onclick = handleCancel;
            });
        }
        
        // --- PASTE LOGIC (UPDATED WITH PROPER ABORT HANDLING) ---
        async function handlePaste(event) {
            const items = (event.clipboardData || event.originalEvent.clipboardData)?.items;
            if (!items) return;

            let imageFile = null;
            for (let i = 0; i < items.length; i++) {
                if (items[i].kind === 'file' && items[i].type.startsWith('image/')) {
                    imageFile = items[i].getAsFile();
                    break;
                }
            }

            if (!imageFile) return;
            event.preventDefault();
            
            try {
                const originalBase64 = await fileToBase64(imageFile);
                const imageDataUrl = await showCropModal(originalBase64, "Обрезать вставленное изображение");
                if (!imageDataUrl || imageDataUrl === 'ABORT') {
                    createNotification('Вставка отменена', 'info');
                    return;
                }

                const timestamp = Date.now();
                const newFileName = `pasted-${timestamp}.png`;
                const newFile = dataURLtoFile(imageDataUrl, newFileName);

                const fileData = {
                    id: `img-${timestamp}-${Math.random()}`,
                    src: imageDataUrl,
                    originalSrc: originalBase64,
                    file: newFile
                };

                state.files.push(fileData);
                if (DOM.paletteEmptyState) { DOM.paletteEmptyState.remove(); DOM.paletteEmptyState = null; }
                
                DOM.palette.appendChild(createPaletteItem(fileData));

                const workspaceRect = DOM.workspace.getBoundingClientRect();
                const img = new Image();
                img.onload = () => {
                    const aspectRatio = img.width / img.height;
                    const width = Math.min(workspaceRect.width * 0.25, 200);
                    const height = width / aspectRatio;
                    const x = (workspaceRect.width - width) / 2 + DOM.workspace.scrollLeft;
                    const y = (workspaceRect.height - height) / 2 + DOM.workspace.scrollTop;
                    
                    createWorkspaceItem(fileData, { x, y, width, height });
                    createNotification('Изображение вставлено', 'success');
                };
                img.src = fileData.src;

            } catch (error) {
                console.error("Paste/Crop operation failed:", error);
                createNotification('Ошибка при вставке изображения', 'error');
            }
        }
        
        // --- SAFELY POSITION CONTEXT MENUS (PREVENT TRUNCATION) ---
        function showMenuSafely(menu, clientX, clientY) {
            menu.style.display = 'block';
            
            const menuWidth = menu.offsetWidth || 220;
            const menuHeight = menu.offsetHeight || 160;
            
            let left = clientX;
            let top = clientY;
            
            // Adjust horizontally if going off-screen to the right
            if (left + menuWidth > window.innerWidth) {
                left = window.innerWidth - menuWidth - 12;
            }
            if (left < 12) {
                left = 12; // Prevent going off-screen to the left
            }
            
            // Adjust vertically if going off-screen to the bottom
            if (top + menuHeight > window.innerHeight) {
                top = window.innerHeight - menuHeight - 12;
            }
            if (top < 12) {
                top = 12; // Prevent going off-screen to the top
            }
            
            menu.style.left = `${left}px`;
            menu.style.top = `${top}px`;
        }

        // --- CONTEXT MENUS SETUP & ACTIONS (FIXED TARGET RETRIEVAL) ---
        function setupContextMenus() {
            // Workspace menu actions
            document.getElementById('wcm-return').addEventListener('click', () => {
                const target = state.contextTarget;
                hideContextMenus();
                if (target) returnToPalette(target);
            });

            document.getElementById('wcm-delete').addEventListener('click', () => {
                const target = state.contextTarget;
                hideContextMenus();
                if (target) {
                    const idToRemove = target.dataset.id;
                    state.files = state.files.filter(f => f.id !== idToRemove);
                    target.remove();
                    updateUIOnItemChange();
                }
            });

            // Palette context menu listener (Event Delegation)
            DOM.palette.addEventListener('contextmenu', e => {
                e.preventDefault();
                e.stopPropagation();
                
                const item = e.target.closest('.palette-item');
                state.paletteContextTarget = item;
                
                DOM.workspaceContextMenu.style.display = 'none';

                const cropSingle = document.getElementById('pcm-crop');
                const restoreSingle = document.getElementById('pcm-restore');
                const cropAllBtn = document.getElementById('pcm-crop-all');
                const restoreAllBtn = document.getElementById('pcm-restore-all');

                if (item) {
                    cropSingle.classList.remove('disabled');
                    restoreSingle.classList.remove('disabled');
                } else {
                    cropSingle.classList.add('disabled');
                    restoreSingle.classList.add('disabled');
                }

                if (state.files.length > 0) {
                    cropAllBtn.classList.remove('disabled');
                    restoreAllBtn.classList.remove('disabled');
                } else {
                    cropAllBtn.classList.add('disabled');
                    restoreAllBtn.classList.add('disabled');
                }

                // Show and dynamically align the menu within visible bounds
                showMenuSafely(DOM.paletteContextMenu, e.clientX, e.clientY);
            });

            // Palette single crop action (fixed target check)
            document.getElementById('pcm-crop').addEventListener('click', async () => {
                const target = state.paletteContextTarget;
                hideContextMenus();
                if (!target) return;
                const id = target.dataset.id;
                const fileData = state.files.find(f => f.id === id);
                if (fileData) {
                    const croppedSrc = await showCropModal(fileData.originalSrc, `Обрезать изображение: ${fileData.file.name}`);
                    if (croppedSrc && croppedSrc !== 'ABORT') {
                        fileData.src = croppedSrc;
                        updateImageUI(fileData);
                        createNotification("Изображение успешно обрезано", "success");
                    }
                }
            });

            // Sequential cropping with abort support
            document.getElementById('pcm-crop-all').addEventListener('click', async () => {
                hideContextMenus();
                if (state.files.length === 0) return;
                
                let count = 0;
                for (let i = 0; i < state.files.length; i++) {
                    const fileData = state.files[i];
                    try {
                        const title = `Обрезать изображение (${i + 1} из ${state.files.length}): ${fileData.file.name}`;
                        const croppedSrc = await showCropModal(fileData.originalSrc, title);
                        if (croppedSrc === 'ABORT') {
                            createNotification("Поочередная обрезка прервана", "info");
                            break;
                        }
                        if (croppedSrc && croppedSrc !== fileData.originalSrc) {
                            fileData.src = croppedSrc;
                            updateImageUI(fileData);
                            count++;
                        }
                    } catch (err) {
                        console.error("Error during sequential cropping:", err);
                        break;
                    }
                }
                if (count > 0) {
                    createNotification(`Обработка завершена. Обрезано: ${count} из ${state.files.length}`, "success");
                }
            });

            // Palette single restore action (fixed target check)
            document.getElementById('pcm-restore').addEventListener('click', () => {
                const target = state.paletteContextTarget;
                hideContextMenus();
                if (!target) return;
                const id = target.dataset.id;
                const fileData = state.files.find(f => f.id === id);
                if (fileData && fileData.originalSrc) {
                    fileData.src = fileData.originalSrc;
                    updateImageUI(fileData);
                    createNotification("Изображение успешно восстановлено", "success");
                }
            });

            document.getElementById('pcm-restore-all').addEventListener('click', () => {
                hideContextMenus();
                state.files.forEach(fileData => {
                    if (fileData.originalSrc) {
                        fileData.src = fileData.originalSrc;
                        updateImageUI(fileData);
                    }
                });
                createNotification("Все изображения в палитре восстановлены", "success");
            });
        }

        function showWorkspaceContextMenu(e) { 
            e.preventDefault(); 
            e.stopPropagation(); 
            state.contextTarget = e.currentTarget; 
            DOM.paletteContextMenu.style.display = 'none';
            showMenuSafely(DOM.workspaceContextMenu, e.clientX, e.clientY);
        }
        
        function hideContextMenus() { 
            if (DOM.workspaceContextMenu) DOM.workspaceContextMenu.style.display = 'none'; 
            if (DOM.paletteContextMenu) DOM.paletteContextMenu.style.display = 'none'; 
            state.contextTarget = null; 
            state.paletteContextTarget = null;
        }

        // --- CORE UI SYNCHRONIZATION AFTER CROP / RESTORE ---
        function updateImageUI(fileData) {
            const paletteItem = DOM.palette.querySelector(`[data-id="${fileData.id}"]`);
            if (paletteItem) {
                paletteItem.style.backgroundImage = `url(${fileData.src})`;
            }
            
            const workspaceItemImg = DOM.workspace.querySelector(`[data-id="${fileData.id}"] img`);
            if (workspaceItemImg) {
                workspaceItemImg.src = fileData.src;
                
                const img = new Image();
                img.onload = () => {
                    const workspaceItem = workspaceItemImg.parentElement;
                    if (workspaceItem) {
                        const currentWidth = workspaceItem.offsetWidth;
                        const newHeight = currentWidth * (img.naturalHeight / img.naturalWidth);
                        workspaceItem.style.height = `${newHeight}px`;
                        updateUIOnItemChange();
                    }
                };
                img.src = fileData.src;
            }
        }

        // --- AUTOSIZE LOGIC ---
        async function updateAutosize() {
            if (!DOM.autosizeCheckbox.checked) return;
            const placedItems = Array.from(DOM.workspace.querySelectorAll('.draggable-item'));
            if (placedItems.length === 0) { DOM.finalWidthInput.value = 0; return; }
            let minX = Infinity, maxX = -Infinity;
            placedItems.forEach(item => { minX = Math.min(minX, item.offsetLeft); maxX = Math.max(maxX, item.offsetLeft + item.offsetWidth); });
            const bboxWidth = maxX - minX;
            let maxDisplayToNativeRatio = 0;
            for (const item of placedItems) {
                const imgData = state.files.find(f => f.id === item.dataset.id);
                if (imgData) {
                    const img = new Image(); img.src = imgData.src; await img.decode();
                    if (img.naturalWidth > 0) { const currentRatio = item.offsetWidth / img.naturalWidth; if (currentRatio > maxDisplayToNativeRatio) { maxDisplayToNativeRatio = currentRatio; } }
                }
            }
            if (maxDisplayToNativeRatio === 0) { DOM.finalWidthInput.value = Math.round(bboxWidth); return; }
            const upscaleFactor = 1 / maxDisplayToNativeRatio; const autoWidth = bboxWidth * upscaleFactor; DOM.finalWidthInput.value = Math.round(autoWidth);
        }
        function handleAutosizeToggle() { DOM.finalWidthInput.disabled = DOM.autosizeCheckbox.checked; if (DOM.autosizeCheckbox.checked) updateAutosize(); }
        function updateUIOnItemChange() { updateButtonsState(); if (DOM.autosizeCheckbox.checked) updateAutosize(); }

        // --- CORE APP LOGIC ---
        function createPaletteItem(d) { const p = document.createElement('div'); p.className = 'palette-item'; p.style.backgroundImage = `url(${d.src})`; p.dataset.id = d.id; p.draggable = true; p.title = d.file.name; p.addEventListener('dragstart', e => e.dataTransfer.setData('text/plain', d.id)); const b = d.file.name.substring(0, d.file.name.lastIndexOf('.')) || d.file.name; const s = document.createElement('span'); s.className = 'palette-item-name'; s.textContent = b; p.appendChild(s); return p; }
        
        function handleFileLoad(e) { 
            const f = e.target.files; 
            if (!f.length) return; 
            if (DOM.paletteEmptyState) { DOM.paletteEmptyState.remove(); DOM.paletteEmptyState = null; } 
            showLoading(`Загрузка ${f.length} файлов...`); 
            let c = 0; 
            Array.from(f).forEach(file => { 
                const r = new FileReader(); 
                r.onload = ev => { 
                    const d = { 
                        id: `img-${Date.now()}-${Math.random()}`, 
                        src: ev.target.result, 
                        originalSrc: ev.target.result,
                        file: file 
                    }; 
                    state.files.push(d); 
                    DOM.palette.appendChild(createPaletteItem(d)); 
                    if (++c === f.length) { 
                        hideLoading(); 
                        updateUIOnItemChange();
                        createNotification(`Добавлено ${f.length} изображений`, 'success'); 
                    } 
                }; 
                r.readAsDataURL(file); 
            }); 
        }
        
        function createWorkspaceItem(d, pos) { const i = new Image(); i.onload = () => { const w = document.createElement('div'); w.className = 'draggable-item'; w.dataset.id = d.id; w.title = d.file.name; w.draggable = true; w.addEventListener('dragstart', e => { e.stopPropagation(); e.dataTransfer.setData('text/plain', d.id); }); w.style.left = `${pos.x}px`; w.style.top = `${pos.y}px`; w.style.width = `${pos.width}px`; w.style.height = `${pos.height}px`; const e = document.createElement('img'); e.src = d.src; const h = document.createElement('div'); h.className = 'resize-handle'; w.appendChild(e); w.appendChild(h); DOM.workspace.appendChild(w); makeInteractive(w); updateUIOnItemChange(); }; i.src = d.src; }
        function handleDropOnWorkspace(e) { e.preventDefault(); const id = e.dataTransfer.getData('text/plain'); const d = state.files.find(f => f.id === id); if (!d || DOM.workspace.querySelector(`[data-id="${id}"]`)) return; const p = DOM.palette.querySelector(`[data-id="${id}"]`); if (p) p.remove(); const r = DOM.workspace.getBoundingClientRect(); const i = new Image(); i.onload = () => { const a = i.width / i.height; const w = Math.min(r.width * 0.25, 200); const h = w / a; createWorkspaceItem(d, { x: e.clientX - r.left - w / 2, y: e.clientY - r.top - h / 2, width: w, height: h }); }; i.src = d.src; }
        function handleDropOnPalette(e) { e.preventDefault(); DOM.palette.classList.remove('drag-over'); const id = e.dataTransfer.getData('text/plain'); const i = DOM.workspace.querySelector(`[data-id="${id}"]`); if (i) returnToPalette(i); }
        function makeInteractive(el) { el.addEventListener('mousedown', onMouseDown); el.addEventListener('dblclick', e => returnToPalette(e.currentTarget)); el.addEventListener('contextmenu', showWorkspaceContextMenu); }
        function onMouseDown(e) { if (e.button !== 0) return; e.preventDefault(); e.stopPropagation(); state.action = e.target.classList.contains('resize-handle') ? 'resizing' : 'dragging'; state.activeElement = e.currentTarget; document.querySelectorAll('.draggable-item.selected').forEach(el => el.classList.remove('selected')); state.activeElement.classList.add('selected'); state.activeElement.style.zIndex = 100; const r = state.activeElement.getBoundingClientRect(); state.offsetX = e.clientX - r.left; state.offsetY = e.clientY - r.top; document.addEventListener('mousemove', onMouseMove); document.addEventListener('mouseup', onMouseUp); document.body.style.userSelect = 'none'; }
        function onMouseMove(e) { if (!state.activeElement) return; e.preventDefault(); const r = DOM.workspace.getBoundingClientRect(); if (state.action === 'dragging') { let l = e.clientX - r.left - state.offsetX; let t = e.clientY - r.top - state.offsetY; if (DOM.noOverlapCheckbox.checked) { const p = preventOverlap(state.activeElement, l, t); l = p.x; t = p.y; } state.activeElement.style.left = `${l}px`; state.activeElement.style.top = `${t}px`; } else if (state.action === 'resizing') { const i = state.activeElement.getBoundingClientRect(); let w = e.clientX - i.left; w = Math.max(50, w); const imgElement = state.activeElement.querySelector('img'); const a = imgElement.naturalWidth / imgElement.naturalHeight; state.activeElement.style.width = `${w}px`; state.activeElement.style.height = `${w / a}px`; } }
        function preventOverlap(activeItem, newX, newY) { const activeRect = { left: newX, top: newY, right: newX + activeItem.offsetWidth, bottom: newY + activeItem.offsetHeight, width: activeItem.offsetWidth, height: activeItem.offsetHeight }; for (const otherItem of Array.from(DOM.workspace.querySelectorAll('.draggable-item')).filter(i => i !== activeItem)) { const staticRect = { left: otherItem.offsetLeft, top: otherItem.offsetTop, right: otherItem.offsetLeft + otherItem.offsetWidth, bottom: otherItem.offsetTop + otherItem.offsetHeight }; const isColliding = !(activeRect.right < staticRect.left || activeRect.left > staticRect.right || activeRect.bottom < staticRect.top || activeRect.top > staticRect.bottom); if (isColliding) { const overlapX = Math.min(activeRect.right, staticRect.right) - Math.max(activeRect.left, staticRect.left); const overlapY = Math.min(activeRect.bottom, staticRect.bottom) - Math.max(activeRect.top, staticRect.top); if (overlapX < overlapY) { activeRect.left = activeRect.left < staticRect.left ? staticRect.left - activeRect.width : staticRect.right; } else { activeRect.top = activeRect.top < staticRect.top ? staticRect.top - activeRect.height : staticRect.bottom; } } } return { x: activeRect.left, y: activeRect.top }; }
        function onMouseUp() { if (!state.activeElement) return; updateUIOnItemChange(); state.activeElement.style.zIndex = 10; state.activeElement = null; state.action = null; document.removeEventListener('mousemove', onMouseMove); document.removeEventListener('mouseup', onMouseUp); document.body.style.userSelect = ''; }
        function returnToPalette(el) { const id = el.dataset.id; const d = state.files.find(f => f.id === id); if (d && !DOM.palette.querySelector(`[data-id="${id}"]`)) DOM.palette.appendChild(createPaletteItem(d)); el.remove(); updateUIOnItemChange(); }
        
        function updateButtonsState() { 
            const hasWorkspaceItems = DOM.workspace.querySelectorAll('.draggable-item').length > 0; 
            DOM.saveImageBtn.disabled = !hasWorkspaceItems; 
            DOM.saveLayoutBtn.disabled = !hasWorkspaceItems; 
            DOM.saveProjectBtn.disabled = state.files.length === 0;
        }
        
        // --- SAVE/LOAD/EXPORT ---
        function saveLayout() { const i = Array.from(DOM.workspace.querySelectorAll('.draggable-item')); if (i.length === 0) return; const l = i.map(item => { const d = state.files.find(f => f.id === item.dataset.id); return { filename: d.file.name, x: item.offsetLeft, y: item.offsetTop, width: item.offsetWidth, height: item.offsetHeight }; }); const s = JSON.stringify(l, null, 2); const b = new Blob([s], { type: 'application/json' }); const t = new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-'); saveAs(b, `layout-${t}.collage`); }
        function handleLayoutLoad(e) { const f = e.target.files[0]; if (!f) return; const r = new FileReader(); r.onload = ev => { try { applyLayout(JSON.parse(ev.target.result)); } catch (err) { createNotification('Ошибка: неверный формат файла макета.', 'error'); } }; r.readAsText(f); e.target.value = ''; }
        function applyLayout(layoutData) { DOM.workspace.innerHTML = ''; let c = 0; layoutData.forEach(itemData => { const d = state.files.find(f => f.file.name === itemData.filename); if (d) { const p = DOM.palette.querySelector(`[data-id="${d.id}"]`); if (p) p.remove(); createWorkspaceItem(d, { x: itemData.x, y: itemData.y, width: itemData.width, height: itemData.height }); c++; } else console.warn(`Изображение "${itemData.filename}" не найдено.`); }); createNotification(`Макет загружен. Применено ${c} из ${layoutData.length} изображений.`, 'success'); }
        
        // --- ZIP PROJECT SAVE & LOAD OPERATIONS ---
        function saveProject() {
            if (state.files.length === 0) return;
            showLoading("Сохранение проекта...", true);
            
            try {
                const zip = new JSZip();
                const metadata = [];
                
                state.files.forEach((fileData, index) => {
                    updateLoadingProgress(index + 1, state.files.length);
                    
                    const originalBase64 = fileData.originalSrc.split(',')[1];
                    const currentBase64 = fileData.src.split(',')[1];
                    
                    zip.file(`images/${fileData.id}_original.bin`, originalBase64, {base64: true});
                    zip.file(`images/${fileData.id}_current.bin`, currentBase64, {base64: true});
                    
                    const workspaceItem = DOM.workspace.querySelector(`.draggable-item[data-id="${fileData.id}"]`);
                    let placement = null;
                    if (workspaceItem) {
                        placement = {
                            x: workspaceItem.offsetLeft,
                            y: workspaceItem.offsetTop,
                            width: workspaceItem.offsetWidth,
                            height: workspaceItem.offsetHeight
                        };
                    }
                    
                    metadata.push({
                        id: fileData.id,
                        filename: fileData.file.name,
                        type: fileData.file.type,
                        placement: placement
                    });
                });
                
                zip.file("project.json", JSON.stringify(metadata, null, 2));
                
                zip.generateAsync({type:"blob"}).then(blob => {
                    const t = new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-');
                    saveAs(blob, `project-${t}.collageproj`);
                    hideLoading();
                    createNotification("Проект успешно сохранен!", "success");
                }).catch(err => {
                    console.error("Zip generation error:", err);
                    hideLoading();
                    createNotification("Ошибка при создании ZIP-архива", "error");
                });
                
            } catch (error) {
                console.error("Save project error:", error);
                hideLoading();
                createNotification("Ошибка при экспорте проекта", "error");
            }
        }

        async function handleProjectLoad(e) {
            const file = e.target.files[0];
            if (!file) return;
            
            showLoading("Загрузка проекта...", true);
            
            try {
                const zip = await JSZip.loadAsync(file);
                const projectJsonStr = await zip.file("project.json").async("string");
                const metadata = JSON.parse(projectJsonStr);
                
                DOM.workspace.innerHTML = '';
                DOM.palette.innerHTML = '';
                state.files = [];
                
                if (DOM.paletteEmptyState) {
                    DOM.paletteEmptyState.remove();
                    DOM.paletteEmptyState = null;
                }
                
                for (let i = 0; i < metadata.length; i++) {
                    updateLoadingProgress(i + 1, metadata.length);
                    const meta = metadata[i];
                    
                    const originalBin = await zip.file(`images/${meta.id}_original.bin`).async("base64");
                    const currentBin = await zip.file(`images/${meta.id}_current.bin`).async("base64");
                    
                    const originalSrc = `data:${meta.type || 'image/png'};base64,${originalBin}`;
                    const src = `data:${meta.type || 'image/png'};base64,${currentBin}`;
                    
                    const dummyFile = dataURLtoFile(src, meta.filename);
                    
                    const fileData = {
                        id: meta.id,
                        src: src,
                        originalSrc: originalSrc,
                        file: dummyFile
                    };
                    
                    state.files.push(fileData);
                    
                    if (meta.placement) {
                        createWorkspaceItem(fileData, {
                            x: meta.placement.x,
                            y: meta.placement.y,
                            width: meta.placement.width,
                            height: meta.placement.height
                        });
                    } else {
                        DOM.palette.appendChild(createPaletteItem(fileData));
                    }
                }
                
                hideLoading();
                updateUIOnItemChange();
                createNotification("Проект успешно восстановлен!", "success");
                
            } catch (err) {
                console.error("Error loading project:", err);
                hideLoading();
                createNotification("Ошибка при загрузке. Неверный формат файла проекта.", "error");
            }
            e.target.value = '';
        }

        async function assembleAndSave() { const items = Array.from(DOM.workspace.querySelectorAll('.draggable-item')); if (items.length === 0) { createNotification('Добавьте изображения!', 'error'); return; } const finalWidth = parseInt(DOM.finalWidthInput.value, 10); if (isNaN(finalWidth) || finalWidth < 100) { createNotification('Укажите корректную ширину!', 'error'); return; } if (finalWidth > 15000 && !confirm(`Высокое разрешение (${finalWidth}px) может потребовать много времени и памяти. Продолжить?`)) return; showLoading('Подготовка...', true); try { let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity; items.forEach(i => { minX = Math.min(minX, i.offsetLeft); minY = Math.min(minY, i.offsetTop); maxX = Math.max(maxX, i.offsetLeft + i.offsetWidth); maxY = Math.max(maxY, i.offsetTop + i.offsetHeight); }); const bboxWidth = maxX - minX; if (bboxWidth <= 0) throw new Error("Неверные размеры."); const scaleFactor = finalWidth / bboxWidth; const finalHeight = (maxY - minY) * scaleFactor; const canvas = document.createElement('canvas'); canvas.width = finalWidth; canvas.height = Math.round(finalHeight); const ctx = canvas.getContext('2d'); ctx.fillStyle = 'white'; ctx.fillRect(0, 0, canvas.width, canvas.height); for (let i = 0; i < items.length; i++) { const item = items[i]; updateLoadingProgress(i + 1, items.length); const imgData = state.files.find(f => f.id === item.dataset.id); if (imgData) { const sourceImage = new Image(); sourceImage.src = imgData.src; await sourceImage.decode(); const finalX = (item.offsetLeft - minX) * scaleFactor; const finalY = (item.offsetTop - minY) * scaleFactor; const finalW = item.offsetWidth * scaleFactor; const finalH = item.offsetHeight * scaleFactor; ctx.drawImage(sourceImage, finalX, finalY, finalW, finalH); } } showLoading("Сохранение файла..."); canvas.toBlob(blob => { const t = new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-'); saveAs(blob, `collage-${t}.jpg`); hideLoading(); createNotification('Коллаж сохранен!', 'success'); }, 'image/jpeg', 0.95); } catch (error) { console.error('Ошибка:', error); hideLoading(); createNotification('Ошибка при создании коллажа!', 'error'); } }
        
        // --- UI HELPERS ---
        function showLoading(text, showBar = false) { DOM.loadingText.textContent = text; DOM.progressBarContainer.style.display = showBar ? 'block' : 'none'; DOM.progressBar.style.width = '0%'; DOM.loadingOverlay.style.display = 'flex'; }
        function hideLoading() { DOM.loadingOverlay.style.display = 'none'; }
        function updateLoadingProgress(current, total) { const p = current / total * 100; DOM.progressBar.style.width = `${p}%`; DOM.loadingText.textContent = `Обработка ${current} из ${total}...`; }
        function createNotification(message, type) { const n = document.createElement('div'); n.className = `notification`; n.style.backgroundColor = type === 'error' ? 'var(--danger-color)' : 'var(--secondary-color)'; n.innerHTML = `<i class="fas fa-${type==='success'?'check-circle':'exclamation-circle'}"></i> ${message}`; document.body.appendChild(n); setTimeout(() => n.classList.add('show'), 100); setTimeout(() => { n.classList.remove('show'); setTimeout(() => n.remove(), 400); }, 5000); }
        
        initialize();
    });
    </script>
</body>
</html>