            .ac-streetview-box { width: 100%; height: 280px; background: #0f172a; border-radius: 12px; overflow: hidden; border: 1px solid #cbd5e1; position: relative; }
            .ac-card-btn { padding: 10px 14px; border-radius: 10px; font-size: 0.85rem; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; border: none; }
            .ac-btn-egrn { background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #fff; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25); }

            .ac-confirm-dialog-overlay { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65); z-index: 1000000; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(4px); }
            .ac-confirm-dialog { background: #ffffff; width: 450px; max-width: 90vw; border-radius: 18px; padding: 24px; box-shadow: 0 25px 50px rgba(0,0,0,0.3); border: 1px solid #e2e8f0; text-align: center; }
            .ac-confirm-icon { width: 52px; height: 52px; border-radius: 50%; background: #fef3c7; color: #d97706; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin: 0 auto 14px auto; }
        `;
        document.head.appendChild(style);
    }

    // =========================================================================
    // 2. УМНЫЙ АЛГОРИТМ ПОИСКА ПО АДРЕСУ С ГРАНИЦАМИ ЧИСЕЛ
    // =========================================================================

    function matchSmartAddress(rawAddress, query) {
        if (!query || !query.trim()) return true;
        if (!rawAddress) return false;

        const addr = String(rawAddress).toLowerCase();
        const tokens = query.trim().toLowerCase().split(/\s+/).filter(Boolean);

        for (const token of tokens) {
            // Литерные номера домов и квартир: "5", "5а", "8к1", "12/2"
            const isHouseOrAptNumber = /^(\d+[\/а-яa-z\-]*(?:к\d+)?)$/i.test(token);

            if (isHouseOrAptNumber) {
                const cleanToken = token.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                // Строгая проверка границ слова/числа: 5 не совпадет с 51 или 15
                const boundaryRegex = new RegExp(`(?:^|[^0-9а-яa-z])${cleanToken}(?:[^0-9а-яa-z]|$)`, 'i');
                if (!boundaryRegex.test(addr)) {
                    return false;
                }
            } else {
                // Текстовые части улицы, района, города
                if (!addr.includes(token)) {
                    return false;
                }
            }
        }
        return true;
    }

    // =========================================================================
    // 3. ХЕЛПЕРЫ ДАННЫХ И КООРДИНАТ
    // =========================================================================

    function escapeHtml(str) {
        if (str === null || str === undefined) return '';
        return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function getActiveMap() {
        if (window.yandexMap && typeof window.yandexMap.getBounds === 'function') return window.yandexMap;
        try {
            if (typeof map !== 'undefined' && map && typeof map.getBounds === 'function') return map;
        } catch (e) {}
        return null;
    }

    function extractCadastralNumber(f) {
        if (!f) return '';
        const p = f.properties || {};
        const o = p.options || {};
        const candidates = [
            o.cad_num, o.cad_number, p.descr, o.reg_numb_border, p.label,
            typeof f.id === 'string' && f.id.includes(':') ? f.id : null
        ];
        for (const c of candidates) {
            if (c && typeof c === 'string' && c.includes(':') && !c.startsWith('Полигон_') && !c.startsWith('Линия_') && c !== 'Объект') {
                return c.trim();
            }
        }
        return o.cad_num || o.cad_number || p.descr || o.reg_numb_border || (typeof f.id === 'string' ? f.id : '') || '';
    }

    function getNumericArea(f) {
        if (!f) return 0;
        const o = f.properties?.options || {};
        const val = parseFloat(o.specified_area || o.build_record_area || o.declared_area || o.land_record_area || o.params_extension || f.area || 0);
        return isFinite(val) && val > 0 ? val : 0;
    }

    function getNumericCost(f) {
        if (!f) return 0;
        const o = f.properties?.options || {};
        const val = parseFloat(o.cost_value || 0);
        return isFinite(val) && val > 0 ? val : 0;
    }

    function hasRealBoundaries(f) {
        if (!f || !f.geometry || !f.geometry.coordinates) return false;
        const c = f.geometry.coordinates;
        if (!Array.isArray(c) || c.length === 0) return false;
        if (f.geometry.type === 'Point') return false;
        if (f.geometry.type === 'Polygon') return Array.isArray(c[0]) && c[0].length >= 3;
        if (f.geometry.type === 'MultiPolygon') return Array.isArray(c[0]) && Array.isArray(c[0][0]) && c[0][0].length >= 3;
        if (f.geometry.type === 'LineString') return c.length >= 2;
        return true;
    }

    function isDeclaredParcel(f) {
        if (!f || f._layer_type !== 'zu') return false;
        const o = f.properties?.options || {};
        const isVerified = o.specified_area || o.land_record_area_verified;
        const hasDeclaredField = o.declared_area || o.land_record_area_declaration || o.land_record_area;
        return !isVerified && !!hasDeclaredField;
    }

    function getFeatureDate(f) {
        if (!f) return { regDate: null, dbDate: null };
        const p = f.properties || {};
        const o = p.options || {};
        const regDateRaw = o.land_record_reg_date || o.build_record_registration_date || o.registration_date || p.updated_date;
        const dbDateRaw = f.db_date || f.updated_date;
        const format = (d) => {
            if (!d || d === '-') return null;
            const m = String(d).match(/^(\d{4})-(\d{2})-(\d{2})/);
            return m ? `${m[3]}.${m[2]}.${m[1]}` : String(d);
        };
        return { regDate: format(regDateRaw), dbDate: format(dbDateRaw) };
    }

    function getFeatureCenterWgs(feature) {
        if (!feature || !feature.geometry) return null;
        let x = 0, y = 0, count = 0;
        const extractPoints = (coords) => {
            if (!Array.isArray(coords)) return;
            if (typeof coords[0] === 'number') { x += coords[0]; y += coords[1]; count++; }
            else { coords.forEach(extractPoints); }
        };
        extractPoints(feature.geometry.coordinates);
        if (count === 0) return null;
        x /= count; y /= count;
        const lon = (x / 6378137.0) * (180.0 / Math.PI);
        const lat = (Math.atan(Math.exp(y / 6378137.0)) * 2 - Math.PI / 2) * (180.0 / Math.PI);
        return { lat, lon };
    }

    function convertFeatureToYandexCoords(feature) {
        if (!feature || !feature.geometry || !feature.geometry.coordinates) return [];
        const mapOffsetY = parseFloat(localStorage.getItem('mapOffsetY')) || -1;
        const mapOffsetX = parseFloat(localStorage.getItem('mapOffsetX')) || -4.5;
        const toYandexPoint = (c) => {
            const is3857 = Math.abs(c[0]) > 200 || Math.abs(c[1]) > 200;
            let wgs = c;
            if (is3857 && typeof proj4 !== 'undefined') wgs = proj4('EPSG:3857', 'EPSG:4326', c);
            const lat = wgs[1] - (mapOffsetY * 0.000008983);
            const lon = wgs[0] - (mapOffsetX * 0.000008983);
            return [lat, lon];
        };
        const geom = feature.geometry;
        if (geom.type === 'Polygon') return geom.coordinates.map(ring => ring.map(toYandexPoint));
        if (geom.type === 'MultiPolygon') return geom.coordinates.flatMap(poly => poly.map(ring => ring.map(toYandexPoint)));
        if (geom.type === 'LineString') return [geom.coordinates.map(toYandexPoint)];
        return [];
    }

    function getDefaultCadastralPrefix() {
        try {
            const mskVal = localStorage.getItem('savedDefaultMskSystem') || '';
            const m = mskVal.match(/633(\d{2})/);
            if (m) return `${m[1]}:`;
            const mskText = (typeof COORDINATE_SYSTEMS !== 'undefined')
                ? (COORDINATE_SYSTEMS.find(s => s.value === mskVal)?.text || '') : '';
            const m2 = mskText.match(/МСК[ -]?(\d{2})/i);
            if (m2) return `${m2[1]}:`;
        } catch (e) {}
        return '01:';
    }

    async function ensureEcharts() {
        if (typeof echarts === 'undefined') {
            await new Promise((resolve, reject) => {
                const s = document.createElement('script');
                s.src = "https://cdnjs.cloudflare.com/ajax/libs/echarts/5.5.0/echarts.min.js";
                s.onload = resolve; s.onerror = reject;
                document.head.appendChild(s);
            });
        }
    }

    async function ensureXlsx() {
        if (typeof XLSX === 'undefined') {
            await new Promise((resolve, reject) => {
                const s = document.createElement('script');
                s.src = "https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js";
                s.onload = resolve; s.onerror = reject;
                document.head.appendChild(s);
            });
        }
    }

    // =========================================================================
    // 4. СБОР ОБЪЕКТОВ С КАРТЫ, РАСЧЕТ И ФИЛЬТРАЦИЯ
    // =========================================================================

    function getMapObjectsAsFeatures() {
        const features = [];
        const seen = new Set();

        const addFeature = (f, defaultType) => {
            if (!f) return;
            const p = f.properties || {};
            const o = p.options || {};
            const cn = extractCadastralNumber(f) || 'Объект';
            const key = (cn && cn !== 'Объект') ? cn : (p._exportId || `${defaultType}_${Math.random()}`);
            if (seen.has(key)) return;
            seen.add(key);

            let layerType = defaultType;
            const cat = p.category;
            const catName = (p.categoryName || '').toLowerCase();
            if (cat === 36369 || catName.includes('здани') || o.build_record_area || (o.cad_num && o.purpose)) {
                layerType = 'oks';
            } else if (cat === 36383 || catName.includes('сооружен') || o.params_extension) {
                layerType = 'structure';
            } else if (cat === 36940 || cat === 36315 || cat === 36281 || cat === 36278 || cat === 36314 || catName.includes('зон') || p._zone_type) {
                layerType = 'zones';
            } else if (cat === 36368 || catName.includes('земельн') || o.land_record_type || o.specified_area || o.declared_area) {
                layerType = 'zu';
            }

            features.push({
                id: cn,
                _layer_type: layerType,
                properties: p,
                geometry: f.geometry || null,
                area: getNumericArea(f),
                cost: getNumericCost(f),
                db_date: f.db_date || p.updated_date || new Date().toISOString().slice(0, 10)
            });
        };

        const zuArray = (typeof parcelFeaturesData !== 'undefined' && Array.isArray(parcelFeaturesData)) ? parcelFeaturesData : (window.parcelFeaturesData || []);
        const oksArray = (typeof buildingFeaturesData !== 'undefined' && Array.isArray(buildingFeaturesData)) ? buildingFeaturesData : (window.buildingFeaturesData || []);
        const strArray = (typeof structureFeaturesData !== 'undefined' && Array.isArray(structureFeaturesData)) ? structureFeaturesData : (window.structureFeaturesData || []);
        const zouitArray = (typeof zouitFeaturesData !== 'undefined' && Array.isArray(zouitFeaturesData)) ? zouitFeaturesData : (window.zouitFeaturesData || []);

        zuArray.forEach(f => addFeature(f, 'zu'));
        oksArray.forEach(f => addFeature(f, 'oks'));
        strArray.forEach(f => addFeature(f, 'structure'));
        zouitArray.forEach(f => addFeature(f, 'zones'));

        const polyArray = (typeof polygons !== 'undefined' && Array.isArray(polygons)) ? polygons : (window.polygons || []);
        polyArray.forEach(obj => {
            if (!obj || !obj.properties) return;
            const p = obj.properties;
            if (p.get('isQuarterBoundary') || p.get('isSearchShape') || p.get('isVertexPoint')) return;

            let fd = p.get('featureData');
            const cn = p.get('cadastralNumber');
            let defaultType = 'zu';
            if (p.get('isBuilding')) defaultType = 'oks';
            else if (p.get('isStructure')) defaultType = 'structure';
            else if (p.get('isZouit')) defaultType = 'zones';

            if (fd) {
                addFeature(fd, defaultType);
            } else if (cn || obj instanceof ymaps.Polygon || obj instanceof ymaps.Polyline) {
                const stats = (typeof calculatePreciseGeometry === 'function') ? calculatePreciseGeometry(obj) : { area: 0, perimeter: 0 };
                addFeature({
                    type: "Feature",
                    id: cn || 'Объект',
                    geometry: obj.geometry ? { type: obj.geometry.getType(), coordinates: obj.geometry.getCoordinates() } : null,
                    properties: {
                        descr: cn || 'Объект',
                        options: {
                            cad_num: cn || 'Объект',
                            readable_address: p.get('address') || 'Нанесен на карту',
                            specified_area: stats.area || null,
                            params_extension: stats.perimeter || null
                        }
                    }
                }, defaultType);
            }
        });

        return features;
    }

    function detectPopularCadastralPrefix(features) {
        if (!features || !features.length) return '';
        const counts = {};
        features.forEach(f => {
            const cn = extractCadastralNumber(f);
            const m = cn.match(/\b(\d{1,2}:\d{1,2})\b/);
            if (m) counts[m[1]] = (counts[m[1]] || 0) + 1;
        });
        let best = '', max = 0;
        for (const k in counts) {
            if (counts[k] > max) { max = counts[k]; best = k; }
        }
        return best;
    }

    function generateSummaryFromFeatures(features) {
        let count_zu = 0, count_oks = 0, count_str = 0, count_zones = 0;
        let total_area = 0, total_cost = 0;
        let cost_count = 0, cost_upks_sum = 0;
        const ownership_dist = {};
        const floors_dist = {};
        const materials_dist = {};
        const cost_brackets = {
            'До 1 млн ₽': 0, '1 - 3 млн ₽': 0, '3 - 5 млн ₽': 0,
            '5 - 10 млн ₽': 0, '10 - 20 млн ₽': 0, '20+ млн ₽': 0
        };

        features.forEach(f => {
            const o = f.properties?.options || {};
            if (f._layer_type === 'zu') count_zu++;
            else if (f._layer_type === 'oks') count_oks++;
            else if (f._layer_type === 'structure') count_str++;
            else if (f._layer_type === 'zones') count_zones++;

            const area = getNumericArea(f);
            const cost = getNumericCost(f);

            total_area += area;
            if (cost > 0) {
                total_cost += cost;
                if (area > 0) { cost_upks_sum += (cost / area); cost_count++; }
                if (cost < 1e6) cost_brackets['До 1 млн ₽']++;
                else if (cost < 3e6) cost_brackets['1 - 3 млн ₽']++;
                else if (cost < 5e6) cost_brackets['3 - 5 млн ₽']++;
                else if (cost < 1e7) cost_brackets['5 - 10 млн ₽']++;
                else if (cost < 2e7) cost_brackets['10 - 20 млн ₽']++;
                else cost_brackets['20+ млн ₽']++;
            }

            const own = (o.ownership_type || 'Не указано').trim();
            ownership_dist[own] = (ownership_dist[own] || 0) + 1;

            const fl = parseInt(o.floors, 10);
            if (fl && fl > 0 && fl <= 50) floors_dist[fl] = (floors_dist[fl] || 0) + 1;

            const mat = (o.materials || '').trim();
            if (mat && mat !== '-' && mat !== 'null') materials_dist[mat] = (materials_dist[mat] || 0) + 1;
        });

        return {
            total_count: features.length, count_zu, count_oks, count_str, count_zones,
            total_area, total_cost, avg_upks: cost_count > 0 ? (cost_upks_sum / cost_count) : 0,
            ownership_dist, floors_dist, cost_brackets, materials_dist, is_limit_reached: false
        };
    }

    function computeClientStats(features) {
        let withGeom = 0, withoutGeom = 0, zuSpecified = 0, zuDeclared = 0, oksWithGeom = 0, oksWithoutGeom = 0;
        const vriCounts = {}, upksList = [], scatterData = [];

        features.forEach(f => {
            const o = f.properties?.options || {};
            const hasGeom = hasRealBoundaries(f);
            if (hasGeom) withGeom++; else withoutGeom++;

            if (f._layer_type === 'zu') {
                if (isDeclaredParcel(f)) zuDeclared++; else zuSpecified++;
            } else if (f._layer_type === 'oks' || f._layer_type === 'structure') {
                if (hasGeom) oksWithGeom++; else oksWithoutGeom++;
            }

            const vriRaw = (o.permitted_use_established_by_document || o.purpose || o.params_purpose || '').trim();
            if (vriRaw && vriRaw !== '-' && vriRaw !== 'null') {
                const shortVri = vriRaw.length > 48 ? vriRaw.slice(0, 45) + '...' : vriRaw;
                vriCounts[shortVri] = (vriCounts[shortVri] || 0) + 1;
            }

            const area = getNumericArea(f);
            const cost = getNumericCost(f);
            if (area > 0 && cost > 0) {
                const upks = cost / area;
                if (upks > 1 && upks < 5000000) upksList.push(upks);
                if (scatterData.length < 1500) {
                    scatterData.push({
                        value: [Math.round(area), Math.round(cost)],
                        id: f.id, type: f._layer_type, raw: f
                    });
                }
            }
        });

        upksList.sort((a, b) => a - b);
        const medianUpks = upksList.length > 0 ? upksList[Math.floor(upksList.length / 2)] : 0;
        const topVri = Object.entries(vriCounts).sort((a, b) => b[1] - a[1]).slice(0, 10);

        return {
            withGeom, withoutGeom, zuSpecified, zuDeclared, oksWithGeom, oksWithoutGeom,
            topVri, medianUpks, minUpks: upksList[0] || 0, maxUpks: upksList[upksList.length - 1] || 0, scatterData
        };
    }

    function filterMapFeatures(allFeatures, payload) {
        const filters = payload.filters || {};
        const tables = payload.tables || ['zu', 'oks', 'structure', 'zones'];

        return allFeatures.filter(f => {
            if (!tables.includes(f._layer_type)) return false;

            const p = f.properties || {};
            const o = p.options || {};
            const objCad = extractCadastralNumber(f).toLowerCase();

            if (filters.cad_num) {
                const searchCad = filters.cad_num.toLowerCase().replace(/:+$/, '');
                if (/^\d{1,2}:/.test(objCad)) {
                    if (!objCad.includes(searchCad)) return false;
                }
            }

            if (filters.address) {
                const objAddr = String(o.readable_address || o.address_readable_address || '');
                if (filters.exact_match) {
                    if (!objAddr.toLowerCase().includes(filters.address.toLowerCase())) return false;
                } else {
                    // Используем умный поиск по адресу с границами чисел
                    if (!matchSmartAddress(objAddr, filters.address)) return false;
                }
            }

            if (filters.ownership && !(o.ownership_type || '').toLowerCase().includes(filters.ownership.toLowerCase())) return false;
            if (filters.right_type && !(o.right_type || '').toLowerCase().includes(filters.right_type.toLowerCase())) return false;
            if (filters.status && !(o.status || '').toLowerCase().includes(filters.status.toLowerCase())) return false;

            if (filters.zu_area_type && f._layer_type === 'zu') {
                if (filters.zu_area_type === 'specified' && !hasRealBoundaries(f)) return false;
                if (filters.zu_area_type === 'declared' && !isDeclaredParcel(f)) return false;
            }

            if (filters.zu_category && f._layer_type === 'zu') {
                if (!(o.land_record_category_type || '').toLowerCase().includes(filters.zu_category.toLowerCase())) return false;
            }

            if (filters.zu_vri && f._layer_type === 'zu') {
                if (!(o.permitted_use_established_by_document || '').toLowerCase().includes(filters.zu_vri.toLowerCase())) return false;
            }

            if (filters.oks_purpose && f._layer_type === 'oks') {
                if (!(o.purpose || '').toLowerCase().includes(filters.oks_purpose.toLowerCase())) return false;
            }

            const floors = parseInt(o.floors, 10);
            if (filters.floors_min !== undefined && (!floors || floors < filters.floors_min)) return false;
            if (filters.floors_max !== undefined && (!floors || floors > filters.floors_max)) return false;

            const area = getNumericArea(f);
            if (filters.area_min !== undefined && area < filters.area_min) return false;
            if (filters.area_max !== undefined && area > filters.area_max) return false;

            const cost = getNumericCost(f);
            if (filters.cost_min !== undefined && cost < filters.cost_min) return false;
            if (filters.cost_max !== undefined && cost > filters.cost_max) return false;

            if (filters.materials && f._layer_type === 'oks') {
                if (!(o.materials || '').toLowerCase().includes(filters.materials.toLowerCase())) return false;
            }

            return true;
        });
    }

    function collectFilterPayload(clickLat, clickLon, isMapObjectsMode = false) {
        const spatialType = document.getElementById('ac-spatial-type')?.value || 'map_objects';
        const cad = document.getElementById('ac-cadnum-search')?.value.trim() || '';

        if (!isMapObjectsMode && !/^\d{2}:\d{2}/.test(cad) && spatialType === 'all') {
            const defPrefix = getDefaultCadastralPrefix();
            alert(`Для выборки по всей базе укажите код региона и района (например: ${defPrefix}01:).`);
            document.getElementById('ac-cadnum-search')?.focus();
            return null;
        }

        const payload = {
            tables: [],
            filters: {
                exact_match: document.getElementById('ac-exact-match')?.checked || false
            }
        };

        if (document.getElementById('ac-type-zu')?.checked) payload.tables.push('zu');
        if (document.getElementById('ac-type-oks')?.checked) payload.tables.push('oks');
        if (document.getElementById('ac-type-str')?.checked) payload.tables.push('structure');
        if (document.getElementById('ac-type-zones')?.checked) payload.tables.push('zones');

        if (spatialType === 'viewport') {
            const activeMap = getActiveMap();
            if (activeMap) {
                const bounds = activeMap.getBounds();
                if (bounds && bounds[0] && bounds[1]) {
                    payload.spatial = {
                        type: 'bbox',
                        min_lat: bounds[0][0], min_lon: bounds[0][1],
                        max_lat: bounds[1][0], max_lon: bounds[1][1]
                    };
                }
            } else {
                alert('Карта еще не инициализирована');
                return null;
            }
        } else if (spatialType === 'radius' && clickLat && clickLon) {
            payload.spatial = {
                type: 'circle',
                lat: clickLat, lon: clickLon,
                radius: parseFloat(document.getElementById('ac-radius-val')?.value) || 1000
            };
        }

        if (cad) payload.filters.cad_num = cad;

        const addr = document.getElementById('ac-address-search')?.value.trim();
        if (addr) payload.filters.address = addr;

        const own = document.getElementById('ac-ownership-type')?.value;
        if (own) payload.filters.ownership = own;

        const right = document.getElementById('ac-right-type')?.value.trim();
        if (right) payload.filters.right_type = right;

        const status = document.getElementById('ac-status-val')?.value;
        if (status) payload.filters.status = status;

        const zuAreaType = document.getElementById('ac-zu-area-type')?.value;
        if (zuAreaType) payload.filters.zu_area_type = zuAreaType;

        const zuCat = document.getElementById('ac-zu-category')?.value;
        if (zuCat) payload.filters.zu_category = zuCat;

        const zuVri = document.getElementById('ac-zu-vri')?.value.trim();
        if (zuVri) payload.filters.zu_vri = zuVri;

        const oksPurpose = document.getElementById('ac-oks-purpose')?.value.trim();
        if (oksPurpose) payload.filters.oks_purpose = oksPurpose;

        const fMin = document.getElementById('ac-floors-min')?.value;
        if (fMin) payload.filters.floors_min = parseInt(fMin, 10);
        const fMax = document.getElementById('ac-floors-max')?.value;
        if (fMax) payload.filters.floors_max = parseInt(fMax, 10);

        const aMin = document.getElementById('ac-area-min')?.value;
        if (aMin) payload.filters.area_min = parseFloat(aMin);
        const aMax = document.getElementById('ac-area-max')?.value;
        if (aMax) payload.filters.area_max = parseFloat(aMax);

        const cMin = document.getElementById('ac-cost-min')?.value;
        if (cMin) payload.filters.cost_min = parseFloat(cMin);
        const cMax = document.getElementById('ac-cost-max')?.value;
        if (cMax) payload.filters.cost_max = parseFloat(cMax);

        const mat = document.getElementById('ac-materials')?.value.trim();
        if (mat) payload.filters.materials = mat;

        return payload;
    }

    function resetAllFilters(defaultCadValue, lat, lon) {
        document.getElementById('ac-ai-text').value = '';
        document.getElementById('ac-spatial-type').value = 'map_objects';
        document.getElementById('ac-radius-wrap').style.display = 'none';
        document.getElementById('ac-cadnum-search').value = defaultCadValue;
        document.getElementById('ac-address-search').value = '';
        document.getElementById('ac-exact-match').checked = false;
        document.getElementById('ac-type-zu').checked = true;
        document.getElementById('ac-type-oks').checked = true;
        document.getElementById('ac-type-str').checked = false;
        document.getElementById('ac-type-zones').checked = false;
        document.getElementById('ac-ownership-type').value = '';
        document.getElementById('ac-right-type').value = '';
        document.getElementById('ac-status-val').value = '';
        document.getElementById('ac-zu-area-type').value = '';
        document.getElementById('ac-zu-category').value = '';
        document.getElementById('ac-zu-vri').value = '';
        document.getElementById('ac-oks-purpose').value = '';
        document.getElementById('ac-floors-min').value = '';
        document.getElementById('ac-floors-max').value = '';
        document.getElementById('ac-materials').value = '';
        document.getElementById('ac-area-min').value = '';
        document.getElementById('ac-area-max').value = '';
        document.getElementById('ac-cost-min').value = '';
        document.getElementById('ac-cost-max').value = '';
        analyticsSettings.tableSearchTerm = '';
        analyticsSettings.tableSortField = 'default';
        runAnalyticsQuery(lat, lon);
    }

    async function processAiQuery() {
        const inputEl = document.getElementById('ac-ai-text');
        const queryText = inputEl.value.trim();
        if (!queryText) return;

        const submitBtn = document.getElementById('ac-ai-submit');
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Распознавание ИИ...';

        const systemPrompt = `Ты — кадастровый аналитик. Преобразуй запрос на русском в JSON фильтр:
{
  "address": "строка или пусто",
  "cad_num": "маска или номер или пусто",
  "floors_min": число или null,
  "floors_max": число или null,
  "area_min": число или null,
  "area_max": число или null,
  "cost_min": число или null,
  "cost_max": число или null,
  "materials": "материал стен или пусто",
  "purpose": "назначение здания или пусто",
  "zu_vri": "разрешенное использование или пусто",
  "ownership": "Частная, Муниципальная, Государственная или пусто",
  "types": ["zu", "oks", "structure", "zones"]
}`;

        try {
            const resp = await fetch(MAPRUAPP_AI_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    model: AI_MODEL_NAME,
                    messages: [
                        { role: "system", content: systemPrompt },
                        { role: "user", content: queryText }
                    ],
                    max_tokens: 1024
                })
            });

            if (!resp.ok) throw new Error("Шлюз ИИ не ответил.");
            const data = await resp.json();
            const textResponse = data.choices?.[0]?.message?.content || "";
            const cleanJson = textResponse.replace(/^```json\s*|\s*```$/g, '').trim();
            const parsed = JSON.parse(cleanJson);

            if (parsed.address !== undefined) document.getElementById('ac-address-search').value = parsed.address || '';
            if (parsed.cad_num) document.getElementById('ac-cadnum-search').value = parsed.cad_num;
            if (parsed.floors_min !== undefined) document.getElementById('ac-floors-min').value = parsed.floors_min || '';
            if (parsed.floors_max !== undefined) document.getElementById('ac-floors-max').value = parsed.floors_max || '';
            if (parsed.area_min !== undefined) document.getElementById('ac-area-min').value = parsed.area_min || '';
            if (parsed.area_max !== undefined) document.getElementById('ac-area-max').value = parsed.area_max || '';
            if (parsed.cost_min !== undefined) document.getElementById('ac-cost-min').value = parsed.cost_min || '';
            if (parsed.cost_max !== undefined) document.getElementById('ac-cost-max').value = parsed.cost_max || '';
            if (parsed.materials !== undefined) document.getElementById('ac-materials').value = parsed.materials || '';
            if (parsed.purpose !== undefined) document.getElementById('ac-oks-purpose').value = parsed.purpose || '';
            if (parsed.zu_vri !== undefined) document.getElementById('ac-zu-vri').value = parsed.zu_vri || '';
            if (parsed.ownership !== undefined) document.getElementById('ac-ownership-type').value = parsed.ownership || '';

            if (Array.isArray(parsed.types) && parsed.types.length > 0) {
                document.getElementById('ac-type-zu').checked = parsed.types.includes('zu');
                document.getElementById('ac-type-oks').checked = parsed.types.includes('oks');
                document.getElementById('ac-type-str').checked = parsed.types.includes('structure');
                document.getElementById('ac-type-zones').checked = parsed.types.includes('zones');
            }

            runAnalyticsQuery();
        } catch (err) {
            alert("Ошибка распознавания ИИ: " + err.message);
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-wand-magic-sparkles"></i> Применить фильтр';
        }
    }

    // =========================================================================
    // 5. ПАРСИНГ НАБОРА И РАСЧЕТ KPI КАРТОЧЕК
    // =========================================================================

    function parseInfographicsDataset(features) {
        const items = [];
        let totalZuArea = 0, totalOksArea = 0, totalStrLength = 0, totalCost = 0, costIndexSum = 0, costIndexCount = 0;
        let specifiedCount = 0, declaredCount = 0, countZu = 0, countOks = 0, countStr = 0, countZones = 0;

        const ownershipDist = {}, vriDist = {}, categoryDist = {};
        const oksYearsDist = { 'До 1970': 0, '1970–1990': 0, '1991–2010': 0, '2011–2020': 0, '2021+': 0, 'Не указан': 0 };
        const oksFloorsDist = { '1 эт.': 0, '2 эт.': 0, '3-5 эт.': 0, '6-9 эт.': 0, '10+ эт.': 0, 'Не указано': 0 };

        features.forEach(f => {
            const p = f.properties || {};
            const o = p.options || {};
            const type = f._layer_type || 'zu';
            const cn = extractCadastralNumber(f) || (type === 'zu' ? 'ЗУ б/н' : 'ОКС б/н');
            const area = getNumericArea(f);
            const cost = getNumericCost(f);
            const upks = parseFloat(o.cost_index || (area > 0 && cost > 0 ? cost / area : 0));
            const own = (o.ownership_type || 'Не указано').trim();
            const right = o.right_type || '-';
            const vri = (o.permitted_use_established_by_document || o.purpose || o.params_purpose || 'Не указан').trim();
            const cat = (o.land_record_category_type || 'Категория не установлена').trim();
            const address = o.readable_address || o.address_readable_address || 'Адрес не указан';
            const isSpec = hasRealBoundaries(f) && !isDeclaredParcel(f);

            if (type === 'zu') {
                countZu++;
                totalZuArea += area;
                if (isSpec) specifiedCount++; else declaredCount++;
                ownershipDist[own] = (ownershipDist[own] || 0) + 1;
                vriDist[vri] = (vriDist[vri] || 0) + 1;
                categoryDist[cat] = (categoryDist[cat] || 0) + 1;
            } else if (type === 'oks') {
                countOks++;
                totalOksArea += area;
                const year = parseInt(o.year_built, 10);
                const floors = parseInt(o.floors, 10);

                if (isNaN(year)) oksYearsDist['Не указан']++;
                else if (year < 1970) oksYearsDist['До 1970']++;
                else if (year <= 1990) oksYearsDist['1970–1990']++;
                else if (year <= 2010) oksYearsDist['1991–2010']++;
                else if (year <= 2020) oksYearsDist['2011–2020']++;
                else oksYearsDist['2021+']++;

                if (isNaN(floors) || floors <= 0) oksFloorsDist['Не указано']++;
                else if (floors === 1) oksFloorsDist['1 эт.']++;
                else if (floors === 2) oksFloorsDist['2 эт.']++;
                else if (floors <= 5) oksFloorsDist['3-5 эт.']++;
                else if (floors <= 9) oksFloorsDist['6-9 эт.']++;
                else oksFloorsDist['10+ эт.']++;
            } else if (type === 'structure') {
                countStr++;
                totalStrLength += area;
            } else if (type === 'zones') {
                countZones++;
            }

            if (cost > 0) totalCost += cost;
            if (upks > 0) { costIndexSum += upks; costIndexCount++; }

            items.push({
                type,
                typeLabel: type === 'zu' ? 'ЗУ' : (type === 'oks' ? 'ОКС' : (type === 'structure' ? 'Сооружение' : 'Зона')),
                cn,
                name: o.name || o.building_name || o.params_name || '',
                purpose: o.purpose || o.params_purpose || '',
                area,
                cost,
                upks: Math.round(upks * 100) / 100,
                ownership: own,
                right,
                vri,
                category: cat,
                address,
                year: o.year_built || o.params_year_built || '-',
                floors: o.floors || '-',
                materials: o.materials || '-',
                isSpecified: isSpec,
                feature: f
            });
        });

        return {
            items,
            totalCount: features.length, countZu, countOks, countStr, countZones,
            totalZuArea, totalOksArea, totalStrLength, totalCost,
            avgUpks: costIndexCount > 0 ? (costIndexSum / costIndexCount) : 0,
            specifiedCount, declaredCount, ownershipDist, vriDist, categoryDist, oksYearsDist, oksFloorsDist
        };
    }

    function getFilteredDatasetItems() {
        if (!currentParsedDataset) return [];
        let list = currentParsedDataset.items;

        if (analyticsSettings.scope === 'zu') list = list.filter(i => i.type === 'zu');
        else if (analyticsSettings.scope === 'oks') list = list.filter(i => i.type === 'oks');
        else if (analyticsSettings.scope === 'structure') list = list.filter(i => i.type === 'structure');

        if (analyticsSettings.tableSearchTerm) {
            const query = analyticsSettings.tableSearchTerm.trim().toLowerCase();
            list = list.filter(item => {
                if (item.cn.toLowerCase().includes(query)) return true;
                const fullAddressString = `${item.address} ${item.name} ${item.purpose} ${item.vri}`;
                return matchSmartAddress(fullAddressString, query);
            });
        }
        return list;
    }

    function updateKpiBarUI() {
        const kpiContainer = document.getElementById('ac-kpi-container');
        if (!kpiContainer || !currentParsedDataset) return;

        const filtered = getFilteredDatasetItems();
        let filteredArea = 0, filteredCost = 0, upksSum = 0, upksCnt = 0, specCnt = 0, declCnt = 0;

        filtered.forEach(i => {
            filteredArea += i.area;
            if (i.cost > 0) filteredCost += i.cost;
            if (i.upks > 0) { upksSum += i.upks; upksCnt++; }
            if (i.type === 'zu') {
                if (i.isSpecified) specCnt++; else declCnt++;
            }
        });

        const avgUpks = upksCnt > 0 ? (upksSum / upksCnt) : 0;
        const areaHa = (filteredArea / 10000).toFixed(2);
        const costMln = (filteredCost / 1000000).toFixed(2);
        const totalZu = specCnt + declCnt;
        const boundaryPercent = totalZu > 0 ? Math.round((specCnt / totalZu) * 100) : 0;

        kpiContainer.innerHTML = `
            <div class="ac-kpi-card" style="border-left: 4px solid #3b82f6;">
                <div class="ac-kpi-info">
                    <span>Суммарная площадь (${filtered.length} об.)</span>
                    <strong>${areaHa} га</strong>
                    <div class="ac-kpi-sub">${Math.round(filteredArea).toLocaleString('ru-RU')} м²</div>
                </div>
                <div class="ac-kpi-icon" style="background:#eff6ff; color:#2563eb;"><i class="fas fa-ruler-combined"></i></div>
            </div>

            <div class="ac-kpi-card" style="border-left: 4px solid #10b981;">
                <div class="ac-kpi-info">
                    <span>Кадастровая стоимость</span>
                    <strong style="color:#047857;">${Number(costMln).toLocaleString('ru-RU')} млн ₽</strong>
                    <div class="ac-kpi-sub">${Math.round(filteredCost).toLocaleString('ru-RU')} ₽</div>
                </div>
                <div class="ac-kpi-icon" style="background:#ecfdf5; color:#10b981;"><i class="fas fa-sack-dollar"></i></div>
            </div>

            <div class="ac-kpi-card" style="border-left: 4px solid #f59e0b;">
                <div class="ac-kpi-info">
                    <span>Средний показатель УПКС</span>
                    <strong style="color:#b45309;">${Math.round(avgUpks).toLocaleString('ru-RU')} ₽/м²</strong>
                    <div class="ac-kpi-sub">По объектам с кадастровой оценкой</div>
                </div>
                <div class="ac-kpi-icon" style="background:#fffbeb; color:#d97706;"><i class="fas fa-chart-line"></i></div>
            </div>

            <div class="ac-kpi-card" style="border-left: 4px solid #8b5cf6;">
                <div class="ac-kpi-info">
                    <span>Точность границ (межевание)</span>
                    <strong style="color:#6d28d9;">${boundaryPercent}%</strong>
                    <div class="ac-kpi-sub">Уточнено: ${specCnt} / Без границ: ${declCnt}</div>
                </div>
                <div class="ac-kpi-icon" style="background:#f5f3ff; color:#7c3aed;"><i class="fas fa-draw-polygon"></i></div>
            </div>

            <div class="ac-kpi-card" style="border-left: 4px solid #0284c7;">
                <div class="ac-kpi-info">
                    <span>Объекты застройки (ОКС)</span>
                    <strong>${currentParsedDataset.countOks} зданий</strong>
                    <div class="ac-kpi-sub">Площадь ОКС: ${Math.round(currentParsedDataset.totalOksArea).toLocaleString('ru-RU')} м²</div>
                </div>
                <div class="ac-kpi-icon" style="background:#ecfeff; color:#0891b2;"><i class="fas fa-city"></i></div>
            </div>
        `;
    }
    
    
    
    // =========================================================================
    // 6. ИНТЕРАКТИВНЫЙ ТУЛТИП-ПАСПОРТ ОБЪЕКТА ДЛЯ ГРАФИКОВ
    // =========================================================================

    function generateInfographicsTooltipHtml(item) {
        if (!item) return '';

        const areaStr = item.area > 0 ? `${Math.round(item.area).toLocaleString('ru-RU')} м²` : 'Не указана';
        const costStr = item.cost > 0 ? `${Math.round(item.cost).toLocaleString('ru-RU')} ₽` : 'Не указана';
        const upksStr = item.upks > 0 ? `${item.upks.toLocaleString('ru-RU')} ₽/м²` : 'Не указан';

        const cleanAddress = (item.address || 'Адрес не указан')
            .replace(/Российская Федерация,\s*/gi, '')
            .replace(/Республика\s+[^,]+,\s*/gi, '')
            .trim();

        const isZu = item.type === 'zu';
        const isOks = item.type === 'oks';
        const badgeBg = isZu ? '#dbeafe' : (isOks ? '#ede9fe' : '#ffedd5');
        const badgeColor = isZu ? '#1d4ed8' : (isOks ? '#6d28d9' : '#c2410c');

        let specBadge = '';
        if (isZu) {
            specBadge = item.isSpecified
                ? `<span style="background:#dcfce7; color:#15803d; padding:2px 7px; border-radius:5px; font-size:10px; font-weight:700;">✔ Границы уточнены</span>`
                : `<span style="background:#fee2e2; color:#b91c1c; padding:2px 7px; border-radius:5px; font-size:10px; font-weight:700;">⚠ Без межевания (декларированный)</span>`;
        } else if (isOks) {
            specBadge = `<span style="background:#f1f5f9; color:#475569; padding:2px 7px; border-radius:5px; font-size:10px; font-weight:600;">Год: ${item.year || '-'} | Этажей: ${item.floors || '-'}</span>`;
        }

        return `
            <div style="
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                width: 310px; max-width: 80vw; white-space: normal; line-height: 1.45;
                font-size: 11.5px; color: #1e293b; padding: 4px; box-sizing: border-box;
            ">
                <div style="display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid #e2e8f0; padding-bottom:6px; margin-bottom:7px; gap:6px;">
                    <div style="display:flex; align-items:center; gap:6px; min-width:0;">
                        <span style="background:${badgeBg}; color:${badgeColor}; font-weight:800; font-size:10px; padding:2px 6px; border-radius:5px; flex-shrink:0;">
                            ${item.typeLabel}
                        </span>
                        <span style="font-weight:800; font-size:12.5px; color:#0f172a; word-break:break-all;">${escapeHtml(item.cn)}</span>
                    </div>
                </div>

                ${specBadge ? `<div style="margin-bottom:7px;">${specBadge}</div>` : ''}

                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:6px; background:#f8fafc; padding:6px 8px; border-radius:8px; border:1px solid #e2e8f0; margin-bottom:7px;">
                    <div>
                        <div style="font-size:9.5px; color:#64748b; text-transform:uppercase; font-weight:700;">Площадь</div>
                        <div style="font-weight:700; color:#0f172a;">${areaStr}</div>
                    </div>
                    <div>
                        <div style="font-size:9.5px; color:#64748b; text-transform:uppercase; font-weight:700;">УПКС</div>
                        <div style="font-weight:700; color:#b45309;">${upksStr}</div>
                    </div>
                    <div style="grid-column: span 2; border-top:1px dashed #e2e8f0; padding-top:4px;">
                        <div style="font-size:9.5px; color:#64748b; text-transform:uppercase; font-weight:700;">Кадастровая стоимость</div>
                        <div style="font-weight:800; color:#047857; font-size:12px;">${costStr}</div>
                    </div>
                </div>

                <div style="display:flex; flex-direction:column; gap:3px; font-size:11px;">
                    ${item.ownership && item.ownership !== 'Не указано' ? `<div><span style="color:#64748b;">Собственность:</span> <b>${escapeHtml(item.ownership)}</b></div>` : ''}
                    ${item.right && item.right !== '-' ? `<div><span style="color:#64748b;">Право:</span> <b>${escapeHtml(item.right)}</b></div>` : ''}
                    ${isOks ? `
                        ${item.name ? `<div><span style="color:#64748b;">Наименование:</span> <span style="color:#0f172a; font-weight:700;">${escapeHtml(item.name)}</span></div>` : ''}
                        ${item.purpose ? `<div><span style="color:#64748b;">Назначение:</span> <span style="color:#334155; font-weight:600;">${escapeHtml(item.purpose)}</span></div>` : ''}
                    ` : `
                        ${item.vri && item.vri !== 'Не указан' ? `<div><span style="color:#64748b;">ВРИ:</span> <span style="color:#334155; font-weight:600;">${escapeHtml(item.vri)}</span></div>` : ''}
                    `}
                    <div style="color:#64748b; margin-top:3px; font-size:10.5px; display:flex; gap:4px;">
                        <span>📍</span> <span>${escapeHtml(cleanAddress)}</span>
                    </div>
                </div>

                <div style="margin-top:8px; padding-top:5px; border-top:1px dashed #cbd5e1; font-size:10px; color:#0284c7; font-weight:700; text-align:center;">
                    🎯 Кликните по элементу для перехода к объекту на карте
                </div>
            </div>
        `;
    }

    // =========================================================================
    // 7. УПРАВЛЕНИЕ И ПЕРЕКЛЮЧЕНИЕ ВКЛАДОК АНАЛИТИЧЕСКОГО ЦЕНТРА
    // =========================================================================

    function disposeAllCharts() {
        if (echartMainInstance && !echartMainInstance.isDisposed()) {
            echartMainInstance.dispose();
            echartMainInstance = null;
        }
        if (currentChartInstances.length > 0) {
            currentChartInstances.forEach(inst => {
                if (inst && !inst.isDisposed()) inst.dispose();
            });
            currentChartInstances = [];
        }
    }

    function switchAnalyticsTab(tabKey) {
        activeTab = tabKey;
        const mainChartEl = document.getElementById('ac-chart-main');
        const summaryGridEl = document.getElementById('ac-summary-grid');
        const tableContainerEl = document.getElementById('ac-table-container');
        const subcontrols = document.getElementById('ac-subcontrols');
        if (!mainChartEl || !summaryGridEl || !tableContainerEl || !subcontrols) return;

        subcontrols.innerHTML = '';
        disposeAllCharts();

        // Переключение видимости блоков
        mainChartEl.style.display = 'none';
        summaryGridEl.style.display = 'none';
        tableContainerEl.style.display = 'none';

        if (tabKey === 'table') {
            tableContainerEl.style.display = 'flex';
            if (typeof renderTableTab === 'function') {
                renderTableTab();
            }
            return;
        }

        if (tabKey === 'summary') {
            summaryGridEl.style.display = 'grid';
            renderSummaryTabGrid(summaryGridEl);
            return;
        }

        // Для графиков Treemap, Scatter, Ranking используется общий полноразмерный ECharts контейнер
        mainChartEl.style.display = 'block';
        echartMainInstance = echarts.init(mainChartEl);
        currentChartInstances.push(echartMainInstance);

        // Интерактивный клик по точке/плитке: фокус на карте
        echartMainInstance.on('click', (params) => {
            const raw = params.data?.rawItem || params.data?.raw;
            if (raw && raw.cn && typeof focusSingleFeatureOnMainMap === 'function') {
                focusSingleFeatureOnMainMap(raw.feature || raw);
            }
        });

        const items = getFilteredDatasetItems();

        if (tabKey === 'treemap') {
            renderTreemapTab(items, subcontrols);
        } else if (tabKey === 'scatter') {
            renderScatterTab(items, subcontrols);
        } else if (tabKey === 'ranking') {
            renderRankingTab(items, subcontrols);
        }
    }

    // =========================================================================
    // 8. МОДУЛЬ 1: ДРЕВОВИДНАЯ ПЛИТОЧНАЯ КАРТА (TREEMAP)
    // =========================================================================

    function renderTreemapTab(items, subcontrols) {
     subcontrols.innerHTML = `
            <span style="color:#64748b; font-weight:600; font-size:0.78rem;">Размер:</span>
            <select id="ac-tree-metric-sel" class="ac-select" style="width: auto; padding: 3px 20px 3px 6px; font-size: 0.78rem;">
                <option value="area" ${analyticsSettings.treemapMetric === 'area' ? 'selected' : ''}>По площади (м²)</option>
                <option value="cost" ${analyticsSettings.treemapMetric === 'cost' ? 'selected' : ''}>По стоимости (₽)</option>
                <option value="upks" ${analyticsSettings.treemapMetric === 'upks' ? 'selected' : ''}>По УПКС (₽/м²)</option>
            </select>
            <span style="color:#64748b; font-weight:600; font-size:0.78rem; margin-left:4px;">Цвет:</span>
            <select id="ac-tree-color-sel" class="ac-select" style="width: auto; padding: 3px 20px 3px 6px; font-size: 0.78rem;">
                <option value="upks" ${analyticsSettings.treemapColoring === 'upks' ? 'selected' : ''}>Тепловая шкала (УПКС)</option>
                <option value="ownership" ${analyticsSettings.treemapColoring === 'ownership' ? 'selected' : ''}>Форма собственности</option>
                <option value="type" ${analyticsSettings.treemapColoring === 'type' ? 'selected' : ''}>Тип объекта (ЗУ / ОКС)</option>
            </select>
        `;

        document.getElementById('ac-tree-metric-sel').onchange = (e) => {
            analyticsSettings.treemapMetric = e.target.value;
            renderTreemapTab(items, subcontrols);
        };
        document.getElementById('ac-tree-color-sel').onchange = (e) => {
            analyticsSettings.treemapColoring = e.target.value;
            renderTreemapTab(items, subcontrols);
        };

        const metric = analyticsSettings.treemapMetric;
        const colorMode = analyticsSettings.treemapColoring;

        // Поиск мин/макс УПКС для динамической тепловой карты
        let minUpks = Infinity, maxUpks = -Infinity;
        items.forEach(i => {
            if (i.upks > 0) {
                minUpks = Math.min(minUpks, i.upks);
                maxUpks = Math.max(maxUpks, i.upks);
            }
        });
        if (!isFinite(minUpks)) { minUpks = 0; maxUpks = 1000; }

        const ownershipColors = {
            'Частная': '#8b5cf6',
            'Муниципальная': '#0284c7',
            'Государственная': '#10b981',
            'Федеральная': '#059669',
            'Не указано': '#64748b'
        };

        const treeData = items.map(item => {
            const val = item[metric] || 0;
            let itemColor = '#0284c7';

            if (colorMode === 'upks') {
                if (item.upks <= 0) {
                    itemColor = '#94a3b8';
                } else {
                    const ratio = maxUpks > minUpks ? Math.max(0, Math.min(1, (item.upks - minUpks) / (maxUpks - minUpks))) : 0.5;
                    // Плавный градиент HSL: от зеленого (140) через желтый к красному (0)
                    const hue = Math.round((1 - ratio) * 140);
                    itemColor = `hsl(${hue}, 80%, 42%)`;
                }
            } else if (colorMode === 'ownership') {
                itemColor = ownershipColors[item.ownership] || '#3b82f6';
            } else {
                itemColor = item.type === 'zu' ? '#059669' : (item.type === 'oks' ? '#2563eb' : '#ea580c');
            }

            return {
                name: item.cn,
                value: Math.max(1, Math.round(val)),
                rawItem: item,
                itemStyle: {
                    color: itemColor,
                    borderColor: '#ffffff',
                    borderWidth: 1.5,
                    gapWidth: 1.5,
                    borderRadius: 5
                }
            };
        }).filter(d => d.value > 0);

        const unitMap = { area: 'м²', cost: '₽', upks: '₽/м²' };

        const option = {
            tooltip: {
                trigger: 'item',
                confine: true,
                padding: 6,
                backgroundColor: 'rgba(255, 255, 255, 0.98)',
                borderColor: '#cbd5e1',
                borderWidth: 1,
                extraCssText: 'box-shadow: 0 12px 28px rgba(15,23,42,0.18); border-radius: 10px; z-index: 100060;',
                formatter: (params) => generateInfographicsTooltipHtml(params.data?.rawItem)
            },
            series: [{
                type: 'treemap',
                width: '100%',
                height: '100%',
                top: 0,
                bottom: 0,
                left: 0,
                right: 0,
                roam: 'move',
                nodeClick: false,
                breadcrumb: { show: false },
                emphasis: {
                    itemStyle: {
                        borderColor: '#0f172a',
                        borderWidth: 2.5,
                        shadowBlur: 14,
                        shadowColor: 'rgba(0,0,0,0.35)'
                    }
                },
                label: {
                    show: true,
                    formatter: (p) => {
                        const raw = p.data?.rawItem;
                        if (!raw) return p.name;
                        const vStr = `${Number(p.value).toLocaleString('ru-RU')} ${unitMap[metric]}`;
                        return `{cn|${p.name}}\n{val|${vStr}}`;
                    },
                    rich: {
                        cn: { fontSize: 11, fontWeight: 'bold', color: '#ffffff', lineHeight: 15, textShadowBlur: 3, textShadowColor: 'rgba(0,0,0,0.7)' },
                        val: { fontSize: 10, color: 'rgba(255,255,255,0.95)', lineHeight: 13, textShadowBlur: 2, textShadowColor: 'rgba(0,0,0,0.7)' }
                    }
                },
                data: treeData
            }]
        };

        echartMainInstance.setOption(option, true);
    }

    // =========================================================================
    // 9. МОДУЛЬ 2: МАТРИЦА КОРРЕЛЯЦИИ И ВЫБРОСОВ (SCATTER PLOT)
    // =========================================================================

    function renderScatterTab(items, subcontrols) {
    subcontrols.innerHTML = `
            <span style="color:#64748b; font-weight:600; font-size:0.78rem;">Ось Y:</span>
            <select id="ac-scatter-yaxis-sel" class="ac-select" style="width: auto; padding: 3px 20px 3px 6px; font-size: 0.78rem;">
                <option value="upks" ${analyticsSettings.scatterYAxis === 'upks' ? 'selected' : ''}>УПКС (₽/м²)</option>
                <option value="cost" ${analyticsSettings.scatterYAxis === 'cost' ? 'selected' : ''}>Кадастровая стоимость (₽)</option>
            </select>
            <span style="color:#64748b; font-weight:600; font-size:0.78rem; margin-left:4px;">Группировка:</span>
            <select id="ac-scatter-color-sel" class="ac-select" style="width: auto; padding: 3px 20px 3px 6px; font-size: 0.78rem;">
                <option value="ownership" ${analyticsSettings.scatterColorBy === 'ownership' ? 'selected' : ''}>По собственности</option>
                <option value="boundary" ${analyticsSettings.scatterColorBy === 'boundary' ? 'selected' : ''}>По межеванию (ЗУ)</option>
            </select>
        `;

        document.getElementById('ac-scatter-yaxis-sel').onchange = (e) => {
            analyticsSettings.scatterYAxis = e.target.value;
            renderScatterTab(items, subcontrols);
        };
        document.getElementById('ac-scatter-color-sel').onchange = (e) => {
            analyticsSettings.scatterColorBy = e.target.value;
            renderScatterTab(items, subcontrols);
        };

        const isByBoundary = analyticsSettings.scatterColorBy === 'boundary';
        const isYUpks = analyticsSettings.scatterYAxis === 'upks';
        const seriesMap = {};
        let sumX = 0, sumY = 0, validCnt = 0;

        items.forEach(item => {
            const yVal = isYUpks ? item.upks : item.cost;
            if (item.area <= 0 || yVal <= 0) return;

            sumX += item.area;
            sumY += yVal;
            validCnt++;

            const groupKey = isByBoundary
                ? (item.isSpecified ? 'Уточненный (с границами)' : 'Декларированный (без границ)')
                : (item.ownership || 'Не указано');

            if (!seriesMap[groupKey]) seriesMap[groupKey] = [];

            seriesMap[groupKey].push({
                value: [Math.round(item.area), Math.round(yVal), Math.round(item.cost)],
                rawItem: item
            });
        });

        const avgX = validCnt > 0 ? Math.round(sumX / validCnt) : 0;
        const avgY = validCnt > 0 ? Math.round(sumY / validCnt) : 0;

        const colorMap = {
            'Уточненный (с границами)': '#10b981',
            'Декларированный (без границ)': '#ef4444',
            'Частная': '#8b5cf6',
            'Муниципальная': '#0284c7',
            'Государственная': '#059669',
            'Не указано': '#64748b'
        };

        const series = Object.keys(seriesMap).map((key, idx) => ({
            name: key,
            type: 'scatter',
            symbolSize: (data) => {
                const cost = data[2] || 0;
                // Размер маркера масштабируется от корня стоимости
                return Math.max(10, Math.min(50, Math.sqrt(cost) / 100));
            },
            itemStyle: {
                color: colorMap[key] || ['#0284c7', '#f59e0b', '#8b5cf6', '#ec4899'][idx % 4],
                opacity: 0.84,
                borderColor: '#ffffff',
                borderWidth: 1.5,
                shadowBlur: 5,
                shadowColor: 'rgba(15, 23, 42, 0.2)'
            },
            emphasis: {
                scale: 1.3,
                itemStyle: { opacity: 1, borderColor: '#0f172a', borderWidth: 2 }
            },
            data: seriesMap[key],
            markLine: (idx === 0 && validCnt > 1) ? {
                silent: true,
                symbol: 'none',
                lineStyle: { type: 'dashed', color: '#94a3b8', width: 1.5 },
                label: { fontSize: 10, color: '#475569', fontWeight: 600, backgroundColor: '#f8fafc', padding: [2, 5], borderRadius: 4 },
                data: [
                    { xAxis: avgX, name: 'Средняя площадь', label: { formatter: `Ср. S: ${avgX.toLocaleString('ru-RU')} м²` } },
                    { yAxis: avgY, name: 'Среднее Y', label: { formatter: isYUpks ? `Ср. УПКС: ${avgY.toLocaleString('ru-RU')} ₽/м²` : `Ср. оценка` } }
                ]
            } : undefined
        }));

        const option = {
            legend: { top: 4, textStyle: { fontSize: 11.5, fontWeight: 600, color: '#334155' } },
            grid: { left: '4%', right: '5%', bottom: '9%', top: '14%', containLabel: true },
            dataZoom: [
                { type: 'inside', xAxisIndex: 0, filterMode: 'empty' },
                { type: 'inside', yAxisIndex: 0, filterMode: 'empty' }
            ],
            tooltip: {
                trigger: 'item',
                confine: true,
                padding: 6,
                backgroundColor: 'rgba(255, 255, 255, 0.98)',
                borderColor: '#cbd5e1',
                borderWidth: 1,
                extraCssText: 'box-shadow: 0 12px 28px rgba(15,23,42,0.18); border-radius: 10px; z-index: 100060;',
                formatter: (params) => generateInfographicsTooltipHtml(params.data?.rawItem)
            },
            xAxis: {
                type: 'value',
                name: 'Площадь, м²',
                nameLocation: 'middle',
                nameGap: 26,
                nameTextStyle: { fontWeight: 'bold', color: '#475569' },
                splitLine: { lineStyle: { type: 'dashed', color: '#e2e8f0' } }
            },
            yAxis: {
                type: 'value',
                name: isYUpks ? 'Удельный показатель (УПКС), ₽/м²' : 'Кадастровая стоимость, ₽',
                nameTextStyle: { fontWeight: 'bold', color: '#475569' },
                splitLine: { lineStyle: { type: 'dashed', color: '#e2e8f0' } }
            },
            series
        };

        echartMainInstance.setOption(option, true);
    }

    // =========================================================================
    // 10. МОДУЛЬ 3: РАНЖИРОВАННЫЙ РЕЙТИНГ ОБЪЕКТОВ (RANKING BAR CHART)
    // =========================================================================

    function renderRankingTab(items, subcontrols) {
        subcontrols.innerHTML = `
            <span style="color:#64748b; font-weight:600; font-size:0.78rem;">Метрика:</span>
            <select id="ac-rank-metric-sel" class="ac-select" style="width: auto; padding: 3px 20px 3px 6px; font-size: 0.78rem;">
                <option value="area" ${analyticsSettings.rankingMetric === 'area' ? 'selected' : ''}>По площади (м²)</option>
                <option value="cost" ${analyticsSettings.rankingMetric === 'cost' ? 'selected' : ''}>По стоимости (₽)</option>
                <option value="upks" ${analyticsSettings.rankingMetric === 'upks' ? 'selected' : ''}>По УПКС (₽/м²)</option>
            </select>
            <span style="color:#64748b; font-weight:600; font-size:0.78rem; margin-left:4px;">Глубина:</span>
            <select id="ac-rank-limit-sel" class="ac-select" style="width: auto; padding: 3px 20px 3px 6px; font-size: 0.78rem;">
                <option value="15" ${analyticsSettings.rankingLimit === 15 ? 'selected' : ''}>Топ-15</option>
                <option value="30" ${analyticsSettings.rankingLimit === 30 ? 'selected' : ''}>Топ-30</option>
                <option value="50" ${analyticsSettings.rankingLimit === 50 ? 'selected' : ''}>Топ-50</option>
                <option value="0" ${analyticsSettings.rankingLimit === 0 ? 'selected' : ''}>Все</option>
            </select>
        `;

        document.getElementById('ac-rank-metric-sel').onchange = (e) => {
            analyticsSettings.rankingMetric = e.target.value;
            renderRankingTab(items, subcontrols);
        };
        document.getElementById('ac-rank-limit-sel').onchange = (e) => {
            analyticsSettings.rankingLimit = parseInt(e.target.value, 10);
            renderRankingTab(items, subcontrols);
        };

        const metric = analyticsSettings.rankingMetric;
        const sorted = [...items].filter(i => (i[metric] || 0) > 0).sort((a, b) => b[metric] - a[metric]);
        const limited = analyticsSettings.rankingLimit > 0 ? sorted.slice(0, analyticsSettings.rankingLimit) : sorted;

        const names = limited.map((i, idx) => `#${idx + 1}  ${i.cn}`).reverse();
        const values = limited.map((item, idx) => {
            // Золотой градиент для Топ-1, изумрудный для Топ-2/3, лазурный для остальных
            let barColor = new echarts.graphic.LinearGradient(0, 0, 1, 0, [
                { offset: 0, color: '#0284c7' },
                { offset: 1, color: '#38bdf8' }
            ]);

            if (idx === 0) {
                barColor = new echarts.graphic.LinearGradient(0, 0, 1, 0, [
                    { offset: 0, color: '#d97706' },
                    { offset: 1, color: '#fbbf24' }
                ]);
            } else if (idx === 1 || idx === 2) {
                barColor = new echarts.graphic.LinearGradient(0, 0, 1, 0, [
                    { offset: 0, color: '#059669' },
                    { offset: 1, color: '#34d399' }
                ]);
            }

            return {
                value: Math.round(item[metric]),
                rawItem: item,
                itemStyle: { color: barColor, borderRadius: [0, 6, 6, 0] }
            };
        }).reverse();

        const unitMap = { area: ' м²', cost: ' ₽', upks: ' ₽/м²' };
        const needScroll = limited.length > 25;

        const option = {
            grid: { left: '2%', right: '12%', top: '3%', bottom: '4%', containLabel: true },
            dataZoom: needScroll ? [
                {
                    type: 'slider',
                    yAxisIndex: 0,
                    right: 8,
                    width: 16,
                    startValue: Math.max(0, limited.length - 25),
                    endValue: limited.length - 1,
                    borderColor: '#e2e8f0',
                    fillerColor: 'rgba(2, 132, 199, 0.2)',
                    handleSize: '80%'
                },
                { type: 'inside', yAxisIndex: 0 }
            ] : [],
            tooltip: {
                trigger: 'item',
                confine: true,
                padding: 6,
                backgroundColor: 'rgba(255, 255, 255, 0.98)',
                borderColor: '#cbd5e1',
                borderWidth: 1,
                extraCssText: 'box-shadow: 0 12px 28px rgba(15,23,42,0.18); border-radius: 10px; z-index: 100060;',
                formatter: (params) => generateInfographicsTooltipHtml(params.data?.rawItem)
            },
            xAxis: {
                type: 'value',
                splitLine: { lineStyle: { type: 'dashed', color: '#e2e8f0' } }
            },
            yAxis: {
                type: 'category',
                data: names,
                axisLabel: { fontSize: 11, fontWeight: 700, color: '#334155' }
            },
            series: [{
                type: 'bar',
                barMaxWidth: 24,
                data: values,
                label: {
                    show: true,
                    position: 'right',
                    formatter: (p) => `${p.value.toLocaleString('ru-RU')}${unitMap[metric]}`,
                    fontSize: 11,
                    fontWeight: 700,
                    color: '#1e293b'
                }
            }]
        };

        echartMainInstance.setOption(option, true);
    }

    // =========================================================================
    // 11. МОДУЛЬ 4: СВОДНЫЙ ДАШБОРД (SUMMARY GRID ИЗ 6 ДИАГРАММ)
    // =========================================================================

    function renderSummaryTabGrid(gridEl) {
        gridEl.innerHTML = `
            <div class="ac-chart-card" style="height: 300px;"><div id="sub-chart-own" style="width:100%; height:100%;"></div></div>
            <div class="ac-chart-card" style="height: 300px;"><div id="sub-chart-ki" style="width:100%; height:100%;"></div></div>
            <div class="ac-chart-card" style="height: 300px;"><div id="sub-chart-vri" style="width:100%; height:100%;"></div></div>
            <div class="ac-chart-card" style="height: 300px;"><div id="sub-chart-cat" style="width:100%; height:100%;"></div></div>
            <div class="ac-chart-card" style="height: 300px;"><div id="sub-chart-oks-eras" style="width:100%; height:100%;"></div></div>
            <div class="ac-chart-card" style="height: 300px;"><div id="sub-chart-floors" style="width:100%; height:100%;"></div></div>
        `;

        const stats = currentParsedDataset;
        const palette = ['#0284c7', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899', '#64748b'];

        // 1. Формы собственности
        const c1 = echarts.init(document.getElementById('sub-chart-own'));
        c1.setOption({
            title: { text: '1. Формы собственности (ЗУ)', textStyle: { fontSize: 13, fontWeight: 800, color: '#0f172a' } },
            tooltip: { trigger: 'item', formatter: '{b}: <b>{c}</b> ({d}%)' },
            legend: { bottom: 0, textStyle: { fontSize: 10.5 } },
            series: [{
                type: 'pie',
                radius: ['42%', '68%'],
                center: ['50%', '46%'],
                itemStyle: { borderRadius: 5, borderColor: '#fff', borderWidth: 2 },
                data: Object.entries(stats.ownershipDist).map(([k, v]) => ({ name: k, value: v })),
                color: palette
            }]
        });

        // 2. Межевание границ ЗУ
        const c2 = echarts.init(document.getElementById('sub-chart-ki'));
        c2.setOption({
            title: { text: '2. Межевание границ ЗУ', textStyle: { fontSize: 13, fontWeight: 800, color: '#0f172a' } },
            tooltip: { trigger: 'item', formatter: '{b}: <b>{c}</b> ({d}%)' },
            legend: { bottom: 0, textStyle: { fontSize: 10.5 } },
            series: [{
                type: 'pie',
                radius: ['42%', '68%'],
                center: ['50%', '46%'],
                itemStyle: { borderRadius: 5, borderColor: '#fff', borderWidth: 2 },
                data: [
                    { name: 'Уточненные', value: stats.specifiedCount, itemStyle: { color: '#10b981' } },
                    { name: 'Декларированные', value: stats.declaredCount, itemStyle: { color: '#ef4444' } }
                ]
            }]
        });

        // 3. Топ-10 ВРИ
        const topVri = Object.entries(stats.vriDist).sort((a, b) => b[1] - a[1]).slice(0, 10);
        const c3 = echarts.init(document.getElementById('sub-chart-vri'));
        c3.setOption({
            title: { text: '3. Топ-10 видов разрешенного использования', textStyle: { fontSize: 13, fontWeight: 800, color: '#0f172a' } },
            tooltip: { trigger: 'axis' },
            grid: { left: '3%', right: '10%', bottom: '6%', top: '22%', containLabel: true },
            xAxis: { type: 'value', splitLine: { lineStyle: { type: 'dashed', color: '#e2e8f0' } } },
            yAxis: {
                type: 'category',
                axisLabel: { fontSize: 10, color: '#334155' },
                data: topVri.map(i => i[0].length > 25 ? i[0].slice(0, 24) + '…' : i[0]).reverse()
            },
            series: [{
                type: 'bar',
                barMaxWidth: 18,
                data: topVri.map(i => i[1]).reverse(),
                itemStyle: { color: '#f59e0b', borderRadius: [0, 5, 5, 0] },
                label: { show: true, position: 'right', fontSize: 10.5, fontWeight: 'bold' }
            }]
        });

        // 4. Категории земель
        const topCat = Object.entries(stats.categoryDist).sort((a, b) => b[1] - a[1]);
        const c4 = echarts.init(document.getElementById('sub-chart-cat'));
        c4.setOption({
            title: { text: '4. Категории земель', textStyle: { fontSize: 13, fontWeight: 800, color: '#0f172a' } },
            tooltip: { trigger: 'item', formatter: '{b}: <b>{c}</b> ({d}%)' },
            legend: { bottom: 0, textStyle: { fontSize: 10 } },
            series: [{
                type: 'pie',
                radius: '62%',
                center: ['50%', '46%'],
                data: topCat.map(([k, v]) => ({ name: k.replace('Земли ', ''), value: v })),
                color: ['#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#64748b']
            }]
        });

        // 5. Хронология застройки по годам ввода со слайдером
        const c5 = echarts.init(document.getElementById('sub-chart-oks-eras'));
        const yearCounts = {};
        const features = (lastQueryResults && lastQueryResults.features) ? lastQueryResults.features : [];
        features.forEach(f => {
            const y = parseInt(f.properties?.options?.year_built || f.properties?.options?.params_year_built, 10);
            if (y && y >= 1850 && y <= 2035) {
                yearCounts[y] = (yearCounts[y] || 0) + 1;
            }
        });

        const uniqueYears = Object.keys(yearCounts).map(Number).sort((a, b) => a - b);
        let xYears = [];
        let yYearsCount = [];

        if (uniqueYears.length > 0) {
            const minYear = uniqueYears[0];
            const maxYear = uniqueYears[uniqueYears.length - 1];
            for (let y = minYear; y <= maxYear; y++) {
                xYears.push(y);
                yYearsCount.push(yearCounts[y] || 0);
            }
        }

        c5.setOption({
            title: { text: '5. Динамика застройки по годам ввода', textStyle: { fontSize: 13, fontWeight: 800, color: '#0f172a' } },
            tooltip: {
                trigger: 'axis',
                formatter: (params) => {
                    const item = params[0];
                    return item ? `<b>${item.name} год</b><br>Построено зданий: <b>${item.value} шт.</b>` : '';
                }
            },
            grid: { left: '8%', right: '5%', bottom: '22%', top: '22%' },
            xAxis: { type: 'category', data: xYears, axisLabel: { color: '#64748b', fontSize: 10 } },
            yAxis: { type: 'value', minInterval: 1, splitLine: { lineStyle: { color: '#f1f5f9' } } },
            dataZoom: [
                { type: 'inside', xAxisIndex: 0 },
                { type: 'slider', xAxisIndex: 0, bottom: 4, height: 16, borderColor: '#cbd5e1', fillerColor: 'rgba(99, 102, 241, 0.2)', handleSize: '80%' }
            ],
            series: [{
                type: 'bar',
                data: yYearsCount,
                barMaxWidth: 14,
                itemStyle: {
                    color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                        { offset: 0, color: '#8b5cf6' },
                        { offset: 1, color: '#6366f1' }
                    ]),
                    borderRadius: [3, 3, 0, 0]
                }
            }]
        });

        // 6. Распределение ОКС по этажности
        const c6 = echarts.init(document.getElementById('sub-chart-floors'));
        c6.setOption({
            title: { text: '6. Распределение ОКС по этажности', textStyle: { fontSize: 13, fontWeight: 800, color: '#0f172a' } },
            tooltip: { trigger: 'axis' },
            grid: { left: '6%', right: '5%', bottom: '12%', top: '22%', containLabel: true },
            xAxis: { type: 'category', data: Object.keys(stats.oksFloorsDist), axisLabel: { interval: 0, fontSize: 10.5 } },
            yAxis: { type: 'value', splitLine: { lineStyle: { type: 'dashed', color: '#e2e8f0' } } },
            series: [{
                type: 'bar',
                barMaxWidth: 28,
                data: Object.values(stats.oksFloorsDist),
                itemStyle: { color: '#0284c7', borderRadius: [5, 5, 0, 0] },
                label: { show: true, position: 'top', fontSize: 10.5, fontWeight: 'bold' }
            }]
        });

        currentChartInstances.push(c1, c2, c3, c4, c5, c6);
    }
    
    
// =========================================================================
    // 12. МОДУЛЬ 5: ИНТЕРАКТИВНЫЙ РЕЕСТР ОБЪЕКТОВ С УМНЫМ ПОИСКОМ АДРЕСА
    // =========================================================================

    function renderTableTab() {
        const tableContainerEl = document.getElementById('ac-table-container');
        if (!tableContainerEl || !currentParsedDataset) return;

        const BATCH_SIZE = 120;
        let renderedCount = 0;
        const allItems = currentParsedDataset.items;

        tableContainerEl.innerHTML = `
            <div class="ac-table-toolbar">
                <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                    <span style="font-size: 0.82rem; font-weight: 700; color: #334155;">
                        Отображено: <b id="ac-table-rendered-count" style="color: #0284c7;">0</b> из <b id="ac-table-filtered-total">${allItems.length.toLocaleString('ru-RU')}</b>
                    </span>
                    <span style="font-size: 0.72rem; color: #64748b; background: #e2e8f0; padding: 2px 7px; border-radius: 6px;">
                        Строгий поиск: слова как подстроки, числа как номера (д., кв.)
                    </span>
                </div>
                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                    <div style="position: relative; display: flex; align-items: center;">
                        <i class="fas fa-search" style="position: absolute; left: 9px; color: #94a3b8; font-size: 0.78rem; pointer-events: none;"></i>
                        <input type="text" id="ac-table-quick-search" class="ac-input-text" 
                               style="width: 260px; padding: 5px 26px 5px 28px; font-size: 0.82rem;" 
                               placeholder="Адрес..." 
                               value="${escapeHtml(analyticsSettings.tableSearchTerm)}">
                        <button id="ac-table-clear-search" 
                                style="position: absolute; right: 5px; background: none; border: none; color: #94a3b8; cursor: pointer; display: ${analyticsSettings.tableSearchTerm ? 'block' : 'none'}; font-size: 14px; padding: 0 4px;" 
                                title="Сбросить поиск">&times;</button>
                    </div>

                    <select id="ac-table-sort" class="ac-select" style="width: auto; padding: 5px 24px 5px 8px; font-size: 0.82rem;">
                        <option value="default" ${analyticsSettings.tableSortField === 'default' ? 'selected' : ''}>Сортировка: исходная</option>
                        <option value="cost_desc" ${analyticsSettings.tableSortField === 'cost_desc' ? 'selected' : ''}>Стоимость: по убыванию</option>
                        <option value="cost_asc" ${analyticsSettings.tableSortField === 'cost_asc' ? 'selected' : ''}>Стоимость: по возрастанию</option>
                        <option value="area_desc" ${analyticsSettings.tableSortField === 'area_desc' ? 'selected' : ''}>Площадь: по убыванию</option>
                        <option value="area_asc" ${analyticsSettings.tableSortField === 'area_asc' ? 'selected' : ''}>Площадь: по возрастанию</option>
                    </select>
                </div>
            </div>

            <div id="ac-table-scroll-wrap" style="overflow-x: auto; overflow-y: auto; flex: 1; border: 1px solid #e2e8f0; border-radius: 10px; background: #fff;">
                <table class="ac-table">
                    <thead>
                        <tr>
                            <th style="width: 45px;">№</th>
                            <th style="width: 210px;">Кадастровый номер</th>
                            <th style="width: 80px;">Тип</th>
                            <th>Адрес / Местоположение и назначение</th>
                            <th style="width: 120px;">Площадь</th>
                            <th style="width: 150px;">Кад. стоимость / УПКС</th>
                            <th style="width: 130px;">Форма / Право</th>
                            <th style="width: 48px;"></th>
                        </tr>
                    </thead>
                    <tbody id="ac-table-body"></tbody>
                </table>
            </div>
        `;

        const tbody = document.getElementById('ac-table-body');
        const countEl = document.getElementById('ac-table-rendered-count');
        const totalEl = document.getElementById('ac-table-filtered-total');
        const scrollWrap = document.getElementById('ac-table-scroll-wrap');
        const quickSearchInput = document.getElementById('ac-table-quick-search');
        const clearSearchBtn = document.getElementById('ac-table-clear-search');
        const sortSelect = document.getElementById('ac-table-sort');

        let filteredItems = [];

        function applyClientFilterAndSort() {
            filteredItems = getFilteredDatasetItems();

            if (analyticsSettings.tableSortField === 'cost_desc') {
                filteredItems.sort((a, b) => b.cost - a.cost);
            } else if (analyticsSettings.tableSortField === 'cost_asc') {
                filteredItems.sort((a, b) => a.cost - b.cost);
            } else if (analyticsSettings.tableSortField === 'area_desc') {
                filteredItems.sort((a, b) => b.area - a.area);
            } else if (analyticsSettings.tableSortField === 'area_asc') {
                filteredItems.sort((a, b) => a.area - b.area);
            }

            tbody.innerHTML = '';
            renderedCount = 0;
            totalEl.textContent = filteredItems.length.toLocaleString('ru-RU');
            renderRowsBatch();
        }

        function renderRowsBatch() {
            const nextLimit = Math.min(renderedCount + BATCH_SIZE, filteredItems.length);
            const fragment = document.createDocumentFragment();

            for (let i = renderedCount; i < nextLimit; i++) {
                const item = filteredItems[i];
                const areaStr = item.area > 0 ? `${Math.round(item.area).toLocaleString('ru-RU')} м²` : '-';
                const costStr = item.cost > 0 ? `${Math.round(item.cost).toLocaleString('ru-RU')} ₽` : '-';
                const upksStr = item.upks > 0 ? `${item.upks.toLocaleString('ru-RU')} ₽/м²` : '';

                const badgeClass = item.type === 'zu' ? 'ac-badge-zu' : (item.type === 'oks' ? 'ac-badge-oks' : 'ac-badge-str');
                const hasGeom = hasRealBoundaries(item.feature);

                const cleanAddress = escapeHtml(item.address);
                const subPurpose = escapeHtml(item.purpose || item.name || item.vri || '');

                const tr = document.createElement('tr');
                tr.className = 'ac-table-row-clickable';
                tr.innerHTML = `
                    <td style="color: #64748b; font-weight: 600;">${i + 1}</td>
                    <td style="font-weight: 700; color: #0284c7;">
                        <div style="display:flex; align-items:center; gap:6px;">
                            <span>${escapeHtml(item.cn)}</span>
                            ${hasGeom ? '<span title="Границы определены" style="color:#10b981;font-size:0.75rem;"><i class="fas fa-draw-polygon"></i></span>' : ''}
                        </div>
                    </td>
                    <td><span class="ac-badge-type ${badgeClass}">${item.typeLabel}</span></td>
                    <td>
                        <div style="font-weight: 500; color: #0f172a;">${cleanAddress}</div>
                        ${subPurpose ? `<div style="font-size: 0.73rem; color: #64748b; margin-top: 2px;">${subPurpose}</div>` : ''}
                    </td>
                    <td style="font-weight: 600;">
                        ${item.type === 'zu' && !item.isSpecified 
                            ? `<span style="color:#dc2626; font-weight:700;" title="Без межевания">${areaStr}</span>` 
                            : areaStr}
                    </td>
                    <td>
                        <div style="font-weight: 700; color: #0f172a;">${costStr}</div>
                        ${upksStr ? `<div style="font-size: 0.72rem; color: #b45309;">${upksStr}</div>` : ''}
                    </td>
                    <td>
                        <div style="font-weight: 600; color: #334155;">${escapeHtml(item.ownership)}</div>
                        ${item.right && item.right !== '-' ? `<div style="font-size:0.72rem; color:#64748b;">${escapeHtml(item.right)}</div>` : ''}
                    </td>
                    <td>
                        ${hasGeom 
                            ? `<button class="ac-zoom-btn" data-fid="${escapeHtml(item.cn)}" title="Фокус на карте">
                                   <i class="fas fa-location-crosshairs"></i>
                               </button>` 
                            : `<span style="color: #cbd5e1; font-weight: bold;">—</span>`}
                    </td>
                `;

                tr.onclick = (e) => {
                    if (e.target.closest('.ac-zoom-btn')) return;
                    openObjectDetailCard(item.feature || item);
                };

                const zoomBtn = tr.querySelector('.ac-zoom-btn');
                if (zoomBtn) {
                    zoomBtn.onclick = (e) => {
                        e.stopPropagation();
                        focusSingleFeatureOnMainMap(item.feature || item);
                    };
                }

                fragment.appendChild(tr);
            }

            tbody.appendChild(fragment);
            renderedCount = nextLimit;
            countEl.textContent = renderedCount.toLocaleString('ru-RU');
        }

        let searchDebounce = null;
        quickSearchInput.oninput = (e) => {
            clearTimeout(searchDebounce);
            searchDebounce = setTimeout(() => {
                analyticsSettings.tableSearchTerm = e.target.value.trim();
                clearSearchBtn.style.display = analyticsSettings.tableSearchTerm ? 'block' : 'none';
                applyClientFilterAndSort();
                updateKpiBarUI();
            }, 180);
        };

        clearSearchBtn.onclick = () => {
            quickSearchInput.value = '';
            analyticsSettings.tableSearchTerm = '';
            clearSearchBtn.style.display = 'none';
            applyClientFilterAndSort();
            updateKpiBarUI();
            quickSearchInput.focus();
        };

        sortSelect.onchange = (e) => {
            analyticsSettings.tableSortField = e.target.value;
            applyClientFilterAndSort();
        };

        scrollWrap.addEventListener('scroll', () => {
            if (renderedCount < filteredItems.length) {
                if (scrollWrap.scrollTop + scrollWrap.clientHeight >= scrollWrap.scrollHeight - 140) {
                    renderRowsBatch();
                }
            }
        });

        applyClientFilterAndSort();
    }

    // =========================================================================
    // 13. ДЕТАЛЬНАЯ КАРТОЧКА ОБЪЕКТА С ПАНОРАМАМИ И ДАННЫМИ ЕГРН
    // =========================================================================

    function openObjectDetailCard(feature) {
        const existingCard = document.getElementById('ac-object-card-overlay');
        if (existingCard) existingCard.remove();

        const p = feature.properties || {};
        const o = p.options || {};
        const cn = extractCadastralNumber(feature) || 'Без номера';
        const typeName = feature._layer_type === 'zu' ? 'Земельный участок' : (feature._layer_type === 'oks' ? 'Здание (ОКС)' : 'Сооружение');
        const hasGeom = hasRealBoundaries(feature);

        const center = getFeatureCenterWgs(feature);
        const streetViewUrl = center
            ? `https://maps.google.com/maps?layer=c&cbll=${center.lat},${center.lon}&cbp=12,0,0,0,0&output=svembed`
            : null;

        const cardOverlay = document.createElement('div');
        cardOverlay.id = 'ac-object-card-overlay';
        cardOverlay.className = 'ac-card-overlay';

        let propRows = '';
        const addRow = (label, val) => {
            if (val !== null && val !== undefined && String(val).trim() !== '' && String(val).trim() !== '-' && String(val).trim() !== 'null') {
                propRows += `<tr><td>${escapeHtml(label)}:</td><td>${escapeHtml(val)}</td></tr>`;
            }
        };

        const areaNum = getNumericArea(feature);
        const costNum = getNumericCost(feature);
        const calcUpks = (areaNum > 0 && costNum > 0) ? `${Math.round(costNum / areaNum).toLocaleString('ru-RU')} ₽/м²` : null;

        addRow('Кадастровый номер', cn);
        addRow('Тип объекта', typeName);
        const dateInfo = getFeatureDate(feature);
        if (dateInfo.regDate) addRow('Дата внесения сведений', dateInfo.regDate);
        if (dateInfo.dbDate) addRow('Дата обновления в БД', dateInfo.dbDate);
        addRow('Адрес', o.readable_address || o.address_readable_address);
        addRow('Площадь / Протяженность', areaNum > 0 ? `${areaNum.toLocaleString('ru-RU')} м²` : '-');
        addRow('Характер границ', hasGeom ? 'Границы установлены (координаты в базе)' : 'Без координат границ (декларированный)');
        addRow('Кадастровая стоимость', costNum > 0 ? `${costNum.toLocaleString('ru-RU')} ₽` : null);
        addRow('УПКС', o.cost_index ? `${Number(o.cost_index).toLocaleString('ru-RU')} ₽/м²` : calcUpks);
        addRow('Форма собственности', o.ownership_type);
        addRow('Вид права', o.right_type);
        addRow('Статус записи', o.status);
        addRow('Назначение', o.purpose || o.params_purpose);
        addRow('Наименование', o.name || o.building_name || o.params_name);
        addRow('Этажность', o.floors);
        addRow('Материал стен', o.materials);
        addRow('Год постройки', o.year_built || o.params_year_built);
        addRow('Категория земель', o.land_record_category_type);
        addRow('Разрешенное использование', o.permitted_use_established_by_document);

        const zoomBtnHtml = hasGeom
            ? `<button class="ac-card-btn" id="ac-card-btn-zoom" style="background:linear-gradient(135deg, #0284c7, #2563eb); color:#fff; box-shadow:0 4px 12px rgba(2,132,199,0.25);">
                   <i class="fas fa-location-crosshairs"></i> Показать контур на карте
               </button>`
            : '';

        cardOverlay.innerHTML = `
            <div class="ac-card-window">
                <div class="ac-card-header">
                    <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                        <span style="font-weight:800; font-size:1.15rem; color:#0f172a;">${escapeHtml(cn)}</span>
                        <button id="ac-copy-cn-btn" style="background:#f1f5f9; border:1px solid #cbd5e1; border-radius:6px; padding:3px 8px; font-size:0.74rem; font-weight:600; color:#334155; cursor:pointer;" title="Скопировать номер">
                            <i class="fas fa-copy"></i> Копировать
                        </button>
                        <span style="background:#e0f2fe; color:#0369a1; font-size:0.75rem; font-weight:700; padding:3px 9px; border-radius:6px;">${typeName}</span>
                    </div>
                    <button class="ac-close-btn" id="ac-card-close">&times;</button>
                </div>
                <div class="ac-card-body">
                    <div style="overflow-y:auto; max-height:480px; padding-right:8px;">
                        <table class="ac-card-prop-table">
                            <tbody>${propRows}</tbody>
                        </table>
                    </div>

                    <div class="ac-card-right-panel">
                        <div class="ac-streetview-box">
                            ${streetViewUrl
                                ? `<iframe src="${streetViewUrl}" style="width:100%;height:100%;border:none;" allowfullscreen></iframe>`
                                : `<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#94a3b8;font-size:0.85rem;">Координаты для панорамы не определены</div>`
                            }
                        </div>
                        <button class="ac-card-btn ac-btn-egrn" id="ac-card-btn-egrn">
                            <i class="fas fa-file-shield"></i> Проверить актуальные данные (ЕГРН)
                        </button>
                        ${zoomBtnHtml}
                    </div>
                </div>
            </div>
        `;

        document.body.appendChild(cardOverlay);

        const closeCard = () => cardOverlay.remove();
        cardOverlay.querySelector('#ac-card-close').onclick = closeCard;
        cardOverlay.onclick = (e) => {
            if (e.target === cardOverlay) closeCard();
        };

        const copyBtn = cardOverlay.querySelector('#ac-copy-cn-btn');
        copyBtn.onclick = async () => {
            try {
                await navigator.clipboard.writeText(cn);
                copyBtn.innerHTML = '<i class="fas fa-check" style="color:#16a34a;"></i> Скопировано';
                setTimeout(() => { copyBtn.innerHTML = '<i class="fas fa-copy"></i> Копировать'; }, 1500);
            } catch (e) {}
        };

        cardOverlay.querySelector('#ac-card-btn-egrn').onclick = async () => {
            try { await navigator.clipboard.writeText(cn); } catch (err) {}
            window.open('egrn.html', '_blank');
        };

        const zoomBtn = cardOverlay.querySelector('#ac-card-btn-zoom');
        if (zoomBtn) {
            zoomBtn.onclick = () => {
                closeCard();
                focusSingleFeatureOnMainMap(feature);
            };
        }
    }

    // =========================================================================
    // 14. СВЯЗКА С КАРТОЙ: ФОКУСИРОВКА И ПЕРЕНОС ВЫБОРКИ
    // =========================================================================

    function focusSingleFeatureOnMainMap(feature) {
        const activeMap = getActiveMap();
        if (!feature || !activeMap) return;

        if (analyticsModal) {
            analyticsModal.style.display = 'none';
        }

        const type = feature._layer_type;
        if (type === 'zu' && typeof processAndDrawParcels === 'function') {
            processAndDrawParcels([feature], 'areaSearch', true);
        } else if (type === 'oks' && typeof processAndDrawBuildings === 'function') {
            processAndDrawBuildings([feature]);
        } else if (type === 'structure' && typeof processAndDrawStructures === 'function') {
            processAndDrawStructures([feature]);
        }

        const yandexRings = convertFeatureToYandexCoords(feature);
        if (yandexRings && yandexRings.length > 0) {
            let minLat = Infinity, maxLat = -Infinity, minLon = Infinity, maxLon = -Infinity;
            yandexRings.forEach(ring => {
                ring.forEach(pt => {
                    minLat = Math.min(minLat, pt[0]);
                    maxLat = Math.max(maxLat, pt[0]);
                    minLon = Math.min(minLon, pt[1]);
                    maxLon = Math.max(maxLon, pt[1]);
                });
            });

            if (isFinite(minLat)) {
                const latPad = Math.max((maxLat - minLat) * 0.35, 0.0008);
                const lonPad = Math.max((maxLon - minLon) * 0.35, 0.0008);
                activeMap.setBounds([
                    [minLat - latPad, minLon - lonPad],
                    [maxLat + latPad, maxLon + lonPad]
                ], { checkZoomRange: true, duration: 400 });
            }
        }

        const cn = extractCadastralNumber(feature);
        setTimeout(() => {
            const targetPolygon = (typeof polygons !== 'undefined' ? polygons : []).find(p =>
                p.properties && (p.properties.get('cadastralNumber') === cn || p.properties.get('descr') === cn)
            );
            if (targetPolygon && targetPolygon.options) {
                const oldFill = targetPolygon.options.get('fillColor');
                const oldStroke = targetPolygon.options.get('strokeColor');
                const oldWidth = targetPolygon.options.get('strokeWidth');

                targetPolygon.options.set({
                    fillColor: '#FFFF00A6',
                    strokeColor: '#FF0000',
                    strokeWidth: 4
                });

                setTimeout(() => {
                    targetPolygon.options.set({
                        fillColor: oldFill,
                        strokeColor: oldStroke,
                        strokeWidth: oldWidth
                    });
                }, 2000);
            }
        }, 200);

        if (typeof showNotification === 'function') {
            showNotification(`Фокус на объекте: ${cn}`, 'success');
        }
    }

    function showResultsOnMainMap() {
        const activeMap = getActiveMap();
        if (!lastQueryResults?.features?.length || !activeMap) {
            alert('Нет объектов для переноса на карту или карта не готова');
            return;
        }

        const allFeatures = lastQueryResults.features;
        const totalCount = allFeatures.length;

        if (totalCount > SAFE_MAP_OBJECT_LIMIT) {
            promptLargeVolumeConfirmation(totalCount, (choice) => {
                if (choice === 'cancel') return;
                const featuresToRender = (choice === 'all')
                    ? allFeatures
                    : allFeatures.slice(0, SAFE_MAP_OBJECT_LIMIT);
                executeDrawOnMap(featuresToRender, choice === 'limit' ? SAFE_MAP_OBJECT_LIMIT : totalCount);
            });
        } else {
            executeDrawOnMap(allFeatures, totalCount);
        }
    }

    function promptLargeVolumeConfirmation(totalCount, callback) {
        const dialogOverlay = document.createElement('div');
        dialogOverlay.className = 'ac-confirm-dialog-overlay';

        dialogOverlay.innerHTML = `
            <div class="ac-confirm-dialog">
                <div class="ac-confirm-icon"><i class="fas fa-triangle-exclamation"></i></div>
                <h3 style="margin: 0 0 8px 0; color: #0f172a; font-size: 1.2rem; font-weight: 800;">Большой объем выборки</h3>
                <div style="font-size: 0.95rem; font-weight: 700; color: #0284c7; margin-bottom: 8px;">
                    Выбрано объектов: ${totalCount.toLocaleString('ru-RU')} шт.
                </div>
                <p style="font-size: 0.85rem; color: #64748b; margin: 0 0 18px 0; line-height: 1.45;">
                    Отрисовка более ${SAFE_MAP_OBJECT_LIMIT} полигонов одновременно может снизить плавность работы карты. Как поступить?
                </p>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <button id="ac-confirm-first" style="padding: 11px; border-radius: 10px; border: none; background: linear-gradient(135deg, #2563eb, #1d4ed8); color: #fff; font-weight: 700; cursor: pointer;">
                        Нанести первые ${SAFE_MAP_OBJECT_LIMIT} объектов (Рекомендуется)
                    </button>
                    <button id="ac-confirm-all" style="padding: 10px; border-radius: 10px; border: 1px solid #cbd5e1; background: #f8fafc; color: #334155; font-weight: 600; cursor: pointer;">
                        Нанести весь объем (${totalCount.toLocaleString('ru-RU')} шт.)
                    </button>
                    <button id="ac-confirm-cancel" style="padding: 8px; border-radius: 10px; border: none; background: transparent; color: #ef4444; font-weight: 700; cursor: pointer;">
                        Отмена
                    </button>
                </div>
            </div>
        `;

        document.body.appendChild(dialogOverlay);

        const closeDialog = (choice) => {
            dialogOverlay.remove();
            callback(choice);
        };

        dialogOverlay.querySelector('#ac-confirm-first').onclick = () => closeDialog('limit');
        dialogOverlay.querySelector('#ac-confirm-all').onclick = () => closeDialog('all');
        dialogOverlay.querySelector('#ac-confirm-cancel').onclick = () => closeDialog('cancel');
    }

    function executeDrawOnMap(features, countDrawn) {
        if (typeof processAndDrawParcels === 'function') {
            const zu = features.filter(f => f._layer_type === 'zu');
            const oks = features.filter(f => f._layer_type === 'oks');
            const str = features.filter(f => f._layer_type === 'structure');

            if (zu.length > 0) processAndDrawParcels(zu, 'areaSearch', false);
            if (oks.length > 0 && typeof processAndDrawBuildings === 'function') processAndDrawBuildings(oks);
            if (str.length > 0 && typeof processAndDrawStructures === 'function') processAndDrawStructures(str);
        }

        if (analyticsModal) {
            analyticsModal.style.display = 'none';
        }

        if (typeof showNotification === 'function') {
            showNotification(`На карту нанесено объектов: ${countDrawn}`, 'success');
        }
    }

    // =========================================================================
    // 15. МОДУЛИ ЭКСПОРТА (EXCEL, GEOJSON)
    // =========================================================================

    async function exportToExcel() {
        if (!lastQueryResults?.features?.length) {
            alert('Нет данных для выгрузки в Excel');
            return;
        }
        await ensureXlsx();

        const headers = [
            "Кадастровый номер",
            "Тип объекта",
            "Адрес",
            "Площадь / Длина (м² / м)",
            "Кадастровая стоимость (₽)",
            "УПКС (₽/м²)",
            "Дата регистрации",
            "Дата обновления БД",
            "Наличие границ",
            "ВРИ / Назначение",
            "Форма собственности",
            "Вид права",
            "Статус",
            "Этажность",
            "Материал стен",
            "Год постройки"
        ];
        const rows = [headers];

        lastQueryResults.features.forEach(f => {
            const o = f.properties?.options || {};
            const dateObj = getFeatureDate(f);
            const areaVal = getNumericArea(f);
            const costVal = getNumericCost(f);
            const upksVal = (areaVal > 0 && costVal > 0) ? Math.round(costVal / areaVal) : (o.cost_index || '');

            rows.push([
                extractCadastralNumber(f) || '',
                f._layer_type === 'zu' ? 'Земельный участок' : (f._layer_type === 'oks' ? 'Здание' : 'Сооружение'),
                o.readable_address || o.address_readable_address || '',
                areaVal || '',
                costVal || '',
                upksVal,
                dateObj.regDate || '',
                dateObj.dbDate || '',
                hasRealBoundaries(f) ? 'Да' : 'Нет',
                o.permitted_use_established_by_document || o.purpose || '',
                o.ownership_type || '',
                o.right_type || '',
                o.status || '',
                o.floors || '',
                o.materials || '',
                o.year_built || o.params_year_built || ''
            ]);
        });

        const wb = XLSX.utils.book_new();
        const ws = XLSX.utils.aoa_to_sheet(rows);
        ws['!cols'] = [
            { wch: 22 }, { wch: 18 }, { wch: 45 }, { wch: 15 },
            { wch: 20 }, { wch: 15 }, { wch: 16 }, { wch: 16 },
            { wch: 14 }, { wch: 35 }, { wch: 18 }, { wch: 20 },
            { wch: 16 }, { wch: 12 }, { wch: 18 }, { wch: 14 }
        ];
        XLSX.utils.book_append_sheet(wb, ws, "Аналитика");
        XLSX.writeFile(wb, `Аналитическая_выборка_${new Date().toISOString().slice(0, 10)}.xlsx`);
    }

    function exportToGeoJSON() {
        if (!lastQueryResults?.features?.length) {
            alert('Нет объектов для экспорта');
            return;
        }
        const fc = {
            type: "FeatureCollection",
            features: lastQueryResults.features
        };
        const blob = new Blob([JSON.stringify(fc, null, 2)], { type: "application/json" });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `Аналитические_объекты_${new Date().toISOString().slice(0, 10)}.geojson`;
        a.click();
    }

    // =========================================================================
    // 16. ВЫПОЛНЕНИЕ ЗАПРОСА И ИНИЦИАЛИЗАЦИЯ
    // =========================================================================

    async function runAnalyticsQuery(lat, lon) {
        const spatialType = document.getElementById('ac-spatial-type')?.value || 'map_objects';

        // Режим «Объекты на карте»: моментальный анализ без сетевых задержек
        if (spatialType === 'map_objects') {
            const rawMapFeatures = getMapObjectsAsFeatures();
            if (!rawMapFeatures.length) {
                const container = document.getElementById('ac-content-view');
                if (container) {
                    container.innerHTML = `
                        <div style="text-align: center; padding-top: 110px; color: #d97706;">
                            <i class="fas fa-layer-group" style="font-size: 2.8rem; margin-bottom: 12px; color: #f59e0b;"></i>
                            <div style="font-weight: 800; font-size: 1.15rem; color: #0f172a;">На карте нет загруженных объектов</div>
                            <div style="font-size: 0.9rem; color: #64748b; margin-top: 6px;">
                                Загрузите участки на карту или выберите режим «Текущий экран карты» / «По всей базе»
                            </div>
                        </div>
                    `;
                }
                return;
            }

            const payload = collectFilterPayload(lat, lon, true);
            const filtered = filterMapFeatures(rawMapFeatures, payload || { tables: ['zu', 'oks', 'structure', 'zones'], filters: {} });

            lastQueryResults = {
                summary: generateSummaryFromFeatures(filtered),
                features: filtered
            };
            currentParsedDataset = parseInfographicsDataset(filtered);
            lastQueryResults._clientStats = computeClientStats(filtered);

            updateKpiBarUI();
            switchAnalyticsTab(activeTab);
            return;
        }

        // Серверный режим через бэкенд
        const payload = collectFilterPayload(lat, lon);
        if (!payload) return;

        const container = document.getElementById('ac-content-view');
        if (container) {
            container.innerHTML = `
                <div style="text-align: center; padding-top: 120px; color: #2563eb;">
                    <i class="fas fa-circle-notch fa-spin" style="font-size: 2.8rem; margin-bottom: 14px;"></i>
                    <div style="font-weight: 800; font-size: 1.15rem; color: #0f172a;">Анализ базы данных и расчет показателей...</div>
                    <div style="font-size: 0.85rem; color: #64748b; margin-top: 6px;">Выполняется агрегация атрибутов и геометрии</div>
                </div>
            `;
        }

        try {
            const resp = await fetch(BACKEND_QUERY_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!resp.ok) throw new Error(`Ошибка сервера: ${resp.status}`);
            lastQueryResults = await resp.json();
            currentParsedDataset = parseInfographicsDataset(lastQueryResults.features || []);
            lastQueryResults._clientStats = computeClientStats(lastQueryResults.features || []);

            updateKpiBarUI();
            switchAnalyticsTab(activeTab);
        } catch (err) {
            if (container) {
                container.innerHTML = `
                    <div style="text-align: center; padding-top: 110px; color: #ef4444;">
                        <i class="fas fa-triangle-exclamation" style="font-size: 2.8rem; margin-bottom: 12px;"></i>
                        <div style="font-weight: 800; font-size: 1.15rem;">Не удалось выполнить запрос к базе данных</div>
                        <div style="font-size: 0.9rem; color: #64748b; margin-top: 6px;">${escapeHtml(err.message)}</div>
                    </div>
                `;
            }
        }
    }

    // =========================================================================
    // 17. ГЛАВНАЯ ТОЧКА ВХОДА: ОТКРЫТИЕ ОКНА АНАЛИТИЧЕСКОГО ЦЕНТРА
    // =========================================================================

    window.openAnalyticsCenter = async function (lat, lon) {
        injectAnalyticsStyles();
        await ensureEcharts();

        if (analyticsModal) {
            analyticsModal.style.display = 'flex';
            setTimeout(() => currentChartInstances.forEach(c => {
                try { if (!c.isDisposed()) c.resize(); } catch(e) {}
            }), 60);
            return;
        }

        const mapFeatures = getMapObjectsAsFeatures();
        const popularDistrict = detectPopularCadastralPrefix(mapFeatures);
        const initialCadValue = popularDistrict ? popularDistrict : (getDefaultCadastralPrefix() + '01:');

        analyticsModal = document.createElement('div');
        analyticsModal.id = 'analytics-center-overlay';

        analyticsModal.innerHTML = `
            <div class="ac-window">
                <div class="ac-header">
                    <div class="ac-header-title">
                        <div class="ac-header-icon"><i class="fas fa-chart-pie"></i></div>
                        <div>
                            <div style="display:flex; align-items:center; gap:8px;">
                                <span>Аналитический центр недвижимости</span>
                                <span class="ac-version-badge">v${ANALYTICS_CENTER_VERSION}</span>
                            </div>
                            <div style="font-size:0.75rem; font-weight:500; color:#64748b;">Интеллектуальный анализ территории и пространственных данных</div>
                        </div>
                    </div>

                    <div style="display:flex; align-items:center; gap:10px;">
                        <div class="info-scope-group">
                            <button class="info-scope-btn active" data-scope="all">Все</button>
                            <button class="info-scope-btn" data-scope="zu">Только ЗУ</button>
                            <button class="info-scope-btn" data-scope="oks">Только ОКС</button>
                            <button class="info-scope-btn" data-scope="structure">Сооружения</button>
                        </div>
                        <button class="ac-close-btn" id="ac-close-btn" title="Закрыть окно">&times;</button>
                    </div>
                </div>

                <div id="ac-kpi-container" class="info-kpi-grid"></div>
                
                <div class="ac-body">
                    <div class="ac-sidebar">

                        <div class="ac-filter-group">
                            <span class="ac-filter-title"><i class="fas fa-globe"></i> Пространственный охват</span>
                            <div class="ac-form-row">
                                <label>Гео-зона поиска:</label>
                                <select id="ac-spatial-type" class="ac-select">
                                    <option value="map_objects" selected>Объекты на карте</option>
                                    <option value="viewport">Текущий экран карты</option>
                                    <option value="radius">В радиусе от точки клика</option>
                                    <option value="all">По всей базе (требуется район)</option>
                                </select>
                            </div>
                            <div class="ac-form-row" id="ac-radius-wrap" style="display: none;">
                                <label>Радиус поиска (метров):</label>
                                <input type="number" id="ac-radius-val" class="ac-input-text" value="1000" min="50" step="50">
                            </div>
                        </div>

                        <div class="ac-filter-group">
                            <span class="ac-filter-title"><i class="fas fa-hashtag"></i> Кадастровый номер и адрес</span>
                            <div class="ac-form-row">
                                <label>Кадастровый номер или маска:</label>
                                <input type="text" id="ac-cadnum-search" class="ac-input-text" value="${initialCadValue}" placeholder="01:02 или 01:02:010101">
                            </div>
                            <div class="ac-form-row">
                                <label>Адрес / ориентир (умный поиск):</label>
                                <input type="text" id="ac-address-search" class="ac-input-text" placeholder="">
                            </div>
                            <div style="font-size: 0.78rem; margin-top: 2px;">
                                <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; color: #475569;">
                                    <input type="checkbox" id="ac-exact-match" style="accent-color:#0284c7;">
                                    <span>Точное совпадение фразы целиком</span>
                                </label>
                            </div>
                        </div>

                        <div class="ac-filter-group">
                            <span class="ac-filter-title"><i class="fas fa-layer-group"></i> Типы объектов</span>
                            <div class="ac-checkbox-grid">
                                <label class="ac-checkbox-pill"><input type="checkbox" id="ac-type-zu" checked> Участки (ЗУ)</label>
                                <label class="ac-checkbox-pill"><input type="checkbox" id="ac-type-oks" checked> Здания (ОКС)</label>
                                <label class="ac-checkbox-pill"><input type="checkbox" id="ac-type-str"> Сооружения</label>
                                <label class="ac-checkbox-pill"><input type="checkbox" id="ac-type-zones"> Зоны / Границы</label>
                            </div>
                        </div>

                        <div class="ac-filter-group">
                            <span class="ac-filter-title"><i class="fas fa-scale-balanced"></i> Права и статус</span>
                            <div class="ac-form-row">
                                <label>Форма собственности:</label>
                                <select id="ac-ownership-type" class="ac-select">
                                    <option value="">(Любая)</option>
                                    <option value="Частная">Частная</option>
                                    <option value="Муниципальная">Муниципальная</option>
                                    <option value="Государственная">Государственная</option>
                                </select>
                            </div>
                            <div class="ac-form-row">
                                <label>Вид права:</label>
                                <input type="text" id="ac-right-type" class="ac-input-text" placeholder="Собственность, Аренда...">
                            </div>
                            <div class="ac-form-row">
                                <label>Статус записи:</label>
                                <select id="ac-status-val" class="ac-select">
                                    <option value="">(Любой)</option>
                                    <option value="Ранее учтенный">Ранее учтенный</option>
                                    <option value="Учтенный">Учтенный</option>
                                    <option value="Временный">Временный</option>
                                </select>
                            </div>
                        </div>

                        <div class="ac-filter-group">
                            <span class="ac-filter-title"><i class="fas fa-vector-square"></i> Параметры участков (ЗУ)</span>
                            <div class="ac-form-row">
                                <label>Межевание границ:</label>
                                <select id="ac-zu-area-type" class="ac-select">
                                    <option value="">(Все)</option>
                                    <option value="specified">Уточненные (с границами)</option>
                                    <option value="declared">Декларированные (без границ)</option>
                                </select>
                            </div>
                            <div class="ac-form-row">
                                <label>Категория земель:</label>
                                <select id="ac-zu-category" class="ac-select">
                                    <option value="">(Любая категория)</option>
                                    <option value="Земли населенных пунктов">Земли населенных пунктов</option>
                                    <option value="Земли сельскохозяйственного назначения">Земли сельхозназначения</option>
                                    <option value="Земли промышленности">Земли промышленности и транспорта</option>
                                    <option value="Земли лесного фонда">Земли лесного фонда</option>
                                    <option value="Земли водного фонда">Земли водного фонда</option>
                                </select>
                            </div>
                            <div class="ac-form-row">
                                <label>Разрешенное использование (ВРИ):</label>
                                <input type="text" id="ac-zu-vri" class="ac-input-text" placeholder="ИЖС, ЛПХ, склад, торговля...">
                            </div>
                        </div>

                        <div class="ac-filter-group">
                            <span class="ac-filter-title"><i class="fas fa-building"></i> Параметры зданий (ОКС)</span>
                            <div class="ac-form-row">
                                <label>Назначение здания:</label>
                                <input type="text" id="ac-oks-purpose" class="ac-input-text" placeholder="Жилой дом, Нежилое, МКД...">
                            </div>
                            <div class="ac-form-row">
                                <label>Этажность:</label>
                                <div class="ac-range-row">
                                    <input type="number" id="ac-floors-min" class="ac-input-text" placeholder="От эт." min="1">
                                    <input type="number" id="ac-floors-max" class="ac-input-text" placeholder="До эт." min="1">
                                </div>
                            </div>
                            <div class="ac-form-row">
                                <label>Материал стен:</label>
                                <input type="text" id="ac-materials" class="ac-input-text" placeholder="Кирпич, дерево, монолит...">
                            </div>
                        </div>

                        <div class="ac-filter-group">
                            <span class="ac-filter-title"><i class="fas fa-ruble-sign"></i> Площадь и стоимость</span>
                            <div class="ac-form-row">
                                <label>Площадь (м²):</label>
                                <div class="ac-range-row">
                                    <input type="number" id="ac-area-min" class="ac-input-text" placeholder="От м²">
                                    <input type="number" id="ac-area-max" class="ac-input-text" placeholder="До м²">
                                </div>
                            </div>
                            <div class="ac-form-row">
                                <label>Кадастровая стоимость (₽):</label>
                                <div class="ac-range-row">
                                    <input type="number" id="ac-cost-min" class="ac-input-text" placeholder="От руб.">
                                    <input type="number" id="ac-cost-max" class="ac-input-text" placeholder="До руб.">
                                </div>
                            </div>
                        </div>

                        <div class="ac-ai-box">
                            <h4><i class="fas fa-sparkles" style="color: #2563eb;"></i> ИИ-Ассистент</h4>
                            <textarea id="ac-ai-text" class="ac-ai-input" placeholder="Например: участки ИЖС в частной собственности дороже 2 млн"></textarea>
                            <button id="ac-ai-submit" class="ac-btn-ai">
                                <i class="fas fa-wand-magic-sparkles"></i> Применить фильтр ИИ
                            </button>
                        </div>

                        <div class="ac-sidebar-footer">
                            <button id="ac-btn-execute" class="ac-btn-run">
                                <i class="fas fa-bolt"></i> Обновить
                            </button>
                            <button id="ac-btn-reset" class="ac-btn-reset" title="Сбросить все критерии">
                                <i class="fas fa-rotate-left"></i>
                            </button>
                        </div>
                    </div>

                    <div class="ac-main">
                     <div class="ac-tabs-bar">
                            <!-- Ряд 1: Вкладки -->
                            <div class="ac-tabs">
                                <button class="ac-tab-btn active" data-tab="summary"><i class="fas fa-chart-pie"></i> Сводный дашборд</button>
                                <button class="ac-tab-btn" data-tab="treemap"><i class="fas fa-table-cells-large"></i> Плиточная карта</button>
                                <button class="ac-tab-btn" data-tab="scatter"><i class="fas fa-braille"></i> Матрица корреляции</button>
                                <button class="ac-tab-btn" data-tab="ranking"><i class="fas fa-sort-amount-down"></i> Топ-рейтинг</button>
                                <button class="ac-tab-btn" data-tab="table"><i class="fas fa-list-check"></i> Реестр объектов</button>
                            </div>

                            <!-- Ряд 2: Контролы графика слева и кнопки справа в 1 строку -->
                            <div class="ac-subbar">
                                <div id="ac-subcontrols"></div>
                                <div class="ac-actions">
                                    <button class="ac-action-btn" id="ac-btn-map" title="Отобразить выборку на карте">
                                        <i class="fas fa-map-location-dot" style="color:#0284c7;"></i> На карту
                                    </button>
                                    <button class="ac-action-btn" id="ac-btn-xlsx" title="Скачать в Excel">
                                        <i class="fas fa-file-excel" style="color:#16a34a;"></i> Excel
                                    </button>
                                    <button class="ac-action-btn" id="ac-btn-png" title="Сохранить график как PNG">
                                        <i class="fas fa-camera" style="color:#8b5cf6;"></i> PNG
                                    </button>
                                    <button class="ac-action-btn" id="ac-btn-geojson" title="Скачать GeoJSON">
                                        <i class="fas fa-file-code" style="color:#ea580c;"></i> GeoJSON
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="ac-content-view" id="ac-content-view">
                            <div id="ac-chart-main" style="width: 100%; height: 100%; display: none;"></div>
                            <div id="ac-summary-grid" class="ac-charts-grid-3" style="display: none; overflow-y: auto; height: 100%; gap: 14px; padding-right: 4px;"></div>
                            <div id="ac-table-container" style="display: none; flex-direction: column; height: 100%; gap: 10px;"></div>
                        </div>
                    </div>
                </div>
            </div>
        `;

        document.body.appendChild(analyticsModal);

        const contentViewEl = document.getElementById('ac-content-view');
        if (typeof ResizeObserver !== 'undefined' && contentViewEl) {
            resizeObserver = new ResizeObserver(() => {
                if (echartMainInstance && !echartMainInstance.isDisposed()) echartMainInstance.resize();
                currentChartInstances.forEach(c => {
                    try { if (!c.isDisposed()) c.resize(); } catch(e) {}
                });
            });
            resizeObserver.observe(contentViewEl);
        }

        const close = () => {
            disposeAllCharts();
            if (resizeObserver) {
                resizeObserver.disconnect();
                resizeObserver = null;
            }
            document.removeEventListener('keydown', escHandler);
            if (analyticsModal) {
                analyticsModal.remove();
                analyticsModal = null;
            }
        };

        const escHandler = (e) => {
            if (e.key === 'Escape') close();
        };
        document.addEventListener('keydown', escHandler);

        analyticsModal.querySelector('#ac-close-btn').onclick = close;
        analyticsModal.onclick = (e) => {
            if (e.target === analyticsModal) close();
        };

        const spatialSelect = document.getElementById('ac-spatial-type');
        const radiusWrap = document.getElementById('ac-radius-wrap');
        spatialSelect.onchange = () => {
            radiusWrap.style.display = spatialSelect.value === 'radius' ? 'flex' : 'none';
        };

        analyticsModal.querySelectorAll('.ac-tab-btn').forEach(btn => {
            btn.onclick = () => {
                analyticsModal.querySelectorAll('.ac-tab-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                switchAnalyticsTab(btn.dataset.tab);
            };
        });

        analyticsModal.querySelectorAll('.info-scope-btn').forEach(btn => {
            btn.onclick = () => {
                analyticsModal.querySelectorAll('.info-scope-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                analyticsSettings.scope = btn.dataset.scope;
                updateKpiBarUI();
                switchAnalyticsTab(activeTab);
            };
        });

        document.getElementById('ac-btn-png').onclick = () => {
            const chart = echartMainInstance || currentChartInstances[0];
            if (!chart || chart.isDisposed()) {
                alert('Нет активного графика для экспорта в PNG');
                return;
            }
            try {
                const url = chart.getDataURL({ type: 'png', pixelRatio: 2, backgroundColor: '#ffffff' });
                const a = document.createElement('a');
                a.href = url;
                a.download = `analytics_${activeTab}_${new Date().toISOString().slice(0, 10)}.png`;
                a.click();
            } catch (e) {
                console.error(e);
            }
        };

        document.getElementById('ac-btn-execute').onclick = () => runAnalyticsQuery(lat, lon);
        document.getElementById('ac-btn-reset').onclick = () => resetAllFilters(initialCadValue, lat, lon);
        document.getElementById('ac-ai-submit').onclick = processAiQuery;
        document.getElementById('ac-btn-map').onclick = showResultsOnMainMap;
        document.getElementById('ac-btn-xlsx').onclick = exportToExcel;
        document.getElementById('ac-btn-geojson').onclick = exportToGeoJSON;

        runAnalyticsQuery(lat, lon);
    };
})();    
    
    
    