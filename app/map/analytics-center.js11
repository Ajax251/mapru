            .ac-input-text:focus, .ac-select:focus { background: #ffffff; border-color: #0284c7; box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.14); }
            .ac-range-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
