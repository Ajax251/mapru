            .ac-charts-grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 14px; }
            .ac-chart-card { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 12px; box-shadow: 0 2px 8px rgba(15, 23, 42, 0.02); display: flex; flex-direction: column; }
            .ac-table-toolbar { margin-bottom: 8px; padding: 8px 12px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; }
            .ac-table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 0.82rem; text-align: left; }
