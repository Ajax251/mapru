            .ac-zoom-btn:hover { background: #2563eb; color: #ffffff; }

            .ac-card-overlay { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65); z-index: 1000005; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(5px); }
            .ac-card-window { background: #ffffff; width: 960px; max-width: 95vw; max-height: 90vh; border-radius: 20px; box-shadow: 0 25px 70px rgba(0, 0, 0, 0.4); display: flex; flex-direction: column; overflow: hidden; border: 1px solid #cbd5e1; }
            .ac-card-header { padding: 16px 22px; background: linear-gradient(90deg, #f8fafc 0%, #ffffff 100%); border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between; }
            .ac-card-body { display: grid; grid-template-columns: 1.25fr 1fr; gap: 20px; padding: 20px; overflow-y: auto; }
            .ac-card-prop-table { width: 100%; border-collapse: collapse; font-size: 0.84rem; }
