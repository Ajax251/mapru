  --message-bot-color: #f1f5f9;
  --input-bg: rgba(20, 22, 32, 0.88);
  --input-border: rgba(255, 255, 255, 0.1);
  --input-text: #f8fafc;
  --button-bg: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  --button-color: white;
  --accent: #818cf8;
  --accent-secondary: #a78bfa;
  --accent-glow: rgba(129, 140, 248, 0.35);
  --shadow: rgba(0, 0, 0, 0.45);
  --shadow-md: rgba(0, 0, 0, 0.65);
  --border: rgba(255, 255, 255, 0.08);
  --header-color: #f8fafc;
  --time-color: #94a3b8;
  --typing-bg: rgba(22, 24, 34, 0.9);
  --typing-dot: #818cf8;
  --code-bg: #0b0c12;
  --code-header: #141622;
  --code-border: rgba(255, 255, 255, 0.08);
  --scrollbar-thumb: rgba(255, 255, 255, 0.16);
  --modal-bg: rgba(16, 18, 27, 0.92);
  --modal-border: rgba(255, 255, 255, 0.1);
  --chip-bg: rgba(30, 33, 48, 0.85);
  --chip-color: #e2e8f0;
  --selection-bg: #818cf8;
  --selection-color: #000;
  --hover-bg: rgba(255, 255, 255, 0.06);
  --selected-bg: rgba(129, 140, 248, 0.15);
  --selected-border: #818cf8;
  --notify-bg: #6366f1;
  --table-header-bg: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  --table-row-alt: rgba(255, 255, 255, 0.02);
  --table-hover: rgba(129, 140, 248, 0.08);
  --checkbox-bg: #161822;
  --checkbox-border: #334155;
  --checkbox-checked-bg: #818cf8;
  --checkbox-checked-border: #818cf8;
}

body.night-theme {
  --bg-color: #12100b;
  --bg-grad: linear-gradient(135deg, #12100a 0%, #1a160d 50%, #211a0f 100%);
