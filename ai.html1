<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI</title>
<link rel="stylesheet" href="webfonts/github.min.css" id="hljs-theme">
<script src="webfonts/highlight.min.js"></script>
<script src="webfonts/marked.min.js"></script>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><path fill='%239B72CB' d='M16 0C16 8.8 8.8 16 0 16C8.8 16 16 23.2 16 32C16 23.2 23.2 16 32 16C23.2 16 16 8.8 16 0Z'/></svg>" type="image/svg+xml">

<style>
* { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

:root {
  --base-font-size: 15px;
  --bg-color: #f4f6fb;
  --bg-grad: radial-gradient(at 0% 0%, rgba(102,126,234,0.12) 0px, transparent 50%),
             radial-gradient(at 100% 0%, rgba(155,114,203,0.12) 0px, transparent 50%),
             radial-gradient(at 100% 100%, rgba(27,161,227,0.10) 0px, transparent 50%),
             linear-gradient(135deg, #f4f6fb 0%, #eef2ff 50%, #f8f5ff 100%);
  --container-bg: rgba(255, 255, 255, 0.72);
  --glass-blur: 22px;
  --glass-border: rgba(255, 255, 255, 0.6);
  --message-user-bg: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
  --message-user-solid: #4f46e5;
  --message-bot-bg: rgba(255, 255, 255, 0.88);
  --message-bot-border: rgba(226, 232, 240, 0.9);
  --message-user-color: #ffffff;
  --message-bot-color: #0f172a;
  --input-bg: rgba(255, 255, 255, 0.88);
  --input-border: rgba(203, 213, 225, 0.8);
  --input-text: #0f172a;
  --button-bg: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
  --button-color: #ffffff;
  --accent: #4f46e5;
  --accent-secondary: #7c3aed;
  --accent-glow: rgba(79, 70, 229, 0.32);
  --shadow: rgba(15, 23, 42, 0.06);
  --shadow-md: rgba(15, 23, 42, 0.12);
  --border: rgba(226, 232, 240, 0.85);
  --header-color: #0f172a;
  --time-color: #64748b;
  --typing-bg: rgba(255, 255, 255, 0.9);
  --typing-dot: #4f46e5;
  --code-bg: #f8fafc;
  --code-header: #f1f5f9;
  --code-border: #e2e8f0;
  --scrollbar-thumb: rgba(148, 163, 184, 0.5);
  --modal-bg: rgba(255, 255, 255, 0.92);
  --modal-border: rgba(226, 232, 240, 0.9);
  --chip-bg: rgba(241, 245, 249, 0.9);
  --chip-color: #1e293b;
  --selection-bg: #4f46e5;
  --selection-color: #ffffff;
  --hover-bg: rgba(241, 245, 249, 0.85);
  --selected-bg: rgba(79, 70, 229, 0.1);
  --selected-border: #4f46e5;
  --notify-bg: #1e293b;
  --table-header-bg: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
  --table-row-alt: rgba(248, 250, 252, 0.7);
  --table-hover: rgba(79, 70, 229, 0.06);
  --checkbox-bg: #ffffff;
  --checkbox-border: #cbd5e1;
  --checkbox-checked-bg: #4f46e5;
  --checkbox-checked-border: #4f46e5;

  /* Переменные активной модели (меняются динамически) */
  --model-primary: #4285F4;
  --model-secondary: #9B72CB;
  --model-glow: rgba(155, 114, 203, 0.35);
  --model-grad: linear-gradient(135deg, #1BA1E3 0%, #9B72CB 55%, #D96570 100%);
}

/* Динамическое брендирование под выбранное семейство моделей */
body[data-model-brand="gemini"] {
  --model-primary: #4285F4;
  --model-secondary: #9B72CB;
  --model-glow: rgba(155, 114, 203, 0.38);
  --model-grad: linear-gradient(135deg, #1BA1E3 0%, #9B72CB 52%, #D96570 100%);
}
body[data-model-brand="atria"] {
  --model-primary: #0ea5e9;
  --model-secondary: #6366f1;
  --model-glow: rgba(14, 165, 233, 0.42);
  --model-grad: linear-gradient(135deg, #06b6d4 0%, #3b82f6 50%, #6366f1 100%);
}
body[data-model-brand="mistral"] {
  --model-primary: #f97316;
  --model-secondary: #ef4444;
  --model-glow: rgba(249, 115, 22, 0.4);
  --model-grad: linear-gradient(135deg, #fbbf24 0%, #f97316 50%, #ef4444 100%);
}
body[data-model-brand="anthropic"] {
  --model-primary: #d97757;
  --model-secondary: #b45309;
  --model-glow: rgba(217, 119, 87, 0.38);
  --model-grad: linear-gradient(135deg, #e08b6d 0%, #c96442 100%);
}
body[data-model-brand="qwen"] {
  --model-primary: #8b5cf6;
  --model-secondary: #ec4899;
  --model-glow: rgba(139, 92, 246, 0.4);
  --model-grad: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #d946ef 100%);
}

body.dark-theme {
  --bg-color: #07080c;
  --bg-grad: radial-gradient(at 0% 0%, rgba(99,102,241,0.14) 0px, transparent 50%),
             radial-gradient(at 100% 100%, rgba(139,92,246,0.12) 0px, transparent 50%),
             linear-gradient(135deg, #07080c 0%, #0d0f17 50%, #110e1a 100%);
  --container-bg: rgba(15, 17, 25, 0.72);
  --glass-border: rgba(255, 255, 255, 0.07);
  --message-user-bg: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  --message-user-solid: #6366f1;
  --message-bot-bg: rgba(22, 24, 34, 0.85);
  --message-bot-border: rgba(255, 255, 255, 0.08);
