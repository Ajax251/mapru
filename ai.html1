  --table-hover: #16203a;
  --checkbox-bg: #11182b;
  --checkbox-border: #1c2540;
  --checkbox-checked-bg: #00e5ff;
  --checkbox-checked-border: #00e5ff;
}

body.ocean-theme {
  --bg-color: #021b2e;
  --bg-grad: linear-gradient(135deg, #021e30 0%, #03354c 50%, #044a59 100%);
  --container-bg: rgba(3, 40, 62, 0.76);
  --message-user-bg: linear-gradient(135deg, #00b4d8 0%, #0077b6 100%);
  --message-user-solid: #0077b6;
  --message-bot-bg: rgba(6, 52, 76, 0.9);
  --message-bot-border: rgba(72, 202, 228, 0.22);
  --message-user-color: #ffffff;
  --message-bot-color: #e0fbfc;
  --input-bg: rgba(6, 52, 76, 0.9);
  --input-border: rgba(72, 202, 228, 0.3);
  --input-text: #e0fbfc;
  --button-bg: linear-gradient(135deg, #00b4d8 0%, #48cae4 100%);
  --button-color: #022b45;
  --accent: #48cae4;
  --accent-secondary: #90e0ef;
  --accent-glow: rgba(72, 202, 228, 0.4);
  --shadow: rgba(0,0,0,0.45);
  --shadow-md: rgba(0,0,0,0.6);
  --border: rgba(72, 202, 228, 0.2);
  --header-color: #ffffff;
  --time-color: #90e0ef;
  --typing-bg: #073b54;
  --typing-dot: #48cae4;
  --code-bg: #042938;
  --code-header: #073b54;
  --code-border: #0a5a73;
  --scrollbar-thumb: #0a5a73;
  --modal-bg: rgba(3, 30, 46, 0.94);
  --modal-border: #0a5a73;
  --chip-bg: #073b54;
  --chip-color: #caf0f8;
  --selection-bg: #48cae4;
  --selection-color: #022b45;
  --hover-bg: #073b54;
  --selected-bg: #0a4a63;
  --selected-border: #48cae4;
  --notify-bg: #0096c7;
  --table-header-bg: linear-gradient(135deg, #00b4d8 0%, #48cae4 100%);
  --table-row-alt: #042938;
  --table-hover: #0a4a63;
  --checkbox-bg: #073b54;
  --checkbox-border: #0a5a73;
  --checkbox-checked-bg: #48cae4;
  --checkbox-checked-border: #48cae4;
}

body.sakura-theme {
  --bg-color: #fff0f5;
  --bg-grad: linear-gradient(135deg, #ffe4ee 0%, #fce7f3 50%, #f3e8ff 100%);
  --container-bg: rgba(255, 245, 250, 0.78);
  --message-user-bg: linear-gradient(135deg, #ec4899 0%, #db2777 100%);
  --message-user-solid: #db2777;
  --message-bot-bg: rgba(255, 255, 255, 0.94);
  --message-bot-border: #fbcfe8;
  --message-user-color: #fff;
  --message-bot-color: #500724;
  --input-bg: rgba(255, 255, 255, 0.92);
  --input-border: #f9a8d4;
  --input-text: #500724;
  --button-bg: linear-gradient(135deg, #ec4899 0%, #db2777 100%);
  --button-color: #fff;
  --accent: #db2777;
  --accent-secondary: #f472b6;
  --accent-glow: rgba(219, 39, 119, 0.3);
  --shadow: rgba(219, 39, 119, 0.08);
  --shadow-md: rgba(219, 39, 119, 0.16);
  --border: #fbcfe8;
  --header-color: #831843;
  --time-color: #be185d;
  --typing-bg: #fce7f3;
  --typing-dot: #db2777;
  --code-bg: #fdf2f8;
  --code-header: #fce7f3;
  --code-border: #fbcfe8;
  --scrollbar-thumb: #f9a8d4;
  --modal-bg: rgba(255, 245, 250, 0.94);
  --modal-border: #fbcfe8;
  --chip-bg: #fce7f3;
  --chip-color: #831843;
  --selection-bg: #db2777;
  --selection-color: #fff;
  --hover-bg: #fce7f3;
  --selected-bg: #fbcfe8;
  --selected-border: #db2777;
  --notify-bg: #db2777;
  --table-header-bg: linear-gradient(135deg, #ec4899 0%, #db2777 100%);
  --table-row-alt: #fdf2f8;
  --table-hover: #fce7f3;
  --checkbox-bg: #fff;
  --checkbox-border: #f9a8d4;
  --checkbox-checked-bg: #db2777;
  --checkbox-checked-border: #db2777;
}

html, body {
  height: 100%;
  width: 100%;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background: var(--bg-color);
  color: var(--message-bot-color);
  transition: background 0.35s ease, color 0.35s ease;
  overflow: hidden;
  -webkit-font-smoothing: antialiased;
}

::selection { background: var(--selection-bg); color: var(--selection-color); }

.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  max-width: 100%;
  margin: 0 auto;
  position: relative;
  background: var(--bg-grad);
  background-size: 200% 200%;
  animation: bgFlow 26s ease infinite;
}

@keyframes bgFlow {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* ==================== ШАПКА И АЙДЕНТИКА МОДЕЛЕЙ ==================== */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 20px;
  background: var(--container-bg);
  backdrop-filter: blur(var(--glass-blur));
  -webkit-backdrop-filter: blur(var(--glass-blur));
  border-bottom: 1px solid var(--border);
  z-index: 100;
  gap: 12px;
  flex-shrink: 0;
  position: relative;
}

/* Тонкая фирменная линия свечения активной модели под шапкой */
.header::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--model-grad);
  opacity: 0.65;
  transition: all 0.4s ease;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  min-width: 0;
  flex: 1;
  user-select: none;
}

.header-logo {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
}

.header-logo:hover {
  transform: translateY(-1px) scale(1.05);
}

/* Индивидуальные стили иконок моделей */
.header-logo.gemini, .msg-avatar.gemini {
  background: linear-gradient(135deg, rgba(27, 161, 227, 0.14), rgba(155, 114, 203, 0.18), rgba(217, 101, 112, 0.14));
  border: 1px solid rgba(155, 114, 203, 0.35);
  box-shadow: 0 4px 16px rgba(155, 114, 203, 0.25);
}
.header-logo.atria, .msg-avatar.atria {
  background: linear-gradient(135deg, #0284c7, #4f46e5);
  border: 1px solid rgba(56, 189, 248, 0.45);
  box-shadow: 0 4px 16px rgba(14, 165, 233, 0.32);
}
.header-logo.mistral, .msg-avatar.mistral {
  background: linear-gradient(135deg, #f97316, #dc2626);
  border: 1px solid rgba(251, 191, 36, 0.4);
  box-shadow: 0 4px 16px rgba(249, 115, 22, 0.32);
}
.header-logo.anthropic, .msg-avatar.anthropic {
  background: linear-gradient(135deg, #d97757, #b45309);
  border: 1px solid rgba(251, 146, 60, 0.35);
  box-shadow: 0 4px 16px rgba(217, 119, 87, 0.28);
}
.header-logo.qwen, .msg-avatar.qwen {
  background: linear-gradient(135deg, #6366f1, #a855f7, #ec4899);
  border: 1px solid rgba(192, 132, 252, 0.4);
  box-shadow: 0 4px 16px rgba(168, 85, 247, 0.32);
}

.brand-svg-wrap {
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.brand-svg-wrap svg {
  width: 100%;
  height: 100%;
  display: block;
}

/* Индивидуальные анимации моделей во время генерации ответа */
@keyframes geminiPulseSpin {
  0% { transform: rotate(0deg) scale(0.92); filter: drop-shadow(0 0 2px rgba(66,133,244,0.4)); }
  50% { transform: rotate(180deg) scale(1.14); filter: drop-shadow(0 0 8px rgba(217,101,112,0.8)); }
  100% { transform: rotate(360deg) scale(0.92); filter: drop-shadow(0 0 2px rgba(66,133,244,0.4)); }
}
@keyframes atriaOrbit {
  0% { transform: rotate(0deg) scale(1); }
  50% { transform: rotate(180deg) scale(1.1); }
  100% { transform: rotate(360deg) scale(1); }
}
@keyframes mistralWave {
  0%, 100% { transform: translateY(0) scaleY(1); }
  50% { transform: translateY(-2px) scaleY(1.15); }
}
@keyframes qwenPulse {
  0%, 100% { transform: scale(1) rotate(0deg); }
  50% { transform: scale(1.15) rotate(15deg); }
}

.header-logo.loading.gemini .brand-svg-wrap svg,
.msg-avatar.thinking.gemini .brand-svg-wrap svg {
  animation: geminiPulseSpin 2.2s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
}
.header-logo.loading.atria .brand-svg-wrap svg,
.msg-avatar.thinking.atria .brand-svg-wrap svg {
  animation: atriaOrbit 1.8s linear infinite;
}
.header-logo.loading.mistral .brand-svg-wrap svg,
.msg-avatar.thinking.mistral .brand-svg-wrap svg {
  animation: mistralWave 0.9s ease-in-out infinite;
}
.header-logo.loading.qwen .brand-svg-wrap svg,
.msg-avatar.thinking.qwen .brand-svg-wrap svg,
.header-logo.loading.anthropic .brand-svg-wrap svg,
.msg-avatar.thinking.anthropic .brand-svg-wrap svg {
  animation: qwenPulse 1.4s ease-in-out infinite;
}

.header-info { display: flex; flex-direction: column; min-width: 0; flex: 1; }
.header-title-row { display: flex; align-items: center; gap: 8px; }
.header-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--header-color);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: -0.2px;
}
.model-pill {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  padding: 2px 7px;
  border-radius: 999px;
  background: var(--model-grad);
  color: #fff;
  box-shadow: 0 2px 8px var(--model-glow);
  flex-shrink: 0;
}
.header-subtitle {
  font-size: 11.5px;
  color: var(--time-color);
  white-space: nowrap;
  margin-top: 1px;
}

.header-controls { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }

.h-btn {
  width: 36px;
  height: 36px;
  border-radius: 11px;
  background: var(--container-bg);
  border: 1px solid var(--border);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  color: var(--accent);
}
.h-btn:hover {
  background: var(--hover-bg);
  border-color: var(--accent);
  transform: translateY(-1px);
}
.h-btn.active {
  background: var(--selected-bg);
  border-color: var(--accent);
  box-shadow: 0 0 12px var(--accent-glow);
}
.h-btn svg { width: 18px; height: 18px; fill: currentColor; }

/* ==================== ВЫПАДАЮЩИЕ СПИСКИ ==================== */
.selector { position: relative; }
.sel-btn {
  padding: 7px 13px;
  border: 1px solid var(--border);
  border-radius: 11px;
  background: var(--container-bg);
  backdrop-filter: blur(10px);
  cursor: pointer;
  font-size: 12.5px;
  font-weight: 600;
  color: var(--message-bot-color);
  display: flex;
  align-items: center;
  gap: 8px;
  transition: all 0.2s ease;
  white-space: nowrap;
}
.sel-btn:hover {
  background: var(--hover-bg);
  border-color: var(--model-primary);
  box-shadow: 0 2px 10px var(--model-glow);
}
.sel-btn-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--model-grad);
  box-shadow: 0 0 6px var(--model-glow);
}
.sel-btn::after {
  content: '';
  width: 5px;
  height: 5px;
  border-right: 1.5px solid currentColor;
  border-bottom: 1.5px solid currentColor;
  transform: rotate(45deg);
  margin-left: 2px;
  opacity: 0.6;
}

.sel-opts {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  background: var(--modal-bg);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
  border-radius: 16px;
  box-shadow: 0 14px 36px var(--shadow-md);
  padding: 6px;
  list-style: none;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-8px) scale(0.97);
  transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 1000;
  border: 1px solid var(--border);
  min-width: 230px;
  max-height: 380px;
  overflow-y: auto;
}
.sel-opts.show {
  opacity: 1;
  visibility: visible;
  transform: translateY(0) scale(1);
}
.sel-opt {
  padding: 9px 12px;
  border-radius: 10px;
  cursor: pointer;
  font-size: 12.5px;
  font-weight: 500;
  transition: all 0.18s ease;
  color: var(--message-bot-color);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.sel-opt:hover { background: var(--hover-bg); transform: translateX(2px); }
.sel-opt.selected {
  background: var(--selected-bg);
  color: var(--accent);
  font-weight: 600;
}
.sel-opt-badge {
  font-size: 9.5px;
  padding: 2px 6px;
  border-radius: 6px;
  font-weight: 700;
  text-transform: uppercase;
  opacity: 0.85;
}
.sel-opt-badge.gemini { background: rgba(66,133,244,0.15); color: #3b82f6; }
.sel-opt-badge.atria { background: rgba(14,165,233,0.15); color: #0ea5e9; }
.sel-opt-badge.mistral { background: rgba(249,115,22,0.15); color: #f97316; }

/* ==================== КОНТЕЙНЕР ЧАТА И СООБЩЕНИЯ ==================== */
#chat-container {
  flex: 1;
  overflow-y: auto;
  padding: 22px 18px 28px;
  scroll-behavior: smooth;
}
#chat-container::-webkit-scrollbar { width: 6px; }
#chat-container::-webkit-scrollbar-track { background: transparent; }
#chat-container::-webkit-scrollbar-thumb { background: var(--scrollbar-thumb); border-radius: 99px; }

.message {
  display: flex;
  gap: 12px;
  margin-bottom: 18px;
  animation: msgSpring 0.42s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  max-width: min(86%, 860px);
}
@keyframes msgSpring {
  0% { opacity: 0; transform: translateY(18px) scale(0.97); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}
.message.user { margin-left: auto; flex-direction: row-reverse; }
.message.bot { margin-right: auto; }
.message.grouped { margin-top: -10px; margin-bottom: 8px; }
.message.grouped .msg-avatar { visibility: hidden; }

.msg-avatar {
  width: 34px;
  height: 34px;
  border-radius: 11px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-weight: 700;
  font-size: 12px;
  position: relative;
  transition: transform 0.25s ease;
}
.msg-avatar .brand-svg-wrap { width: 20px; height: 20px; }
.msg-avatar.user-avatar {
  background: var(--message-user-bg);
  box-shadow: 0 3px 10px var(--accent-glow);
  border-radius: 11px;
}

.msg-bubble {
  display: flex;
  flex-direction: column;
  max-width: 100%;
  min-width: 0;
  position: relative;
}

.msg-copy {
  position: absolute;
  bottom: -11px;
  right: 10px;
  width: 26px;
  height: 26px;
  border-radius: 8px;
  background: var(--container-bg);
  backdrop-filter: blur(12px);
  border: 1px solid var(--border);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: scale(0.85);
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 10;
  color: var(--time-color);
  box-shadow: 0 4px 10px var(--shadow);
}
.msg-copy svg { width: 13px; height: 13px; fill: currentColor; }
.msg-copy:hover { background: var(--hover-bg); border-color: var(--accent); color: var(--accent); transform: scale(1.06); }
.msg-copy.copied { background: #10b981; border-color: #10b981; color: white; }
.msg-bubble:hover .msg-copy { opacity: 1; transform: scale(1); }
.user .msg-copy { left: 10px; right: auto; }

@media (hover: none) and (pointer: coarse) {
  .msg-copy { opacity: 0.7; transform: scale(1); }
}

.msg-content {
  padding: 12px 16px;
  border-radius: 20px;
  line-height: 1.6;
  font-size: var(--base-font-size);
  word-wrap: break-word;
  position: relative;
}
.user .msg-content {
  background: var(--message-user-bg);
  color: var(--message-user-color);
  border-bottom-right-radius: 6px;
  box-shadow: 0 6px 20px -4px var(--accent-glow);
}
.bot .msg-content {
  background: var(--message-bot-bg);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  color: var(--message-bot-color);
  border: 1px solid var(--message-bot-border);
  border-bottom-left-radius: 6px;
  box-shadow: 0 6px 22px -6px var(--shadow);
}

.msg-content p + p { margin-top: 8px; }
.msg-content ul, .msg-content ol { padding-left: 20px; margin: 8px 0; }
.msg-content li + li { margin-top: 4px; }

.msg-meta {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 10.5px;
  color: var(--time-color);
  margin-top: 5px;
  padding: 0 6px;
}
.user .msg-meta { justify-content: flex-end; }
.msg-model-tag {
  font-weight: 600;
  color: var(--model-primary);
  opacity: 0.9;
}

.msg-image, .msg-video {
  max-width: 300px;
  border-radius: 14px;
  margin-bottom: 8px;
  cursor: pointer;
  box-shadow: 0 4px 14px var(--shadow);
  transition: transform 0.2s ease;
}
.msg-image:hover { transform: scale(1.02); }
.msg-video { background: black; }

/* ==================== ИНДИКАТОР ГЕНЕРАЦИИ С АЙДЕНТИКОЙ МОДЕЛИ ==================== */
.typing {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 18px;
  animation: msgSpring 0.3s ease;
}
.typing-bubble {
  background: var(--typing-bg);
  backdrop-filter: blur(14px);
  border: 1px solid var(--border);
  padding: 12px 18px;
  border-radius: 20px;
  border-bottom-left-radius: 6px;
  display: flex;
  align-items: center;
  gap: 10px;
  box-shadow: 0 6px 20px -4px var(--model-glow);
}
.typing-bars {
  display: flex;
  align-items: center;
  gap: 4px;
  height: 16px;
}
.typing-bar {
  width: 4px;
  height: 8px;
  border-radius: 99px;
  background: var(--model-grad);
  animation: waveBar 1.1s ease-in-out infinite;
}
.typing-bar:nth-child(2) { animation-delay: 0.15s; }
.typing-bar:nth-child(3) { animation-delay: 0.3s; }
.typing-bar:nth-child(4) { animation-delay: 0.45s; }

@keyframes waveBar {
  0%, 100% { height: 6px; opacity: 0.5; }
  50% { height: 16px; opacity: 1; }
}
.typing-text {
  font-size: 12px;
  font-weight: 600;
  background: var(--model-grad);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* ==================== ПРИВЕТСТВЕННЫЙ ЭКРАН ==================== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100%;
  color: var(--time-color);
  text-align: center;
  padding: 28px 16px;
}
.empty-hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  border-radius: 999px;
  background: var(--container-bg);
  border: 1px solid var(--border);
  font-size: 12px;
  font-weight: 600;
  color: var(--header-color);
  margin-bottom: 16px;
  box-shadow: 0 4px 16px var(--model-glow);
  backdrop-filter: blur(10px);
}
.empty-hero-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #10b981;
  box-shadow: 0 0 8px #10b981;
}
.empty-icon {
  width: 78px;
  height: 78px;
  border-radius: 24px;
  background: var(--container-bg);
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18px;
  box-shadow: 0 12px 32px var(--model-glow);
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  animation: floatHero 5s ease-in-out infinite;
}
@keyframes floatHero {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-6px); }
}
.empty-icon .brand-svg-wrap { width: 42px; height: 42px; }
.empty-title {
  font-size: 22px;
  font-weight: 800;
  color: var(--header-color);
  margin-bottom: 6px;
  letter-spacing: -0.4px;
}
.empty-text {
  font-size: 13.5px;
  max-width: 340px;
  margin-bottom: 24px;
  line-height: 1.45;
}
.prompt-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  justify-content: center;
  max-width: 560px;
}
.prompt-chip {
  padding: 10px 15px;
  border-radius: 14px;
  background: var(--container-bg);
  backdrop-filter: blur(10px);
  border: 1px solid var(--border);
  font-size: 13px;
  font-weight: 500;
  color: var(--message-bot-color);
  cursor: pointer;
  transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  align-items: center;
  gap: 7px;
  box-shadow: 0 2px 8px var(--shadow);
}
.prompt-chip:hover {
  border-color: var(--model-primary);
  background: var(--selected-bg);
  color: var(--header-color);
  transform: translateY(-3px);
  box-shadow: 0 8px 20px var(--model-glow);
}

/* ==================== ПРИКРЕПЛЕННЫЕ ФАЙЛЫ ==================== */
#file-preview {
  display: none;
  padding: 10px 20px;
  background: var(--container-bg);
  backdrop-filter: blur(16px);
  border-top: 1px solid var(--border);
  flex-wrap: wrap;
  gap: 8px;
}
#file-preview.visible { display: flex; }
.file-chip {
  display: inline-flex;
  align-items: center;
  background: var(--chip-bg);
  border: 1px solid var(--border);
  color: var(--chip-color);
  padding: 6px 12px;
  border-radius: 14px;
  font-size: 12px;
  font-weight: 500;
  gap: 8px;
  animation: msgSpring 0.25s ease;
}
.file-chip svg { width: 16px; height: 16px; fill: var(--accent); }
.file-chip img, .file-chip video { width: 32px; height: 32px; border-radius: 8px; object-fit: cover; background: #000; }
.file-chip-remove {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--hover-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.15s ease;
}
.file-chip-remove:hover { background: #ef4444; color: #fff; }
.file-chip-remove:hover svg { fill: #fff; }
.file-chip-remove svg { width: 10px; height: 10px; fill: var(--message-bot-color); }

.compress-checkbox-container {
  display: none;
  align-items: center;
  gap: 8px;
  padding: 8px 20px;
  background: var(--hover-bg);
  border-bottom: 1px solid var(--border);
  font-size: 12px;
  color: var(--message-bot-color);
}
.compress-checkbox-container.visible { display: flex; }
.custom-checkbox {
  position: relative;
  width: 18px;
  height: 18px;
  border: 2px solid var(--checkbox-border);
  border-radius: 5px;
  background: var(--checkbox-bg);
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.custom-checkbox.checked { background: var(--checkbox-checked-bg); border-color: var(--checkbox-checked-border); }
.custom-checkbox.checked::after { content: '✓'; color: white; font-size: 12px; font-weight: bold; }
.compress-checkbox-label { cursor: pointer; user-select: none; display: flex; align-items: center; gap: 6px; }
.file-size-info { color: var(--accent); font-weight: 600; }
.compression-info { font-size: 11px; color: var(--time-color); margin-left: auto; }

/* ==================== ПАРЯЩАЯ ПАНЕЛЬ ВВОДА ==================== */
#input-container {
  display: flex;
  padding: 10px 16px 16px;
  background: transparent;
  align-items: flex-end;
  justify-content: center;
  gap: 10px;
  position: relative;
  z-index: 50;
}
.input-dock {
  width: 100%;
  max-width: 880px;
  display: flex;
  align-items: flex-end;
  gap: 8px;
  background: var(--input-bg);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid var(--input-border);
  border-radius: 26px;
  padding: 6px 8px;
  box-shadow: 0 10px 30px -6px var(--shadow-md);
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}
.input-dock:focus-within {
  border-color: var(--model-primary);
  box-shadow: 0 12px 34px -6px var(--model-glow), 0 0 0 3px var(--model-glow);
  transform: translateY(-1px);
}
.input-capsule {
  flex: 1;
  display: flex;
  align-items: flex-end;
}
#message-input {
  flex: 1;
  padding: 9px 6px;
  border: none;
  background: transparent;
  font-size: var(--base-font-size);
  color: var(--input-text);
  resize: none;
  min-height: 38px;
  max-height: 130px;
  font-family: inherit;
  line-height: 1.45;
  outline: none;
}
#message-input::placeholder { color: var(--time-color); }

.in-btn {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  flex-shrink: 0;
}
#upload-btn { background: transparent; color: var(--time-color); }
#upload-btn:hover { background: var(--hover-bg); color: var(--accent); transform: rotate(90deg); }
#upload-btn.has-file { background: var(--selected-bg); color: var(--accent); }
#upload-btn svg { width: 22px; height: 22px; fill: currentColor; }

#send-btn {
  background: var(--model-grad);
  color: #ffffff;
  box-shadow: 0 4px 14px var(--model-glow);
}
#send-btn:hover:not(:disabled) { transform: scale(1.07); filter: brightness(1.06); }
#send-btn:active:not(:disabled) { transform: scale(0.95); }
#send-btn:disabled { opacity: 0.75; cursor: default; }
#send-btn svg { width: 20px; height: 20px; fill: currentColor; }

/* ==================== ТАБЛИЦЫ И КОД В СООБЩЕНИЯХ ==================== */
.msg-content table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  margin: 12px 0;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 14px var(--shadow);
  border: 1px solid var(--border);
}
.msg-content thead { background: var(--table-header-bg); }
.msg-content th { padding: 11px 14px; text-align: left; font-weight: 600; color: white; font-size: 12.5px; }
.msg-content td { padding: 10px 14px; border-bottom: 1px solid var(--border); font-size: 13.5px; }
.msg-content tbody tr:last-child td { border-bottom: none; }
.msg-content tbody tr:nth-child(even) { background: var(--table-row-alt); }
.msg-content tbody tr:hover { background: var(--table-hover); }

.msg-content pre {
  background: var(--code-bg);
  border: 1px solid var(--code-border);
  border-radius: 14px;
  margin: 12px 0;
  overflow: hidden;
  box-shadow: 0 4px 14px var(--shadow);
}
.code-header {
  background: var(--code-header);
  padding: 8px 14px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 11.5px;
  color: var(--time-color);
  border-bottom: 1px solid var(--code-border);
}
.code-lang-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
}
.code-dots {
  display: flex;
  gap: 5px;
}
.code-dots span {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}
.code-dots span:nth-child(1) { background: #ef4444; }
.code-dots span:nth-child(2) { background: #f59e0b; }
.code-dots span:nth-child(3) { background: #10b981; }

.code-lang { font-weight: 700; color: var(--accent); text-transform: uppercase; font-size: 10.5px; letter-spacing: 0.5px; }
.code-actions { display: flex; gap: 6px; }
.code-btn {
  background: var(--container-bg);
  border: 1px solid var(--border);
  border-radius: 7px;
  padding: 4px 10px;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  color: var(--message-bot-color);
  transition: all 0.18s ease;
}
.code-btn:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-1px); }
.msg-content pre code {
  display: block;
  padding: 14px;
  overflow-x: auto;
  font-family: 'JetBrains Mono', 'SF Mono', Consolas, monospace;
  font-size: calc(var(--base-font-size) * 0.86);
  line-height: 1.55;
}
.msg-content code:not(pre code) {
  background: var(--hover-bg);
  border: 1px solid var(--border);
  padding: 2px 6px;
  border-radius: 6px;
  font-family: 'JetBrains Mono', 'SF Mono', Consolas, monospace;
  font-size: 0.88em;
}

/* ==================== УВЕДОМЛЕНИЯ И МОДАЛЬНЫЕ ОКНА ==================== */
.notify {
  position: fixed;
  top: 18px;
  left: 50%;
  transform: translateX(-50%) translateY(-80px);
  background: var(--notify-bg);
  color: white;
  padding: 10px 20px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 600;
  box-shadow: 0 8px 24px rgba(0,0,0,0.25);
  z-index: 10000;
  opacity: 0;
  transition: all 0.32s cubic-bezier(0.16, 1, 0.3, 1);
}
.notify.show { transform: translateX(-50%) translateY(0); opacity: 1; }
.notify.error { background: #ef4444; }

.modal {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.5);
  display: none;
  justify-content: center;
  align-items: center;
  z-index: 10000;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 16px;
}

.modal-box {
  background: var(--modal-bg);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-radius: 22px;
  width: 100%;
  max-width: 450px;
  max-height: 88vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  border: 1px solid var(--modal-border);
  box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.3);
  animation: modalPop 0.28s cubic-bezier(0.16, 1, 0.3, 1);
}
@keyframes modalPop {
  from { opacity: 0; transform: scale(0.95) translateY(10px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  border-bottom: 1px solid var(--border);
}
.modal-title {
  display: flex;
  align-items: center;
  font-size: 16px;
  font-weight: 700;
  color: var(--header-color);
  letter-spacing: -0.2px;
}
.modal-close {
  width: 32px;
  height: 32px;
  border-radius: 10px;
  background: var(--hover-bg);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--time-color);
  transition: all 0.2s ease;
}
.modal-close:hover { background: var(--border); color: var(--header-color); transform: rotate(90deg); }
.modal-close svg { width: 15px; height: 15px; fill: currentColor; }

.modal-body { padding: 20px; overflow-y: auto; flex: 1; }
.modal-body::-webkit-scrollbar { width: 5px; }
.modal-body::-webkit-scrollbar-thumb { background: var(--scrollbar-thumb); border-radius: 4px; }

.set-group { margin-bottom: 20px; }
.set-group:last-child { margin-bottom: 0; }
.set-label {
  display: block;
  font-size: 11px;
  font-weight: 700;
  color: var(--time-color);
  margin-bottom: 8px;
  text-transform: uppercase;
  letter-spacing: 0.6px;
}
.set-select, .set-input {
  width: 100%;
  padding: 10px 14px;
  background: var(--input-bg);
  border: 1px solid var(--input-border);
  border-radius: 12px;
  color: var(--input-text);
  font-size: 13.5px;
  font-family: inherit;
  transition: all 0.2s ease;
}
.set-select:focus, .set-input:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-glow);
}
.set-link {
  display: inline-block;
  margin-top: 6px;
  font-size: 12px;
  color: var(--accent);
  text-decoration: none;
  font-weight: 600;
}

.api-modes { display: flex; flex-direction: column; gap: 8px; }
.api-mode {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  background: var(--input-bg);
  border: 1px solid var(--input-border);
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.2s ease;
}
.api-mode:hover { border-color: var(--accent); background: var(--hover-bg); }
.api-mode.selected {
  border-color: var(--accent);
  background: var(--selected-bg);
  box-shadow: 0 0 0 1px var(--accent);
}
.api-mode svg { width: 17px; height: 17px; fill: var(--accent); flex-shrink: 0; }
.api-mode span { font-size: 13px; font-weight: 500; color: var(--message-bot-color); }

.theme-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
.theme-option {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8px;
  border: 1.5px solid var(--border);
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.2s ease;
  background: var(--input-bg);
  aspect-ratio: 1;
}
.theme-option:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: 0 4px 12px var(--shadow); }
.theme-option.selected {
  border-color: var(--accent);
  background: var(--selected-bg);
  box-shadow: 0 0 0 1px var(--accent), 0 4px 12px var(--accent-glow);
}
.theme-preview {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 1.5px solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 2px 6px rgba(0,0,0,0.08);
}
.theme-preview.light     { background: linear-gradient(135deg, #ffffff 50%, #4f46e5 50%); }
.theme-preview.dark      { background: linear-gradient(135deg, #07080c 50%, #6366f1 50%); }
.theme-preview.night     { background: linear-gradient(135deg, #12100a 50%, #eab308 50%); }
.theme-preview.royalblue { background: linear-gradient(135deg, #012456 50%, #facc15 50%); }
.theme-preview.imessage  { background: linear-gradient(135deg, #ffffff 50%, #007aff 50%); }
.theme-preview.nature    { background: linear-gradient(135deg, #e8f5e9 50%, #16a34a 50%); }
.theme-preview.arctic    { background: linear-gradient(135deg, #e0f2fe 50%, #0284c7 50%); }
.theme-preview.sunset    { background: linear-gradient(135deg, #ffedd5 50%, #f97316 50%); }
.theme-preview.neon      { background: linear-gradient(135deg, #06060f 50%, #00e5ff 50%); }
.theme-preview.ocean     { background: linear-gradient(135deg, #022b45 50%, #48cae4 50%); }
.theme-preview.sakura    { background: linear-gradient(135deg, #ffe4ee 50%, #db2777 50%); }

.font-size-control {
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--input-bg);
  padding: 6px;
  border-radius: 14px;
  border: 1px solid var(--input-border);
}
.font-size-btn {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: var(--container-bg);
  color: var(--accent);
  font-size: 18px;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}
.font-size-btn:hover { border-color: var(--accent); background: var(--hover-bg); transform: scale(1.05); }
.font-size-value { flex: 1; text-align: center; font-size: 14px; font-weight: 600; color: var(--header-color); }

.set-btn {
  width: 100%;
  padding: 13px;
  background: var(--model-grad);
  color: #ffffff;
  border: none;
  border-radius: 14px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  margin-top: 20px;
  box-shadow: 0 4px 16px var(--model-glow);
  transition: all 0.2s ease;
}
.set-btn:hover { opacity: 0.94; transform: translateY(-1px); }

.auto-toggle { display: flex; align-items: center; gap: 8px; cursor: pointer; user-select: none; font-size: 13px; color: var(--message-bot-color); }

.table-modal .modal-box {
  max-width: 95vw;
  width: 95vw;
  height: 90vh;
  max-height: 90vh;
}
.table-actions { display: flex; gap: 8px; }
.table-actions button {
  padding: 6px 12px;
  background: var(--hover-bg);
  border: 1px solid var(--border);
  border-radius: 8px;
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  color: var(--message-bot-color);
  display: flex;
  align-items: center;
  gap: 5px;
}
.table-actions button:hover { border-color: var(--accent); color: var(--accent); }
.table-actions button svg { width: 14px; height: 14px; fill: currentColor; }
#table-content { padding: 20px; min-height: 100%; }
#table-content table { width: 100%; border-collapse: separate; border-spacing: 0; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px var(--shadow); }
#table-content thead { background: var(--table-header-bg); }
#table-content th { padding: 14px 18px; text-align: left; font-weight: 600; color: white; font-size: 13px; white-space: nowrap; }
#table-content td { padding: 12px 18px; border-bottom: 1px solid var(--border); font-size: 14px; color: var(--message-bot-color); }
#table-content tbody tr:nth-child(even) { background: var(--table-row-alt); }
#table-content tbody tr:hover { background: var(--table-hover); }

#crop-modal { z-index: 10001; }
#crop-modal .modal-box { max-width: 95vw; max-height: 95vh; width: auto; }
.crop-container { position: relative; display: inline-block; border: 1px dashed var(--border); user-select: none; touch-action: none; cursor: crosshair; margin: 15px auto; max-width: 100%; max-height: calc(80vh - 150px); overflow: hidden; border-radius: 10px; }
.crop-container img { display: block; max-width: 100%; max-height: calc(80vh - 150px); width: auto; height: auto; object-fit: contain; -webkit-user-drag: none; }
.crop-selection { position: absolute; border: 2px solid var(--accent); background: rgba(79, 70, 229, 0.18); display: none; pointer-events: none; }
.crop-info { font-size: 12px; color: var(--time-color); text-align: center; margin-bottom: 10px; }
.crop-buttons { display: flex; justify-content: center; gap: 12px; margin-top: 15px; }
.crop-buttons button { padding: 10px 24px; border: none; border-radius: 10px; cursor: pointer; font-size: 14px; font-weight: 600; transition: all 0.2s ease; }
.crop-btn-confirm { background: #10b981; color: white; }
.crop-btn-confirm:hover { background: #059669; }
.crop-btn-cancel { background: #ef4444; color: white; }
.crop-btn-cancel:hover { background: #dc2626; }

.image-preview-modal { background: rgba(0,0,0,0.9); cursor: zoom-out; }
.image-preview-modal img { max-width: 95vw; max-height: 95vh; object-fit: contain; border-radius: 12px; box-shadow: 0 8px 36px rgba(0,0,0,0.6); cursor: default; }
.image-preview-close { position: absolute; top: 16px; right: 16px; width: 42px; height: 42px; border-radius: 50%; background: rgba(255,255,255,0.15); border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; z-index: 10; }
.image-preview-close:hover { background: rgba(255,255,255,0.25); }
.image-preview-close svg { width: 20px; height: 20px; fill: white; }

.scroll-bottom {
  position: fixed;
  bottom: 92px;
  right: 22px;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: var(--model-grad);
  color: #ffffff;
  border: none;
  cursor: pointer;
  display: none;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6px 18px var(--model-glow);
  z-index: 90;
  transition: all 0.22s ease;
}
.scroll-bottom.visible { display: flex; }
.scroll-bottom:hover { transform: translateY(-2px) scale(1.06); }
.scroll-bottom svg { width: 22px; height: 22px; fill: currentColor; }

/* ==================== РЕЖИМЫ ВЫВОДА ==================== */
#output-mode-selector { position: relative; }
#output-mode-btn {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 11px;
  border: 1px solid var(--border);
  background: var(--container-bg);
  cursor: pointer;
  transition: all 0.2s ease;
  color: var(--accent);
}
#output-mode-icon { display: flex; align-items: center; justify-content: center; width: 18px; height: 18px; }
#output-mode-icon svg { width: 18px; height: 18px; fill: currentColor; }

#output-mode-opts {
  min-width: 280px;
  max-height: none;
  overflow: visible;
  padding: 6px;
  border-radius: 16px;
}

#output-mode-btn.mode-default { background: rgba(99, 102, 241, 0.14); border-color: rgba(99, 102, 241, 0.4); color: #6366f1; }
#output-mode-btn.mode-table { background: rgba(16, 185, 129, 0.14); border-color: rgba(16, 185, 129, 0.4); color: #10b981; }
#output-mode-btn.mode-presentation { background: rgba(249, 115, 22, 0.14); border-color: rgba(249, 115, 22, 0.4); color: #f97316; }
#output-mode-btn.mode-webapp { background: rgba(6, 182, 212, 0.14); border-color: rgba(6, 182, 212, 0.4); color: #06b6d4; }
#output-mode-btn.mode-document { background: rgba(236, 72, 153, 0.14); border-color: rgba(236, 72, 153, 0.4); color: #ec4899; }
#output-mode-btn.mode-onepage { background: rgba(168, 85, 247, 0.14); border-color: rgba(168, 85, 247, 0.4); color: #a855f7; }
#output-mode-btn.mode-motion {
  background: rgba(168, 85, 247, 0.16) !important;
  border-color: rgba(168, 85, 247, 0.45) !important;
  color: #a855f7 !important;
  box-shadow: 0 0 12px rgba(168, 85, 247, 0.25);
}

.mode-opt {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 7px 10px;
  border-radius: 11px;
  cursor: pointer;
  transition: all 0.18s ease;
  border: 1px solid transparent;
}
.mode-opt:hover { background: var(--hover-bg); transform: translateX(2px); }
.mode-opt.selected { background: var(--selected-bg); border-color: var(--selected-border); }

.mode-icon-box {
  width: 34px;
  height: 34px;
  border-radius: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 0.2s ease;
}
.mode-opt:hover .mode-icon-box { transform: scale(1.08); }
.mode-icon-box svg { width: 17px; height: 17px; fill: currentColor; }
.mode-icon-box.default { background: rgba(99, 102, 241, 0.15); color: #6366f1; }
.mode-icon-box.table { background: rgba(16, 185, 129, 0.15); color: #10b981; }
.mode-icon-box.presentation { background: rgba(249, 115, 22, 0.15); color: #f97316; }
.mode-icon-box.onepage { background: rgba(168, 85, 247, 0.15); color: #a855f7; }
.mode-icon-box.motion { background: rgba(168, 85, 247, 0.15); color: #a855f7; }
.mode-icon-box.webapp { background: rgba(6, 182, 212, 0.15); color: #06b6d4; }
.mode-icon-box.document { background: rgba(236, 72, 153, 0.15); color: #ec4899; }

.mode-text-box { display: flex; flex-direction: column; min-width: 0; }
.mode-title { font-size: 13px; font-weight: 600; color: var(--header-color); line-height: 1.25; }
.mode-opt.selected .mode-title { color: var(--accent); }
.mode-desc { font-size: 11px; color: var(--time-color); margin-top: 2px; line-height: 1.2; }

.m-title-icon {
  width: 26px;
  height: 26px;
  border-radius: 8px;
  background: rgba(168, 85, 247, 0.18);
  color: #a855f7;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 8px;
}
.m-title-icon svg { width: 16px; height: 16px; fill: currentColor; }

.motion-grid { display: grid; gap: 8px; }
.motion-grid.cols-2 { grid-template-columns: repeat(2, 1fr); }
.motion-grid.cols-3 { grid-template-columns: repeat(3, 1fr); }

.m-card {
  position: relative;
  padding: 10px 12px;
  background: var(--input-bg);
  border: 1.5px solid var(--border);
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.18s ease;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.m-card:hover { border-color: #a855f7; transform: translateY(-1px); }
.m-card.selected {
  border-color: #a855f7 !important;
  background: rgba(168, 85, 247, 0.12) !important;
  box-shadow: 0 0 0 1px #a855f7, 0 4px 12px rgba(168, 85, 247, 0.2) !important;
}
.m-card-title { font-size: 13px; font-weight: 600; color: var(--header-color); line-height: 1.25; }
.m-card-desc { font-size: 10.5px; color: var(--time-color); margin-top: 3px; line-height: 1.25; }
.m-card-badge {
  position: absolute;
  top: -6px;
  right: 8px;
  background: #a855f7;
  color: white;
  font-size: 8.5px;
  font-weight: 700;
  padding: 1px 6px;
  border-radius: 6px;
  text-transform: uppercase;
}

.mode-tune-btn {
  width: 32px;
  height: 32px;
  min-width: 32px;
  border-radius: 8px;
  border: 1px solid rgba(168, 85, 247, 0.35);
  background: rgba(168, 85, 247, 0.12);
  color: #a855f7;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 8px;
  transition: all 0.2s ease;
}
.mode-tune-btn:hover { background: #a855f7; color: #fff; border-color: #a855f7; transform: scale(1.08); }
.mode-tune-btn svg { width: 17px; height: 17px; fill: currentColor; }

@media (max-width: 600px) {
  .header { padding: 8px 12px; gap: 8px; }
  #model-selector { display: none; }
  .message { max-width: 94%; }
  #chat-container { padding: 14px 12px; }
  #input-container { padding: 8px 10px 12px; }
  .theme-grid { grid-template-columns: repeat(4, 1fr); gap: 6px; }
  .theme-preview { width: 28px; height: 28px; }
  .table-actions button span { display: none; }
}
</style>
</head>
<body data-model-brand="gemini">
<div class="container">
  <header class="header">
    <div class="header-left" id="header-left" title="Начать новый диалог">
      <div class="header-logo gemini" id="header-logo"></div>
      <div class="header-info">
        <div class="header-title-row">
          <div class="header-title" id="header-title">Gemini 3.5 Flash Lite</div>
          <span class="model-pill" id="model-pill">Gemini</span>
        </div>
        <div class="header-subtitle" id="header-subtitle">Готов к работе</div>
      </div>
    </div>

    <div class="header-controls">
      <div class="selector" id="model-selector">
        <button class="sel-btn" id="model-btn">
          <span class="sel-btn-dot"></span>
          <span id="model-name">Gemini 3.5 Flash Lite</span>
        </button>
        <ul class="sel-opts" id="model-opts"></ul>
      </div>

      <div class="selector" id="output-mode-selector">
        <button class="h-btn" id="output-mode-btn" title="Формат ответа">
          <span id="output-mode-icon"></span>
        </button>
        <ul class="sel-opts" id="output-mode-opts">
          <li class="mode-opt" data-mode="default">
            <div class="mode-icon-box default">
              <svg viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 10H6v-2h12v2zm0-3H6V7h12v2z"/></svg>
            </div>
            <div class="mode-text-box">
              <span class="mode-title">Стандартный диалог</span>
              <span class="mode-desc">Обычный текст и Markdown</span>
            </div>
          </li>

          <li class="mode-opt" data-mode="table">
            <div class="mode-icon-box table">
              <svg viewBox="0 0 24 24"><path d="M3 3h18v18H3V3zm16 16V5H5v14h14zM7 7h2v2H7V7zm0 4h2v2H7v-2zm0 4h2v2H7v-2zm4-8h6v2h-6V7zm0 4h6v2h-6v-2zm0 4h6v2h-6v-2z"/></svg>
            </div>
            <div class="mode-text-box">
              <span class="mode-title">Режим таблицы</span>
              <span class="mode-desc">Вся информация в виде таблицы</span>
            </div>
          </li>

          <li class="mode-opt" data-mode="presentation">
            <div class="mode-icon-box presentation">
              <svg viewBox="0 0 24 24"><path d="M21 3H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h7v2H8v2h8v-2h-2v-2h7c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 14H3V5h18v12zm-11-2l5.5-4L10 7v8z"/></svg>
            </div>
            <div class="mode-text-box">
              <span class="mode-title">Презентация HTML</span>
              <span class="mode-desc">Интерактивные слайды</span>
            </div>
          </li>

          <li class="mode-opt" data-mode="onepage">
            <div class="mode-icon-box onepage">
              <svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zM7 7h10v2H7zm0 4h10v2H7zm0 4h7v2H7z"/></svg>
            </div>
            <div class="mode-text-box">
              <span class="mode-title">Одностраничный HTML</span>
              <span class="mode-desc">Дашборд или лонгрид</span>
            </div>
          </li>

          <li class="mode-opt" data-mode="motion">
            <div class="mode-icon-box motion">
              <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/></svg>
            </div>
            <div class="mode-text-box" style="flex:1;">
              <span class="mode-title">Motion-анимация</span>
              <span class="mode-desc">Динамический видео-ролик</span>
            </div>
            <button class="mode-tune-btn" id="open-motion-settings" title="Параметры Motion">
              <svg viewBox="0 0 24 24"><path d="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"/></svg>
            </button>
          </li>

          <li class="mode-opt" data-mode="webapp">
            <div class="mode-icon-box webapp">
              <svg viewBox="0 0 24 24"><path d="M7 2v11h3v9l7-12h-4l4-8z"/></svg>
            </div>
            <div class="mode-text-box">
              <span class="mode-title">HTML-программа или игра</span>
              <span class="mode-desc">Интерактивный микро-сервис</span>
            </div>
          </li>

          <li class="mode-opt" data-mode="document">
            <div class="mode-icon-box document">
              <svg viewBox="0 0 24 24"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg>
            </div>
            <div class="mode-text-box">
              <span class="mode-title">Документ A4</span>
              <span class="mode-desc">Редактируемый печатный лист</span>
            </div>
          </li>
        </ul>
      </div>

      <button class="h-btn" id="settings-btn" title="Настройки">
        <svg viewBox="0 0 24 24"><path d="M19.14 12.94c.04-.31.06-.63.06-.94 0-.31-.02-.63-.06-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.44.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>
      </button>
    </div>
  </header>

  <div class="compress-checkbox-container" id="compress-container">
    <div class="custom-checkbox" id="compress-checkbox"></div>
    <label class="compress-checkbox-label" id="compress-label">
      <span>Сжать изображение</span>
      <span class="file-size-info" id="file-size-info"></span>
    </label>
    <span class="compression-info">50% размер, 80% качество</span>
  </div>

  <div id="chat-container">
    <div class="empty" id="empty">
      <div class="empty-hero-badge">
        <span class="empty-hero-dot"></span>
        <span id="empty-model-badge">Gemini 3.5 Flash Lite</span>
      </div>
      <div class="empty-icon" id="empty-icon"></div>
      <div class="empty-title">Чем могу помочь сегодня?</div>
      <div class="empty-text">Задайте вопрос, прикрепите изображение/PDF или выберите готовый сценарий ниже</div>
      <div class="prompt-chips" id="prompt-chips">
        <div class="prompt-chip" data-prompt="Исправь ошибки и улучши текст, сохранив смысл: ">✍️ Улучши текст</div>
        <div class="prompt-chip" data-prompt="Перепиши проще и понятнее: ">🎯 Упрости текст</div>
        <div class="prompt-chip" data-prompt="Сделай таблицу по теме: ">📊 Сделай таблицу</div>
        <div class="prompt-chip" data-prompt="Переведи на английский: ">🌐 Переведи</div>
        <div class="prompt-chip" data-prompt="Кратко перескажи основные тезисы: ">📝 Краткий пересказ</div>
        <div class="prompt-chip" data-prompt="Придумай 10 креативных идей на тему: ">💡 Придумай идеи</div>
        <div class="prompt-chip" data-prompt="Распознай и извлеки весь текст из изображения: ">🖼️ Распознай текст</div>
        <div class="prompt-chip" data-prompt="Объясни простыми словами и с примерами: ">🔍 Объясни</div>
        <div class="prompt-chip" data-prompt="Создай шаблон документа для: ">📋 Сделай шаблон</div>
        <div class="prompt-chip" data-prompt="Сравни по ключевым параметрам: ">⚖️ Сравни</div>
      </div>
    </div>
  </div>

  <div id="file-preview"></div>

  <div id="input-container">
    <input type="file" id="file-input" accept="image/*,application/pdf,video/*" hidden>
    <div class="input-dock">
      <button class="in-btn" id="upload-btn" title="Прикрепить файл">
        <svg viewBox="0 -960 960 960"><path d="M440-280h80v-160h160v-80H520v-160h-80v160H280v80h160v160Zm40 200q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z"/></svg>
      </button>
      <div class="input-capsule">
        <textarea id="message-input" placeholder="Напишите сообщение..." rows="1"></textarea>
      </div>
      <button class="in-btn" id="send-btn" title="Отправить">
        <svg id="send-icon" viewBox="0 -960 960 960"><path d="M120-160v-640l760 320-760 320Zm80-120 474-200-474-200v140l240 60-240 60v140Z"/></svg>
      </button>
    </div>
  </div>
</div>

<button class="scroll-bottom" id="scroll-bottom" title="Вниз">
  <svg viewBox="0 0 24 24"><path d="M12 16l-6-6 1.41-1.41L12 13.17l4.59-4.58L18 10z"/></svg>
</button>

<div class="notify" id="notify"></div>

<!-- Модальное окно настроек Motion -->
<div class="modal" id="motion-modal">
  <div class="modal-box">
    <div class="modal-head">
      <div class="modal-title">
        <span class="m-title-icon">
          <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/></svg>
        </span>
        Параметры Motion
      </div>
      <button class="modal-close" id="close-motion-modal" title="Закрыть">
        <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
      </button>
    </div>
    <div class="modal-body">
      <div class="set-group">
        <label class="set-label">Панель управления (Таймлайн)</label>
        <div class="motion-grid cols-3" id="motion-controls-group">
          <div class="m-card" data-val="autohide">
            <span class="m-card-badge">Хит</span>
            <div class="m-card-title">👁 Скрывать</div>
            <div class="m-card-desc">Всплывает при наведении</div>
          </div>
          <div class="m-card" data-val="visible">
            <div class="m-card-title">📌 Видна</div>
            <div class="m-card-desc">Всегда поверх анимации</div>
          </div>
          <div class="m-card" data-val="none">
            <div class="m-card-title">✕ Без плеера</div>
            <div class="m-card-desc">Только чистый ролик</div>
          </div>
        </div>
      </div>

      <div class="set-group">
        <label class="set-label">Структура контента</label>
        <div class="motion-grid cols-2" id="motion-scenes-group">
          <div class="m-card" data-val="single">
            <div class="m-card-title">1 Экран (Hero)</div>
            <div class="m-card-desc">Всё на одном экране, без смены кадров</div>
          </div>
          <div class="m-card" data-val="multi">
            <div class="m-card-title">Ролик (3–5 сцен)</div>
            <div class="m-card-desc">Последовательные сцены по таймлайну</div>
          </div>
        </div>
      </div>

      <div class="set-group">
        <label class="set-label">Цветовой стиль</label>
        <div class="motion-grid cols-2" id="motion-color-group">
          <div class="m-card" data-val="auto">
            <div class="m-card-title">🌗 Авто-тема</div>
            <div class="m-card-desc">Под текущую тему чата</div>
          </div>
          <div class="m-card" data-val="neon">
            <div class="m-card-title">⚡ Неон / Киберпанк</div>
            <div class="m-card-desc">Тёмный фон + Purple/Cyan</div>
          </div>
          <div class="m-card" data-val="minimal">
            <div class="m-card-title">⚪ Минимализм</div>
            <div class="m-card-desc">Светлый строгий стиль</div>
          </div>
          <div class="m-card" data-val="luxury">
            <div class="m-card-title">✨ Dark Gold</div>
            <div class="m-card-desc">Глубокий чёрный и золото</div>
          </div>
        </div>
      </div>

      <div class="set-group">
        <label class="set-label">Формат экрана</label>
        <div class="motion-grid cols-3" id="motion-ratio-group">
          <div class="m-card" data-val="fullscreen">
            <div class="m-card-title">Full-screen</div>
            <div class="m-card-desc">На весь экран</div>
          </div>
          <div class="m-card" data-val="16_9">
            <div class="m-card-title">16:9</div>
            <div class="m-card-desc">Широкий экран</div>
          </div>
          <div class="m-card" data-val="9_16">
            <div class="m-card-title">9:16</div>
            <div class="m-card-desc">Reels / Shorts</div>
          </div>
        </div>
      </div>

      <button class="set-btn" id="save-motion-settings">Сохранить параметры</button>
    </div>
  </div>
</div>

<!-- Модальное окно настроек -->
<div class="modal" id="settings-modal">
  <div class="modal-box">
    <div class="modal-head">
      <div class="modal-title">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;fill:var(--accent);vertical-align:middle;margin-right:6px;"><path d="M19.14 12.94c.04-.31.06-.63.06-.94 0-.31-.02-.63-.06-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.44.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>
        Настройки
      </div>
      <button class="modal-close" id="close-settings" title="Закрыть">
        <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
      </button>
    </div>
    <div class="modal-body">
      <div class="set-group">
        <label class="set-label">Модель ИИ</label>
        <select class="set-select" id="set-model"></select>
      </div>

      <div class="set-group">
        <label class="set-label">Режим подключения API</label>
        <div class="api-modes" id="api-modes"></div>
      </div>

      <div class="set-group" id="api-key-group" style="display:none;">
        <label class="set-label">API ключ</label>
        <input type="password" class="set-input" id="api-key-input" placeholder="Введите ваш ключ...">
        <a class="set-link" id="api-link" href="#" target="_blank">Получить API ключ →</a>
      </div>

      <div class="set-group">
        <label class="set-label">Цветовая тема</label>
        <div class="theme-grid" id="theme-grid">
          <div class="theme-option" data-theme="light" title="Светлая"><div class="theme-preview light"></div></div>
          <div class="theme-option" data-theme="dark" title="Тёмная"><div class="theme-preview dark"></div></div>
          <div class="theme-option" data-theme="night" title="Ночная"><div class="theme-preview night"></div></div>
          <div class="theme-option" data-theme="royalblue" title="Royal Blue"><div class="theme-preview royalblue"></div></div>
          <div class="theme-option" data-theme="imessage" title="iMessage"><div class="theme-preview imessage"></div></div>
          <div class="theme-option" data-theme="nature" title="Природа"><div class="theme-preview nature"></div></div>
          <div class="theme-option" data-theme="arctic" title="Arctic"><div class="theme-preview arctic"></div></div>
          <div class="theme-option" data-theme="sunset" title="Закат"><div class="theme-preview sunset"></div></div>
          <div class="theme-option" data-theme="neon" title="Неон"><div class="theme-preview neon"></div></div>
          <div class="theme-option" data-theme="ocean" title="Океан"><div class="theme-preview ocean"></div></div>
          <div class="theme-option" data-theme="sakura" title="Сакура"><div class="theme-preview sakura"></div></div>
        </div>
        <label class="auto-toggle" id="auto-theme-toggle" style="margin-top:12px;">
          <div class="custom-checkbox" id="auto-theme-cb"></div>
          <span>🌗 Автоматически (как в системе)</span>
        </label>
      </div>

      <div class="set-group">
        <label class="set-label">Размер шрифта</label>
        <div class="font-size-control">
          <button class="font-size-btn" id="font-decrease">−</button>
          <span class="font-size-value" id="font-size-value">15px</span>
          <button class="font-size-btn" id="font-increase">+</button>
        </div>
      </div>

      <button class="set-btn" id="save-settings">Сохранить</button>
    </div>
  </div>
</div>

<!-- Модальное окно таблицы -->
<div class="modal table-modal" id="table-modal">
  <div class="modal-box">
    <div class="modal-head">
      <div class="modal-title">📊 Результат в таблице</div>
      <div class="table-actions">
        <button id="table-copy"><svg viewBox="0 0 24 24"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg><span>Копировать</span></button>
        <button id="table-excel"><svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-9 14l-1.5-2.5L7 17H5l2.5-4L5 9h2l1.5 2.5L10 9h2l-2.5 4 2.5 4h-2zm9 0h-6v-2h6v2zm0-4h-6v-2h6v2zm0-4h-6V7h6v2z"/></svg><span>Excel</span></button>
        <button id="table-html"><svg viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg><span>Скачать</span></button>
        <button id="table-newtab"><svg viewBox="0 0 24 24"><path d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/></svg><span>Открыть</span></button>
      </div>
      <button class="modal-close" id="close-table"><svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg></button>
    </div>
    <div class="modal-body"><div id="table-content"></div></div>
  </div>
</div>

<!-- Модальное окно обрезки фото -->
<div class="modal" id="crop-modal">
  <div class="modal-box">
    <div class="modal-head">
      <div class="modal-title">✂️ Обрезать изображение</div>
      <button class="modal-close" id="close-crop"><svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg></button>
    </div>
    <div class="modal-body" style="text-align:center;">
      <p class="crop-info">Выделите область для обрезки или нажмите «Использовать всё»</p>
      <div class="crop-container" id="crop-container">
        <img id="crop-image" src="" alt="Preview">
        <div class="crop-selection" id="crop-selection"></div>
      </div>
      <div class="crop-buttons">
        <button class="crop-btn-confirm" id="crop-confirm">✓ Применить</button>
        <button class="crop-btn-cancel" id="crop-use-all">Использовать всё</button>
      </div>
    </div>
  </div>
</div>

<!-- Просмотр изображений -->
<div class="modal image-preview-modal" id="image-preview-modal">
  <button class="image-preview-close" id="close-image-preview"><svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg></button>
  <img id="image-preview-img" src="" alt="Preview">
</div>

<script>
const MODELS = [
  { id: "gemini-2.5-flash-lite", name: "Gemini 2.5 Flash Lite", api: "gemini", badge: "Gemini" },
  { id: "gemini-3.1-flash-lite", name: "Gemini 3.1 Flash Lite", api: "gemini", badge: "Gemini" },
  { id: "gemini-3.5-flash-lite", name: "Gemini 3.5 Flash Lite", api: "gemini", badge: "Gemini" },
  { id: "gemini-3.8-flash", name: "Gemini 3.8 Flash", api: "gemini", badge: "Gemini" },
  { id: "Atria-Dawn-Preview", name: "Atria Dawn Preview", api: "atria", badge: "Atria" },
 { id: "mistral-large-latest", name: "Mistral Large", api: "mistral" },
{ id: "mistral-small-latest", name: "Mistral Small", api: "mistral" },
{ id: "codestral-latest", name: "Codestral", api: "mistral" }

];

const API_MODES = {
  mapruapp: { name: 'Прокси (MapRuApp)', icon: 'server' },
  vercel: { name: 'Прокси (Vercel)', icon: 'cloud' },
  direct: { name: 'Прямой (Gemini)', icon: 'key' },
  direct_mistral: { name: 'Прямой (Mistral)', icon: 'bolt' }
};

/* Уникальные векторные логотипы для каждого семейства моделей */
const BRAND_LOGOS = {
  gemini: `<div class="brand-svg-wrap"><svg viewBox="0 0 28 28" fill="none"><defs><linearGradient id="g-star" x1="0" y1="0" x2="28" y2="28" gradientUnits="userSpaceOnUse"><stop stop-color="#1BA1E3"/><stop offset="0.5" stop-color="#9B72CB"/><stop offset="1" stop-color="#D96570"/></linearGradient></defs><path fill="url(#g-star)" d="M14 0C14 7.732 7.732 14 0 14C7.732 14 14 20.268 14 28C14 20.268 20.268 14 28 14C20.268 14 14 7.732 14 0Z"/></svg></div>`,
  atria: `<div class="brand-svg-wrap"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8" stroke="white" stroke-width="1.8" stroke-dasharray="14 6"/><path d="M12 5L14.2 9.8L19 12L14.2 14.2L12 19L9.8 14.2L5 12L9.8 9.8L12 5Z" fill="white"/></svg></div>`,
  mistral: `<div class="brand-svg-wrap"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="4" height="16" rx="1.2" fill="white"/><rect x="10" y="8" width="4" height="12" rx="1.2" fill="white" fill-opacity="0.85"/><rect x="17" y="4" width="4" height="16" rx="1.2" fill="white"/><rect x="6.5" y="6" width="4" height="5" rx="1" fill="#fde047"/><rect x="13.5" y="6" width="4" height="5" rx="1" fill="#fde047"/></svg></div>`,
  anthropic: `<div class="brand-svg-wrap"><svg viewBox="0 0 24 24" fill="none"><path d="M13.8 4L19.5 20H16.1L14.9 16.3H9.1L7.9 20H4.5L10.2 4H13.8ZM12 7.9L10.1 13.5H13.9L12 7.9Z" fill="white"/></svg></div>`,
  qwen: `<div class="brand-svg-wrap"><svg viewBox="0 0 24 24" fill="none"><path d="M12 3L19.8 7.5V16.5L12 21L4.2 16.5V7.5L12 3Z" stroke="white" stroke-width="2"/><circle cx="12" cy="12" r="3.5" fill="white"/></svg></div>`
};

const THEMES = ['light','dark','night','royalblue','imessage','nature','arctic','sunset','neon','ocean','sakura'];
const DARK_THEMES = ['dark','night','royalblue','neon','ocean'];
const FONTS = [12,13,14,15,16,17,18,19,20];

const PROXY_MAP = "https://mapruapp.ru/ai/api/v1/chat/completions";
const PROXY_VER = "https://ver-olive-delta.vercel.app";

function isCurrentThemeDark() {
  const activeTheme = autoTheme ? getSystemTheme() : theme;
  return DARK_THEMES.includes(activeTheme);
}

function getThemeInstruction() {
  return isCurrentThemeDark()
    ? 'Цветовая палитра: современная ТЁМНАЯ тема (глубокий тёмный фон #0d1117 / #121216, контрастный светлый текст #f0f6fc / #ffffff, стильные неоновые или пастельные акценты, полупрозрачные карточки с тонкими границами).'
    : 'Цветовая палитра: чистая современная СВЕТЛАЯ тема (светлый фон #f8fafc / #ffffff, контрастный тёмный текст #0f172a / #1e293b, мягкие тени карточек, чистые разделители, яркие акцентные кнопки).';
}

function getSystemPrompt(mode) {
  const themePrompt = getThemeInstruction();

  if (mode === 'motion') {
    const isMulti = motionConfig.scenes === 'multi';
    const useGsap = motionConfig.engine === 'gsap' || (motionConfig.engine === 'auto' && isMulti);

    let ratioInstruction = 'Контейнер занимает 100vw и 100vh адаптивно под экран.';
    if (motionConfig.ratio === '16_9') ratioInstruction = 'Главный блок анимации оформлен как широкоформатный кадр 16:9 (aspect-ratio: 16/9, max-width: 1200px, центрирован).';
    if (motionConfig.ratio === '9_16') ratioInstruction = 'Главный блок анимации оформлен как вертикальный кадр смартфона 9:16 (aspect-ratio: 9/16, max-height: 92vh, закругленные углы 24px, центрирован).';

    let colorInstruction = themePrompt;
    if (motionConfig.color === 'neon') colorInstruction = 'Цветовая палитра: глубокий тёмный фон (#07080f), неоновые градиенты Cyan (#00e5ff), Purple (#a855f7) и Pink (#ff2d95).';
    if (motionConfig.color === 'minimal') colorInstruction = 'Цветовая палитра: чистый белый/светло-серый фон (#f8fafc), глубокий графитовый текст (#0f172a) и мягкие тени.';
    if (motionConfig.color === 'luxury') colorInstruction = 'Цветовая палитра: тёмный премиум фон (#0d0b08), золото (#d4af37, #f6e08a) и деликатные разделители.';

    let playerInstruction = '';
    if (motionConfig.controls === 'none') {
      playerInstruction = '- НЕ добавляй никаких панелей управления и кнопок: весь экран на 100% отводится под непрерывную плавную анимацию.';
    } else {
      const isAutohide = motionConfig.controls === 'autohide';
      playerInstruction = `
- Сделай премиальную стеклянную полоску управления (Player Bar) по центру внизу:
  * Стили панели: position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.12); border-radius: 40px; padding: 6px 16px; display: flex; align-items: center; gap: 12px; z-index: 9999; box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  * Кнопки Play/Pause и Replay: минималистичные круглые иконки (28x28px, background: rgba(255,255,255,0.08), hover эффект).
  * Полоска прогресса (скраббер): тонкий слайдер (высота 4px, скругление, градиентная заливка, аккуратный круглый бегунок 12px с лёгким свечением).
  * Текстовый таймер: моноширинный счетчик времени справа (например, "00:03 / 00:15").
  ${isAutohide ? '* ВАЖНО: Изначально панель СКРЫТА (opacity: 0; transform: translateX(-50%) translateY(20px); pointer-events: none; transition: all 0.3s ease;). Добавь триггер-зону внизу экрана или появление панели при движении мыши (mouseenter/mousemove у нижнего края экрана), чтобы при наведении она плавно всплывала, а всё остальное время 100% экрана занимала только анимация.' : '* Панель всегда плавает поверх анимации.'}`;
    }

    const engineInstruction = useGsap
      ? `- Используй библиотеку GSAP: подключи <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"><\\/script>;
- Собери единый таймлайн gsap.timeline() и привяжи ползунок скраббера к timeline.progress().`
      : `- Используй современный чистый CSS3 (@keyframes) и Vanilla JS.`;

    const structureInstruction = isMulti
      ? 'Анимация состоит из 3-4 последовательных сцен с красивой кинетической сменой кадров.'
      : 'Анимация представляет собой единый выразительный экран (Hero-тизер): заголовок, карточки, метрики, без смены экранов.';

    return `Создай готовую интерактивную Motion-анимацию по теме запроса.
Верни ТОЛЬКО рабочий чистый HTML внутри одного блока \`\`\`html ... \`\`\` без вступлений и комментариев.
Требования:
- Единый автономный HTML-файл;
- ${ratioInstruction}
- ${colorInstruction}
- ${structureInstruction}
- ${engineInstruction}
- ${playerInstruction}`;
  }

  const prompts = {
    default: 'Отвечай на русском языке.',
    table: 'Отвечай ТОЛЬКО в формате Markdown таблиц. Структурируй ВСЮ информацию в таблицы.',
    presentation: `Создай готовую интерактивную HTML-презентацию со слайдами по теме запроса.
Верни ТОЛЬКО чистый рабочий HTML-код внутри одного блока \`\`\`html ... \`\`\` без вводных фраз и комментариев.
Требования:
- Единый автономный файл (HTML + CSS + JS внутри);
- ${themePrompt}
- Стильный полноэкранный интерфейс слайдов на 100vh (крупные заголовки, списки, карточки);
- Управление для планшетов, сенсорных экранов и ПК:
  * ОБЯЗАТЕЛЬНО создай на экране крупные плавающие кнопки переключения («◀ Назад» и «Вперёд ▶»), удобные для нажатия пальцем на планшете/смартфоне, и счетчик слайдов (например, по центру внизу);
  * Добавь поддержку сенсорных свайпов пальцем (влево — следующий слайд, вправо — предыдущий через touchstart/touchend);
  * Для ПК сохрани поддержку стрелок клавиатуры (Left/Right) и клавиши Пробел;
- Полная адаптивность под планшеты и плавная анимация переходов.`,

    onepage: `Создай презентацию-одностраничник на чистом HTML по теме запроса.
Верни ТОЛЬКО рабочий код внутри одного блока \`\`\`html ... \`\`\` без лишнего текста и вступлений.
Требования:
- Единый автономный файл (HTML + стили + JS внутри);
- ${themePrompt}
- Архитектура страницы выбирается АВТОМАТИЧЕСКИ по объёму:
  * Если данных немного (1-4 тезиса) — сделай единый дашборд/экран ровно на 100vh БЕЗ вертикальной прокрутки, с выразительными карточками и цифрами;
  * Если данных много — сделай вертикальный лонгрид с секциями (scroll-snap или плавная прокрутка), красивой типографикой и плавающей навигацией;
- Полная адаптивность под экран любого устройства.`,

    webapp: `Создай законченную интерактивную HTML-программу (веб-приложение) под задачу пользователя.
Верни ТОЛЬКО рабочий код внутри одного блока \`\`\`html ... \`\`\` без лишнего текста и вступлений.
Требования:
- Единый файл (HTML5 + современные CSS стили + чистый JavaScript);
- ${themePrompt}
- Современный и красивый UI (стильные формы, кнопки, тени, анимации, аккуратная типографика);
- Полная интерактивность (клики, расчеты, динамика контента, валидация полей);
- Мобильная адаптивность.`,

    document: `Оформи ответ как презентабельный документ формата А4 (договор, отчет, коммерческое предложение или статью).
Верни ТОЛЬКО рабочий код внутри блока \`\`\`html ... \`\`\` без вступлений.
Требования:
- Лист A4 размести по центру: ширина 210mm, минимальная высота 297mm, внутренние отступы 20mm, белый фон, мягкая тень (box-shadow) на нейтральном фоне страницы (#f1f5f9);
- Добавь атрибут contenteditable="true" основному контейненьо листа;
- Качественная типографика (четкие заголовки, аккуратные абзацы, списки, таблицы и колонтитулы);
- Поддержка @media print: при печати скрывать фон страницы и показывать чистый белый лист А4 без экранных отступов.`
  };

  return prompts[mode] || prompts.default;
}

const MODE_ICONS = {
  default: `<svg viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 10H6v-2h12v2zm0-3H6V7h12v2z"/></svg>`,
  table: `<svg viewBox="0 0 24 24"><path d="M3 3h18v18H3V3zm16 16V5H5v14h14zM7 7h2v2H7V7zm0 4h2v2H7v-2zm0 4h2v2H7v-2zm4-8h6v2h-6V7zm0 4h6v2h-6v-2zm0 4h6v2h-6v-2z"/></svg>`,
  presentation: `<svg viewBox="0 0 24 24"><path d="M21 3H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h7v2H8v2h8v-2h-2v-2h7c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 14H3V5h18v12zm-11-2l5.5-4L10 7v8z"/></svg>`,
  onepage: `<svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zM7 7h10v2H7zm0 4h10v2H7zm0 4h7v2H7z"/></svg>`,
  webapp: `<svg viewBox="0 0 24 24"><path d="M7 2v11h3v9l7-12h-4l4-8z"/></svg>`,
  document: `<svg viewBox="0 0 24 24"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg>`,
  motion: `<svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/></svg>`
};

let outputMode = localStorage.getItem('outputMode') || 'default';
const COMPRESS_THRESHOLD_BYTES = 1 * 1024 * 1024;

let history = [];
let pendingFiles = [];
let model = localStorage.getItem('model') || 'gemini-3.5-flash-lite';
let apiMode = localStorage.getItem('apiMode') || 'mapruapp';
let apiKey = localStorage.getItem('apiKey') || '';
let theme = localStorage.getItem('theme') || 'light';
let autoTheme = localStorage.getItem('autoTheme') === 'true';
let fontIdx = parseInt(localStorage.getItem('fontIdx'));
if (isNaN(fontIdx)) fontIdx = 3;

let compressEnabled = localStorage.getItem('compressEnabled') !== 'false';
let isLoading = false;
let lastTableHtml = '';
let lastRenderedRole = null;

let cropResolve = null;
let cropSelection = { startX:0, startY:0, endX:0, endY:0, isDrawing:false };
let imageNaturalSize = { width:0, height:0 };
let imageDisplaySize = { width:0, height:0 };

let motionConfig = JSON.parse(localStorage.getItem('motionConfig')) || {
  controls: 'autohide',
  scenes: 'single',
  color: 'auto',
  ratio: 'fullscreen',
  engine: 'auto'
};

const $ = id => document.getElementById(id);
const chat = $('chat-container');
const input = $('message-input');
const sendBtn = $('send-btn');
const sendIcon = $('send-icon');
const uploadBtn = $('upload-btn');
const fileInput = $('file-input');
const filePreview = $('file-preview');
const notify = $('notify');
const empty = $('empty');
const headerTitle = $('header-title');
const headerSub = $('header-subtitle');
const headerLogo = $('header-logo');
const modelBtn = $('model-btn');
const modelOpts = $('model-opts');
const modeBtn = $('output-mode-btn');
const modeOpts = $('output-mode-opts');
const settingsModal = $('settings-modal');
const tableModal = $('table-modal');
const cropModal = $('crop-modal');
const compressContainer = $('compress-container');
const compressCheckbox = $('compress-checkbox');
const fileSizeInfo = $('file-size-info');
const scrollBottomBtn = $('scroll-bottom');

const SEND_SVG = '<path d="M120-160v-640l760 320-760 320Zm80-120 474-200-474-200v140l240 60-240 60v140Z"/>';
const STOP_SVG = '<path d="M320-320h320v-320H320v320ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z"/>';

const ICONS = {
  server: `<svg viewBox="0 0 24 24"><path d="M20 13H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1v-6c0-.55-.45-1-1-1zM7 19c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM20 3H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1V4c0-.55-.45-1-1-1zM7 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/></svg>`,
  cloud: `<svg viewBox="0 0 24 24"><path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z"/></svg>`,
  key: `<svg viewBox="0 0 24 24"><path d="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/></svg>`,
  bolt: `<svg viewBox="0 0 24 24"><path d="M11 21h-1l1-7H7.5c-.58 0-.57-.32-.38-.66.19-.34.05-.08.07-.12C8.48 10.94 10.42 7.54 13 3h1l-1 7h3.5c.49 0 .56.33.47.51l-.07.15C12.96 17.55 11 21 11 21z"/></svg>`
};

function init() {
  marked.setOptions({ gfm: true, breaks: true });
  if (autoTheme) applyTheme(getSystemTheme(), true);
  else applyTheme(theme);
  applyFont(FONTS[fontIdx]);
  renderModels();
  renderApiModes();
  updateUI();
  setupEvents();
  updateCompressCheckboxUI();
  $('auto-theme-cb').classList.toggle('checked', autoTheme);
  input.focus();
}

function getSystemTheme() {
  return (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
}

function setupEvents() {
  sendBtn.onclick = send;
  input.onkeydown = e => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      send();
    }
  };
  input.oninput = autoResize;

  uploadBtn.onclick = () => fileInput.click();
  fileInput.onchange = handleFile;
  input.onpaste = handlePaste;

  $('header-left').onclick = resetChat;
  $('settings-btn').onclick = () => openModal(settingsModal);
  $('table-excel').onclick = exportTableToExcel;

  modelBtn.onclick = e => {
    e.stopPropagation();
    modeOpts?.classList.remove('show');
    modelOpts.classList.toggle('show');
  };

  const motionModal = $('motion-modal');
  const openMotionBtn = $('open-motion-settings');
  if (openMotionBtn) {
    openMotionBtn.onclick = (e) => {
      e.stopPropagation();
      outputMode = 'motion';
      localStorage.setItem('outputMode', outputMode);
      updateOutputModeUI();
      modeOpts?.classList.remove('show');
      syncMotionModalUI();
      openModal(motionModal);
    };
  }

  $('close-motion-modal').onclick = () => closeModal(motionModal);
  motionModal.onclick = (e) => { if (e.target === motionModal) closeModal(motionModal); };

  function setupCardGroup(groupId, key) {
    const group = $(groupId);
    if (!group) return;
    group.querySelectorAll('.m-card').forEach(card => {
      card.onclick = () => {
        group.querySelectorAll('.m-card').forEach(c => c.classList.remove('selected'));
        card.classList.add('selected');
        motionConfig[key] = card.dataset.val;
      };
    });
  }

  setupCardGroup('motion-controls-group', 'controls');
  setupCardGroup('motion-scenes-group', 'scenes');
  setupCardGroup('motion-color-group', 'color');
  setupCardGroup('motion-ratio-group', 'ratio');

  function syncMotionModalUI() {
    const syncGroup = (groupId, val) => {
      const group = $(groupId);
      if (!group) return;
      group.querySelectorAll('.m-card').forEach(card => {
        card.classList.toggle('selected', card.dataset.val === val);
      });
    };
    syncGroup('motion-controls-group', motionConfig.controls);
    syncGroup('motion-scenes-group', motionConfig.scenes);
    syncGroup('motion-color-group', motionConfig.color);
    syncGroup('motion-ratio-group', motionConfig.ratio);
  }

  $('save-motion-settings').onclick = () => {
    localStorage.setItem('motionConfig', JSON.stringify(motionConfig));
    closeModal(motionModal);
    showNotify('Параметры Motion сохранены');
  };

  if (modeBtn && modeOpts) {
    modeBtn.onclick = e => {
      e.stopPropagation();
      modelOpts?.classList.remove('show');
      modeOpts.classList.toggle('show');
    };

    modeOpts.querySelectorAll('.mode-opt').forEach(opt => {
      opt.onclick = e => {
        e.stopPropagation();
        outputMode = opt.dataset.mode;
        localStorage.setItem('outputMode', outputMode);
        updateOutputModeUI();
        modeOpts.classList.remove('show');
        const title = opt.querySelector('.mode-title')?.textContent.trim() || '';
        showNotify(`Режим: ${title}`);
      };
    });
  }

  document.addEventListener('click', () => {
    modelOpts?.classList.remove('show');
    modeOpts?.classList.remove('show');
  });

  $('close-settings').onclick = () => closeModal(settingsModal);
  settingsModal.onclick = e => { if (e.target === settingsModal) closeModal(settingsModal); };
  $('save-settings').onclick = saveSettings;
  $('set-model').onchange = e => { model = e.target.value; updateUI(); };

  $('close-image-preview').onclick = () => closeModal($('image-preview-modal'));
  $('image-preview-modal').onclick = e => { if (e.target === $('image-preview-modal')) closeModal($('image-preview-modal')); };

  document.querySelectorAll('.theme-option').forEach(opt => {
    opt.onclick = () => {
      autoTheme = false;
      $('auto-theme-cb').classList.remove('checked');
      applyTheme(opt.dataset.theme);
    };
  });

  $('auto-theme-toggle').onclick = () => {
    autoTheme = !autoTheme;
    $('auto-theme-cb').classList.toggle('checked', autoTheme);
    localStorage.setItem('autoTheme', autoTheme);
    if (autoTheme) applyTheme(getSystemTheme(), true);
  };

  if (window.matchMedia) {
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
      if (autoTheme) applyTheme(e.matches ? 'dark' : 'light', true);
    });
  }

  document.querySelectorAll('.prompt-chip').forEach(chip => {
    chip.onclick = () => {
      input.value = chip.dataset.prompt;
      input.focus();
      autoResize.call(input);
    };
  });

  $('font-decrease').onclick = () => {
    if (fontIdx > 0) {
      fontIdx--;
      applyFont(FONTS[fontIdx]);
      localStorage.setItem('fontIdx', fontIdx);
    }
  };
  $('font-increase').onclick = () => {
    if (fontIdx < FONTS.length - 1) {
      fontIdx++;
      applyFont(FONTS[fontIdx]);
      localStorage.setItem('fontIdx', fontIdx);
    }
  };

  $('close-table').onclick = () => closeModal(tableModal);
  tableModal.onclick = e => { if (e.target === tableModal) closeModal(tableModal); };
  $('table-copy').onclick = copyTable;
  $('table-html').onclick = downloadTableHtml;
  $('table-newtab').onclick = openTableNewTab;

  compressCheckbox.onclick = toggleCompressCheckbox;
  $('compress-label').onclick = toggleCompressCheckbox;

  $('close-crop').onclick = () => { if (cropResolve) cropResolve(null); closeModal(cropModal); };
  cropModal.onclick = e => { if (e.target === cropModal) { if (cropResolve) cropResolve(null); closeModal(cropModal); } };

  chat.onscroll = () => {
    const nearBottom = chat.scrollHeight - chat.scrollTop - chat.clientHeight < 120;
    scrollBottomBtn.classList.toggle('visible', !nearBottom && history.length > 0);
  };
  scrollBottomBtn.onclick = () => { chat.scrollTop = chat.scrollHeight; };

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      closeModal(settingsModal);
      closeModal(tableModal);
      closeModal(motionModal);
      closeModal($('image-preview-modal'));
      if (cropResolve) cropResolve(null);
      closeModal(cropModal);
      modelOpts?.classList.remove('show');
      modeOpts?.classList.remove('show');
    }
  });

  updateOutputModeUI();
}

async function stitchImagesVertically(base64Images) {
  const images = await Promise.all(base64Images.map(src => new Promise((resolve, reject) => {
    const img = new Image(); img.onload = () => resolve(img); img.onerror = reject; img.src = src;
  })));
  const maxWidth = Math.max(...images.map(i => i.width));
  const totalHeight = images.reduce((s, i) => s + i.height, 0);
  const canvas = document.createElement('canvas');
  canvas.width = maxWidth; canvas.height = totalHeight;
  const ctx = canvas.getContext('2d');
  ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, maxWidth, totalHeight);
  let y = 0;
  for (const img of images) { ctx.drawImage(img, Math.round((maxWidth - img.width)/2), y); y += img.height; }
  return canvas.toDataURL('image/jpeg', 0.92);
}

async function exportTableToExcel() {
  const table = document.querySelector('#table-content table');
  if (!table) {
    showNotify('Таблица не найдена', true);
    return;
  }

  if (!window.XLSX) {
    showNotify('Загрузка модуля Excel...', false);
    try {
      await new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = 'webfonts/xlsx.full.min.js';
        script.onload = resolve;
        script.onerror = reject;
        document.head.appendChild(script);
      });
    } catch (err) {
      showNotify('Не удалось загрузить библиотеку Excel', true);
      return;
    }
  }

  try {
    const wb = XLSX.utils.table_to_book(table, { sheet: "Данные" });
    XLSX.writeFile(wb, `table_${Date.now()}.xlsx`);
    showNotify('Файл Excel успешно скачан!');
  } catch (err) {
    console.error(err);
    showNotify('Ошибка при создании файла Excel', true);
  }
}

function toggleCompressCheckbox() { compressEnabled = !compressEnabled; localStorage.setItem('compressEnabled', compressEnabled); updateCompressCheckboxUI(); }
function updateCompressCheckboxUI() { compressCheckbox.classList.toggle('checked', compressEnabled); }
function updateCompressVisibility() {
  const imageFiles = pendingFiles.filter(f => f.type.startsWith('image/'));
  const totalSize = imageFiles.reduce((s, f) => s + f.size, 0);
  if (imageFiles.length > 0 && totalSize >= COMPRESS_THRESHOLD_BYTES) {
    fileSizeInfo.textContent = `(${(totalSize/(1024*1024)).toFixed(2)} MB)`;
    compressContainer.classList.add('visible');
  } else compressContainer.classList.remove('visible');
}
window.removeFile = function(idx) { pendingFiles.splice(idx, 1); updateFilePreview(); updateCompressVisibility(); };

async function compressImage(base64Data, quality=0.8, scale=0.5) {
  return new Promise((resolve, reject) => {
    const img = new Image();
    img.onload = () => {
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(img.width*scale);
      canvas.height = Math.round(img.height*scale);
      const ctx = canvas.getContext('2d');
      ctx.imageSmoothingEnabled = true; ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      resolve(canvas.toDataURL('image/jpeg', quality));
    };
    img.onerror = () => reject(new Error('Failed to load image'));
    img.src = base64Data;
  });
}
async function compressToTargetSize(base64Data, targetBytes=COMPRESS_THRESHOLD_BYTES, maxAttempts=5) {
  let currentData = base64Data, attempt = 0;
  while (attempt < maxAttempts) {
    const content = currentData.split(',')[1] || currentData;
    const sizeBytes = Math.round((content.length * 3)/4);
    if (sizeBytes < targetBytes) return currentData;
    attempt++;
    showNotify(`Сжатие: попытка ${attempt}...`, false);
    currentData = await compressImage(currentData, 0.8, 0.5);
  }
  return currentData;
}

function showCropModal(file, currentIndex=1, totalCount=1) {
  return new Promise((resolve) => {
    cropResolve = resolve;
    const imgEl = $('crop-image'), container = $('crop-container'), selection = $('crop-selection');
    const modalTitle = cropModal.querySelector('.modal-title');
    modalTitle.textContent = totalCount > 1 ? `✂️ Обрезать изображение ${currentIndex}/${totalCount}` : '✂️ Обрезать изображение';
    selection.style.display = 'none';
    cropSelection = { startX:0, startY:0, endX:0, endY:0, isDrawing:false };

    const reader = new FileReader();
    reader.onload = (e) => {
      imgEl.src = e.target.result;
      openModal(cropModal);
      imgEl.onload = () => {
        imageNaturalSize = { width: imgEl.naturalWidth, height: imgEl.naturalHeight };
        requestAnimationFrame(() => { imageDisplaySize = { width: imgEl.offsetWidth, height: imgEl.offsetHeight }; });
      };
    };
    reader.readAsDataURL(file);

    function getPos(e) {
      const rect = container.getBoundingClientRect();
      const cx = e.touches ? e.touches[0].clientX : e.clientX;
      const cy = e.touches ? e.touches[0].clientY : e.clientY;
      return { x: Math.max(0, Math.min(cx-rect.left, imageDisplaySize.width)), y: Math.max(0, Math.min(cy-rect.top, imageDisplaySize.height)) };
    }
    function updateRect() {
      const x = Math.min(cropSelection.startX, cropSelection.endX);
      const y = Math.min(cropSelection.startY, cropSelection.endY);
      selection.style.left = x+'px'; selection.style.top = y+'px';
      selection.style.width = Math.abs(cropSelection.endX-cropSelection.startX)+'px';
      selection.style.height = Math.abs(cropSelection.endY-cropSelection.startY)+'px';
    }
    const onStart = e => { e.preventDefault(); cropSelection.isDrawing = true; const p = getPos(e); cropSelection.startX = cropSelection.endX = p.x; cropSelection.startY = cropSelection.endY = p.y; selection.style.display = 'block'; selection.style.width = '0'; selection.style.height = '0'; };
    const onMove = e => { if (!cropSelection.isDrawing) return; e.preventDefault(); const p = getPos(e); cropSelection.endX = p.x; cropSelection.endY = p.y; updateRect(); };
    const onEnd = () => { cropSelection.isDrawing = false; const w = Math.abs(cropSelection.endX-cropSelection.startX), h = Math.abs(cropSelection.endY-cropSelection.startY); if (w < 10 || h < 10) selection.style.display = 'none'; };

    container.onmousedown = onStart; container.ontouchstart = onStart;
    container.onmousemove = onMove; container.ontouchmove = onMove;
    window.onmouseup = onEnd; window.ontouchend = onEnd;

    $('crop-confirm').onclick = () => {
      const w = Math.abs(cropSelection.endX-cropSelection.startX), h = Math.abs(cropSelection.endY-cropSelection.startY);
      if (w < 10 || h < 10 || selection.style.display === 'none') { toBase64(file).then(data => { cleanup(); resolve({ cropped:false, data }); }); return; }
      const canvas = document.createElement('canvas'), ctx = canvas.getContext('2d');
      const scaleX = imageNaturalSize.width/imageDisplaySize.width, scaleY = imageNaturalSize.height/imageDisplaySize.height;
      const sx = Math.min(cropSelection.startX, cropSelection.endX)*scaleX, sy = Math.min(cropSelection.startY, cropSelection.endY)*scaleY;
      const sw = w*scaleX, sh = h*scaleY;
      canvas.width = sw; canvas.height = sh;
      ctx.drawImage(imgEl, sx, sy, sw, sh, 0, 0, sw, sh);
      cleanup(); resolve({ cropped:true, data: canvas.toDataURL(file.type || 'image/png') });
    };
    $('crop-use-all').onclick = () => { toBase64(file).then(data => { cleanup(); resolve({ cropped:false, data }); }); };

    function cleanup() {
      closeModal(cropModal);
      container.onmousedown = container.ontouchstart = container.onmousemove = container.ontouchmove = null;
      window.onmouseup = window.ontouchend = null;
      cropResolve = null;
    }
  });
}

function applyTheme(t, fromAuto=false) {
  document.body.className = '';
  if (t !== 'light') document.body.classList.add(`${t}-theme`);
  theme = t;
  if (!fromAuto) localStorage.setItem('theme', t);
  document.querySelectorAll('.theme-option').forEach(opt => opt.classList.toggle('selected', !autoTheme && opt.dataset.theme === t));
  const isDark = DARK_THEMES.includes(t);
  $('hljs-theme').href = isDark
    ? 'webfonts/atom-one-dark.min.css'
    : 'webfonts/github.min.css';
}
function applyFont(size) { document.documentElement.style.setProperty('--base-font-size', size+'px'); $('font-size-value').textContent = size+'px'; }

function getBrandKey(apiType) {
  if (apiType === 'atria') return 'atria';
  if (apiType === 'mistral') return 'mistral';
  if (apiType === 'anthropic' || apiType === 'omniroute') return 'anthropic';
  if (apiType === 'qwen' || apiType === 'openrouter' || apiType === 'notion') return 'qwen';
  return 'gemini';
}

function updateUI() {
  const m = MODELS.find(x => x.id === model) || MODELS[2];
  const brand = getBrandKey(m.api);

  document.body.setAttribute('data-model-brand', brand);
  headerTitle.textContent = m.name;
  $('model-name').textContent = m.name;
  $('model-pill').textContent = m.badge || brand.toUpperCase();

  headerLogo.className = `header-logo ${brand}`;
  headerLogo.innerHTML = BRAND_LOGOS[brand] || BRAND_LOGOS.gemini;

  const emptyIcon = $('empty-icon');
  if (emptyIcon) {
    emptyIcon.className = `empty-icon ${brand}`;
    emptyIcon.innerHTML = BRAND_LOGOS[brand] || BRAND_LOGOS.gemini;
  }
  const emptyBadge = $('empty-model-badge');
  if (emptyBadge) emptyBadge.textContent = m.name;

  modelOpts.querySelectorAll('.sel-opt').forEach(o => o.classList.toggle('selected', o.dataset.id === model));
  $('set-model').value = model;
  updateApiModesVisibility(m.api);
  updateOutputModeUI();
  updateContextSize();
}

function updateOutputModeUI() {
  const modeBtn = $('output-mode-btn');
  const iconSpan = $('output-mode-icon');

  if (iconSpan) {
    iconSpan.innerHTML = MODE_ICONS[outputMode] || MODE_ICONS.default;
  }

  if (modeBtn) {
    const allModes = ['mode-default', 'mode-table', 'mode-presentation', 'mode-webapp', 'mode-document', 'mode-onepage', 'mode-motion'];
    modeBtn.classList.remove(...allModes);
    modeBtn.classList.add(`mode-${outputMode}`);
  }

  const opts = document.querySelectorAll('#output-mode-opts .mode-opt');
  opts.forEach(opt => {
    opt.classList.toggle('selected', opt.dataset.mode === outputMode);
  });
}

function updateContextSize() {
  if (history.length === 0) {
    headerSub.textContent = 'Готов к диалогу';
    return;
  }

  let totalTokens = 0;
  let totalBytes = 0;

  history.forEach(m => {
    if (m.text) {
      totalBytes += new TextEncoder().encode(m.text).length;
      const cyrillicChars = (m.text.match(/[а-яёА-ЯЁ]/g) || []).length;
      const otherChars = m.text.length - cyrillicChars;
      totalTokens += Math.round(cyrillicChars / 2 + otherChars / 3.5);
    }

    if (m.file?.base64) {
      const fileBytes = Math.round((m.file.base64.length * 3) / 4);
      totalBytes += fileBytes;
      totalTokens += 258;
    }
  });

  const kb = (totalBytes / 1024).toFixed(1);
  headerSub.textContent = `~${totalTokens.toLocaleString()} токенов · ${kb} КБ`;
}

function updateApiModesVisibility(apiType) {
  const modes = $('api-modes');
  if (apiType === 'notion') {
    modes.querySelectorAll('.api-mode').forEach(m => m.style.display = 'none');
    $('api-key-group').style.display = 'none';
    return;
  }
  modes.querySelectorAll('.api-mode').forEach(m => {
    const mode = m.dataset.mode;
    if (apiType === 'gemini') m.style.display = mode === 'direct_mistral' ? 'none' : 'flex';
    else if (apiType === 'mistral') m.style.display = (mode === 'direct' || mode === 'vercel') ? 'none' : 'flex';
    else m.style.display = mode === 'mapruapp' ? 'flex' : 'none';
  });
  const currentEl = modes.querySelector(`[data-mode="${apiMode}"]`);
  if (currentEl && currentEl.style.display === 'none') {
    apiMode = 'mapruapp';
    modes.querySelectorAll('.api-mode').forEach(m => m.classList.toggle('selected', m.dataset.mode === apiMode));
  }
  const needsKey = (apiMode === 'direct' || apiMode === 'direct_mistral');
  $('api-key-group').style.display = needsKey ? 'block' : 'none';
  $('api-link').href = apiMode === 'direct' ? 'https://aistudio.google.com/app/apikey' : 'https://console.mistral.ai/api-keys/';
}

function renderModels() {
  modelOpts.innerHTML = MODELS.map(m => {
    const brand = getBrandKey(m.api);
    return `<li class="sel-opt ${m.id === model ? 'selected':''}" data-id="${m.id}">
      <span>${m.name}</span>
      <span class="sel-opt-badge ${brand}">${m.badge || brand}</span>
    </li>`;
  }).join('');
  modelOpts.querySelectorAll('.sel-opt').forEach(o => {
    o.onclick = e => {
      e.stopPropagation();
      model = o.dataset.id;
      localStorage.setItem('model', model);
      modelOpts.classList.remove('show');
      updateUI();
      showNotify(`Модель: ${MODELS.find(x => x.id === model)?.name}`);
    };
  });
  $('set-model').innerHTML = MODELS.map(m => `<option value="${m.id}">${m.name}</option>`).join('');
  $('set-model').value = model;
}

function renderApiModes() {
  const modes = $('api-modes');
  modes.innerHTML = Object.entries(API_MODES).map(([key, val]) => `<div class="api-mode ${key === apiMode ? 'selected':''}" data-mode="${key}">${ICONS[val.icon]}<span>${val.name}</span></div>`).join('');
  modes.querySelectorAll('.api-mode').forEach(m => {
    m.onclick = () => { apiMode = m.dataset.mode; modes.querySelectorAll('.api-mode').forEach(x => x.classList.toggle('selected', x.dataset.mode === apiMode)); updateApiModesVisibility(MODELS.find(x => x.id === model)?.api || 'gemini'); };
  });
  $('api-key-input').value = apiKey;
}

function saveSettings() {
  model = $('set-model').value;
  apiKey = $('api-key-input').value.trim();
  localStorage.setItem('model', model);
  localStorage.setItem('apiMode', apiMode);
  localStorage.setItem('apiKey', apiKey);
  closeModal(settingsModal);
  updateUI();
  showNotify('Настройки сохранены');
}

function handleFile() {
  const file = fileInput.files?.[0];
  if (!file) return;
  const allowed = ['image/jpeg','image/png','image/gif','image/webp','application/pdf','video/mp4','video/webm','video/quicktime'];
  if (!allowed.includes(file.type)) { showNotify('Формат не поддерживается', true); return; }
  const limit = file.type.startsWith('video/') ? 50*1024*1024 : 20*1024*1024;
  if (file.size > limit) { showNotify(`Файл слишком большой (>${limit/1024/1024}MB)`, true); return; }
  if (file.type.startsWith('image/') || file.type.startsWith('video/')) {
    if (pendingFiles.length >= 5) { showNotify('Максимум 5 файлов', true); return; }
    pendingFiles.push(file);
  } else pendingFiles = [file];
  updateFilePreview(); updateCompressVisibility(); fileInput.value = '';
}

function handlePaste(e) {
  const items = e.clipboardData?.items;
  if (!items) return;
  for (const item of items) {
    if (item.type.startsWith('image/')) {
      e.preventDefault();
      if (pendingFiles.length >= 5) { showNotify('Максимум 5 изображений', true); return; }
      const blob = item.getAsFile();
      pendingFiles.push(new File([blob], `image-${Date.now()}.png`, { type: blob.type }));
      updateFilePreview(); updateCompressVisibility();
      showNotify(`Изображение ${pendingFiles.length}/5 добавлено`);
      break;
    }
  }
}

function updateFilePreview() {
  if (pendingFiles.length === 0) { filePreview.innerHTML = ''; filePreview.classList.remove('visible'); uploadBtn.classList.remove('has-file'); return; }
  uploadBtn.classList.add('has-file');
  filePreview.classList.add('visible');
  filePreview.innerHTML = pendingFiles.map((file, idx) => {
    const isImg = file.type.startsWith('image/'), isVideo = file.type.startsWith('video/');
    let preview;
    if (isImg) preview = `<img src="${URL.createObjectURL(file)}" alt="">`;
    else if (isVideo) preview = `<video src="${URL.createObjectURL(file)}"></video>`;
    else preview = `<svg viewBox="0 -960 960 960"><path d="M320-240h320v-80H320v80Zm0-160h320v-80H320v80ZM240-80q-33 0-56.5-23.5T160-160v-640q0-33 23.5-56.5T240-880h320l240 240v480q0 33-23.5 56.5T720-80H240Z"/></svg>`;
    const label = (isImg || isVideo) ? `#${idx+1}` : file.name;
    return `<div class="file-chip">${preview}<span style="max-width:90px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${label}</span><span class="file-chip-remove" onclick="removeFile(${idx})"><svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg></span></div>`;
  }).join('');
}

window.clearFile = function() { pendingFiles = []; updateFilePreview(); compressContainer.classList.remove('visible'); };

function getAvatarHtml(role, apiType) {
  if (role === 'user') return '<div class="msg-avatar user-avatar">Я</div>';
  const brand = getBrandKey(apiType);
  return `<div class="msg-avatar ${brand}">${BRAND_LOGOS[brand] || BRAND_LOGOS.gemini}</div>`;
}

function addMessage(role, text, mediaUrl=null, mediaType=null, duration=null) {
  empty.style.display = 'none';
  const m = MODELS.find(x => x.id === model) || MODELS[2];
  const div = document.createElement('div');
  const grouped = lastRenderedRole === role;
  div.className = `message ${role}${grouped ? ' grouped' : ''}`;
  lastRenderedRole = role;

  let content = '';
  if (mediaUrl) {
    content += (mediaType && mediaType.startsWith('video/'))
      ? `<video src="${mediaUrl}" class="msg-video" controls></video>`
      : `<img src="${mediaUrl}" class="msg-image" data-full="${mediaUrl}" onclick="openImagePreview(this.dataset.full)">`;
  }
  content += formatText(text);

  let timeStr = new Date().toLocaleTimeString('ru-RU', { hour:'2-digit', minute:'2-digit' });
  if (duration !== null) timeStr += ` · ${duration} сек`;

  const modelBadgeHtml = role === 'bot' ? `<span class="msg-model-tag">${m.name}</span><span>·</span>` : '';

  const copyIcon = '<svg viewBox="0 0 24 24"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg>';
  const checkIcon = '<svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>';

  div.innerHTML = `${getAvatarHtml(role, m?.api)}<div class="msg-bubble"><button class="msg-copy" title="Копировать">${copyIcon}</button><div class="msg-content">${content}</div><div class="msg-meta">${modelBadgeHtml}<span>${timeStr}</span></div></div>`;

  const copyBtn = div.querySelector('.msg-copy');
  copyBtn.onclick = () => {
    navigator.clipboard.writeText(text).then(() => {
      copyBtn.classList.add('copied');
      copyBtn.innerHTML = checkIcon;
      setTimeout(() => { copyBtn.classList.remove('copied'); copyBtn.innerHTML = copyIcon; }, 1500);
    });
  };

  chat.appendChild(div);
  chat.scrollTop = chat.scrollHeight;
  div.querySelectorAll('pre code').forEach(b => hljs.highlightElement(b));
  updateContextSize();
}

window.openImagePreview = function(dataUrl) { $('image-preview-img').src = dataUrl; openModal($('image-preview-modal')); };

function formatText(text) {
  if (!text) return '';
  text = text.replace(/```(\w*)\n?([\s\S]*?)```/g, (_, lang, code) => {
    const l = lang || 'plaintext';
    return `<pre><div class="code-header" data-lang="${l}"><div class="code-lang-wrap"><div class="code-dots"><span></span><span></span><span></span></div><span class="code-lang">${l}</span></div><div class="code-actions"><button class="code-btn" onclick="runCode(this)">▶ Запустить</button><button class="code-btn" onclick="downloadCode(this)">⬇ Скачать</button><button class="code-btn" onclick="copyCode(this)">Копировать</button></div></div><code class="language-${l}">${escapeHtml(code.trim())}</code></pre>`;
  });
  return marked.parse(text);
}

function escapeHtml(t) { const d = document.createElement('div'); d.textContent = t; return d.innerHTML; }

const CODE_EXT_MAP = {
  html: 'html', htm: 'html', js: 'js', javascript: 'js',
  ts: 'ts', typescript: 'ts', py: 'py', python: 'py',
  css: 'css', json: 'json', xml: 'xml', svg: 'svg',
  sh: 'sh', bash: 'sh', sql: 'sql', md: 'md', markdown: 'md',
  php: 'php', java: 'java', cpp: 'cpp', 'c++': 'cpp',
  c: 'c', cs: 'cs', csharp: 'cs', rb: 'rb', go: 'go', rs: 'rs'
};

window.runCode = function(btn) {
  const pre = btn.closest('pre');
  const code = pre.querySelector('code').textContent;
  const lang = (pre.querySelector('.code-header').dataset.lang || '').toLowerCase().trim();
  const isHtml = lang === 'html' || lang === 'htm';

  const blob = new Blob([code], { type: isHtml ? 'text/html;charset=utf-8' : 'text/plain;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  window.open(url, '_blank');
  setTimeout(() => URL.revokeObjectURL(url), 10000);
};

window.downloadCode = function(btn) {
  const pre = btn.closest('pre');
  const code = pre.querySelector('code').textContent;
  const lang = (pre.querySelector('.code-header').dataset.lang || '').toLowerCase().trim();

  const ext = CODE_EXT_MAP[lang] || (/^[a-z0-9]+$/i.test(lang) ? lang : 'txt');
  const mime = ext === 'html' ? 'text/html' : (ext === 'json' ? 'application/json' : 'text/plain');

  const blob = new Blob([code], { type: `${mime};charset=utf-8` });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `code_${Date.now()}.${ext}`;
  a.click();
  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
};

window.copyCode = function(btn) {
  const code = btn.closest('pre').querySelector('code').textContent;
  navigator.clipboard.writeText(code);
  btn.textContent = '✓ Скопировано';
  setTimeout(() => btn.textContent = 'Копировать', 1500);
};

function showTyping() {
  headerLogo.classList.add('loading');
  const m = MODELS.find(x => x.id === model) || MODELS[2];
  const typingAvatar = getAvatarHtml('bot', m?.api).replace('msg-avatar ', 'msg-avatar thinking ');
  const div = document.createElement('div');
  div.className = 'typing'; div.id = 'typing';
  div.innerHTML = `${typingAvatar}<div class="typing-bubble"><div class="typing-bars"><div class="typing-bar"></div><div class="typing-bar"></div><div class="typing-bar"></div><div class="typing-bar"></div></div><span class="typing-text">${m.name} думает...</span></div>`;
  chat.appendChild(div);
  chat.scrollTop = chat.scrollHeight;
}
function hideTyping() { $('typing')?.remove(); headerLogo.classList.remove('loading'); }

function setLoadingState(loading) {
  isLoading = loading;
  sendBtn.disabled = loading;
  sendIcon.innerHTML = loading ? STOP_SVG : SEND_SVG;
}

function makeDocumentEditable(html) {
  const toolbarHtml = `
<style id="a4-edit-style">
  @media screen {
    body { padding-top: 52px !important; }
    .a4-edit-bar {
      position: fixed; top: 0; left: 0; right: 0; height: 46px;
      background: #1e293b; color: #f8fafc; display: flex; align-items: center;
      justify-content: space-between; padding: 0 20px; z-index: 999999;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-size: 13px; box-shadow: 0 2px 12px rgba(0,0,0,0.15);
    }
    .a4-edit-info { display: flex; align-items: center; gap: 8px; font-weight: 500; }
    .a4-edit-btns { display: flex; gap: 8px; }
    .a4-btn {
      background: #3b82f6; color: white; border: none; padding: 6px 14px;
      border-radius: 8px; cursor: pointer; font-size: 12px; font-weight: 600;
      transition: all 0.2s ease;
    }
    .a4-btn:hover { opacity: 0.9; transform: translateY(-1px); }
    .a4-btn.secondary { background: #475569; }
    .a4-btn.docx-btn { background: #2563eb; }
    [contenteditable="true"] { outline: none; }
    [contenteditable="true"]:focus { outline: 1px dashed rgba(59, 130, 246, 0.5); }
  }
  @media print {
    .a4-edit-bar { display: none !important; }
    body { padding-top: 0 !important; }
  }
</style>
<div class="a4-edit-bar">
  <div class="a4-edit-info">
    <span>✏️ <b>Редактирование включено:</b> кликните по любому тексту, чтобы изменить его</span>
  </div>
  <div class="a4-edit-btns">
    <button class="a4-btn docx-btn" onclick="downloadEditedDocx(this)">📄 Docx</button>
    <button class="a4-btn secondary" onclick="downloadEditedDoc()">💾 Скачать HTML</button>
    <button class="a4-btn" onclick="window.print()">🖨️ Печать / PDF</button>
  </div>
</div>
<script id="a4-edit-script">
  (function() {
    const page = document.querySelector('.page, .sheet, .document, .a4-page, .container, main') || document.body;
    if (page) page.setAttribute('contenteditable', 'true');
  })();

  function getCleanHtmlContent() {
    const clone = document.documentElement.cloneNode(true);
    clone.querySelector('.a4-edit-bar')?.remove();
    clone.querySelector('#a4-edit-style')?.remove();
    clone.querySelector('#a4-edit-script')?.remove();
    return '<!DOCTYPE html>\\n' + clone.outerHTML;
  }

  function downloadEditedDoc() {
    const cleanHtml = getCleanHtmlContent();
    const blob = new Blob([cleanHtml], { type: 'text/html;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'document_' + Date.now() + '.html';
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  }

  async function downloadEditedDocx(btn) {
    const origText = btn.textContent;
    btn.textContent = '⏳ Экспорт...';
    btn.disabled = true;

    try {
      if (!window.htmlDocx) {
        await new Promise((resolve, reject) => {
          const script = document.createElement('script');
          script.src = 'https://cdn.jsdelivr.net/npm/html-docx-js@0.3.1/dist/html-docx.min.js';
          script.onload = resolve;
          script.onerror = () => reject(new Error('Не удалось загрузить библиотеку docx'));
          document.head.appendChild(script);
        });
      }

      const cleanHtml = getCleanHtmlContent();
      const converted = window.htmlDocx.asBlob(cleanHtml, {
        orientation: 'portrait',
        margins: { top: 1134, right: 1134, bottom: 1134, left: 1134 }
      });

      const a = document.createElement('a');
      a.href = URL.createObjectURL(converted);
      a.download = 'document_' + Date.now() + '.docx';
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    } catch (err) {
      console.error(err);
      alert('Ошибка при генерации DOCX: ' + err.message);
    } finally {
      btn.textContent = origText;
      btn.disabled = false;
    }
  }
<\/script>
`;

  if (html.includes('</body>')) {
    return html.replace('</body>', toolbarHtml + '</body>');
  }
  return html + toolbarHtml;
}

async function send() {
  const text = input.value.trim();
  const files = [...pendingFiles];
  if (!text && files.length === 0) return;
  if (isLoading) return;

  const needsKey = (apiMode === 'direct' || apiMode === 'direct_mistral');
  if (needsKey && !apiKey) {
    openModal(settingsModal);
    showNotify('Введите API ключ', true);
    return;
  }

  setLoadingState(true);
  input.value = '';
  autoResize.call(input);
  clearFile();

  let fileData = null, displayUrl = null, displayType = null;

  if (files.length > 0) {
    try {
      const videoFile = files.find(f => f.type.startsWith('video/'));
      const imageFiles = files.filter(f => f.type.startsWith('image/'));
      const pdfFile = files.find(f => f.type === 'application/pdf');

      if (videoFile) {
        const result = await toBase64(videoFile);
        fileData = { dataUrl: result, base64: result.split(',')[1], mimeType: videoFile.type };
        displayUrl = result;
        displayType = videoFile.type;
      } else if (pdfFile) {
        const result = await toBase64(pdfFile);
        fileData = { dataUrl: result, base64: result.split(',')[1], mimeType: pdfFile.type };
      } else if (imageFiles.length > 0) {
        const processedImages = [];
        const totalCount = imageFiles.length;
        for (let i = 0; i < imageFiles.length; i++) {
          const file = imageFiles[i];
          const tempImg = new Image();
          const objectUrl = URL.createObjectURL(file);
          await new Promise((resolve, reject) => {
            tempImg.onload = resolve;
            tempImg.onerror = reject;
            tempImg.src = objectUrl;
          });
          URL.revokeObjectURL(objectUrl);

          let base64Data;
          if (tempImg.width > 800 || tempImg.height > 800) {
            const cropResult = await showCropModal(file, i + 1, totalCount);
            if (!cropResult) {
              setLoadingState(false);
              return;
            }
            base64Data = cropResult.data;
          } else {
            base64Data = await toBase64(file);
          }
          processedImages.push(base64Data);
        }

        let finalImage = processedImages.length === 1
          ? processedImages[0]
          : await stitchImagesVertically(processedImages);

        const totalSize = Math.round(((finalImage.split(',')[1] || finalImage).length * 3) / 4);
        if (totalSize >= COMPRESS_THRESHOLD_BYTES && compressEnabled) {
          finalImage = await compressToTargetSize(finalImage, COMPRESS_THRESHOLD_BYTES);
        }
        fileData = { dataUrl: finalImage, base64: finalImage.split(',')[1], mimeType: 'image/jpeg' };
        displayUrl = finalImage;
        displayType = 'image/jpeg';
      }
    } catch (e) {
      console.error(e);
      showNotify('Ошибка обработки файла', true);
      setLoadingState(false);
      return;
    }
  }

  const apiText = text || 'Проанализируй этот контент.';
  history.push({ role: 'user', text: apiText, file: fileData });

  const displayText = text || (files.length > 0 ? (displayType?.startsWith('video/') ? '📹 Видео' : `📎 ${files.length} файл(ов)`) : '');
  addMessage('user', displayText, displayUrl, displayType);

  showTyping();
  const startTime = Date.now();

  try {
    const response = await callAPI();
    const durationSec = Math.round((Date.now() - startTime) / 1000);
    hideTyping();

    if (response) {
      history.push({ role: 'bot', text: response });
      addMessage('bot', response, null, null, durationSec);
      updateContextSize();

      if (outputMode === 'table' && response.includes('|')) {
        lastTableHtml = marked.parse(response);
        $('table-content').innerHTML = lastTableHtml;
        openModal(tableModal);
      }

      if (['presentation', 'onepage', 'webapp', 'document', 'motion'].includes(outputMode)) {
        const htmlMatch = response.match(/```(?:html|htm)?\n?([\s\S]*?)```/i);
        const raw = response.trim();
        let code = htmlMatch
          ? htmlMatch[1].trim()
          : (raw.startsWith('<!DOCTYPE') || raw.startsWith('<html') ? raw : null);

        if (code) {
          if (outputMode === 'document') {
            code = makeDocumentEditable(code);
          }

          const blob = new Blob([code], { type: 'text/html;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const win = window.open(url, '_blank');
          if (win) {
            showNotify(outputMode === 'document' ? 'Документ открыт для редактирования!' : 'Запущено в новой вкладке!');
          } else {
            showNotify('Разрешите всплывающие окна для автозапуска', true);
          }
          setTimeout(() => URL.revokeObjectURL(url), 20000);
        }
      }
    }
  } catch (e) {
    hideTyping();
    addMessage('bot', `❌ Ошибка: ${e.message}`);
  }
  setLoadingState(false);
}

async function callAPI() {
  const m = MODELS.find(x => x.id === model);

  if (m.api === 'notion') {
    const formattedMessages = history.map(h => ({
      role: h.role === 'bot' ? 'assistant' : 'user',
      content: h.text
    }));

    const res = await fetch("https://aivercel.vercel.app/api/chat", {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Custom-Token': 'key-998'
      },
      body: JSON.stringify({
        messages: formattedMessages,
        model: "ambrosia-tart-high"
      })
    });

    if (!res.ok) throw new Error(`HTTP ${res.status}`);

    const reader = res.body.getReader();
    const decoder = new TextDecoder();
    let textResult = "";
    while (true) {
      const { value, done } = await reader.read();
      if (done) break;
      textResult += decoder.decode(value, { stream: true });
    }
    return textResult;
  }

  const sysPrompt = getSystemPrompt(outputMode);
  let url, body, headers = { 'Content-Type': 'application/json' };

  if (apiMode === 'mapruapp') {
    url = PROXY_MAP;
    const messages = [{ role:'system', content: sysPrompt }];
    history.forEach(h => {
      if (h.role === 'user') {
        const content = [{ type:'text', text: h.text }];
        if (h.file) content.push({ type:'image_url', image_url: { url: h.file.dataUrl } });
        messages.push({ role:'user', content });
      } else messages.push({ role:'assistant', content: h.text });
    });
    body = { model, messages };
    if (m.api !== 'qwen') body.max_tokens = 8192;
  } else if (apiMode === 'vercel' || apiMode === 'direct') {
    url = apiMode === 'direct'
      ? `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${apiKey}`
      : `${PROXY_VER}/v1beta/models/${model}:generateContent`;

    const contents = history.map(h => {
      const parts = [];
      if (h.text) parts.push({ text: h.text });
      if (h.role === 'user' && h.file) parts.push({ inlineData: { mimeType: h.file.mimeType, data: h.file.base64 } });
      return { role: h.role === 'user' ? 'user' : 'model', parts };
    });
    body = { contents, systemInstruction: { parts: [{ text: sysPrompt }] } };
  } else if (apiMode === 'direct_mistral') {
    url = 'https://api.mistral.ai/v1/chat/completions';
    headers['Authorization'] = `Bearer ${apiKey}`;
    const messages = [{ role:'system', content: sysPrompt }];
    history.forEach(h => {
      if (h.role === 'user') {
        const content = [{ type:'text', text: h.text }];
        if (h.file) content.push({ type:'image_url', image_url: { url: h.file.dataUrl } });
        messages.push({ role:'user', content });
      } else messages.push({ role:'assistant', content: h.text });
    });
    body = { model, messages, max_tokens: 8192 };
  }

  const res = await fetch(url, { method:'POST', headers, body: JSON.stringify(body) });
  if (!res.ok) {
    const err = await res.json().catch(() => ({}));
    throw new Error(err.error?.message || `HTTP ${res.status}`);
  }
  const data = await res.json();
  if (data.choices) return data.choices[0]?.message?.content || '';
  if (data.candidates) return data.candidates[0]?.content?.parts?.[0]?.text || '';
  return '';
}

function copyTable() {
  navigator.clipboard.writeText($('table-content').innerText);
  showNotify('Скопировано');
}

function downloadTableHtml() {
  const html = `<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Таблица</title><style>body{font-family:sans-serif;padding:20px}table{width:100%;border-collapse:collapse}th{background:#4f46e5;color:white;padding:12px}td{padding:12px;border-bottom:1px solid #eee}tr:hover{background:#f5f5f5}</style></head><body>${lastTableHtml}</body></html>`;
  const blob = new Blob([html], { type:'text/html' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `table_${Date.now()}.html`;
  a.click();
}

function openTableNewTab() {
  const html = `<!DOCTYPE html><html><head><meta charset="UTF-8"><style>body{font-family:sans-serif;padding:20px}table{width:100%;border-collapse:collapse}th{background:#4f46e5;color:white;padding:12px}td{padding:12px;border-bottom:1px solid #eee}</style></head><body>${lastTableHtml}</body></html>`;
  window.open(URL.createObjectURL(new Blob([html], { type:'text/html' })), '_blank');
}

function toBase64(file) {
  return new Promise((resolve, reject) => {
    const r = new FileReader();
    r.onload = () => resolve(r.result);
    r.onerror = reject;
    r.readAsDataURL(file);
  });
}

function autoResize() {
  this.style.height = 'auto';
  this.style.height = Math.min(this.scrollHeight, 130) + 'px';
}

function showNotify(msg, isErr=false) {
  notify.textContent = msg;
  notify.className = `notify show ${isErr ? 'error' : ''}`;
  setTimeout(() => notify.classList.remove('show'), 2500);
}

function openModal(m) { m.style.display = 'flex'; }
function closeModal(m) { m.style.display = 'none'; }

function resetChat() {
  history = [];
  chat.innerHTML = '';
  lastRenderedRole = null;
  chat.appendChild(empty);
  empty.style.display = 'flex';
  clearFile();
  updateContextSize();
  scrollBottomBtn.classList.remove('visible');
}

document.addEventListener('DOMContentLoaded', init);
</script>
</body>
</html>